<Window x:Class="LTools.Views.ControlPickOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="选择控件" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        Background="Transparent" Cursor="Cross" Focusable="True"
        SizeToContent="Manual" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_KeyDown"
        PreviewKeyUp="Window_KeyUp"
        PreviewMouseMove="Window_MouseMove"
        MouseLeave="Window_MouseLeave"
        PreviewMouseLeftButtonDown="Window_MouseDown"
        PreviewMouseRightButtonDown="Window_Cancel"
        PreviewMouseRightButtonUp="Window_Cancel"
        MouseRightButtonDown="Window_Cancel"
        MouseRightButtonUp="Window_Cancel"
        Loaded="Window_Loaded"
        views:WindowSizing.Mode="Overlay">
    <Window.Resources>
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- 比窗口点选器更轻：看控件靠的是矩形本身，压太黑反而看不清控件里的字 -->
        <Grid Background="#0F000000"/>
        <Canvas x:Name="Layer" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="ControlFill" Fill="#2238BDF8" Visibility="Collapsed"/>
            <Rectangle x:Name="ControlOutline" Stroke="#38BDF8" StrokeThickness="2"
                       RadiusX="3" RadiusY="3" Visibility="Collapsed">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
                </Rectangle.Effect>
            </Rectangle>
        </Canvas>

        <!-- 顶部提示 + 两个纯鼠标出口（控件树 / 取消） -->
        <Border x:Name="TopBar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                Background="#E618181B" CornerRadius="6" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HintText" Foreground="#F4F4F5" FontSize="13"
                           VerticalAlignment="Center"
                           Text="移动鼠标到目标控件，单击选中 · Esc / 右键 / 点「取消」退出"/>
                <Button x:Name="TreeButton" Style="{StaticResource BarBtn}" Content="从控件树选…"
                        Margin="14,0,0,0" Click="Tree_Click"
                        ToolTip="悬停拿不到的控件（被遮挡 / 折叠页里）从这里挑"/>
                <Button x:Name="CancelButton" Style="{StaticResource BarBtn}" Content="✕ 取消"
                        Margin="8,0,0,0" Click="Cancel_Click"
                        ToolTip="退出控件选取（等同于 Esc / 右键）"/>
            </StackPanel>
        </Border>

        <!-- 控件信息：类型 / 名称 / AutomationId / 所属窗口；贴控件矩形下方，放不下翻上方 -->
        <Border x:Name="InfoCard" Background="#E60EA5E9" CornerRadius="4" Padding="10,6"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="InfoTitle" Foreground="#082F49" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoDetail" Foreground="#0C4A6E" FontSize="11" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoWarn" Foreground="#9A3412" FontSize="11" Margin="0,3,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
