<Window x:Class="LTools.Views.ProgramDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Width="720" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,16">
                <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="78"
                        Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnPrimary}" x:Name="OkBtn" Content="覆盖"
                        MinWidth="88" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </controls:DialogShell.Footer>

        <StackPanel Margin="20,14,20,18">
            <TextBlock x:Name="HeaderText" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBody}"/>
            <TextBlock x:Name="CountText" Margin="0,6,0,0" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeHint}"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
            <Border Margin="0,10,0,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerMd}" Padding="6,4">
                <controls:DiffList x:Name="Diff" Height="320"/>
            </Border>
        </StackPanel>
    </controls:DialogShell>
</Window>
