<Window x:Class="CapsLockPro.Views.ActionPoolPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CapsLockPro.Views.Controls"
        Width="760" Height="540" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False"/>

        <!-- 搜索 + 操作 -->
        <Grid Grid.Row="1" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SearchBox" MinHeight="32"
                     ToolTip="按名称 / 类型筛选"
                     TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="新建动作…"
                    MinWidth="104" Margin="12,0,0,0" Click="New_Click"/>
        </Grid>

        <!-- 动作网格 -->
        <ScrollViewer Grid.Row="2" Margin="20,12,20,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="ActionPanel"/>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="HintText" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="取消"
                        MinWidth="84" Margin="0,0,8,0" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="确定"
                        MinWidth="84" IsDefault="True" Click="Ok_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
