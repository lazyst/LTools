<Window x:Class="LTools.Views.StepEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="步骤" Width="640" Height="660" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,10,18,12">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="DescText" Style="{StaticResource HintLabel}"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>

                <StackPanel x:Name="Form" Margin="0,12,0,0"/>

                <Border x:Name="OutputSection" Margin="0,16,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="输出变量" Margin="0,0,0,3"/>
                        <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                   Text="勾选后把这项结果存进变量，后面的步骤用 ${变量} 取用。类型由单元声明（徽标），不必自己记；主结果排在最前。"/>
                        <StackPanel x:Name="Outputs" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="OptionSection" Margin="0,16,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="步骤选项" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <TextBlock Text="失败时" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <ComboBox x:Name="FailBox" MinWidth="110" MinHeight="28" Margin="8,0,18,0">
                                <ComboBoxItem Content="停止整个动作"/>
                                <ComboBoxItem Content="记录后继续"/>
                            </ComboBox>

                            <TextBlock Text="之后等待" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox x:Name="DelayBox" Width="76" MinHeight="28" Margin="8,0,4,0"/>
                            <TextBlock Text="毫秒" VerticalAlignment="Center"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </WrapPanel>

                        <CheckBox x:Name="DisabledBox" Content="跳过这一步（保留配置）" Margin="0,10,0,0"/>

                        <TextBlock Text="备注" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,4"/>
                        <TextBox x:Name="NoteBox" MinHeight="28"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnGhost}" Content="取消" IsCancel="True"
                        Width="88" MinHeight="32" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="确定" IsDefault="True"
                        Width="88" MinHeight="32" Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
