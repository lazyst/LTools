<Window x:Class="LTools.Views.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="动作" Width="1140" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 步骤行：缩进表示嵌套；标记行（否则 / 结束如果 / 结束循环 / 空分支）不可编辑。 -->
        <DataTemplate x:Key="StepRowTemplate">
            <Grid>
                <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" CornerRadius="3"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="{Binding Indent}" Padding="6,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSecondary}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Glyph}" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,6,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeSecondary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                       ToolTip="{Binding Summary}"/>
                        </StackPanel>

                        <Border Grid.Column="3" Background="{StaticResource SurfaceAltBrush}" CornerRadius="3"
                                Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0"
                                Visibility="{Binding OutputVisibility}" ToolTip="输出变量">
                            <TextBlock Text="{Binding Output}" FontSize="{StaticResource FontSizeHint}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Border>

                        <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="✎" Padding="0"
                                Width="24" Height="24" FontSize="{StaticResource FontSizeSecondary}"
                                VerticalAlignment="Center" ToolTip="编辑（双击行亦可）"
                                Visibility="{Binding ButtonVisibility}" Click="EditStep_Click"/>
                        <Button Grid.Column="5" Style="{StaticResource BtnGhost}" Content="✕" Padding="0"
                                Width="24" Height="24" FontSize="{StaticResource FontSizeHint}"
                                VerticalAlignment="Center" ToolTip="删除（含子步骤）"
                                Visibility="{Binding ButtonVisibility}" Click="DeleteStep_Click"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="MarkerText" Text="{Binding MarkerText}" Visibility="Collapsed"
                           Margin="{Binding MarkerIndent}" FontSize="{StaticResource FontSizeHint}"
                           FontStyle="Italic" Foreground="{StaticResource HintTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMarker}" Value="True">
                    <Setter TargetName="Card" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="MarkerText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter TargetName="MarkerText" Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="242" MinWidth="200"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="RightColumn" Width="286" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左：工具箱 ============ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8,0,8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}"
                               Text="工具箱" Margin="12,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintLabel}"
                               Text="点一下填参数 · 拖到步骤里插入 · 右键直接添加" Margin="12,0,12,6" TextWrapping="Wrap"/>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="12,0,12,8"
                             MinHeight="30" TextChanged="SearchBox_TextChanged"
                             ToolTip="按名称 / 分类 / 单元键搜索"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Toolbox" Margin="10,0,8,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 中：步骤 ============ -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <DockPanel Margin="12,8,12,8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="步骤" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnGhost}" Content="↑" Width="24" Height="24"
                                    Padding="0" ToolTip="上移（Alt+↑）" Click="MoveUp_Click"/>
                            <Button Style="{StaticResource BtnGhost}" Content="↓" Width="24" Height="24"
                                    Padding="0" Margin="2,0,8,0" ToolTip="下移（Alt+↓）" Click="MoveDown_Click"/>
                            <TextBlock x:Name="StepCountText" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Bottom"
                               Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="（空动作）从左侧点一个单元开始，例如：读取选中文本 → 文本处理 → 提示弹窗"/>

                    <!-- 试运行：不用先保存，跑的就是编辑器里现在的内容；轨迹按步骤路径回填到下面的列表 -->
                    <Border x:Name="RunBar" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="0,6,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="RunButton" Style="{StaticResource BtnGhost}" Content="▶ 试运行"
                                        MinHeight="24" Padding="8,2" Click="Run_Click"
                                        ToolTip="试运行整个动作（不必先保存）。试运行会真的操作鼠标键盘"/>
                                <Button x:Name="RunFromButton" Grid.Column="1" Style="{StaticResource BtnGhost}"
                                        Content="▶ 从此行" MinHeight="24" Padding="8,2" Margin="6,0,0,0"
                                        Click="RunFrom_Click"
                                        ToolTip="从选中的顶层步骤开始试运行（只支持顶层步骤）"/>
                                <Button x:Name="StopRunButton" Grid.Column="2" Style="{StaticResource BtnGhost}"
                                        Content="■ 停止" MinHeight="24" Padding="8,2" Margin="6,0,0,0"
                                        Visibility="Collapsed" Click="StopRun_Click"/>

                                <TextBlock x:Name="RunStatus" Grid.Column="3" VerticalAlignment="Center"
                                           Margin="10,0,8,0" FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource HintTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="试运行不会先保存；改了不想要就取消"/>

                                <Button x:Name="RunToggleButton" Grid.Column="4" Style="{StaticResource BtnGhost}"
                                        Content="展开" MinHeight="24" Padding="8,2" Click="RunToggle_Click"/>
                            </Grid>

                            <Grid x:Name="RunBody" Height="186" Margin="0,6,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="220"/>
                                    <ColumnDefinition Width="1*" MinWidth="150"/>
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock DockPanel.Dock="Top" Text="运行轨迹" FontSize="{StaticResource FontSizeHint}"
                                               Foreground="{StaticResource HintTextBrush}" Margin="0,0,0,2"/>
                                    <ListView x:Name="TraceList" BorderThickness="0" Background="Transparent"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              SelectionChanged="TraceList_SelectionChanged">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="MinHeight" Value="22"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}"
                                                               FontSize="{StaticResource FontSizeHint}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Unit}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Elapsed}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource HintTextBrush}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Detail}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource HintTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Detail}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>

                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="变量（运行结束后）"
                                               FontSize="{StaticResource FontSizeHint}"
                                               Foreground="{StaticResource HintTextBrush}" Margin="0,0,0,2"/>
                                    <ListView x:Name="SnapshotList" BorderThickness="0" Background="Transparent"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="MinHeight" Value="22"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Value}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="StepList" HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource StepRowTemplate}"
                             ContextMenuOpening="StepList_ContextMenuOpening"
                             PreviewMouseLeftButtonDown="StepList_PreviewMouseDown"
                             MouseDoubleClick="StepList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <!-- 拖动排序的幽灵 + 插入线（不吃鼠标事件） -->
                <Canvas x:Name="GhostLayer" Panel.ZIndex="50" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- ============ 右：变量 + 动作属性 ============ -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="变量" Margin="0,0,0,2"/>
                        <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                   Text="给步骤的输出变量起名后会自动登记在这里。"/>

                        <Grid x:Name="VariableHeader" Margin="0,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition x:Name="DirectionColumn" Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="类型" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                            <TextBlock x:Name="DirectionHeader" Grid.Column="2" Text="方向"
                                       FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                            <TextBlock Grid.Column="3" Text="默认值" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </Grid>

                        <StackPanel x:Name="VariableRows"/>

                        <Button Style="{StaticResource BtnGhost}" Content="＋ 新建变量"
                                HorizontalAlignment="Left" MinHeight="28" Padding="8,2"
                                Margin="0,4,0,0" Click="AddVariable_Click"/>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="名称" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" MinHeight="32" Margin="0,0,0,12"/>

                        <TextBlock x:Name="CodeHint" Style="{StaticResource HintLabel}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,-6,0,12"/>

                        <StackPanel x:Name="IconSection">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="图标" Margin="0,0,0,6"/>
                            <controls:IconPicker x:Name="IconPicker" Margin="0,0,0,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <TextBlock Text="双击步骤编辑 · 右键更多操作 · 从左侧拖到任意行之间插入"
                           VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource HintTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="校验" Width="80" MinHeight="32"
                            Margin="0,0,8,0" Click="Validate_Click"
                            ToolTip="按与 AI 草稿相同的规则静态检查变量 / 参数 / 引用"/>
                    <Button Style="{StaticResource BtnGhost}" Content="取消" IsCancel="True"
                            Width="92" MinHeight="32" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="确定" IsDefault="True"
                            Width="92" MinHeight="32" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
