<Window x:Class="LTools.Views.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="动作" Width="1140" Height="720" MinWidth="1046" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 步骤行：缩进表示嵌套；标记行（否则 / 结束如果 / 结束循环 / 空分支）不可编辑。 -->
        <DataTemplate x:Key="StepRowTemplate">
            <Grid>
                <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" CornerRadius="3"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="{Binding Indent}" Padding="6,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>

                        <!-- 选中指示：最左侧 3px 主色竖条（压在内边距上，不挤布局） -->
                        <Border x:Name="AccentBar" Grid.ColumnSpan="9" Width="3"
                                HorizontalAlignment="Left" CornerRadius="1.5" Margin="-5,0,0,0"
                                Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="1"/>

                        <!-- 折叠箭头：只有带子步骤的块才有 -->
                        <Button x:Name="FoldButton" Grid.Column="0" Style="{StaticResource BtnGhost}"
                                Content="{Binding FoldGlyph}" Padding="0" Width="16" Height="20"
                                FontSize="{StaticResource FontSizeHint}" VerticalAlignment="Center"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Visibility="{Binding FoldVisibility}" ToolTip="{Binding FoldTip}"
                                Click="FoldToggle_Click"/>
                        <TextBlock Grid.Column="1" Text="{Binding Number}" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSecondary}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <!-- 校验标记：✕ = 错误、！ = 提醒（悬停看具体是哪些问题） -->
                        <TextBlock x:Name="IssueMark" Grid.Column="2" Text="{Binding IssueMark}"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{Binding IssueBrush}"
                                   Visibility="{Binding IssueVisibility}"
                                   ToolTip="{Binding IssueTip}"/>

                        <TextBlock Grid.Column="3" Text="{Binding Glyph}" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="4,0,6,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeSecondary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                       ToolTip="{Binding Summary}"/>
                        </StackPanel>

                        <Border Grid.Column="5" Background="{StaticResource SurfaceAltBrush}" CornerRadius="3"
                                Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0"
                                Visibility="{Binding OutputVisibility}" ToolTip="输出变量">
                            <TextBlock Text="{Binding Output}" FontSize="{StaticResource FontSizeHint}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Border>

                        <!-- 状态 chip：跳过 / 失败继续 / ⟳3 / 延迟 / 备注（判定见 StepRowChips） -->
                        <ItemsControl Grid.Column="6" ItemsSource="{Binding Chips}" VerticalAlignment="Center"
                                      Margin="0,0,4,0" Visibility="{Binding ChipsVisibility}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="3"
                                            Padding="5,1" Margin="0,0,4,0" ToolTip="{Binding Tip}">
                                        <TextBlock x:Name="ChipText" Text="{Binding Text}"
                                                   FontSize="{StaticResource FontSizeHint}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Warn}" Value="True">
                                            <Setter TargetName="ChipText" Property="Foreground"
                                                    Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Column="7" Style="{StaticResource BtnGhost}" Content="✎" Padding="0"
                                Width="24" Height="24" FontSize="{StaticResource FontSizeSecondary}"
                                VerticalAlignment="Center" ToolTip="编辑（双击行亦可）"
                                Visibility="{Binding ButtonVisibility}" Click="EditStep_Click"/>
                        <Button Grid.Column="8" Style="{StaticResource BtnGhost}" Content="✕" Padding="0"
                                Width="24" Height="24" FontSize="{StaticResource FontSizeHint}"
                                VerticalAlignment="Center" ToolTip="删除（含子步骤）"
                                Visibility="{Binding ButtonVisibility}" Click="DeleteStep_Click"/>
                    </Grid>
                </Border>

                <Border x:Name="MarkerHost" Background="Transparent" CornerRadius="3" Padding="4,2"
                        Margin="{Binding MarkerIndent}" Visibility="Collapsed">
                    <TextBlock x:Name="MarkerText" Text="{Binding MarkerText}"
                               FontSize="{StaticResource FontSizeHint}"
                               FontStyle="Italic" Foreground="{StaticResource HintTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMarker}" Value="True">
                    <Setter TargetName="Card" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="MarkerHost" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter TargetName="MarkerText" Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter TargetName="FoldButton" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <!-- 单击选中的视觉：卡片变灰底 + 主色描边 + 左侧竖条（行本身是白卡片，容器底色被盖住） -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource PressedBgBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter TargetName="MarkerHost" Property="Background" Value="{StaticResource PressedBgBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 右栏的两页 tab（变量 / 参数）：选中项是「白底卡片」，未选中的只是可点的文字。
             右栏底色是 SurfaceAlt，白底能一眼分出当前页；不加下划线动画，切页要快。 -->
        <Style x:Key="RightTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="{StaticResource CornerSm}"
                                Padding="10,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource NavHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="242" MinWidth="200"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="RightColumn" Width="360" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左：工具箱 ============ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8,0,8">
                    <Grid DockPanel.Dock="Top" Margin="12,0,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="工具箱" VerticalAlignment="Center"
                                   ToolTip="点一下填参数 · 拖到步骤里插入 · 右键直接添加"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ExpandAllButton" Content="全部展开" Style="{StaticResource BtnGhost}"
                                    FontSize="11" Padding="4,0" MinHeight="20" MinWidth="0"
                                    ToolTip="展开所有分类" Click="ExpandAllGroups_Click"/>
                            <Button x:Name="CollapseAllButton" Content="全部收起" Style="{StaticResource BtnGhost}"
                                    FontSize="11" Padding="4,0" MinHeight="20" MinWidth="0" Margin="2,0,0,0"
                                    ToolTip="收起所有分类" Click="CollapseAllGroups_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintLabel}"
                               Text="点一下填参数 · 拖进步骤 · 右键添加" Margin="12,0,12,6"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="点一下动作单元填参数插入 · 拖到步骤列表里插入 · 右键动作单元还有「直接添加 / 添加到末尾」"/>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="12,0,12,8"
                             MinHeight="30" TextChanged="SearchBox_TextChanged"
                              controls:TextBoxPlaceholder.Text="搜索动作单元（名称 / 键 / 拼音首字母）…"
                             ToolTip="按名称 / 分类 / 动作单元键搜索，也可以打拼音首字母：jt = 截图、wbcl = 文本处理"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Toolbox" Margin="10,0,8,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 中：步骤 ============ -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <DockPanel Margin="12,8,12,8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="步骤" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnGhost}" Content="↶" Width="24" Height="24"
                                    Padding="0" ToolTip="撤销（Ctrl+Z）" Click="Undo_Click"/>
                            <Button Style="{StaticResource BtnGhost}" Content="↷" Width="24" Height="24"
                                    Padding="0" Margin="2,0,8,0" ToolTip="重做（Ctrl+Y）" Click="Redo_Click"/>
                            <Button Style="{StaticResource BtnGhost}" Content="↑" Width="24" Height="24"
                                    Padding="0" ToolTip="上移（Alt+↑）" Click="MoveUp_Click"/>
                            <Button Style="{StaticResource BtnGhost}" Content="↓" Width="24" Height="24"
                                    Padding="0" Margin="2,0,8,0" ToolTip="下移（Alt+↓）" Click="MoveDown_Click"/>
                            <TextBlock x:Name="StepCountText" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 搜步骤：只在现有列表里定位（不筛选，避免打乱嵌套结构）；Enter 下一处、Shift+Enter 上一处、Esc 清空 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="StepSearchBox" MinHeight="28" Padding="6,3"
                                 controls:TextBoxPlaceholder.Text="搜索步骤…"
                                 TextChanged="StepSearchBox_TextChanged"
                                 PreviewKeyDown="StepSearchBox_PreviewKeyDown"
                                 ToolTip="搜索步骤（名称 / 摘要 / 动作单元键 / 参数文本）；Enter 跳到下一处，Shift+Enter 上一处，Esc 清空。当前折叠的块会自动展开"/>
                        <TextBlock x:Name="StepSearchInfo" IsHitTestVisible="False"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,8,0" FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource HintTextBrush}" Visibility="Collapsed"/>
                    </Grid>

                    <!-- 宏动作横幅：这个动作就是一段录制的宏（单步「回放宏」），重录 / 调参不在这里改步骤 -->
                    <Border x:Name="MacroPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                            Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="MacroTitle" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MacroMetaText" Margin="0,2,0,0"
                                           FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnGhost}" Content="● 重新录制…"
                                        MinHeight="24" Padding="8,2" Click="MacroRerecord_Click"
                                        ToolTip="重新录一遍，覆盖这段宏（名称、面板 / 快捷键上的引用都不变）"/>
                                <Button Style="{StaticResource BtnGhost}" Content="键鼠宏设置"
                                        MinHeight="24" Padding="8,2" Margin="6,0,0,0"
                                        Click="MacroSettings_Click"
                                        ToolTip="录制热键、回放参数、改名 / 删除宏"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Bottom"
                               Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="提示：双击步骤改参数；Ctrl+点击左侧动作单元可以直接插入；拖到步骤之间可以调顺序"/>

                    <!-- 校验诊断：点一条就选中并滚到对应步骤（错误 / 提醒都列，步骤行上也有标记） -->
                    <Border x:Name="DiagnosticBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                            Margin="0,6,0,0" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="0,6,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DiagnosticTitle" FontSize="{StaticResource FontSizeHint}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="✕"
                                        Width="22" Height="22" Padding="0" Margin="6,0,0,0"
                                        FontSize="{StaticResource FontSizeHint}" Focusable="False"
                                        ToolTip="收起诊断列表（步骤行上的标记保留，改完再点「校验」）"
                                        Click="DiagnosticClose_Click"/>
                            </Grid>

                            <ListView x:Name="DiagnosticList" MaxHeight="132" Margin="0,4,0,0"
                                      BorderThickness="0" Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="2,1"/>
                                        <Setter Property="MinHeight" Value="20"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="DiagnosticRow_Click"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource FontSizeHint}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Where}"
                                                       ToolTip="{Binding Where}"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                       ToolTip="{Binding Message}"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <!-- 试运行：不用先保存，跑的就是编辑器里现在的内容；轨迹按步骤路径回填到下面的列表 -->
                    <Border x:Name="RunBar" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="0,6,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="RunButton" Style="{StaticResource BtnGhost}" Content="▶ 试运行"
                                        MinHeight="24" Padding="8,2" Click="Run_Click"
                                        ToolTip="试运行整个动作（不必先保存）。试运行会真的操作鼠标键盘"/>
                                <Button x:Name="RunFromButton" Grid.Column="1" Style="{StaticResource BtnGhost}"
                                        Content="▶ 从此行" MinHeight="24" Padding="8,2" Margin="6,0,0,0"
                                        Click="RunFrom_Click"
                                        ToolTip="从选中的顶层步骤开始试运行（只支持顶层步骤）"/>
                                <Button x:Name="StopRunButton" Grid.Column="2" Style="{StaticResource BtnGhost}"
                                        Content="■ 停止" MinHeight="24" Padding="8,2" Margin="6,0,0,0"
                                        Visibility="Collapsed" Click="StopRun_Click"/>

                                <TextBlock x:Name="RunStatus" Grid.Column="3" VerticalAlignment="Center"
                                           Margin="10,0,8,0" FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource HintTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="试运行不会先保存；改了不想要就取消"/>

                                <Button x:Name="RunToggleButton" Grid.Column="4" Style="{StaticResource BtnGhost}"
                                        Content="展开" MinHeight="24" Padding="8,2" Click="RunToggle_Click"/>
                            </Grid>

                            <Grid x:Name="RunBody" Height="186" Margin="0,6,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="220"/>
                                    <ColumnDefinition Width="1*" MinWidth="150"/>
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock DockPanel.Dock="Top" Text="运行轨迹" FontSize="{StaticResource FontSizeHint}"
                                               Foreground="{StaticResource HintTextBrush}" Margin="0,0,0,2"/>
                                    <ListView x:Name="TraceList" BorderThickness="0" Background="Transparent"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              SelectionChanged="TraceList_SelectionChanged">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="MinHeight" Value="22"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}"
                                                               FontSize="{StaticResource FontSizeHint}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Unit}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Elapsed}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource HintTextBrush}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Detail}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource HintTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ToolTip}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>

                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="变量（本次 / 上次试运行）"
                                               FontSize="{StaticResource FontSizeHint}"
                                               Foreground="{StaticResource HintTextBrush}" Margin="0,0,0,2"/>
                                    <ListView x:Name="SnapshotList" BorderThickness="0" Background="Transparent"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              MouseDoubleClick="SnapshotList_MouseDoubleClick"
                                              ToolTip="双击一行复制本次的值；加粗 + • = 和上一次试运行不同">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="MinHeight" Value="22"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="84"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Marker}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               ToolTip="和上一次试运行不同"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               FontWeight="{Binding Weight}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ValueTip}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Previous}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="{StaticResource FontSizeHint}"
                                                               Foreground="{StaticResource HintTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ValueTip}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                    <ListBox x:Name="StepList" HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                             ItemTemplate="{StaticResource StepRowTemplate}"
                             ContextMenuOpening="StepList_ContextMenuOpening"
                             PreviewMouseRightButtonDown="StepList_PreviewMouseRightButtonDown"
                             PreviewMouseLeftButtonDown="StepList_PreviewMouseDown"
                             MouseDoubleClick="StepList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 空动作的起步模板：点一下就把几步现成步骤插进来（之后照常改参数）。
                         只在一步都没有时出现，有步骤了不占地方。 -->
                    <StackPanel x:Name="TemplatePanel" Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="2,8,2,0" MaxWidth="440">
                        <TextBlock x:Name="TemplateTitle" Text="从模板开始"
                                   FontSize="{StaticResource FontSizeHint}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="点一下插入几步现成的步骤，再按需要改参数；也可以直接从左边工具箱挑。"
                                   FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource HintTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel x:Name="TemplateList"/>
                    </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- 拖动排序的幽灵 + 插入线（不吃鼠标事件） -->
                <Canvas x:Name="GhostLayer" Panel.ZIndex="50" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 中栏 / 右栏之间的分隔条：只在「参数抽屉」打开时记宽度（见 RightSplitter_DragCompleted）。
                 贴在右栏左缘（覆盖的是右栏内边距，不是步骤列表的滚动条），不额外占一列，
                 所以窗口 MinWidth 的余量算法不变。 -->
            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Left"
                          ResizeBehavior="PreviousAndCurrent" ResizeDirection="Columns"
                          Background="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                          ToolTip="拖动调整右侧参数栏的宽度"
                          DragCompleted="RightSplitter_DragCompleted"/>

            <!-- ============ 右：变量 + 动作属性 / 步骤参数（抽屉） ============ -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 两页共用一条 tab：编辑步骤时切到「参数」，关抽屉自己切回「变量」。
                         用户手动点也算数（抽屉里的表单不会被丢掉，只是暂时看不见）。 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,4">
                        <RadioButton x:Name="VariablesTab" Style="{StaticResource RightTab}"
                                     GroupName="righttab" Content="变量" IsChecked="True"
                                     Checked="RightTab_Checked"/>
                        <RadioButton x:Name="ParamsTab" Style="{StaticResource RightTab}"
                                     GroupName="righttab" Content="参数"
                                     Checked="RightTab_Checked"/>
                    </StackPanel>

                    <ScrollViewer x:Name="VariablesPage" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto" Padding="12,4,12,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="变量" Margin="0,0,0,2"/>
                        <TextBlock x:Name="VariablesHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                   Text="步骤写出的变量（输出、设置变量）会自动登记在这里，参数框右侧 ▾ 里也能选到。"/>

                        <Grid x:Name="VariableHeader" Margin="0,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition x:Name="DirectionColumn" Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="类型" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                            <TextBlock x:Name="DirectionHeader" Grid.Column="2" Text="方向"
                                       FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                            <TextBlock Grid.Column="3" Text="默认值" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </Grid>

                        <StackPanel x:Name="VariableRows"/>

                        <Button Style="{StaticResource BtnGhost}" Content="＋ 新建变量"
                                HorizontalAlignment="Left" MinHeight="28" Padding="8,2"
                                Margin="0,4,0,0" Click="AddVariable_Click"/>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="名称" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" MinHeight="32" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="说明" Margin="0,0,0,4"/>
                        <TextBox x:Name="DescriptionBox" MinHeight="52" MaxHeight="132"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                                 controls:TextBoxPlaceholder.Text="这个动作做什么、什么时候用（面板 / 悬浮的悬停提示会显示）"
                                 ToolTip="可选。写上之后，面板磁贴与悬浮按钮的悬停提示会把这句话一起显示"/>

                        <TextBlock x:Name="CodeHint" Style="{StaticResource HintLabel}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,-6,0,12"/>

                        <StackPanel x:Name="IconSection">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="图标" Margin="0,0,0,6"/>
                            <controls:IconPicker x:Name="IconPicker" Margin="0,0,0,8"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- 步骤参数抽屉：面包屑（可点回上一级）+ 表单本体（StepFormView）。
                         表单与 StepEditorDialog 是同一份控件，这里只是换个宿主。 -->
                    <Grid x:Name="ParamsPage" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="DrawerBreadcrumb" Orientation="Horizontal"
                                    Margin="12,0,12,4" Visibility="Collapsed"/>
                        <ContentControl x:Name="DrawerHost" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <TextBlock Text="双击步骤编辑 · 右键更多操作 · 从左侧拖到任意行之间插入"
                           VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource HintTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="校验" Width="80" MinHeight="32"
                            Margin="0,0,8,0" Click="Validate_Click"
                            ToolTip="按与 AI 草稿相同的规则静态检查变量 / 参数 / 引用"/>
                    <Button Style="{StaticResource BtnGhost}" Content="取消" IsCancel="True"
                            Width="92" MinHeight="32" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="确定" IsDefault="True"
                            Width="92" MinHeight="32" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
