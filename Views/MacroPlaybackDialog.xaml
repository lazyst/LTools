<Window x:Class="LTools.Views.MacroPlaybackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="宏回放设置" Width="520" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <Grid Margin="20,10,20,16">
                <Button x:Name="ResetBtn" Style="{StaticResource BtnGhost}" Content="恢复默认"
                        HorizontalAlignment="Left" MinWidth="80" Click="Reset_Click"
                        ToolTip="三项都改回跟随全局默认"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                            IsCancel="True" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="74"
                            Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </controls:DialogShell.Footer>

        <StackPanel Margin="20,6,20,16">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="只影响这一个宏；留空 = 跟随「回放默认值」里的全局默认。"/>

            <!-- 倒计时 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="开始前倒计时" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBox Grid.Column="1" x:Name="CountdownBox" MinHeight="30"/>
                <TextBlock Grid.Column="2" x:Name="CountdownHint" Style="{StaticResource HintLabel}"
                           Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>

            <!-- 速度 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="速度倍率" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBox Grid.Column="1" x:Name="SpeedBox" MinHeight="30"/>
                <TextBlock Grid.Column="2" x:Name="SpeedHint" Style="{StaticResource HintLabel}"
                           Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>

            <!-- 循环 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="循环次数" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox Grid.Column="1" x:Name="LoopsModeBox" MinHeight="30"
                          SelectionChanged="LoopsMode_Changed">
                    <ComboBoxItem Content="跟随默认" Tag="inherit"/>
                    <ComboBoxItem Content="无限循环" Tag="infinite"/>
                    <ComboBoxItem Content="指定次数" Tag="count"/>
                </ComboBox>
                <TextBox Grid.Column="2" x:Name="LoopsBox" MinHeight="30" Width="64"
                         Margin="8,0,0,0" Visibility="Collapsed"/>
                <TextBlock Grid.Column="3" x:Name="LoopsHint" Style="{StaticResource HintLabel}"
                           Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>

            <TextBlock x:Name="ErrorText" FontSize="{StaticResource FontSizeHint}"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,2,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </controls:DialogShell>
</Window>
