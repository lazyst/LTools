<Window x:Class="LTools.Views.MenuPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.14" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,12"/>
                <Border Background="{StaticResource BorderBrush}" Height="1"/>
            </StackPanel>

            <!-- 菜单项 -->
            <StackPanel Grid.Row="1" x:Name="ItemsHost" Margin="12,6,12,6"/>

            <!-- 关闭 -->
            <StackPanel Grid.Row="2" Margin="12,6,12,12">
                <Button Style="{StaticResource BtnGhost}" Content="关闭 (Esc)" MinHeight="34"
                        HorizontalAlignment="Stretch" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
