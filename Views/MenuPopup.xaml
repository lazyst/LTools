<Window x:Class="LTools.Views.MenuPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单" Width="280" SizeToContent="Height"
        WindowStyle="None" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <!-- 不透明窗口（无 AllowsTransparency）：恢复 ClearType + 硬件加速文本渲染。
         圆角由 Border CornerRadius 在同色底上自绘；无阴影留白故 Margin=0。 -->
    <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8"
            Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTitle}"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,12"/>
                <Border Background="{StaticResource BorderBrush}" Height="1"/>
            </StackPanel>

            <!-- 菜单项 -->
            <StackPanel Grid.Row="1" x:Name="ItemsHost" Margin="12,6,12,6"/>

            <!-- 关闭 -->
            <StackPanel Grid.Row="2" Margin="12,6,12,12">
                <Button Style="{StaticResource BtnGhost}" Content="关闭 (Esc)" MinHeight="34"
                        HorizontalAlignment="Stretch" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
