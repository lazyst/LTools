<Window x:Class="LTools.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Focusable="False" ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <!-- 提示弹窗的卡片：置顶、不抢焦点、不阻塞调用方（流程继续往下跑）。
         卡片正文**不执行回调**：要打开日志 / 设置这类操作，走底部那个明确的按钮，
         这样点空白处永远只是关闭，不会「想关掉却弹出日志」。 -->
    <Window.Resources>
        <!-- 卡片是深色底，按钮不走主题的浅色 Btn 样式，配色就地写；三档圆角仍用全局的 CornerSm。 -->
        <Style x:Key="ToastButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#59FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#7AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「关闭」是次要动作：默认透明，悬停才浮出色块，不会跟主操作抢眼睛。 -->
        <Style x:Key="ToastQuietButton" TargetType="Button" BasedOn="{StaticResource ToastButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>

        <!-- 右上角 ✕：**只关闭**，任何时候都不会打开日志。 -->
        <Style x:Key="ToastCloseMark" TargetType="Button">
            <Setter Property="Foreground" Value="#8A8A94"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource CornerSm}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#F4F4F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Background="#F51B1B1F" CornerRadius="{StaticResource CornerLg}" Padding="0"
            BorderBrush="#33FFFFFF" BorderThickness="1" Cursor="Hand"
            MouseLeftButtonUp="Card_Click" ToolTip="点击关闭">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>     <!-- 左侧色条 -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AccentBar" Grid.Column="0" Background="#3B82F6" CornerRadius="10,0,0,10"/>

            <StackPanel Grid.Column="1" Margin="14,12,6,12">
                <TextBlock x:Name="TitleText" Foreground="#F4F4F5" FontWeight="SemiBold"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,3"/>
                <TextBlock x:Name="MessageText" Foreground="#E4E4E7" TextWrapping="Wrap"
                           MaxHeight="260" TextTrimming="CharacterEllipsis"/>

                <!-- 有回调才有这一行：主操作（打开日志 / 设置…）+ 关闭。 -->
                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,9,0,0" Visibility="Collapsed">
                    <Button x:Name="ActionButton" Style="{StaticResource ToastButton}" Click="Action_Click"/>
                    <Button Style="{StaticResource ToastQuietButton}" Content="关闭"
                            Margin="8,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- 有操作按钮时收起来，避免和「关闭」重复。 -->
            <Button x:Name="CloseMark" Grid.Column="2" Content="✕" Style="{StaticResource ToastCloseMark}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,6,0"
                    ToolTip="关闭" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
