<Window x:Class="LTools.Views.TextViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Width="720" Height="480" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏右侧的状态徽标（只读 / 可编辑）在代码里建：见 ApplyModeChrome -->
        <controls:TitleBar Grid.Row="0" x:Name="Bar"/>

        <!-- 正文：显示模式只读（仍可选中复制），读取模式可编辑。
             底色也跟着变：只读偏灰（不像输入框），可编辑纯白。 -->
        <Border x:Name="BodyHost" Grid.Row="1" Margin="12,6,12,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="Body" BorderThickness="0" Background="Transparent" Padding="10,8"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     IsReadOnlyCaretVisible="False"/>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" Padding="12,6">
            <Grid>
                <TextBlock x:Name="StatsText" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="WrapCheck" Content="自动换行" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="WrapCheck_Changed" Unchecked="WrapCheck_Changed"/>
                    <Button x:Name="CancelBtn" Style="{StaticResource BtnGhost}" Content="取消"
                            MinWidth="70" Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Style="{StaticResource BtnPrimary}" Content="确定"
                            MinWidth="70" Visibility="Collapsed" Click="Ok_Click"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource BtnGhost}" Content="关闭"
                            MinWidth="70" Visibility="Collapsed" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
