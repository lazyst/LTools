<Window x:Class="LTools.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Width="400" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,16">
                <Button Style="{StaticResource BtnGhost}" x:Name="CancelBtn" Content="取消"
                        MinWidth="78" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnGhostDanger}" x:Name="DiscardBtn" Content="不保存"
                        MinWidth="78" Margin="0,0,8,0" Visibility="Collapsed" Click="Discard_Click"/>
                <Button Style="{StaticResource BtnPrimary}" x:Name="OkBtn" Content="确认"
                        MinWidth="78" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </controls:DialogShell.Footer>

        <!-- 消息超长时自己滚；窗口被工作区夹住时由外壳的外层 ScrollViewer 兜底。 -->
        <ScrollViewer Margin="20,16,20,18" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="MessageText" Text="" FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
        </ScrollViewer>
    </controls:DialogShell>
</Window>
