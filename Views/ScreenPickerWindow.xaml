<Window x:Class="LTools.Views.ScreenPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕取点" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="#0B0B0E" Cursor="Cross" UseLayoutRounding="True"
        SnapsToDevicePixels="True" Focusable="True"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseLeftButtonDown="Window_MouseDown"
        PreviewMouseLeftButtonUp="Window_MouseUp"
        PreviewMouseRightButtonDown="Window_Cancel"
        PreviewKeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <!-- 冻结画面 + 取点 / 框选。窗口正好盖住光标所在的显示器，
         所有坐标最终换算成「显示器物理像素 + 左上角偏移」，与截图 / 鼠标注入同一坐标系。 -->
    <Grid x:Name="Root" Background="#0B0B0E" ClipToBounds="True">
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>

        <Canvas x:Name="Layer" ClipToBounds="True">
            <!-- 框选时压暗选区以外的部分（EvenOdd 挖洞） -->
            <Path x:Name="DimPath" Fill="#99000000" IsHitTestVisible="False"/>

            <Rectangle x:Name="Selection" Stroke="#FFFFFF" StrokeThickness="1.5"
                       Visibility="Collapsed" IsHitTestVisible="False"/>

            <Line x:Name="CrossH" Stroke="#E6FFFFFF" StrokeThickness="1"
                  Visibility="Collapsed" IsHitTestVisible="False"/>
            <Line x:Name="CrossV" Stroke="#E6FFFFFF" StrokeThickness="1"
                  Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- 放大镜：8 倍，中心十字 -->
            <Border x:Name="MagBox" Width="132" Height="132" CornerRadius="6"
                    BorderBrush="#FFFFFF" BorderThickness="2" Background="#0B0B0E"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Grid ClipToBounds="True">
                    <Image x:Name="MagImage" Stretch="None" HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Rectangle Width="1" Height="132" Fill="#66FFFFFF" HorizontalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <Rectangle Width="132" Height="1" Fill="#66FFFFFF" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border x:Name="InfoBox" Background="#D9101014" CornerRadius="4" Padding="8,4"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="InfoText" Foreground="#F4F4F5" FontFamily="Consolas" FontSize="13"/>
            </Border>

            <Border x:Name="HintBox" Background="#D9101014" CornerRadius="4" Padding="14,7"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HintText" Foreground="#E4E4E7" FontSize="13"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
