<Window x:Class="LTools.Views.ControlTreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="选择控件"
        Width="760" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="Bar"/>

        <TextBlock x:Name="WindowText" Grid.Row="1" Margin="18,10,18,0"
                   FontSize="{StaticResource FontSizeHint}"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis"/>

        <TextBox x:Name="SearchBox" Grid.Row="2" Margin="18,8,18,0"
                 controls:TextBoxPlaceholder.Text="搜索名称 / AutomationId / 类型 / 类名"
                 TextChanged="SearchBox_TextChanged"
                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>

        <Border Grid.Row="3" Margin="18,8,18,0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CornerMd}" Padding="4">
            <ListBox x:Name="ControlList" BorderThickness="0" Background="Transparent"
                     Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ControlList_SelectionChanged"
                     MouseDoubleClick="ControlList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{Binding IndentMargin}" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding ControlType}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="0,0,12,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                                       MaxWidth="320" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" Padding="18,10" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="HintText" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshBtn" Style="{StaticResource BtnGhost}" Content="刷新"
                            MinWidth="66" Margin="0,0,8,0" Click="Refresh_Click"
                            ToolTip="重新读一次这个窗口的控件树"/>
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="78"
                            Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Style="{StaticResource BtnPrimary}" Content="确定"
                            MinWidth="86" IsDefault="True" IsEnabled="False" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
