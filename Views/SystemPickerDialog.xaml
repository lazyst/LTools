<Window x:Class="LTools.Views.SystemPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="选择窗口" Width="720" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <!-- 搜索 -->
        <Grid Grid.Row="1" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SearchBox" MinHeight="32"
                     ToolTip="按标题 / 进程 / 类名筛选"
                     TextChanged="Search_Changed"/>
            <TextBlock Grid.Column="1" x:Name="CountText" Style="{StaticResource HintLabel}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- 列表 -->
        <ListBox Grid.Row="2" x:Name="ItemList" Margin="14,10,14,0"
                 MouseDoubleClick="List_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,1">
                        <TextBlock Text="{Binding Primary}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Secondary}" Style="{StaticResource HintLabel}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="HintText" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="使用这个"
                        MinWidth="96" IsDefault="True" Click="Ok_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="取消"
                        MinWidth="84" Margin="0,0,8,0" IsCancel="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
