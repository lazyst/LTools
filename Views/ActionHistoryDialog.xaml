<Window x:Class="LTools.Views.ActionHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Width="880" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,16">
                <Button Style="{StaticResource BtnGhost}" Content="关闭" MinWidth="78"
                        Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnPrimary}" x:Name="RestoreBtn" Content="恢复此版本"
                        MinWidth="98" IsDefault="True" IsEnabled="False" Click="Restore_Click"/>
            </StackPanel>
        </controls:DialogShell.Footer>

        <StackPanel Margin="20,14,20,18">
            <TextBlock x:Name="HeaderText" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBody}"/>
            <TextBlock x:Name="HintText" Margin="0,6,0,0" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeHint}"
                       Foreground="{StaticResource SecondaryTextBrush}"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerMd}" Padding="4">
                    <ListBox x:Name="HistoryList" Height="330" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="HistoryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="MinHeight" Value="22"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding TimeText}" FontSize="{StaticResource FontSizeSecondary}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeHint}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="1" Margin="8,0,0,0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CornerMd}" Padding="6,4">
                    <Grid>
                        <TextBlock x:Name="EmptyText" Margin="6,4" TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource HintTextBrush}"
                                   Text="选中左侧一个版本，右侧显示它和当前动作的差异"/>
                        <controls:DiffList x:Name="Diff" Height="330" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </controls:DialogShell>
</Window>
