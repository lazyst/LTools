<Window x:Class="LTools.Views.SubActionInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="试运行子动作" Width="520" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="20,12,20,16">
            <TextBlock x:Name="HeadText" Style="{StaticResource SectionLabel}" Text="输入"/>
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,2,0,10"
                       Text="填这次试运行用的输入值，留空就用变量的默认值。列表每行一项，对象写 JSON。"/>

            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Inputs"/>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="运行" MinWidth="74"
                        Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
