<Window x:Class="LTools.Views.WindowPickOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="选择窗口" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        Background="Transparent" Cursor="Cross" Focusable="True"
        SizeToContent="Manual" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_KeyDown"
        PreviewKeyUp="Window_KeyUp"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseLeftButtonDown="Window_MouseDown"
        PreviewMouseRightButtonDown="Window_Cancel"
        PreviewMouseRightButtonUp="Window_Cancel"
        MouseRightButtonDown="Window_Cancel"
        MouseRightButtonUp="Window_Cancel"
        Loaded="Window_Loaded"
        views:WindowSizing.Mode="Overlay">
    <Window.Resources>
        <!-- 边框沿对角渐变，四边光晕朝窗口内部淡出 = 「边缘渐变高亮」 -->
        <LinearGradientBrush x:Key="EdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDE68A" Offset="0"/>
            <GradientStop Color="#F59E0B" Offset="0.5"/>
            <GradientStop Color="#FB923C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlowTop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80F59E0B" Offset="0"/>
            <GradientStop Color="#00F59E0B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlowBottom" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#80F59E0B" Offset="0"/>
            <GradientStop Color="#00F59E0B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlowLeft" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#80F59E0B" Offset="0"/>
            <GradientStop Color="#00F59E0B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlowRight" StartPoint="1,0" EndPoint="0,0">
            <GradientStop Color="#80F59E0B" Offset="0"/>
            <GradientStop Color="#00F59E0B" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- 轻暗化：窗口内容仍看得见，高亮边框才突出 -->
        <Grid Background="#26000000"/>
        <Canvas x:Name="Layer" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="GlowTopRect" Fill="{StaticResource GlowTop}" Visibility="Collapsed"/>
            <Rectangle x:Name="GlowBottomRect" Fill="{StaticResource GlowBottom}" Visibility="Collapsed"/>
            <Rectangle x:Name="GlowLeftRect" Fill="{StaticResource GlowLeft}" Visibility="Collapsed"/>
            <Rectangle x:Name="GlowRightRect" Fill="{StaticResource GlowRight}" Visibility="Collapsed"/>
            <Rectangle x:Name="Outline" Stroke="{StaticResource EdgeBrush}" StrokeThickness="3"
                       RadiusX="6" RadiusY="6" Visibility="Collapsed">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#F59E0B" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                </Rectangle.Effect>
            </Rectangle>
        </Canvas>

        <!-- 顶部提示 + 次要入口（无窗口进程 / 精确挑窗口时仍可列表选） -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                Background="#E618181B" CornerRadius="6" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HintText" Foreground="#F4F4F5" FontSize="13"
                           VerticalAlignment="Center"
                           Text="移动鼠标到目标窗口，单击选中 · Esc / 右键 / 点「取消」退出"/>
                <Button x:Name="CancelButton" Style="{StaticResource BarBtn}" Content="✕ 取消"
                        Margin="14,0,0,0" Click="Cancel_Click"
                        ToolTip="退出窗口选取（等同于 Esc / 右键）"/>
                <Button x:Name="ListButton" Style="{StaticResource BarBtn}" Content="从列表选…"
                        Margin="8,0,0,0" Click="List_Click"/>
            </StackPanel>
        </Border>

        <!-- 选中窗口的信息，贴在窗口矩形下方（放不下翻上方） -->
        <Border x:Name="InfoBar" Background="#E6F59E0B" CornerRadius="4" Padding="10,5"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="InfoText" Foreground="#18181B" FontSize="12" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
