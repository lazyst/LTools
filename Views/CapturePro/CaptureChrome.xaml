<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 截图**浮层**的配色（浅色）：工具栏 / 长截图面板 / 形状条 / 取色卡 / 提示条 / 选字候选条。
         这些控件浮在截图上面，浅底深字更接近设置页与对话框，也不会在亮内容上糊成一块。
         **一处定义**：CaptureIcons.xaml（BarBtn 家族）与各个浮层都从这里取，别再各处写死色值。
         ⚠ 只服务覆盖层的浮层。贴图窗口的徽标 / 提示仍是深色（它常盖住任意内容，深底更稳），
         覆盖层的压暗（veil）也必须保持深色——那是「未选区」的语义。 -->
    <SolidColorBrush x:Key="ChromeBg" Color="#F0F2F3F5"/>       <!-- 面板底（94%，透一点底图） -->
    <SolidColorBrush x:Key="ChromeFill" Color="#F7F8FA"/>       <!-- 不透明的底：输入框 / 预览框 -->
    <SolidColorBrush x:Key="ChromeBorder" Color="#26000000"/>   <!-- 1px 描边 -->
    <SolidColorBrush x:Key="ChromeInk" Color="#27272A"/>        <!-- 主文字 / 图标 -->
    <SolidColorBrush x:Key="ChromeInkDim" Color="#71717A"/>     <!-- 次文字 / 说明 -->
    <SolidColorBrush x:Key="ChromeInkOff" Color="#A1A1AA"/>     <!-- 禁用文字 -->
    <SolidColorBrush x:Key="ChromeHover" Color="#14000000"/>    <!-- 悬停底（8% 黑） -->
    <SolidColorBrush x:Key="ChromePressed" Color="#26000000"/>  <!-- 按下 / 选中底 -->
    <SolidColorBrush x:Key="ChromePanel" Color="#FFFFFF"/>      <!-- 工具条面板（antd colorBgElevated） -->
    <SolidColorBrush x:Key="ChromeWell" Color="#0D000000"/>     <!-- 凹槽：参数条 / 预览框 / 小按钮 -->
    <SolidColorBrush x:Key="ChromeStroke" Color="#33000000"/>   <!-- 色卡等小元素的描边 -->

    <!-- Ant Design 浅色 token（Snow Shot 工具条的真实取值，见 ant_design_qt 的 colorMap）。
         工具条 / 录屏面板的按钮、图标、选中态一律从这里取，别再写 #3B82F6 这类随手色。 -->
    <SolidColorBrush x:Key="CapturePrimary" Color="#1677FF"/>
    <SolidColorBrush x:Key="CapturePrimaryHover" Color="#4096FF"/>
    <SolidColorBrush x:Key="CapturePrimaryActive" Color="#0958D9"/>
    <SolidColorBrush x:Key="CapturePrimaryBg" Color="#E6F4FF"/>
    <SolidColorBrush x:Key="CaptureText" Color="#E6000000"/>          <!-- rgba(0,0,0,.88) -->
    <SolidColorBrush x:Key="CaptureTextSecondary" Color="#A6000000"/> <!-- rgba(0,0,0,.65) -->
    <SolidColorBrush x:Key="CaptureTextDisabled" Color="#40000000"/>  <!-- rgba(0,0,0,.25) -->
    <SolidColorBrush x:Key="CaptureBorder" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="CaptureBorderSecondary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="CaptureHover" Color="#0F000000"/>         <!-- 悬停：6% 黑 -->
    <SolidColorBrush x:Key="CaptureActive" Color="#1F000000"/>        <!-- 按下：12% 黑 -->
    <SolidColorBrush x:Key="CaptureDanger" Color="#FF4D4F"/>
    <SolidColorBrush x:Key="CaptureSuccess" Color="#52C41A"/>
    <SolidColorBrush x:Key="CaptureWarning" Color="#FAAD14"/>
</ResourceDictionary>
