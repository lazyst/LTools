<Window x:Class="LTools.Views.CapturePro.CaptureSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="保存截图" Width="660" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        views:WindowSizing.Mode="Dialog">
    <!-- 保存对话框：左边预览、右边路径 / 文件名 / 格式 / 尺寸 / 质量。
         外观跟覆盖层上的浮层同一套浅色（见 CaptureChrome.xaml），格式与尺寸用文字胶囊省一次下拉。
         只在覆盖层里用（Owner = 覆盖层），所以 Topmost 跟着宿主。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ChromeInkDim}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,10,0,4"/>
            </Style>

            <Style x:Key="FieldBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource ChromeFill}"/>
                <Setter Property="Foreground" Value="{StaticResource ChromeInk}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CaretBrush" Value="{StaticResource ChromeInk}"/>
                <Setter Property="SelectionBrush" Value="#3B82F6"/>
            </Style>

            <Style x:Key="Chip" TargetType="RadioButton">
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource ChromeInkDim}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{StaticResource ChromeWell}"
                                    BorderBrush="{StaticResource ChromeStroke}"
                                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChromeHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryBtn" TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="#3B82F6"/>
                <Setter Property="Padding" Value="14,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2F6FE0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2560C8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Background" Value="{StaticResource ChromeWell}"/>
                <Setter Property="Foreground" Value="{StaticResource ChromeInk}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
            CornerRadius="8" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 输出尺寸（按住标题拖动窗口：自绘卡片没有标题栏） -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="保存截图" Foreground="{StaticResource ChromeInk}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="MetaText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeInkDim}" FontSize="11"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：预览 -->
                <Border Background="{StaticResource ChromeWell}" BorderBrush="{StaticResource ChromeBorder}"
                        BorderThickness="1" CornerRadius="6" Height="248" Padding="6">
                    <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- 右：路径 / 文件名 / 格式 / 尺寸 / 质量 -->
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="文件夹" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Style="{StaticResource FieldBox}"/>
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostBtn}"
                                Margin="6,0,0,0" Click="Browse_Click"/>
                    </Grid>

                    <TextBlock Text="文件名" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}"/>
                        <TextBlock x:Name="ExtensionText" Grid.Column="1" Foreground="{StaticResource ChromeInkDim}"
                                   FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <TextBlock Text="格式" Style="{StaticResource FieldLabel}"/>
                    <StackPanel x:Name="FormatRow" Orientation="Horizontal"/>

                    <TextBlock Text="尺寸" Style="{StaticResource FieldLabel}"/>
                    <StackPanel x:Name="ScaleRow" Orientation="Horizontal"/>

                    <TextBlock Text="质量（仅 JPEG）" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="QualityBox" Style="{StaticResource FieldBox}" Width="70"
                             HorizontalAlignment="Left" Text="90"/>
                </StackPanel>
            </Grid>

            <!-- 保存结果（设置里「保存后显示结果」打开时，存完留着窗口显示这一条） -->
            <Border x:Name="ResultBar" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed"
                    Background="{StaticResource ChromeWell}" BorderBrush="{StaticResource ChromeBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultText" Foreground="{StaticResource ChromeInk}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="OpenFolderBtn" Grid.Column="1" Content="打开文件夹"
                            Style="{StaticResource GhostBtn}" Margin="8,0,0,0" Click="OpenFolder_Click"/>
                </Grid>
            </Border>

            <!-- 错误 + 按钮 -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostBtn}" MinWidth="66"
                            IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource PrimaryBtn}" MinWidth="78"
                            Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
