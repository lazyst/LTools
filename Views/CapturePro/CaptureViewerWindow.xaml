<Window x:Class="LTools.Views.CapturePro.CaptureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="查看大图" Width="1120" Height="780" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main">
    <!-- 查看大图（替代采集历史右侧那块预览区）：图片 + 右侧识别文字面板。
         滚轮缩放 / 拖动平移 / 双击切换「适应窗口 ↔ 100%」，Esc 关闭。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ViewerButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- 轮播箭头（照上游 AdCarousel）：多张预览才出现，半透明圆底浮在图上 -->
        <Style x:Key="SlideArrow" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#99000000" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <!-- 工具条：标题 + 尺寸 / 文件大小，右侧缩放 -->
        <Grid Grid.Row="1" Margin="18,10,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoText" Margin="0,3,0,0" FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ZoomOutBtn" Style="{StaticResource ViewerButton}" Content="−"
                        Click="ZoomOut_Click" ToolTip="缩小（滚轮也可以 / Ctrl+-）"/>
                <Border MinWidth="64" Height="28" Margin="6,0,0,0" Padding="8,0"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CornerSm}">
                    <TextBlock x:Name="ZoomText" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"
                               Text="100%"/>
                </Border>
                <Button x:Name="ZoomInBtn" Style="{StaticResource ViewerButton}" Content="+"
                        Click="ZoomIn_Click" ToolTip="放大（滚轮也可以 / Ctrl++）"/>
                <Button x:Name="FitBtn" Style="{StaticResource ViewerButton}" Content="适应窗口"
                        Click="Fit_Click" ToolTip="缩放到正好放进窗口（Ctrl+0）"/>
                <Button x:Name="ActualBtn" Style="{StaticResource ViewerButton}" Content="100%"
                        Click="Actual_Click" ToolTip="按图像像素 1:1 显示（Ctrl+1）"/>
            </StackPanel>
        </Grid>

        <!-- 图片 + 识别文字 -->
        <Grid Grid.Row="2" Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerMd}" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="ImageScroll" Background="Transparent"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ImageScroll_PreviewMouseWheel">
                        <Image x:Name="Picture" Stretch="None" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="Picture_MouseLeftButtonDown"
                               MouseLeftButtonUp="Picture_MouseLeftButtonUp"
                               MouseMove="Picture_MouseMove"
                               MouseLeave="Picture_MouseLeave"/>
                    </ScrollViewer>

                    <StackPanel x:Name="NoImagePanel" HorizontalAlignment="Center"
                                VerticalAlignment="Center" MaxWidth="320" Visibility="Collapsed">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource HintTextBrush}"/>
                        <TextBlock x:Name="NoImageText" Margin="0,12,0,0" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <Button x:Name="NoImagePlayBtn" Style="{StaticResource ViewerButton}"
                                Content="播放录屏" Margin="0,14,0,0" HorizontalAlignment="Center"
                                Click="Play_Click" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- 轮播：成品图 + 每块屏幕（原始屏幕，不压暗、不画选框），照上游 AdCarousel 循环翻张 -->
                    <Button x:Name="PrevSlideBtn" Style="{StaticResource SlideArrow}"
                            HorizontalAlignment="Left" Click="PrevSlide_Click"
                            ToolTip="上一张（←）">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                    <Button x:Name="NextSlideBtn" Style="{StaticResource SlideArrow}"
                            HorizontalAlignment="Right" Click="NextSlide_Click"
                            ToolTip="下一张（→）">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>

                    <Border x:Name="SlideChip" Background="#B3000000" CornerRadius="4"
                            Padding="10,3" Margin="0,0,0,12"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="SlideChipText" FontSize="{StaticResource FontSizeHint}"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="TextPanel" Grid.Column="1" Width="360" Margin="12,0,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerMd}" Visibility="Collapsed">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="识别文字" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ViewerButton}" Content="复制"
                                HorizontalAlignment="Right" Click="CopyText_Click"
                                ToolTip="复制全部识别文字"/>
                    </Grid>

                    <TextBox x:Name="TextBody" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Background="{StaticResource SurfaceAltBrush}"
                             controls:TextBoxClear.Attach="False"
                             controls:TextBoxPlaceholder.Attach="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 底栏：复制 / 复制文字 / 定位文件 / 另存为 / 关闭 -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="18,10"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="HintText" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource HintTextBrush}"
                           Text="滚轮缩放 · 拖动平移 · 双击适应窗口 / 100% · ←→ 翻张 · Esc 关闭"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ReopenBtn" Style="{StaticResource ViewerButton}" Content="重新编辑…"
                            Click="Reopen_Click" Visibility="Collapsed"
                            ToolTip="用当时那张整屏画面重开截图工具：选区、外观和画过的标注（连撤销）都在（会记一条新的采集）"/>
                    <Button x:Name="CopyImageBtn" Style="{StaticResource ViewerButton}" Content="复制图片"
                            Click="CopyImage_Click"/>
                    <Button x:Name="CopyTextBtn" Style="{StaticResource ViewerButton}" Content="复制文字"
                            Click="CopyText_Click"/>
                    <Button x:Name="RevealBtn" Style="{StaticResource ViewerButton}" Content="在文件夹中显示"
                            Click="Reveal_Click"/>
                    <Button x:Name="SaveAsBtn" Style="{StaticResource ViewerButton}" Content="另存为…"
                            Click="SaveAs_Click"/>
                    <Button Style="{StaticResource ViewerButton}" Content="关闭" MinWidth="72"
                            IsCancel="True" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
