<UserControl x:Class="LTools.Views.CapturePro.CaptureToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" SnapsToDevicePixels="True">
    <!-- 浮动工具栏：上排工具 + 撤销 / 完成动作，下排当前工具的样式（颜色 / 线宽 / 字号 / 块 / 透明度）。
         按钮在 code-behind 里按 ToolCatalog 生成（新增工具只改表），这里只给外观与两个容器。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToolBtn" TargetType="RadioButton" BasedOn="{StaticResource BarToolBtn}"/>
            <Style x:Key="ActBtn" TargetType="Button" BasedOn="{StaticResource BarBtn}"/>
            <Style x:Key="SeparatorBar" TargetType="Border" BasedOn="{StaticResource BarSeparator}"/>

            <!-- 面板底：白底 + 圆角 8 + 浮层阴影，与 Snow Shot 的 `createPanel` 一致（不画边框） -->
            <Style x:Key="BarPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ChromePanel}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Effect" Value="{StaticResource BarShadow}"/>
            </Style>

            <Style x:Key="StepBtn" TargetType="Button">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Foreground" Value="{StaticResource ChromeInk}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource ChromeWell}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChromeHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ColorChip" TargetType="RadioButton">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Ellipse x:Name="Chip" Fill="{TemplateBinding Background}"
                                     Stroke="{StaticResource ChromeStroke}" StrokeThickness="1"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Stroke" Value="#80000000"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chip" Property="Stroke" Value="{StaticResource CapturePrimary}"/>
                                    <Setter TargetName="Chip" Property="StrokeThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 枚举型参数（序号形状 / 数字写法 / 滤镜类型）的小胶囊：文字比图形省地方 -->
            <Style x:Key="ChoiceChip" TargetType="RadioButton">
                <Setter Property="Height" Value="16"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource ChromeInkDim}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chip" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource ChromeHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource CapturePrimaryBg}"/>
                                    <Setter Property="Foreground" Value="{StaticResource CapturePrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 两条独立的面板（照 Snow Shot）：上排工具 / 完成动作，下排当前工具的样式。
         面板之间隔 6，各有自己的圆角与阴影；参数条只在当前工具有样式时才显示。
         按钮在 code-behind 里按 ToolCatalog 生成（新增工具只改表），这里只给外观与两个容器。 -->
    <StackPanel>
        <Border x:Name="Chrome" Style="{StaticResource BarPanel}" Padding="12,4" Cursor="SizeAll"
                MouseLeftButtonDown="Chrome_MouseDown"
                MouseMove="Chrome_MouseMove"
                MouseLeftButtonUp="Chrome_MouseUp"
                PreviewMouseRightButtonDown="Chrome_RightDown">
            <WrapPanel x:Name="ToolRow" Orientation="Horizontal"/>
        </Border>

        <Border x:Name="ParamBar" Style="{StaticResource BarPanel}" Padding="10,4"
                Margin="0,6,0,0" HorizontalAlignment="Left" Cursor="Arrow">
            <StackPanel x:Name="ParamRow" Orientation="Horizontal"/>
        </Border>
    </StackPanel>
</UserControl>
