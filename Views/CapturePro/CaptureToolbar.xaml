<UserControl x:Class="LTools.Views.CapturePro.CaptureToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" SnapsToDevicePixels="True">
    <!-- 浮动工具栏：上排工具 + 撤销 / 完成动作，下排当前工具的样式（颜色 / 线宽 / 字号 / 块 / 透明度）。
         按钮在 code-behind 里按 ToolCatalog 生成（新增工具只改表），这里只给外观与两个容器。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="IconPath" TargetType="Path">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Fill" Value="Transparent"/>
                <Setter Property="StrokeThickness" Value="1.4"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="Stroke"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
            </Style>

            <Style x:Key="ToolBtn" TargetType="RadioButton">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Foreground" Value="#E4E4E7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActBtn" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Foreground" Value="#E4E4E7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#71717A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StepBtn" TargetType="Button">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Foreground" Value="#E4E4E7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#1FFFFFFF" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#E4E4E7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="42"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#A1A1AA"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="10,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ColorChip" TargetType="RadioButton">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Ellipse x:Name="Chip" Fill="{TemplateBinding Background}"
                                     Stroke="#55FFFFFF" StrokeThickness="1"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Stroke" Value="#AAFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chip" Property="Stroke" Value="#FFFFFF"/>
                                    <Setter TargetName="Chip" Property="StrokeThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 枚举型参数（序号形状 / 数字写法 / 滤镜类型）的小胶囊：文字比图形省地方 -->
            <Style x:Key="ChoiceChip" TargetType="RadioButton">
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Padding" Value="7,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#C7C7CE"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chip" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SeparatorBar" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="Chrome" Background="#E6101014" CornerRadius="8" BorderBrush="#26FFFFFF"
            BorderThickness="1" Padding="8,6" Cursor="SizeAll"
            MouseLeftButtonDown="Chrome_MouseDown"
            MouseMove="Chrome_MouseMove"
            MouseLeftButtonUp="Chrome_MouseUp">
        <StackPanel>
            <WrapPanel x:Name="ToolRow" Orientation="Horizontal"/>
            <Border x:Name="ParamBar" Background="#14FFFFFF" CornerRadius="4" Padding="6,3"
                    Margin="0,6,0,0" HorizontalAlignment="Left" Cursor="Arrow">
                <StackPanel x:Name="ParamRow" Orientation="Horizontal"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
