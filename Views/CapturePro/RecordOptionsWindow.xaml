<Window x:Class="LTools.Views.CapturePro.RecordOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="录屏选项" Width="620" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <!-- 录屏的默认开关：声音 / 摄像头 / 键鼠特效 / 编码 / 录完裁剪。
         这里存的只是「默认值」，内置功能 common.record 的参数可以按次覆盖。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 图标几何（摄像头方向的四个按钮）与截图浮层共用一份 -->
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <Grid Margin="20,10,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText" Grid.Column="0" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="这些是默认值；内置功能「录屏」的参数可以按次覆盖。"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                            IsCancel="True" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="保存" MinWidth="74"
                            Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </controls:DialogShell.Footer>

        <StackPanel Margin="20,12,20,10">

            <TextBlock Text="声音" Style="{StaticResource SectionLabel}"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SystemAudioBox" Content="系统声音（WASAPI 环回）" VerticalAlignment="Center"/>
                <CheckBox x:Name="MicBox" Grid.Column="1" Content="麦克风" Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                <ComboBox x:Name="MicDeviceBox" Grid.Column="2" Margin="12,0,0,0" Height="28"
                          ToolTip="麦克风设备；「系统默认输入设备」跟随 Windows 设置"/>
            </Grid>
            <TextBlock Style="{StaticResource HintLabel}" Margin="0,4,0,0"
                       Text="打不开的设备只记一条警告，另一路照录；两路都打不开就是纯画面。"/>

            <Separator Margin="0,12"/>

            <TextBlock Text="摄像头画中画" Style="{StaticResource SectionLabel}"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CameraBox" Height="28" SelectionChanged="Camera_Changed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="边长" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                    <Slider x:Name="CameraSizeSlider" Width="130" Margin="6,0,4,0" Minimum="50" Maximum="500"
                            SmallChange="10" LargeChange="50" VerticalAlignment="Center"
                            ValueChanged="CameraSize_Changed"/>
                    <TextBlock x:Name="CameraSizeText" Width="52" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"/>
                    <ComboBox x:Name="CameraShapeBox" Width="86" Height="28" Margin="6,0,0,0">
                        <ComboBoxItem Content="方形" Tag="square"/>
                        <ComboBoxItem Content="圆形" Tag="circle"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="方向" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <StackPanel x:Name="OrientationRow" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="OrientationText" Width="126" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="RotateRightBtn" Style="{StaticResource BarBtn}" Margin="4,0,0,0"
                            CommandParameter="rotateClockwise" Click="Orientation_Click"
                            ToolTip="顺时针转 90°">
                        <Path Data="{StaticResource IconRotateRight}" Style="{StaticResource IconPathSm}"/>
                    </Button>
                    <Button x:Name="RotateLeftBtn" Style="{StaticResource BarBtn}" Margin="2,0,0,0"
                            CommandParameter="rotateCounterclockwise" Click="Orientation_Click"
                            ToolTip="逆时针转 90°">
                        <Path Data="{StaticResource IconRotateLeft}" Style="{StaticResource IconPathSm}"/>
                    </Button>
                    <Button x:Name="FlipHorizontalBtn" Style="{StaticResource BarBtn}" Margin="2,0,0,0"
                            CommandParameter="flipHorizontal" Click="Orientation_Click"
                            ToolTip="左右翻转（自拍视角）">
                        <Path Data="{StaticResource IconFlipHorizontal}" Style="{StaticResource IconPathSm}"/>
                    </Button>
                    <Button x:Name="FlipVerticalBtn" Style="{StaticResource BarBtn}" Margin="2,0,0,0"
                            CommandParameter="flipVertical" Click="Orientation_Click"
                            ToolTip="上下翻转">
                        <Path Data="{StaticResource IconFlipVertical}" Style="{StaticResource IconPathSm}"/>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                           Style="{StaticResource HintLabel}"
                           Text="也能在录屏面板上拖动 / 缩放预览、点预览上方的方向按钮"/>
            </Grid>
            <TextBlock Style="{StaticResource HintLabel}" Margin="0,4,0,0"
                       Text="默认贴在录制画面左下角（距离 48 像素，可在录屏面板上拖动 / 缩放）；摄像头打不开就只录画面。"/>

            <Separator Margin="0,12"/>

            <TextBlock Text="键鼠特效" Style="{StaticResource SectionLabel}"/>
            <WrapPanel Margin="0,4,0,0">
                <CheckBox x:Name="CursorBox" Content="光标" VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <CheckBox x:Name="HighlightBox" Content="光标高亮" VerticalAlignment="Center"
                          Margin="0,0,16,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                <CheckBox x:Name="ClicksBox" Content="记录鼠标点击" VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <CheckBox x:Name="ScrollBox" Content="记录鼠标滚动" VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <CheckBox x:Name="KeysBox" Content="按键浮层" VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="高亮半径" VerticalAlignment="Center"
                               Foreground="{StaticResource HintTextBrush}"/>
                    <Slider x:Name="RadiusSlider" Width="110" Margin="6,0,4,0" Minimum="8" Maximum="128"
                            SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                            ValueChanged="Radius_Changed"/>
                    <TextBlock x:Name="RadiusText" Width="28" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock Style="{StaticResource HintLabel}" Margin="0,4,0,0"
                       Text="特效只画在成品上（屏幕上的鼠标外观不变）；涟漪 600ms、拖尾 500ms、按键停留 1.2 秒。激光笔 / 点击的颜色在录屏面板第二行的色卡里改。"/>

            <Separator Margin="0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="编码" VerticalAlignment="Center" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="CodecBox" Grid.Column="1" Width="230" Height="28">
                    <ComboBoxItem Content="自动（有硬件加速就用）" Tag="auto"/>
                    <ComboBoxItem Content="H.264（兼容性最好）" Tag="h264"/>
                    <ComboBoxItem Content="HEVC / H.265（更小）" Tag="hevc"/>
                </ComboBox>
                <CheckBox x:Name="TrimBox" Grid.Column="2" Content="录完打开裁剪 / 倍速窗口"
                          Margin="18,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <Separator Margin="0,12"/>

            <TextBlock Text="工具条" Style="{StaticResource SectionLabel}"/>
            <CheckBox x:Name="AutoHideBox" Margin="0,4,0,0" VerticalAlignment="Center"
                      Content="贴边自动收起：拖到屏幕左 / 右边缘，鼠标移开后收起成小条，悬停唤出"/>
            <TextBlock Style="{StaticResource HintLabel}" Margin="0,4,0,0"
                       Text="只在录制中生效（摆着等点录制时不会自己消失）。小条贴住屏幕边，点它或悬停 0.1 秒就展开。"/>
        </StackPanel>
    </controls:DialogShell>
</Window>
