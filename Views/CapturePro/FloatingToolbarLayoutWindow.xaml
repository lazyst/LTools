<Window x:Class="LTools.Views.CapturePro.FloatingToolbarLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="悬浮工具条布局" Width="760" Height="520" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <!-- 照上游浮动工具条的布局编辑：一叠一行（叠内只露第一个、悬停展开），
         右边是收起来的功能；顺序就是工具条上的顺序。 -->
    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <Grid Margin="20,10,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText" Grid.Column="0" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="恢复默认" MinWidth="86"
                            Click="Reset_Click"/>
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                            Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="保存" MinWidth="74"
                            Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </controls:DialogShell.Footer>

        <Grid Margin="20,12,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="左边一行 = 工具条上的一叠（叠内只露第一个按钮，鼠标停上去展开其余）。顺序就是工具条从左到右的顺序。"/>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="工具条上（一叠一行）"/>
                    <ListBox x:Name="StackList" Height="330" Margin="0,6,0,0"
                             SelectionMode="Single"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <Button x:Name="AddToStackBtn" Style="{StaticResource BtnGhost}" Content="← 加入选中叠"
                            MinWidth="110" Margin="0,0,0,8" Click="AddToStack_Click"/>
                    <Button x:Name="NewStackBtn" Style="{StaticResource BtnGhost}" Content="← 新建一叠"
                            MinWidth="110" Margin="0,0,0,8" Click="NewStack_Click"/>
                    <Button x:Name="RemoveStackBtn" Style="{StaticResource BtnGhost}" Content="移出到收起 →"
                            MinWidth="110" Margin="0,0,0,8" Click="RemoveStack_Click"/>
                    <Button x:Name="UpBtn" Style="{StaticResource BtnGhost}" Content="上移"
                            MinWidth="110" Margin="0,8,0,8" Click="Up_Click"/>
                    <Button x:Name="DownBtn" Style="{StaticResource BtnGhost}" Content="下移"
                            MinWidth="110" Click="Down_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="收起来的"/>
                    <ListBox x:Name="HiddenList" Height="330" Margin="0,6,0,0"
                             SelectionMode="Single"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="PreviewText" Grid.Row="2" Style="{StaticResource HintLabel}"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </Grid>
    </controls:DialogShell>
</Window>
