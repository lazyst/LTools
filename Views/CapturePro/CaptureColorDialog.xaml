<Window x:Class="LTools.Views.CapturePro.CaptureColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:cp="clr-namespace:LTools.Views.CapturePro"
        Title="选择颜色" Width="470" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <!-- 颜色取色器（照上游 AdColorPicker 的截图工具条那一版）：色板 + 色相条 + 透明度条 +
         格式下拉（HEX / RGB / HSB）+ 一个能写多种写法的输入框 + 快捷色。
         以前只有 #RRGGBBAA 与 R/G/B/A 四个框，写不出 rgb() / hsb()，也没法拖色板。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <Grid Margin="20,10,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Foreground="{StaticResource DangerBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                            Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="74"
                            IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </controls:DialogShell.Footer>

        <StackPanel Margin="20,14,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Preview" Grid.Column="0" Width="96" Height="56"
                        CornerRadius="4" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush}"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="格式" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="FormatBox" Width="104" MinHeight="32" Margin="0,4,0,0"
                              controls:TextBoxClear.Attach="False"
                              SelectionChanged="Format_Changed">
                        <ComboBoxItem Content="HEX" Tag="hex"/>
                        <ComboBoxItem Content="RGB" Tag="rgb"/>
                        <ComboBoxItem Content="HSB" Tag="hsb"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="色值（也能直接写 rgb() / hsl() / hsb()）"
                               Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="ValueBox" MinHeight="32" Margin="0,4,0,0"
                             VerticalContentAlignment="Center"
                             TextChanged="Value_Changed"
                             KeyDown="Value_KeyDown"
                             LostFocus="Value_LostFocus"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0" Height="170">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <cp:ColorBoard x:Name="Board" Grid.Column="0" Picked="Board_Picked"/>
                <cp:HueBar x:Name="Hue" Grid.Column="1" Width="18" Margin="10,0,0,0"
                           Picked="Hue_Picked"/>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <cp:AlphaBar x:Name="Alpha" Grid.Column="0" Height="16" Picked="Alpha_Picked"/>
                <TextBlock x:Name="AlphaText" Grid.Column="1" Width="56" Margin="10,0,0,0"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </Grid>

            <TextBlock Text="快捷颜色" Style="{StaticResource SectionLabel}" Margin="0,14,0,0"/>
            <WrapPanel x:Name="QuickPicks" Margin="0,6,0,0"/>
        </StackPanel>
    </controls:DialogShell>
</Window>
