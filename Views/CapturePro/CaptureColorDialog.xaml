<Window x:Class="LTools.Views.CapturePro.CaptureColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="选择颜色" Width="430" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <!-- 颜色预设的取色框：上游用 Qt 的 QColorDialog，本地没有等价物，自写一份
         「十六进制 + RGBA 数字 + 常用色快选 + 预览」（带透明度时铺棋盘格）。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <Grid Margin="20,10,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Foreground="{StaticResource DangerBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                            Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="74"
                            IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </controls:DialogShell.Footer>

        <StackPanel Margin="20,14,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Preview" Grid.Column="0" Width="96" Height="56"
                        CornerRadius="4" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush}"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="十六进制（#RRGGBBAA）" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="HexBox" Height="32" Margin="0,4,0,0"
                             VerticalContentAlignment="Center"
                             TextChanged="Hex_Changed"
                             controls:TextBoxClear.Attach="False"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="常用色" Style="{StaticResource SectionLabel}" Margin="0,14,0,0"/>
            <WrapPanel x:Name="QuickPicks" Margin="0,6,0,0"/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="R" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="RBox" Height="30" Margin="0,4,0,0" TextChanged="Rgba_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="G" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="GBox" Height="30" Margin="0,4,0,0" TextChanged="Rgba_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="B" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="BBox" Height="30" Margin="0,4,0,0" TextChanged="Rgba_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="A（255 = 不透明）" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="ABox" Height="30" Margin="0,4,0,0" TextChanged="Rgba_Changed"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </controls:DialogShell>
</Window>
