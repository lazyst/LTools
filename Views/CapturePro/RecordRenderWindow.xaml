<Window x:Class="LTools.Views.CapturePro.RecordRenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="正在渲染录屏" Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="False" WindowStartupLocation="Manual"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        views:WindowSizing.Mode="Dialog">
    <!-- 渲染进度（照 Snow Shot 的 RecordingRenderDialog）：宽 500、无标题栏、没有标准按钮。
         状态行随阶段变（准备 / 渲染 / 收尾），下面一条 4px 进度条；失败或取消时多出一段可划选的
         细节（原因 + 源文件目录），按钮从「取消」换成「重试 / 保留源文件 / 丢弃」。
         关窗策略 Manual：渲染中关 = 取消，已停下来的态关 = 保留源文件。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RenderProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="4"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track">
                                <Border Background="{StaticResource ChromeWell}" CornerRadius="2"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RenderBtn" TargetType="Button">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinWidth" Value="72"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="{StaticResource ChromeInk}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource ChromeWell}" CornerRadius="4"
                                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChromeHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChromePressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource ChromeInkOff}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RenderBtnPrimary" TargetType="Button" BasedOn="{StaticResource RenderBtn}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource CapturePrimary}" CornerRadius="4"
                                    BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapturePrimaryHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapturePrimaryActive}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChromeWell}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ChromeInkOff}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RenderBtnDanger" TargetType="Button" BasedOn="{StaticResource RenderBtn}">
                <Setter Property="Foreground" Value="{StaticResource CaptureDanger}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    BorderBrush="{StaticResource CaptureDanger}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#14FF4D4F"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#24FF4D4F"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource ChromeInkOff}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChromeBorder}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource ChromeBorder}"
            BorderThickness="1" CornerRadius="10" Padding="20,16">
        <StackPanel>
            <TextBlock x:Name="StatusText" Text="正在准备导出录屏…"
                       Foreground="{StaticResource ChromeInk}" FontSize="13"
                       TextWrapping="Wrap"/>

            <ProgressBar x:Name="Progress" Style="{StaticResource RenderProgress}" Margin="0,12,0,0"
                         AutomationProperties.Name="渲染进度"/>

            <TextBox x:Name="DetailsText" Margin="0,12,0,0" Visibility="Collapsed"
                     IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" Padding="0"
                     Foreground="{StaticResource ChromeInkDim}" FontSize="12"
                     VerticalScrollBarVisibility="Auto" MaxHeight="140" MinHeight="48"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource RenderBtn}" Content="取消"
                        Click="Cancel_Click"/>
                <Button x:Name="RetryBtn" Style="{StaticResource RenderBtnPrimary}" Content="重试"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="Retry_Click"/>
                <Button x:Name="KeepBtn" Style="{StaticResource RenderBtn}" Content="保留源文件"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="Keep_Click"/>
                <Button x:Name="DiscardBtn" Style="{StaticResource RenderBtnDanger}" Content="丢弃"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="Discard_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
