<Window x:Class="LTools.Views.CapturePro.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:cap="clr-namespace:LTools.Features.CapturePro"
        xmlns:cp="clr-namespace:LTools.Views.CapturePro"
        Title="截图" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent" Cursor="Cross" UseLayoutRounding="True"
        SnapsToDevicePixels="True" Focusable="True"
        PreviewKeyDown="Window_KeyDown"
        PreviewKeyUp="Window_KeyUp"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseDown="Window_MiddleDown"
        PreviewMouseLeftButtonDown="Window_MouseDown"
        PreviewMouseLeftButtonUp="Window_MouseUp"
        PreviewMouseRightButtonDown="Window_Cancel"
        PreviewMouseWheel="Window_Wheel"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        views:WindowSizing.Mode="Overlay">
    <!-- 冻结画面 + 框选 + 标注。窗口正好盖住光标所在的显示器，
         所有坐标最终换算成「显示器物理像素 + 左上角偏移」，与截图 / 鼠标注入同一坐标系。
         画面（底图 / 标注 / 压暗 / 选区框）由 cap:CaptureCanvas 一次画完；
         这里只放把手、提示、尺寸条、浮动工具栏与文字输入框这些「窗口层」元素。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="OverlayBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4D4D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayBtnGhost" TargetType="Button" BasedOn="{StaticResource OverlayBtn}">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>

        <!-- ===== 顶部选区信息条（照 snow-shot ScreenshotSelectionToolbarWidget） =====
             深色半透明（#73000000 = rgba(0,0,0,115)）、高 26 / 圆角 6 / 左右内边距 8 / 上下 2、
             白字 14。字段悬停 = 主色半透明胶囊（rgba(22,119,255,107)）。 -->
        <Style x:Key="SelValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="SelSymbol" TargetType="TextBlock" BasedOn="{StaticResource SelValue}"/>
        <Style x:Key="SelUnit" TargetType="TextBlock" BasedOn="{StaticResource SelValue}">
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="SelField" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6B1677FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 信息条上的描边图标（圆角 / 阴影 / 比例锁）：上游是 1024 画布的填充路径，缩到 18。 -->
        <GeometryGroup x:Key="SelRadiusIcon">
            <PathGeometry Figures="M543.36,81.92 L339.52,81.92 C197.28,81.92 81.92,197.28 81.92,339.52 L81.92,543.36 A8.96,8.96 0 0,0 90.88,552.32 L153.6,552.32 A8.96,8.96 0 0,0 162.56,543.36 L162.56,339.52 C162.56,241.744 241.744,162.56 339.52,162.56 L543.36,162.56 A8.96,8.96 0 0,0 552.32,153.6 L552.32,90.88 A8.96,8.96 0 0,0 543.36,81.92 Z"/>
            <RectangleGeometry Rect="664.32,81.92,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="861.44,81.92,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="861.44,276.8,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="861.44,471.68,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="861.44,666.56,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="861.44,861.44,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="666.56,861.44,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="471.68,861.44,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="276.8,861.44,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="81.92,861.44,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
            <RectangleGeometry Rect="81.92,666.56,80.64,80.64" RadiusX="8.96" RadiusY="8.96"/>
        </GeometryGroup>
        <GeometryGroup x:Key="SelShadowIcon">
            <PathGeometry Figures="M816.64,252.16 L924.16,252.16 A35.84,35.84 0 0,1 960,288 L960,924.16 A35.84,35.84 0 0,1 924.16,960 L288,960 A35.84,35.84 0 0,1 252.16,924.16 L252.16,816.64 L780.8,816.64 A35.84,35.84 0 0,0 816.64,780.8 L816.64,252.16 Z"/>
            <PathGeometry Figures="M709.12,64 L99.84,64 A35.84,35.84 0 0,0 64,99.84 L64,709.12 A35.84,35.84 0 0,0 99.84,744.96 L709.12,744.96 A35.84,35.84 0 0,0 744.96,709.12 L744.96,99.84 A35.84,35.84 0 0,0 709.12,64 Z M144.64,144.64 L664.32,144.64 L664.32,664.32 L410.864,410.864 A8.96,8.96 0 0,0 398.096,410.864 L144.64,664.32 L144.64,144.64 Z M258.656,664.32 L404.48,518.496 L550.304,664.32 L258.656,664.32 Z"/>
            <EllipseGeometry Center="552.32,252.16" RadiusX="49.28" RadiusY="49.28"/>
        </GeometryGroup>
        <GeometryGroup x:Key="SelLockIcon">
            <PathGeometry Figures="M270.08,476.16 A8.96,8.96 0 0,1 261.12,467.2 L261.12,314.88 A250.88,250.88 0 0,1 762.88,314.88 L762.88,467.2 A8.96,8.96 0 0,1 753.92,476.16 L691.2,476.16 A8.96,8.96 0 0,1 682.24,467.2 L682.24,314.88 A170.24,170.24 0 0,0 341.76,314.88 L341.76,467.2 A8.96,8.96 0 0,1 332.8,476.16 L270.08,476.16 Z"/>
            <PathGeometry Figures="M270.08,547.84 L332.8,547.84 A8.96,8.96 0 0,1 341.76,556.8 L341.76,709.12 A170.24,170.24 0 0,0 682.24,709.12 L682.24,556.8 A8.96,8.96 0 0,1 691.2,547.84 L753.92,547.84 A8.96,8.96 0 0,1 762.88,556.8 L762.88,709.12 A250.88,250.88 0 0,1 261.12,709.12 L261.12,556.8 A8.96,8.96 0 0,1 270.08,547.84 Z"/>
            <RectangleGeometry Rect="471.68,305.92,80.64,412.16" RadiusX="8.96" RadiusY="8.96"/>
        </GeometryGroup>

        <!-- 选区形状的小胶囊：选中 = 主色底白字，未选中是透明底 -->
        <Style x:Key="ShapeBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource ChromeInk}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChromeHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <!-- ===== 二维码标记 + 气泡（照 Snow Shot ScreenshotQrMarker / ScreenshotQrPopover） =====
             标记：24×24 圆点（主色填充、浅底描边 2、白色 14×14 scan-qrcode，悬停变亮、键盘焦点描边 3）。
             气泡：白色圆角卡 + 16×8 箭头合成一个几何（描边只画外轮廓），阴影 blur 18 / 下移 3 / 黑 22%。 -->
        <DropShadowEffect x:Key="QrBubbleShadow" BlurRadius="18" ShadowDepth="3" Direction="270"
                          Color="#000000" Opacity="0.216"/>

        <Style x:Key="QrMarkerBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Dot" Margin="1" Fill="{StaticResource CapturePrimary}"
                                     Stroke="{StaticResource ChromePanel}" StrokeThickness="2"/>
                            <Path x:Name="Glyph" Width="14" Height="14" Stretch="Uniform"
                                  Data="{StaticResource IconScanQr}" Fill="#FFFFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource CapturePrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource CapturePrimaryHover}"/>
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource CapturePrimaryActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QrBtnBase" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QrBtnOutline" TargetType="Button" BasedOn="{StaticResource QrBtnBase}">
            <Setter Property="Background" Value="{StaticResource ChromePanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CaptureBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource CaptureText}"/>
        </Style>
        <Style x:Key="QrBtnPrimary" TargetType="Button" BasedOn="{StaticResource QrBtnBase}">
            <Setter Property="Background" Value="{StaticResource CapturePrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CapturePrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="#0B0B0E" ClipToBounds="True">
        <cap:CaptureCanvas x:Name="Surface" IsHitTestVisible="False"/>

        <Canvas x:Name="Layer" Background="Transparent" ClipToBounds="True">
            <!-- 悬停探测到的窗口 / 控件（琥珀色，和框选取图一致） -->
            <Rectangle x:Name="DetectRect" Stroke="#F59E0B" StrokeThickness="2"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="DetectLabel" Background="#F59E0B" CornerRadius="3" Padding="6,2"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="DetectText" Foreground="#18181B" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- 选区信息条（照 snow-shot）：X / Y · 比例锁 · 宽 × 高 · 比例下拉 | 圆角 · 效果宽。
                 数字全是**屏幕物理像素**（就是存进配置 / 快速集的那套数）；滚轮 ±1 px，单击开参数框。 -->
            <Border x:Name="SelBar" Panel.ZIndex="18" Background="#73000000" CornerRadius="6"
                    Padding="8,2" Visibility="Collapsed" SnapsToDevicePixels="True">
                <StackPanel x:Name="SelBarRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="SelFieldX" Style="{StaticResource SelField}" Tag="X"
                            Cursor="SizeWE" ToolTip="X 坐标（物理像素）· 滚轮 ±1 · 单击改参数">
                        <TextBlock x:Name="SelXText" Style="{StaticResource SelValue}"/>
                    </Border>
                    <TextBlock Style="{StaticResource SelSymbol}" Text=","/>
                    <Border x:Name="SelFieldY" Style="{StaticResource SelField}" Tag="Y"
                            Cursor="SizeNS" ToolTip="Y 坐标（物理像素）· 滚轮 ±1 · 单击改参数">
                        <TextBlock x:Name="SelYText" Style="{StaticResource SelValue}"/>
                    </Border>
                    <TextBlock x:Name="SelPosUnit" Style="{StaticResource SelUnit}" Text="px"/>

                    <Border x:Name="SelLockBtn" Style="{StaticResource SelField}" Padding="4,0"
                            Cursor="Hand" ToolTip="锁定宽高比">
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                            <Path x:Name="SelLockIcon" Fill="#FFFFFF" Data="{StaticResource SelLockIcon}"/>
                        </Viewbox>
                    </Border>

                    <Border x:Name="SelFieldW" Style="{StaticResource SelField}" Tag="W"
                            Cursor="SizeWE" ToolTip="宽（物理像素）· 滚轮 ±1 · 单击改参数">
                        <TextBlock x:Name="SelWText" Style="{StaticResource SelValue}"/>
                    </Border>
                    <TextBlock Style="{StaticResource SelSymbol}" Text="x"/>
                    <Border x:Name="SelFieldH" Style="{StaticResource SelField}" Tag="H"
                            Cursor="SizeNS" ToolTip="高（物理像素）· 滚轮 ±1 · 单击改参数">
                        <TextBlock x:Name="SelHText" Style="{StaticResource SelValue}"/>
                    </Border>
                    <TextBlock x:Name="SelSizeUnit" Style="{StaticResource SelUnit}" Text="px"/>

                    <Border Width="8"/>
                    <Border x:Name="SelAspectBtn" Style="{StaticResource SelField}" Padding="4,0"
                            Cursor="Hand" ToolTip="选区宽高比">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SelAspectText" Style="{StaticResource SelValue}"
                                       TextAlignment="Center" MinWidth="28"/>
                            <Path Width="8" Height="5" Stretch="Fill" Stroke="#FFFFFF" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 0,0 L 4,4 L 8,0" Margin="2,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="12" Fill="#6BD9D9D9" Margin="8,0"/>

                    <Border x:Name="SelFieldR" Style="{StaticResource SelField}" Tag="R"
                            Cursor="SizeNS" ToolTip="圆角半径（物理像素）· 滚轮 ±1 · 单击改参数">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Path Fill="#FFFFFF" Data="{StaticResource SelRadiusIcon}"/>
                            </Viewbox>
                            <TextBlock x:Name="SelRText" Style="{StaticResource SelValue}" Margin="4,0,2,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SelUnit}" Text="px"/>

                    <Border Width="8"/>

                    <Border x:Name="SelFieldE" Style="{StaticResource SelField}" Tag="E"
                            Cursor="SizeNS" ToolTip="阴影 / 边框宽度（物理像素）· 滚轮 ±1 · 单击改参数">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Path Fill="#FFFFFF" Data="{StaticResource SelShadowIcon}"/>
                            </Viewbox>
                            <TextBlock x:Name="SelEText" Style="{StaticResource SelValue}" Margin="4,0,2,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SelUnit}" Text="px"/>

                    <!-- 采集控制（照上游样式条右端那几个：显示光标 / 重新截图）。
                         **不要**把它们塞进「完成动作」里：那几叠是「这张图要拿去干什么」，
                         这两个是「画面本身怎么来」，混在一起会被当成识别的子项。 -->
                    <Rectangle Width="1" Height="12" Fill="#6BD9D9D9" Margin="8,0"/>

                    <Border x:Name="SelCursorBtn" Style="{StaticResource SelField}" Padding="4,0"
                            Cursor="Hand" ToolTip="显示光标（`）：把鼠标指针画进成品">
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                            <Path x:Name="SelCursorIcon" Fill="#FFFFFF" Data="{StaticResource IconRecCursor}"/>
                        </Viewbox>
                    </Border>

                    <Border x:Name="SelRecaptureBtn" Style="{StaticResource SelField}" Padding="4,0"
                            Cursor="Hand" ToolTip="重新截图（Alt+R）：重抓一张底图，选区 / 标注 / 撤销都不动">
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                            <Path x:Name="SelRecaptureIcon" Fill="#FFFFFF" Data="{StaticResource IconReload}"/>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 比例下拉：上次选区 + 具名快速集（「选区预设」）+ 8 个比例（「比例预设」）。
                 宽 112 / 项高 28 / 上限高 320（照上游 AdSelect 的 token）。

                 **画在覆盖层自己的 Canvas 里，不用 Popup**：Popup 是独立 HWND，在全屏
                 NOACTIVATE 覆盖层上，真机点条目时 WM_LBUTTONDOWN 进了 Popup、WM_LBUTTONUP
                 却被覆盖层收走（实测 ex-style 0x08080088），条目的 MouseLeftButtonUp 永远不触发，
                 表现就是「点一下只把菜单关掉」。上游那个下拉本来也是窗口内的控件。 -->
            <Border x:Name="SelAspectMenu" Panel.ZIndex="40" Visibility="Collapsed"
                    Background="#F21B1B1E" CornerRadius="6" BorderBrush="#33FFFFFF"
                    BorderThickness="1" Padding="4" MinWidth="112" MaxWidth="320" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SelAspectItems"/>
                </ScrollViewer>
            </Border>

            <Border x:Name="HintBox" Background="{StaticResource ChromeBg}" CornerRadius="4" Padding="14,7"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HintText" Foreground="{StaticResource ChromeInk}" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- 选区形状（还没框选时才出现）：矩形 / 折线 / 曲线 / 自由绘制（照上游
                 ScreenshotRegionTypeControl 的四档与顺序）。框过之后形状就定了；
                 想换就右键取消选区，这块条会再出现。 -->
            <Border x:Name="ShapeBar" Panel.ZIndex="15" Background="{StaticResource ChromeBg}" CornerRadius="6"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                    Padding="4" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ShapeRect" Style="{StaticResource ShapeBtn}" Content="矩形"
                                 GroupName="capShape" IsChecked="True" Tag="Rect" Click="Shape_Click"
                                 ToolTip="拖出一个矩形（默认）"/>
                    <RadioButton x:Name="ShapePolyline" Style="{StaticResource ShapeBtn}" Content="折线"
                                 GroupName="capShape" Tag="Polyline" Click="Shape_Click"
                                 ToolTip="逐点单击围出区域，双击 / Enter 结束"/>
                    <RadioButton x:Name="ShapeCurve" Style="{StaticResource ShapeBtn}" Content="曲线"
                                 GroupName="capShape" Tag="Curve" Click="Shape_Click"
                                 ToolTip="逐点单击，边角平滑成曲线，双击 / Enter 结束"/>
                    <RadioButton x:Name="ShapeLasso" Style="{StaticResource ShapeBtn}" Content="自由绘制"
                                 GroupName="capShape" Tag="Lasso" Click="Shape_Click"
                                 ToolTip="按住拖动，随手圈出要截的区域（松开自动闭合并平滑）"/>
                </StackPanel>
            </Border>

            <!-- 长截图：多边形的冻结画面已经收起、只留一块透明壳（见 CaptureOverlayWindow.Scroll.cs 的
                 EnterScrollShell）——页面自己收滚轮才滚得动，这也是「Chromium 被整个盖住就丢滚轮」的修法。
                 这里只画选区描边和小面板；两者像素都不透明，其余地方 alpha = 0，鼠标 / 滚轮直接穿透到页面。 -->
            <Border x:Name="ScrollFrame" Panel.ZIndex="7" BorderBrush="#3B82F6" BorderThickness="2"
                    Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- 长截图的小面板：整张长图的缩略预览 + 拼接到的尺寸 + 自动滚动 / 方向 / 完成 / 放弃。
                 摆位走 ScrollLayout.PlaceIn（优选出选区外面），鼠标点击由覆盖层让路。 -->
            <Border x:Name="ScrollPanel" Panel.ZIndex="22" Background="{StaticResource ChromeBg}" CornerRadius="8"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" Padding="10"
                    Effect="{StaticResource BarShadow}" Visibility="Collapsed">
                <StackPanel Width="212">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="长截图" Foreground="{StaticResource ChromeInk}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ScrollEditBtn" Style="{StaticResource BarBtn}" Click="ScrollEdit_Click"
                                    ToolTip="编辑这张长图（图片编辑窗）">
                                <Path Data="{StaticResource IconPen}" Style="{StaticResource IconPath}"/>
                            </Button>
                            <Button x:Name="ScrollSplitBtn" Style="{StaticResource BarBtn}" Click="ScrollSplit_Click"
                                    ToolTip="切图（先拼好长图，再打开切图窗）">
                                <Path Data="{StaticResource IconCropColumns}" Style="{StaticResource IconPath}"/>
                            </Button>
                            <Button x:Name="ScrollCancelBtn" Style="{StaticResource BarBtn}" Click="ScrollCancel_Click"
                                    ToolTip="放弃这次长截图（Esc）">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}"/>
                            </Button>
                            <Button x:Name="ScrollDoneBtn" Style="{StaticResource BarBtnPrimary}" Click="ScrollDone_Click"
                                    ToolTip="完成：交回拼好的长图（Enter / Ctrl+C）">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- 自动滚动 / 拼接方向：两个常驻开关，亮起来 = 生效中（自动滚动还可按空格切换） -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <!-- GroupName 必须各给一个：同一个 StackPanel 里没写 GroupName 的 RadioButton 会归成一组，
                             亮自动滚动就会把方向那颗顶掉（两颗要能同时亮） -->
                        <RadioButton x:Name="ScrollAutoBtn" Style="{StaticResource BarToolBtn}" GroupName="scrollAuto"
                                     Click="ScrollAuto_Click"
                                     ToolTip="自动滚动：让它自己往下滚着拼（空格）">
                            <Path Data="{StaticResource IconAutoScroll}" Style="{StaticResource IconPath}"/>
                        </RadioButton>
                        <RadioButton x:Name="ScrollAxisBtn" Style="{StaticResource BarToolBtn}" Margin="4,0,0,0"
                                     GroupName="scrollAxis" Click="ScrollAxis_Click"
                                     ToolTip="拼接方向：纵向（往下滚）/ 横向（往右拼）">
                            <Path Data="{StaticResource IconScrollAxis}" Style="{StaticResource IconPath}"/>
                        </RadioButton>
                    </StackPanel>

                    <Border x:Name="ScrollPreviewBox" Height="236" Margin="0,8,0,0" Background="{StaticResource ChromeWell}"
                            CornerRadius="4" ClipToBounds="True">
                        <Image x:Name="ScrollPreview" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock x:Name="ScrollStatus" Margin="0,8,0,0" Foreground="{StaticResource ChromeInkDim}" FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 光标旁那块取色 / 坐标卡（照上游 ScreenshotColorPickerWindow）：
                 上面 11×11 源像素按 12 倍放大（最近邻），中间一格描边；中间一行 X / Y；
                 下面一条色带写当前格式的色值（黑 / 白字按底色自动挑）。
                 选择工具与取色工具下都跟着光标走，显示时机见 OverlayUiSettings.PickerVisible。 -->
            <Border x:Name="PickerChip" Panel.ZIndex="26" Background="{StaticResource ChromePanel}"
                    CornerRadius="6" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                    Padding="4" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <Grid x:Name="PickerPreviewClip" Width="132" Height="132"
                          Background="{StaticResource ChromeWell}" ClipToBounds="True">
                        <Image x:Name="PickerPreview" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Rectangle x:Name="PickerCenterMark" Width="12" Height="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stroke="White" StrokeThickness="1"/>
                    </Grid>
                    <TextBlock x:Name="PickerPosText" Width="132" Height="20" Margin="0,5,0,0"
                               TextAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource ChromeInk}" FontSize="13"/>
                    <Border x:Name="PickerColorBar" Width="132" Height="24" Margin="0,5,0,0"
                            CornerRadius="5">
                        <TextBlock x:Name="PickerText" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 浮动工具栏（框选完成才出现）：上排 12 个标注工具 + 撤销 / 完成动作，下排样式。
                 可拖、双击复位；鼠标事件由覆盖层让路（见 IsOnToolbar）。 -->
            <cp:CaptureToolbar x:Name="Toolbar" Panel.ZIndex="30" Visibility="Collapsed"/>

            <!-- 二维码标记（识别到码、且选区不动时出现；按钮自己的悬停 / 点击由覆盖层让路） -->
            <Canvas x:Name="QrMarkerHost" Panel.ZIndex="28"/>

            <!-- 二维码气泡：白色圆角卡 + 箭头（合成一个几何），只读文本 + 复制 / 打开链接 -->
            <Canvas x:Name="QrBubbleHost" Panel.ZIndex="45" Visibility="Collapsed" Cursor="Arrow">
                <Grid x:Name="QrBubbleCard" Effect="{StaticResource QrBubbleShadow}">
                    <Path x:Name="QrBubbleShape" Fill="{StaticResource ChromePanel}"
                          Stroke="{StaticResource CaptureBorderSecondary}" StrokeThickness="1"/>
                    <StackPanel x:Name="QrBubbleBody" Margin="24">
                        <TextBox x:Name="QrBubbleText" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource ChromeInk}" Padding="0"
                                 FontSize="13" FontFamily="{StaticResource UiFont}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="QrBubbleStatus" Visibility="Collapsed" Margin="0,8,0,0"
                                   Foreground="{StaticResource CaptureDanger}" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="QrCopyBtn" Style="{StaticResource QrBtnOutline}"
                                    Content="复制文本" Click="QrCopy_Click"/>
                            <Button x:Name="QrOpenBtn" Style="{StaticResource QrBtnPrimary}" Margin="8,0,0,0"
                                    Content="打开链接" Click="QrOpen_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Canvas>

            <!-- 文字工具的就地输入框：Enter 结束，Shift+Enter 换行，Esc 放弃。
                 **刻意保持深色**：框里显示的就是最终标注的颜色（白字 / 黄字在白底上根本看不见），
                 所以这块不跟着浮层改浅色。 -->
            <TextBox x:Name="TextEntry" Panel.ZIndex="25" Visibility="Collapsed"
                     AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="80" MaxWidth="480"
                     Background="#E6101014" Foreground="#F4F4F5" BorderBrush="#3B82F6"
                     BorderThickness="1" Padding="4,2" FontFamily="Microsoft YaHei UI"
                     PreviewKeyDown="TextEntry_KeyDown" LostFocus="TextEntry_LostFocus"/>
        </Canvas>
    </Grid>
</Window>
