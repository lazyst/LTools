<Window x:Class="LTools.Views.CapturePro.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:cap="clr-namespace:LTools.Features.CapturePro"
        xmlns:cp="clr-namespace:LTools.Views.CapturePro"
        Title="截图" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent" Cursor="Cross" UseLayoutRounding="True"
        SnapsToDevicePixels="True" Focusable="True"
        PreviewKeyDown="Window_KeyDown"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseLeftButtonDown="Window_MouseDown"
        PreviewMouseLeftButtonUp="Window_MouseUp"
        PreviewMouseRightButtonDown="Window_Cancel"
        PreviewMouseWheel="Window_Wheel"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        views:WindowSizing.Mode="Overlay">
    <!-- 冻结画面 + 框选 + 标注。窗口正好盖住光标所在的显示器，
         所有坐标最终换算成「显示器物理像素 + 左上角偏移」，与截图 / 鼠标注入同一坐标系。
         画面（底图 / 标注 / 压暗 / 选区框）由 cap:CaptureCanvas 一次画完；
         这里只放把手、提示、尺寸条、浮动工具栏与文字输入框这些「窗口层」元素。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="OverlayBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4D4D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayBtnGhost" TargetType="Button" BasedOn="{StaticResource OverlayBtn}">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>

        <!-- 选区形状的小胶囊：选中 = 主色底白字，未选中是透明底 -->
        <Style x:Key="ShapeBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource ChromeInk}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChromeHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="#0B0B0E" ClipToBounds="True">
        <cap:CaptureCanvas x:Name="Surface" IsHitTestVisible="False"/>

        <Canvas x:Name="Layer" Background="Transparent" ClipToBounds="True">
            <!-- 悬停探测到的窗口 / 控件（琥珀色，和框选取图一致） -->
            <Rectangle x:Name="DetectRect" Stroke="#F59E0B" StrokeThickness="2"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="DetectLabel" Background="#F59E0B" CornerRadius="3" Padding="6,2"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="DetectText" Foreground="#18181B" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- 尺寸 / 坐标（物理像素，就是最终会存进配置的数字） -->
            <Border x:Name="InfoBox" Background="{StaticResource ChromeBg}" CornerRadius="4" Padding="8,4"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="InfoText" Foreground="{StaticResource ChromeInk}" FontFamily="Consolas" FontSize="13"/>
            </Border>

            <Border x:Name="HintBox" Background="{StaticResource ChromeBg}" CornerRadius="4" Padding="14,7"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HintText" Foreground="{StaticResource ChromeInk}" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- 选区形状（还没框选时才出现）：矩形 / 自由（按住圈）/ 折线（逐点单击）。
                 框过之后形状就定了；想换就右键取消选区，这块条会再出现。 -->
            <Border x:Name="ShapeBar" Panel.ZIndex="15" Background="{StaticResource ChromeBg}" CornerRadius="6"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                    Padding="4" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ShapeRect" Style="{StaticResource ShapeBtn}" Content="矩形"
                                 GroupName="capShape" IsChecked="True" Tag="Rect" Click="Shape_Click"
                                 ToolTip="拖出一个矩形（默认）"/>
                    <RadioButton x:Name="ShapeLasso" Style="{StaticResource ShapeBtn}" Content="自由"
                                 GroupName="capShape" Tag="Lasso" Click="Shape_Click"
                                 ToolTip="按住拖动，随手圈出要截的区域"/>
                    <RadioButton x:Name="ShapePolyline" Style="{StaticResource ShapeBtn}" Content="折线"
                                 GroupName="capShape" Tag="Polyline" Click="Shape_Click"
                                 ToolTip="逐点单击围出区域，双击 / Enter 结束"/>
                </StackPanel>
            </Border>

            <!-- 长截图：多边形的冻结画面已经收起、只留一块透明壳（见 CaptureOverlayWindow.Scroll.cs 的
                 EnterScrollShell）——页面自己收滚轮才滚得动，这也是「Chromium 被整个盖住就丢滚轮」的修法。
                 这里只画选区描边和小面板；两者像素都不透明，其余地方 alpha = 0，鼠标 / 滚轮直接穿透到页面。 -->
            <Border x:Name="ScrollFrame" Panel.ZIndex="7" BorderBrush="#3B82F6" BorderThickness="2"
                    Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- 长截图的小面板：整张长图的缩略预览 + 拼接到的尺寸 + 自动滚动 / 方向 / 完成 / 放弃。
                 摆位走 ScrollLayout.PlaceIn（优选出选区外面），鼠标点击由覆盖层让路。 -->
            <Border x:Name="ScrollPanel" Panel.ZIndex="22" Background="{StaticResource ChromeBg}" CornerRadius="8"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" Padding="10"
                    Effect="{StaticResource BarShadow}" Visibility="Collapsed">
                <StackPanel Width="212">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="长截图" Foreground="{StaticResource ChromeInk}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ScrollCancelBtn" Style="{StaticResource BarBtn}" Click="ScrollCancel_Click"
                                    ToolTip="放弃这次长截图（Esc）">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}"/>
                            </Button>
                            <Button x:Name="ScrollDoneBtn" Style="{StaticResource BarBtnPrimary}" Click="ScrollDone_Click"
                                    ToolTip="完成：交回拼好的长图（Enter / Ctrl+C）">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- 自动滚动 / 拼接方向：两个常驻开关，亮起来 = 生效中（自动滚动还可按空格切换） -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <!-- GroupName 必须各给一个：同一个 StackPanel 里没写 GroupName 的 RadioButton 会归成一组，
                             亮自动滚动就会把方向那颗顶掉（两颗要能同时亮） -->
                        <RadioButton x:Name="ScrollAutoBtn" Style="{StaticResource BarToolBtn}" GroupName="scrollAuto"
                                     Click="ScrollAuto_Click"
                                     ToolTip="自动滚动：让它自己往下滚着拼（空格）">
                            <Path Data="{StaticResource IconAutoScroll}" Style="{StaticResource IconPath}"/>
                        </RadioButton>
                        <RadioButton x:Name="ScrollAxisBtn" Style="{StaticResource BarToolBtn}" Margin="4,0,0,0"
                                     GroupName="scrollAxis" Click="ScrollAxis_Click"
                                     ToolTip="拼接方向：纵向（往下滚）/ 横向（往右拼）">
                            <Path Data="{StaticResource IconScrollAxis}" Style="{StaticResource IconPath}"/>
                        </RadioButton>
                    </StackPanel>

                    <Border x:Name="ScrollPreviewBox" Height="236" Margin="0,8,0,0" Background="{StaticResource ChromeWell}"
                            CornerRadius="4" ClipToBounds="True">
                        <Image x:Name="ScrollPreview" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock x:Name="ScrollStatus" Margin="0,8,0,0" Foreground="{StaticResource ChromeInkDim}" FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 取色：光标旁一块色卡 + #RRGGBB / rgb()；单击复制十六进制 -->
            <Border x:Name="PickerChip" Panel.ZIndex="26" Background="{StaticResource ChromeBg}" CornerRadius="4"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                    Padding="6,3" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="PickerSwatch" Width="14" Height="14" CornerRadius="2"
                            BorderBrush="{StaticResource ChromeStroke}" BorderThickness="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PickerText" Margin="6,0,0,0" Foreground="{StaticResource ChromeInk}"
                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 浮动工具栏（框选完成才出现）：上排 12 个标注工具 + 撤销 / 完成动作，下排样式。
                 可拖、双击复位；鼠标事件由覆盖层让路（见 IsOnToolbar）。 -->
            <cp:CaptureToolbar x:Name="Toolbar" Panel.ZIndex="30" Visibility="Collapsed"/>

            <!-- 文字工具的就地输入框：Enter 结束，Shift+Enter 换行，Esc 放弃。
                 **刻意保持深色**：框里显示的就是最终标注的颜色（白字 / 黄字在白底上根本看不见），
                 所以这块不跟着浮层改浅色。 -->
            <TextBox x:Name="TextEntry" Panel.ZIndex="25" Visibility="Collapsed"
                     AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="80" MaxWidth="480"
                     Background="#E6101014" Foreground="#F4F4F5" BorderBrush="#3B82F6"
                     BorderThickness="1" Padding="4,2" FontFamily="Microsoft YaHei UI"
                     PreviewKeyDown="TextEntry_KeyDown" LostFocus="TextEntry_LostFocus"/>
        </Canvas>
    </Grid>
</Window>
