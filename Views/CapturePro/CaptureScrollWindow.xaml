<Window x:Class="LTools.Views.CapturePro.CaptureScrollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="长截图" Width="268" Height="372"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        WindowStartupLocation="Manual" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        views:WindowSizing.Mode="Overlay">
    <!-- 长截图的小浮动面板：实时预览拼接结果 + 完成 / 取消。
         不抢焦点（ShowActivated=False + WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW）：
         滚轮要一直打到目标窗口上，面板一抢焦点就滚不动了。
         代价是收不到 Esc，出口全部做成鼠标可达（「完成」/「取消」）。 -->
    <Window.Resources>
        <Style x:Key="ScrollPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4D4D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollGhostBtn" TargetType="Button" BasedOn="{StaticResource ScrollPrimaryBtn}">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>
    </Window.Resources>

    <Border Background="#F2141418" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Ellipse Width="8" Height="8" Fill="#3B82F6" VerticalAlignment="Center"/>
                <TextBlock Text="长截图" Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="滚动目标窗口，自动拼接" Foreground="#71717A" FontSize="11"
                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#0B0B0E" CornerRadius="6"
                    BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True">
                <Image x:Name="Preview" Stretch="Uniform" Margin="4"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <TextBlock Grid.Row="2" x:Name="StatusText" Text="准备滚动…" Foreground="#A1A1AA"
                       FontSize="12" Margin="0,8,0,8" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DoneBtn" Style="{StaticResource ScrollPrimaryBtn}" Content="✓ 完成"
                        Click="Done_Click" ToolTip="停止滚动，用已经拼好的部分"/>
                <Button Style="{StaticResource ScrollGhostBtn}" Content="取消" Margin="8,0,0,0"
                        Click="Cancel_Click" ToolTip="放弃这次长截图"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
