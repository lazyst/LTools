<Window x:Class="LTools.Views.CapturePro.CapturePinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:local="clr-namespace:LTools.Views.CapturePro"
        Title="贴图" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True"
        Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewMouseDown="Window_PointerDown"
        PreviewMouseLeftButtonDown="Window_MouseDown"
        PreviewMouseLeftButtonUp="Window_MouseUp"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseRightButtonDown="Window_RightDown"
        PreviewMouseWheel="Window_Wheel"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        views:WindowSizing.Mode="Overlay">
    <!-- 贴图窗口：把截下来的图钉在屏幕上。
         不抢焦点（ShowActivated=False + WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW）：
         点它、滚它都不该让前台程序变成自己，否则接着注入的键鼠全打在贴图上。
         拖动 / 滚轮缩放 / Ctrl+滚轮不透明度 / 双击关闭 / 右键菜单都在 code-behind。
         局部显示时这里是取景框：内容按 PanTransform 平移，超出部分由 Surface 裁掉，
         所以缩放即「放大看细节」，窗口尺寸不再跟图走。
         缩略图模式复用同一个布局：Shot 的 Stretch 切 Uniform，整张图等比塞进小方块。

         **分层窗口 + DWM 缩略图**（实时贴图）：普通贴图靠 Backdrop 那块不透明底把窗口填满；
         实时贴图时 Backdrop 与 Shot 一起收起，整块内容区变成逐像素透明，露出压在下面一层的
         Native/LiveThumbnail 宿主窗口（DWM 直接把源窗口画在那一层，零抓帧、零延迟）。
         那层是独立的 HWND，鼠标消息由它转发回来，所以透明区里的点击照样能拖动 / 右键。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PinBadge" TargetType="Border">
                <Setter Property="Background" Value="#C9101014"/>
                <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>

            <Style x:Key="PinBarBtn" TargetType="Button">
                <Setter Property="Foreground" Value="#F4F4F5"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#E6212129" CornerRadius="4"
                                    BorderBrush="#40FFFFFF" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F03A3A46"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PinCloseBtn" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="0,3,3,0"/>
                <Setter Property="Foreground" Value="#F4F4F5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#C9101014" CornerRadius="11"
                                    BorderBrush="#40FFFFFF" BorderThickness="1">
                                <Path Data="{StaticResource IconClose}" Width="10" Height="10"
                                      Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E1E1E1"/>
                                    <Setter Property="Foreground" Value="#18181B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Surface" Background="{x:Null}" ClipToBounds="True">
        <!-- 不透明底：普通贴图 / 局部显示 / 缩略图都靠它；实时贴图时收起（见文件头注释）。 -->
        <Border x:Name="Backdrop" Background="#101014"/>

        <!-- 透明棋盘格：图里烘了圆角 / 阴影 / 边框时，透明的那几处铺这层（照上游
             themedCheckerboardBrush，深色底 #1F1F1F + 交替 #313131，10px 一格）。
             缩略图 / 实时贴图 / 没有形状时收起——那时要么有底色要么内容自己铺满。 -->
        <Rectangle x:Name="Checker" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Stretch="None"
                              Viewport="0,0,20,20" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#1F1F1F">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,20,20"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#313131">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,10,10"/>
                                        <RectangleGeometry Rect="10,10,10,10"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Image x:Name="Shot" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <TranslateTransform x:Name="PanTransform"/>
            </Image.RenderTransform>
        </Image>

        <!-- 文字识别层（P4-j）：把识别出的文字按原图行框铺回原图上（原图作底 + 每行估出的
             底色与文字），可拖动选择、复制。贴图不抢焦点，键盘复制走不到这里，所以复制入口
             放在下面那条状态条与右键菜单上（照上游 show_text_recognition_results）。 -->
        <local:CaptureOcrCanvas x:Name="OcrCanvas" Visibility="Collapsed" Cursor="IBeam"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- 边框画在图上而不是当外层 Border 的 BorderThickness：
             那样内容区会小 1px，局部显示里内容比取景框大一点时右下会多露一条空白。 -->
        <Border x:Name="Frame" BorderThickness="1" IsHitTestVisible="False" BorderBrush="#26FFFFFF"/>

        <!-- 源窗口最小化时的占位：实时画面这时没有内容（缩略图整层透明），不铺一块底就会
             直接透到贴图**后面**的窗口上，看着像贴图坏了。放在 ✕ / 徽标**下面**：
             最小化期间用户仍要能点右上角关掉它（占位只盖内容，不盖出口）。 -->
        <Border x:Name="LiveCover" Background="#E8101014" Margin="1" Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <Path Data="{StaticResource IconMinimize}" Width="22" Height="22"
                      Stretch="Uniform" Fill="#A1A1AA"
                      HorizontalAlignment="Center"/>
                <TextBlock x:Name="LiveCoverTitle" Text="源窗口已最小化" Margin="0,8,0,2"
                           FontSize="12" Foreground="#E4E4E7" TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="LiveCoverHint" Text="还原窗口后自动继续实时"
                           FontSize="11" Foreground="#A1A1AA" TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 左上角两枚小徽标：已选（多选）/ 分组名（不在默认组才显示）。
             缩略图方块太小，两枚一起收起（见 RefreshBadges）。 -->
        <StackPanel x:Name="BadgeRow" Orientation="Horizontal" Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border x:Name="SelectionBadge" Style="{StaticResource PinBadge}"
                    Background="#E63B82F6" BorderBrush="#66FFFFFF" Visibility="Collapsed">
                <TextBlock Text="✓ 已选" FontSize="11" Foreground="#FFFFFF"/>
            </Border>
            <Border x:Name="GroupBadge" Style="{StaticResource PinBadge}" Visibility="Collapsed">
                <TextBlock x:Name="GroupBadgeText" FontSize="11" Foreground="#E4E4E7"/>
            </Border>
        </StackPanel>

        <Button x:Name="CloseBtn" Style="{StaticResource PinCloseBtn}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="Collapsed" Click="CloseBtn_Click"
                ToolTip="关闭（也可以双击）"/>

        <Border x:Name="ViewHint" Background="#CC101014" CornerRadius="6" Padding="8,4" Margin="6"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                BorderBrush="#40FFFFFF" BorderThickness="1" IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="ViewHintText" FontSize="11" Foreground="#E4E4E7"/>
        </Border>
        <!-- 文字层状态条：识别进度 / 行数 / 已选字数，外加「复制所选 / 复制全文 / 退出」三个
             鼠标可达的出口（贴图收不到键盘，Ctrl+C 用不了）。 -->
        <Border x:Name="OcrBar" Background="#E6101014" CornerRadius="6" Padding="8,4" Margin="6"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                BorderBrush="#40FFFFFF" BorderThickness="1" Visibility="Collapsed">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="OcrBarText" FontSize="11" Foreground="#E4E4E7"
                           VerticalAlignment="Center" Margin="0,0,8,2"/>
                <Button x:Name="OcrCopySelectionBtn" Style="{StaticResource PinBarBtn}"
                        Content="复制所选" Click="OcrCopySelection_Click"
                        ToolTip="把拖选中的文字复制到剪贴板"/>
                <Button x:Name="OcrCopyAllBtn" Style="{StaticResource PinBarBtn}"
                        Content="复制全文" Click="OcrCopyAll_Click"
                        ToolTip="把识别出的全部文字复制到剪贴板"/>
                <Button x:Name="OcrExitBtn" Style="{StaticResource PinBarBtn}" Margin="0"
                        Content="退出文字层" Click="OcrExit_Click"
                        ToolTip="退出文字层，回到可拖动的贴图"/>
            </WrapPanel>
        </Border>

        <!-- 实时贴图的状态徽标（右下角）：跟得住时红点「实时」，源窗口最小化 / 关闭时换成说明。 -->
        <Border x:Name="LiveBadge" Background="#CC101014" CornerRadius="6" Padding="8,4" Margin="6"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                BorderBrush="#40FFFFFF" BorderThickness="1" IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#EF4444"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="LiveBadgeText" FontSize="11" Foreground="#E4E4E7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
