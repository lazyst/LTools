<Window x:Class="LTools.Views.CapturePro.CapturePinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="贴图" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Background="#101014" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Window_MouseDown"
        PreviewMouseLeftButtonUp="Window_MouseUp"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseRightButtonDown="Window_RightDown"
        PreviewMouseWheel="Window_Wheel"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        views:WindowSizing.Mode="Overlay">
    <!-- 贴图窗口：把截下来的图钉在屏幕上。
         不抢焦点（ShowActivated=False + WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW）：
         点它、滚它都不该让前台程序变成自己，否则接着注入的键鼠全打在贴图上。
         拖动 / 滚轮缩放 / Ctrl+滚轮不透明度 / 双击关闭 / 右键菜单都在 code-behind。
         局部显示时这里是取景框：内容按 PanTransform 平移，超出部分由 Surface 裁掉，
         所以缩放即「放大看细节」，窗口尺寸不再跟图走。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PinCloseBtn" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="0,3,3,0"/>
                <Setter Property="Foreground" Value="#F4F4F5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#C9101014" CornerRadius="11"
                                    BorderBrush="#40FFFFFF" BorderThickness="1">
                                <Path Data="{StaticResource IconClose}" Width="10" Height="10"
                                      Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E1E1E1"/>
                                    <Setter Property="Foreground" Value="#18181B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Surface" Background="#101014" ClipToBounds="True">
        <Image x:Name="Shot" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <TranslateTransform x:Name="PanTransform"/>
            </Image.RenderTransform>
        </Image>

        <!-- 边框画在图上而不是当外层 Border 的 BorderThickness：
             那样内容区会小 1px，局部显示里内容比取景框大一点时右下会多露一条空白。 -->
        <Border x:Name="Frame" BorderThickness="1" IsHitTestVisible="False" BorderBrush="#26FFFFFF"/>

        <Button x:Name="CloseBtn" Style="{StaticResource PinCloseBtn}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="Collapsed" Click="CloseBtn_Click"
                ToolTip="关闭（也可以双击）"/>

        <Border x:Name="ViewHint" Background="#CC101014" CornerRadius="6" Padding="8,4" Margin="6"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                BorderBrush="#40FFFFFF" BorderThickness="1" IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="ViewHintText" FontSize="11" Foreground="#E4E4E7"/>
        </Border>
    </Grid>
</Window>
