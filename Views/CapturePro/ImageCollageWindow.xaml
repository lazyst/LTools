<Window x:Class="LTools.Views.CapturePro.ImageCollageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:cp="clr-namespace:LTools.Views.CapturePro"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="图像拼接" Width="1200" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        Drop="Window_Drop" PreviewKeyDown="Window_KeyDown">
    <!-- 图像拼接窗（照 snow-shot 的 ImageStitchingWindow + ImageStitchingEditorWidget）：
         左边是拼接预览画布（棋盘格 + 背景 + 逐图裁剪绘制 + 选中框 / 八把手 + 两条浮动工具条）
         加一条 108×84 的缩略图；右边固定 340 宽的表单（图像类型 / 布局方向 / 行列 /
         图像尺寸 / 外边框 / 图像间距 / 背景颜色 / PDF 设置），底部是「W × H px · 总计 N 张图像」
         + 取消 / 图像编辑 / 复制 / 保存。
         输出类型切到「PDF 文档」时（照上游 refresh()）：静态画布 / 缩略图条 / 空态 / 画布工具条
         全部收起，换成「页面网格」（分页拼接）或「模板画布 + 页面条 + 缩略图条」（模板拼接），
         表单只留 PDF 设置；页脚改「毫米尺寸 + 共 N 页」，图像编辑 / 复制收起。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 棋盘格透明底：10px 一格（与图片编辑窗 / 切图窗同一套取值） -->
            <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Stretch="None"
                          Viewport="0,0,20,20" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource SurfaceBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,20,20"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#F0F0F1">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,10,10"/>
                                    <RectangleGeometry Rect="10,10,10,10"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- 浮层底：白底 + 圆角 8 + 浮层阴影（画布上的两条工具条） -->
            <Style x:Key="FloatPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ChromePanel}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Effect" Value="{StaticResource BarShadow}"/>
            </Style>

            <!-- 分段控件的一格：透明底、选中填主色（照上游 AdSegmented 的 joined 组） -->
            <Style x:Key="SegBtn" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource CaptureTextSecondary}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource CaptureHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource CapturePrimary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 小号分段（单位：像素 / 百分比），照上游 AdSegmented ControlSize.Small -->
            <Style x:Key="SegBtnSmall" TargetType="RadioButton" BasedOn="{StaticResource SegBtn}">
                <Setter Property="Height" Value="22"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="SegGroup" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CaptureBorderSecondary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CaptureBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <!-- 表单标签 / 数字输入 / 错误 -->
            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="NumberBox" TargetType="TextBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
                <Setter Property="controls:TextBoxClear.Attach" Value="False"/>
            </Style>

            <Style x:Key="FieldError" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>

            <!-- 画布上的 30×30 图标按钮（照上游 CanvasActionToolbar） -->
            <Style x:Key="CanvasAction" TargetType="Button" BasedOn="{StaticResource BarBtn}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
            </Style>

            <Style x:Key="CanvasActionPath" TargetType="Path" BasedOn="{StaticResource IconPathSm}">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
            </Style>

            <!-- 缩略图悬停时右下角的小圆钮（照上游 ThumbnailActions：28×28，白底 + 1px 边） -->
            <Style x:Key="ThumbAction" TargetType="Button">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Foreground" Value="{StaticResource CaptureText}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource ChromePanel}"
                                    BorderBrush="{StaticResource CaptureBorder}" BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource CaptureHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource CaptureActive}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource CaptureTextDisabled}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThumbActionPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
            </Style>

            <!-- 背景色预设（照上游 ImageStitchingColorPresetButton：28 格 + 内 22 色块 + 选中浅主色底） -->
            <Style x:Key="BgPreset" TargetType="RadioButton">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <Border Width="22" Height="22" CornerRadius="3"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource CaptureBorder}" BorderThickness="1"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource CaptureHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapturePrimaryBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 画布区 ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="Surface" Grid.Row="0" Background="{StaticResource CheckerBrush}"
                      ClipToBounds="True">
                    <cp:CollageCanvas x:Name="Preview"/>

                    <!-- 空态（上游 collageEmptyState） -->
                    <Grid x:Name="EmptyState" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="添加图像以创建图像拼接" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="将图像文件拖到此处，或选择“添加图像”" Margin="0,8,0,0"
                                       FontSize="{StaticResource FontSizeHint}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <Button x:Name="EmptyAddBtn" Style="{StaticResource BtnPrimary}" Content="添加图像"
                                    MinWidth="110" Margin="0,16,0,0" HorizontalAlignment="Center"
                                    Click="AddImages_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 拖放提示 -->
                    <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
                            Margin="12" BorderThickness="2" BorderBrush="{StaticResource PrimaryBrush}"
                            CornerRadius="8" Background="#CCFFFFFF">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="DropHintTitle" Text="松开鼠标，将图像添加到图像拼接"
                                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 画布工具条（照上游：底中，距底 12；空态时也在这里） -->
                    <Border x:Name="CanvasToolbar" Style="{StaticResource FloatPanel}" Padding="3"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ReverseBtn" Style="{StaticResource CanvasAction}"
                                    ToolTip="反转图像顺序" Click="Reverse_Click">
                                <Path Data="{StaticResource IconSwap}"
                                      Style="{StaticResource CanvasActionPath}"/>
                            </Button>
                            <Button x:Name="AddBtn" Style="{StaticResource CanvasAction}"
                                    ToolTip="添加图像" Click="AddImages_Click">
                                <Path Data="{StaticResource IconPlus}"
                                      Style="{StaticResource CanvasActionPath}"/>
                            </Button>
                            <Border Width="1" Height="16" Margin="4,0" VerticalAlignment="Center"
                                    Background="{StaticResource CaptureBorder}"/>
                            <Button x:Name="FitBtn" Style="{StaticResource CanvasAction}"
                                    ToolTip="适应画布" Click="Fit_Click">
                                <Path Data="{StaticResource IconFit}"
                                      Style="{StaticResource CanvasActionPath}"/>
                            </Button>
                            <Button x:Name="ClearBtn" Style="{StaticResource BarBtnDanger}"
                                    Width="30" Height="30" ToolTip="全部清空" Click="Clear_Click">
                                <Path Data="{StaticResource IconTrash}"
                                      Style="{StaticResource CanvasActionPath}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 浮层工具条（选中项）：挂在与画布同一坐标系的 Canvas 上，按选中框定位 -->
                    <Canvas x:Name="OverlayLayer">
                        <Border x:Name="SelectionToolbar" Style="{StaticResource FloatPanel}" Padding="3"
                                Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RotateCwBtn" Style="{StaticResource CanvasAction}"
                                        ToolTip="顺时针旋转 90°" Click="RotateCw_Click">
                                    <Path Data="{StaticResource IconRotateRight}"
                                          Style="{StaticResource CanvasActionPath}"/>
                                </Button>
                                <Button x:Name="RotateCcwBtn" Style="{StaticResource CanvasAction}"
                                        ToolTip="逆时针旋转 90°" Click="RotateCcw_Click">
                                    <Path Data="{StaticResource IconRotateLeft}"
                                          Style="{StaticResource CanvasActionPath}"/>
                                </Button>
                                <Button x:Name="FlipHBtn" Style="{StaticResource CanvasAction}"
                                        ToolTip="水平翻转" Click="FlipH_Click">
                                    <Path Data="{StaticResource IconFlipHorizontal}"
                                          Style="{StaticResource CanvasActionPath}"/>
                                </Button>
                                <Button x:Name="FlipVBtn" Style="{StaticResource CanvasAction}"
                                        ToolTip="垂直翻转" Click="FlipV_Click">
                                    <Path Data="{StaticResource IconFlipVertical}"
                                          Style="{StaticResource CanvasActionPath}"/>
                                </Button>
                                <Button x:Name="ResetTransformBtn" Style="{StaticResource CanvasAction}"
                                        ToolTip="重置变换" Click="ResetTransform_Click">
                                    <Path Data="{StaticResource IconReload}"
                                          Style="{StaticResource CanvasActionPath}"/>
                                </Button>
                                <Border Width="1" Height="16" Margin="4,0" VerticalAlignment="Center"
                                        Background="{StaticResource CaptureBorder}"/>
                                <Button x:Name="ReplaceBtn" Style="{StaticResource CanvasAction}"
                                        ToolTip="替换图像" Click="ReplaceSelected_Click">
                                    <Path Data="{StaticResource IconReplace}"
                                          Style="{StaticResource CanvasActionPath}"/>
                                </Button>
                                <Button x:Name="PreviewOriginalBtn" Style="{StaticResource CanvasAction}"
                                        ToolTip="预览原图" Click="PreviewOriginal_Click">
                                    <Path Data="{StaticResource IconEye}"
                                          Style="{StaticResource CanvasActionPath}"/>
                                </Button>
                                <Button x:Name="DeleteSelectedBtn" Style="{StaticResource BarBtnDanger}"
                                        Width="30" Height="30" ToolTip="删除图像"
                                        Click="DeleteSelected_Click">
                                    <Path Data="{StaticResource IconTrash}"
                                          Style="{StaticResource CanvasActionPath}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Canvas>

                    <!-- PDF 分页拼接：页面网格（照上游 ImageStitchingPdfPageGrid） -->
                    <Grid x:Name="PdfGridHost" Visibility="Collapsed" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PdfGridNotice" Margin="16,12,16,0" TextWrapping="Wrap"
                                   Text="页面预览使用上一次有效的设置" Visibility="Collapsed"
                                   FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <cp:CollagePdfPageGrid x:Name="PdfGrid"/>

                            <Grid x:Name="PdfGridEmpty" Background="Transparent">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="添加图像以创建 PDF 文档" FontSize="20"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="将图像文件拖到此处，或选择“添加图像”" Margin="0,8,0,0"
                                               FontSize="{StaticResource FontSizeHint}"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <Button x:Name="PdfEmptyAddBtn" Style="{StaticResource BtnPrimary}"
                                            Content="添加图像" MinWidth="110" Margin="0,16,0,0"
                                            HorizontalAlignment="Center" Click="AddImages_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="PdfGridToolbar" Style="{StaticResource FloatPanel}" Padding="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PdfReverseBtn" Style="{StaticResource CanvasAction}"
                                            ToolTip="反转页面顺序" Click="Reverse_Click">
                                        <Path Data="{StaticResource IconSwap}"
                                              Style="{StaticResource CanvasActionPath}"/>
                                    </Button>
                                    <Button x:Name="PdfAddBtn" Style="{StaticResource CanvasAction}"
                                            ToolTip="添加图像" Click="AddImages_Click">
                                        <Path Data="{StaticResource IconPlus}"
                                              Style="{StaticResource CanvasActionPath}"/>
                                    </Button>
                                    <Border Width="1" Height="16" Margin="4,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource CaptureBorder}"/>
                                    <Button x:Name="PdfClearBtn" Style="{StaticResource BarBtnDanger}"
                                            Width="30" Height="30" ToolTip="清空" Click="Clear_Click">
                                        <Path Data="{StaticResource IconTrash}"
                                              Style="{StaticResource CanvasActionPath}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Canvas x:Name="PdfGridOverlay">
                                <Border x:Name="PdfCardToolbar" Style="{StaticResource FloatPanel}"
                                        Padding="3" Visibility="Collapsed" Canvas.Left="0"
                                        Canvas.Top="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PdfRotateCwBtn" Style="{StaticResource CanvasAction}"
                                                ToolTip="顺时针旋转 90°" Click="RotateCw_Click">
                                            <Path Data="{StaticResource IconRotateRight}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfRotateCcwBtn" Style="{StaticResource CanvasAction}"
                                                ToolTip="逆时针旋转 90°" Click="RotateCcw_Click">
                                            <Path Data="{StaticResource IconRotateLeft}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfFlipHBtn" Style="{StaticResource CanvasAction}"
                                                ToolTip="水平翻转" Click="FlipH_Click">
                                            <Path Data="{StaticResource IconFlipHorizontal}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfFlipVBtn" Style="{StaticResource CanvasAction}"
                                                ToolTip="垂直翻转" Click="FlipV_Click">
                                            <Path Data="{StaticResource IconFlipVertical}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfResetBtn" Style="{StaticResource CanvasAction}"
                                                ToolTip="重置变换" Click="ResetTransform_Click">
                                            <Path Data="{StaticResource IconReload}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Border Width="1" Height="16" Margin="4,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource CaptureBorder}"/>
                                        <Button x:Name="PdfReplaceBtn" Style="{StaticResource CanvasAction}"
                                                ToolTip="替换图像" Click="ReplaceSelected_Click">
                                            <Path Data="{StaticResource IconReplace}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfPreviewBtn" Style="{StaticResource CanvasAction}"
                                                ToolTip="预览原图" Click="PreviewOriginal_Click">
                                            <Path Data="{StaticResource IconEye}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfCardDeleteBtn"
                                                Style="{StaticResource BarBtnDanger}" Width="30" Height="30"
                                                ToolTip="删除图像" Click="DeleteSelected_Click">
                                            <Path Data="{StaticResource IconTrash}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Grid>

                    <!-- PDF 模板拼接：模板画布 + 页面条 + 缩略图条（照上游 ImageStitchingPdfTemplateWidget） -->
                    <Grid x:Name="PdfTemplateHost" Visibility="Collapsed" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PdfTemplateNotice" Margin="16,12,16,0" TextWrapping="Wrap"
                                   Text="页面预览使用上一次有效的设置" Visibility="Collapsed"
                                   FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <cp:CollagePdfTemplateCanvas x:Name="PdfTemplateCanvas"/>

                            <Grid x:Name="PdfTemplateEmpty" Background="Transparent">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="添加图像以创建 PDF 文档" FontSize="20"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="将图像文件拖到此处，或选择“添加图像”" Margin="0,8,0,0"
                                               FontSize="{StaticResource FontSizeHint}"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <Button x:Name="PdfTemplateEmptyAddBtn"
                                            Style="{StaticResource BtnPrimary}" Content="添加图像"
                                            MinWidth="110" Margin="0,16,0,0"
                                            HorizontalAlignment="Center" Click="AddImages_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="PdfTemplateToolbar" Style="{StaticResource FloatPanel}"
                                    Padding="3" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PdfTemplateReverseBtn"
                                            Style="{StaticResource CanvasAction}"
                                            ToolTip="反转图像顺序" Click="Reverse_Click">
                                        <Path Data="{StaticResource IconSwap}"
                                              Style="{StaticResource CanvasActionPath}"/>
                                    </Button>
                                    <Button x:Name="PdfTemplateAddBtn" Style="{StaticResource CanvasAction}"
                                            ToolTip="添加图像" Click="AddImages_Click">
                                        <Path Data="{StaticResource IconPlus}"
                                              Style="{StaticResource CanvasActionPath}"/>
                                    </Button>
                                    <Border Width="1" Height="16" Margin="4,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource CaptureBorder}"/>
                                    <Button x:Name="PdfTemplateFitBtn" Style="{StaticResource CanvasAction}"
                                            ToolTip="适应画布" Click="PdfTemplateFit_Click">
                                        <Path Data="{StaticResource IconFit}"
                                              Style="{StaticResource CanvasActionPath}"/>
                                    </Button>
                                    <Button x:Name="PdfTemplateClearBtn"
                                            Style="{StaticResource BarBtnDanger}" Width="30" Height="30"
                                            ToolTip="全部清空" Click="Clear_Click">
                                        <Path Data="{StaticResource IconTrash}"
                                              Style="{StaticResource CanvasActionPath}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Canvas x:Name="PdfTemplateOverlay">
                                <Border x:Name="PdfTemplateSelectionToolbar"
                                        Style="{StaticResource FloatPanel}" Padding="3"
                                        Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PdfTemplateRotateCwBtn"
                                                Style="{StaticResource CanvasAction}"
                                                ToolTip="顺时针旋转 90°" Click="RotateCw_Click">
                                            <Path Data="{StaticResource IconRotateRight}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfTemplateRotateCcwBtn"
                                                Style="{StaticResource CanvasAction}"
                                                ToolTip="逆时针旋转 90°" Click="RotateCcw_Click">
                                            <Path Data="{StaticResource IconRotateLeft}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfTemplateFlipHBtn"
                                                Style="{StaticResource CanvasAction}"
                                                ToolTip="水平翻转" Click="FlipH_Click">
                                            <Path Data="{StaticResource IconFlipHorizontal}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfTemplateFlipVBtn"
                                                Style="{StaticResource CanvasAction}"
                                                ToolTip="垂直翻转" Click="FlipV_Click">
                                            <Path Data="{StaticResource IconFlipVertical}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfTemplateResetBtn"
                                                Style="{StaticResource CanvasAction}"
                                                ToolTip="重置图像" Click="ResetTransform_Click">
                                            <Path Data="{StaticResource IconReload}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Border Width="1" Height="16" Margin="4,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource CaptureBorder}"/>
                                        <Button x:Name="PdfTemplateReplaceBtn"
                                                Style="{StaticResource CanvasAction}"
                                                ToolTip="替换图像" Click="ReplaceSelected_Click">
                                            <Path Data="{StaticResource IconReplace}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfTemplatePreviewBtn"
                                                Style="{StaticResource CanvasAction}"
                                                ToolTip="预览原图" Click="PreviewOriginal_Click">
                                            <Path Data="{StaticResource IconEye}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                        <Button x:Name="PdfTemplateDeleteBtn"
                                                Style="{StaticResource BarBtnDanger}" Width="30"
                                                Height="30" ToolTip="删除图像" Click="DeleteSelected_Click">
                                            <Path Data="{StaticResource IconTrash}"
                                                  Style="{StaticResource CanvasActionPath}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- 页面条：上一页 / 第 x 页，共 y 页 / 下一页 -->
                        <StackPanel x:Name="PdfPageBar" Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="PdfPrevPageBtn" Style="{StaticResource CanvasAction}"
                                    ToolTip="上一页" Click="PdfPrevPage_Click">
                                <Path Data="{StaticResource IconChevronLeft}"
                                      Style="{StaticResource CanvasActionPath}"/>
                            </Button>
                            <TextBlock x:Name="PdfPageLabel" Text="暂无页面" Margin="10,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <Button x:Name="PdfNextPageBtn" Style="{StaticResource CanvasAction}"
                                    ToolTip="下一页" Click="PdfNextPage_Click">
                                <Path Data="{StaticResource IconChevronRight}"
                                      Style="{StaticResource CanvasActionPath}"/>
                            </Button>
                        </StackPanel>

                        <!-- 输入图像缩略图条（108×84，拖到另一张 = 交换） -->
                        <Border x:Name="PdfThumbRow" Grid.Row="3" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Margin="0,6,0,0">
                            <ScrollViewer x:Name="PdfThumbScroll" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" Height="88">
                                <StackPanel x:Name="PdfThumbHost" Orientation="Horizontal"
                                            Margin="2,2,2,2" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 缩略图条：一格 108×84（照上游 kThumbnailSize），拖到另一格 = 交换 -->
                <Border x:Name="ThumbnailRow" Grid.Row="1" Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <ScrollViewer x:Name="ThumbScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Height="88">
                        <StackPanel x:Name="ThumbHost" Orientation="Horizontal" Margin="2,2,2,2"
                                    VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============ 表单（右栏固定 340） ============ -->
            <Border Grid.Column="1" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="16,16,12,16">
                    <StackPanel x:Name="FormPanel">
                        <TextBlock Text="图像类型" Style="{StaticResource FormLabel}"/>
                        <Border Style="{StaticResource SegGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="OutStatic" Grid.Column="0" Style="{StaticResource SegBtn}"
                                             GroupName="collageOutputType" Content="静态图像"
                                             Checked="OutputType_Checked"/>
                                <RadioButton x:Name="OutPdf" Grid.Column="1" Style="{StaticResource SegBtn}"
                                             GroupName="collageOutputType" Content="PDF 文档"
                                             Checked="OutputType_Checked"/>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="StaticSection" Margin="0,14,0,0">
                        <TextBlock Text="布局方向" Style="{StaticResource FormLabel}"/>
                        <Border Style="{StaticResource SegGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="DirVertical" Grid.Column="0" Style="{StaticResource SegBtn}"
                                             GroupName="collageDirection" Content="垂直"
                                             Checked="Direction_Checked"/>
                                <RadioButton x:Name="DirHorizontal" Grid.Column="1" Style="{StaticResource SegBtn}"
                                             GroupName="collageDirection" Content="水平"
                                             Checked="Direction_Checked"/>
                                <RadioButton x:Name="DirCustom" Grid.Column="2" Style="{StaticResource SegBtn}"
                                             GroupName="collageDirection" Content="自定义"
                                             Checked="Direction_Checked"/>
                            </Grid>
                        </Border>

                        <!-- 自定义宫格：行数 / 列数（照上游 collageCustomGrid） -->
                        <StackPanel x:Name="GridRow" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="行数" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="RowsBox" Style="{StaticResource NumberBox}"
                                             LostFocus="Field_LostFocus"
                                             PreviewKeyDown="Field_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="列数" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="ColumnsBox" Style="{StaticResource NumberBox}"
                                             LostFocus="Field_LostFocus"
                                             PreviewKeyDown="Field_KeyDown"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="图像尺寸" Style="{StaticResource FormLabel}" Margin="0,14,0,4"/>
                        <Border Style="{StaticResource SegGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="SizeUniform" Grid.Column="0" Style="{StaticResource SegBtn}"
                                             GroupName="collageSizing" Content="统一尺寸"
                                             Checked="Sizing_Checked"/>
                                <RadioButton x:Name="SizeOriginal" Grid.Column="1" Style="{StaticResource SegBtn}"
                                             GroupName="collageSizing" Content="原始尺寸"
                                             Checked="Sizing_Checked"/>
                            </Grid>
                        </Border>

                        <!-- 外边框 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BorderLabel" Text="外边框" Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Border x:Name="BorderUnitGroup" Grid.Column="1" Style="{StaticResource SegGroup}"
                                    Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BorderUnitPx" Style="{StaticResource SegBtnSmall}"
                                                 GroupName="collageBorderUnit" Content="像素" MinWidth="40"
                                                 Checked="BorderUnit_Checked"/>
                                    <RadioButton x:Name="BorderUnitPct" Style="{StaticResource SegBtnSmall}"
                                                 GroupName="collageBorderUnit" Content="百分比" MinWidth="46"
                                                 Checked="BorderUnit_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BorderBox" Style="{StaticResource NumberBox}"
                                     LostFocus="Field_LostFocus" PreviewKeyDown="Field_KeyDown"/>
                            <TextBlock x:Name="BorderSuffix" Grid.Column="1" Text="px" Margin="8,0,0,0"
                                       VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </Grid>

                        <!-- 图像间距 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SpacingLabel" Text="图像间距" Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Border x:Name="SpacingUnitGroup" Grid.Column="1" Style="{StaticResource SegGroup}"
                                    Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SpacingUnitPx" Style="{StaticResource SegBtnSmall}"
                                                 GroupName="collageSpacingUnit" Content="像素" MinWidth="40"
                                                 Checked="SpacingUnit_Checked"/>
                                    <RadioButton x:Name="SpacingUnitPct" Style="{StaticResource SegBtnSmall}"
                                                 GroupName="collageSpacingUnit" Content="百分比" MinWidth="46"
                                                 Checked="SpacingUnit_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SpacingBox" Style="{StaticResource NumberBox}"
                                     LostFocus="Field_LostFocus" PreviewKeyDown="Field_KeyDown"/>
                            <TextBlock x:Name="SpacingSuffix" Grid.Column="1" Text="px" Margin="8,0,0,0"
                                       VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </Grid>

                        <!-- 背景颜色：8 个预设 + 取色 -->
                        <TextBlock Text="背景颜色" Style="{StaticResource FormLabel}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <RadioButton x:Name="Preset0" Style="{StaticResource BgPreset}"
                                             GroupName="collageBg" Background="#FFFFFF"
                                             ToolTip="白色" Checked="Preset_Checked" Tag="0"/>
                                <RadioButton x:Name="Preset1" Style="{StaticResource BgPreset}"
                                             GroupName="collageBg" Background="#000000"
                                             ToolTip="黑色" Checked="Preset_Checked" Tag="1"/>
                                <RadioButton x:Name="Preset2" Style="{StaticResource BgPreset}"
                                             GroupName="collageBg" Background="#8C8C8C"
                                             ToolTip="灰色" Checked="Preset_Checked" Tag="2"/>
                                <RadioButton x:Name="Preset3" Style="{StaticResource BgPreset}"
                                             GroupName="collageBg" Background="#FFCCC7"
                                             ToolTip="红色" Checked="Preset_Checked" Tag="3"/>
                                <RadioButton x:Name="Preset4" Style="{StaticResource BgPreset}"
                                             GroupName="collageBg" Background="#D9F7BE"
                                             ToolTip="绿色" Checked="Preset_Checked" Tag="4"/>
                                <RadioButton x:Name="Preset5" Style="{StaticResource BgPreset}"
                                             GroupName="collageBg" Background="#BAE0FF"
                                             ToolTip="蓝色" Checked="Preset_Checked" Tag="5"/>
                                <RadioButton x:Name="Preset6" Style="{StaticResource BgPreset}"
                                             GroupName="collageBg" Background="#FFF1B8"
                                             ToolTip="黄色" Checked="Preset_Checked" Tag="6"/>
                                <RadioButton x:Name="Preset7" Style="{StaticResource BgPreset}"
                                             GroupName="collageBg" Background="#EFDBFF"
                                             ToolTip="紫色" Checked="Preset_Checked" Tag="7"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Margin="6,4" Background="{StaticResource CaptureBorder}"
                                    HorizontalAlignment="Left"/>
                            <Button x:Name="ColorButton" Grid.Column="2" Style="{StaticResource SwatchButton}"
                                    ToolTip="选择背景颜色，可设置透明度" Click="ColorButton_Click"/>
                        </Grid>
                        </StackPanel>

                        <!-- ============ PDF 设置（照上游 ImageStitchingPdfSettingsWidget） ============ -->
                        <StackPanel x:Name="PdfSection" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="拼接方式" Style="{StaticResource FormLabel}"/>
                            <Border Style="{StaticResource SegGroup}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="PdfMethodPage" Grid.Column="0"
                                                 Style="{StaticResource SegBtn}" GroupName="collagePdfMethod"
                                                 Content="分页拼接" Checked="PdfMethod_Checked"/>
                                    <RadioButton x:Name="PdfMethodTemplate" Grid.Column="1"
                                                 Style="{StaticResource SegBtn}" GroupName="collagePdfMethod"
                                                 Content="模板拼接" Checked="PdfMethod_Checked"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PdfMethodError" Style="{StaticResource FieldError}"/>

                            <!-- 模板：9 个 3×3 小格（照上游 TemplateButton 自绘的纸面 + 格子） -->
                            <StackPanel x:Name="PdfTemplateRow" Margin="0,14,0,0">
                                <TextBlock Text="模板" Style="{StaticResource FormLabel}"/>
                                <UniformGrid Columns="3" Margin="0,0,-6,-6">
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateTwo" Kind="two_images"
                                                                 Margin="0,0,6,6" ToolTip="两张图像"
                                                                 Click="PdfTemplate_Click"/>
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateIdCard" Kind="id_card"
                                                                 Margin="0,0,6,6" ToolTip="身份证"
                                                                 Click="PdfTemplate_Click"/>
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateThree" Kind="three_images"
                                                                 Margin="0,0,0,6" ToolTip="三张图像"
                                                                 Click="PdfTemplate_Click"/>
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateFour" Kind="four_images"
                                                                 Margin="0,0,6,6" ToolTip="四张图像"
                                                                 Click="PdfTemplate_Click"/>
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateFive" Kind="five_images"
                                                                 Margin="0,0,6,6" ToolTip="五张图像"
                                                                 Click="PdfTemplate_Click"/>
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateSix" Kind="six_images"
                                                                 Margin="0,0,0,6" ToolTip="六张图像"
                                                                 Click="PdfTemplate_Click"/>
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateSeven" Kind="seven_images"
                                                                 Margin="0,0,6,0" ToolTip="七张图像"
                                                                 Click="PdfTemplate_Click"/>
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateEight" Kind="eight_images"
                                                                 Margin="0,0,6,0" ToolTip="八张图像"
                                                                 Click="PdfTemplate_Click"/>
                                    <cp:CollagePdfTemplateButton x:Name="PdfTemplateNine" Kind="nine_images"
                                                                 Margin="0" ToolTip="九张图像"
                                                                 Click="PdfTemplate_Click"/>
                                </UniformGrid>
                                <TextBlock x:Name="PdfTemplateError" Style="{StaticResource FieldError}"/>
                            </StackPanel>

                            <TextBlock Text="纸张大小" Style="{StaticResource FormLabel}" Margin="0,14,0,4"/>
                            <ComboBox x:Name="PdfPaperBox" Height="30" SelectionChanged="PdfPaper_Changed">
                                <ComboBoxItem Content="A3" Tag="a3"/>
                                <ComboBoxItem Content="A4" Tag="a4"/>
                                <ComboBoxItem Content="A5" Tag="a5"/>
                                <ComboBoxItem Content="B5" Tag="b5"/>
                                <ComboBoxItem Content="Letter" Tag="letter"/>
                                <ComboBoxItem Content="Legal" Tag="legal"/>
                                <ComboBoxItem Content="自定义" Tag="custom"/>
                                <ComboBoxItem Content="图像大小" Tag="image_size"/>
                            </ComboBox>
                            <TextBlock x:Name="PdfPaperError" Style="{StaticResource FieldError}"/>

                            <StackPanel x:Name="PdfOrientationRow" Margin="0,14,0,0">
                                <TextBlock Text="纸张方向" Style="{StaticResource FormLabel}"/>
                                <Border Style="{StaticResource SegGroup}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="PdfPortrait" Grid.Column="0"
                                                     Style="{StaticResource SegBtn}"
                                                     GroupName="collagePdfOrientation" Content="纵向"
                                                     Checked="PdfOrientation_Checked"/>
                                        <RadioButton x:Name="PdfLandscape" Grid.Column="1"
                                                     Style="{StaticResource SegBtn}"
                                                     GroupName="collagePdfOrientation" Content="横向"
                                                     Checked="PdfOrientation_Checked"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="PdfOrientationError" Style="{StaticResource FieldError}"/>
                            </StackPanel>

                            <StackPanel x:Name="PdfCustomRow" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock Text="自定义纸张" Style="{StaticResource FormLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="宽度" Style="{StaticResource FormLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PdfWidthBox" Style="{StaticResource NumberBox}"
                                                     LostFocus="Field_LostFocus"
                                                     PreviewKeyDown="Field_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="mm" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       Foreground="{StaticResource HintTextBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="PdfWidthError" Style="{StaticResource FieldError}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="高度" Style="{StaticResource FormLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PdfHeightBox" Style="{StaticResource NumberBox}"
                                                     LostFocus="Field_LostFocus"
                                                     PreviewKeyDown="Field_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="mm" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       Foreground="{StaticResource HintTextBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="PdfHeightError" Style="{StaticResource FieldError}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- 页边距 / 图像间距：同一行（图像间距只在模板拼接时出现） -->
                            <Grid x:Name="PdfSpacingRow" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition x:Name="PdfSpacingColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="页边距" Style="{StaticResource FormLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PdfMarginBox" Style="{StaticResource NumberBox}"
                                                 LostFocus="Field_LostFocus" PreviewKeyDown="Field_KeyDown"/>
                                        <TextBlock Grid.Column="1" Text="mm" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeHint}"
                                                   Foreground="{StaticResource HintTextBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="PdfMarginError" Style="{StaticResource FieldError}"/>
                                </StackPanel>
                                <StackPanel x:Name="PdfImageSpacingPanel" Grid.Column="2"
                                            Visibility="Collapsed">
                                    <TextBlock Text="图像间距" Style="{StaticResource FormLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PdfImageSpacingBox"
                                                 Style="{StaticResource NumberBox}"
                                                 LostFocus="Field_LostFocus" PreviewKeyDown="Field_KeyDown"/>
                                        <TextBlock Grid.Column="1" Text="mm" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeHint}"
                                                   Foreground="{StaticResource HintTextBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="PdfImageSpacingError"
                                               Style="{StaticResource FieldError}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="导出模式" Style="{StaticResource FormLabel}" Margin="0,14,0,4"/>
                            <Border Style="{StaticResource SegGroup}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="PdfExportCombined" Grid.Column="0"
                                                 Style="{StaticResource SegBtn}" GroupName="collagePdfExport"
                                                 Content="合并导出" Checked="PdfExport_Checked"/>
                                    <RadioButton x:Name="PdfExportPerPage" Grid.Column="1"
                                                 Style="{StaticResource SegBtn}" GroupName="collagePdfExport"
                                                 Content="逐页导出" Checked="PdfExport_Checked"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PdfExportError" Style="{StaticResource FieldError}"/>

                            <TextBlock Text="质量" Style="{StaticResource FormLabel}" Margin="0,14,0,4"/>
                            <Slider x:Name="PdfQualitySlider" Minimum="0" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1"
                                    LargeChange="10" ValueChanged="PdfQuality_Changed"/>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="0%" FontSize="11"
                                           Foreground="{StaticResource HintTextBrush}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="无损" FontSize="11"
                                           Foreground="{StaticResource HintTextBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="PdfQualityError" Style="{StaticResource FieldError}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 页脚：尺寸 / 张数（左）+ 状态（中）+ 取消 / 图像编辑 / 复制 / 保存（右） -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" Padding="12,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DimensionsText" FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalText" Margin="12,0,0,0" FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeHint}" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource HintTextBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Style="{StaticResource Btn}" Content="取消" MinWidth="76"
                            Click="Cancel_Click"/>
                    <Button x:Name="EditBtn" Style="{StaticResource Btn}" Content="图像编辑" MinWidth="84"
                            Margin="8,0,0,0" Click="Edit_Click"/>
                    <Button x:Name="CopyBtn" Style="{StaticResource Btn}" Content="复制" MinWidth="76"
                            Margin="8,0,0,0" Click="Copy_Click"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource BtnPrimary}" Content="保存" MinWidth="76"
                            Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 拖拽幽灵层（缩略图拖到另一张交换时跟随鼠标；不吃事件） -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="3" IsHitTestVisible="False"
                Panel.ZIndex="100"/>

        <!-- 取色弹层：预设之外的任意颜色（含不透明度） -->
        <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom">
            <Border Style="{StaticResource FloatPanel}" Padding="12" Margin="6">
                <StackPanel Width="232">
                    <Border Height="32" CornerRadius="4" Background="{StaticResource SwatchChecker}">
                        <Border x:Name="ColorPreview" CornerRadius="4"/>
                    </Border>

                    <TextBlock Text="色值（#RRGGBBAA）" Style="{StaticResource FormLabel}" Margin="0,12,0,4"/>
                    <TextBox x:Name="ColorHex" Style="{StaticResource NumberBox}"
                             PreviewKeyDown="ColorHex_KeyDown" LostFocus="ColorHex_LostFocus"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Style="{StaticResource FormLabel}" Margin="0" VerticalAlignment="Center"/>
                        <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Channel_Changed"/>
                        <TextBlock x:Name="RedText" Grid.Column="2" Style="{StaticResource FormLabel}"
                                   Margin="0" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="G" Style="{StaticResource FormLabel}" Margin="0" VerticalAlignment="Center"/>
                        <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Channel_Changed"/>
                        <TextBlock x:Name="GreenText" Grid.Column="2" Style="{StaticResource FormLabel}"
                                   Margin="0" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B" Style="{StaticResource FormLabel}" Margin="0" VerticalAlignment="Center"/>
                        <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Channel_Changed"/>
                        <TextBlock x:Name="BlueText" Grid.Column="2" Style="{StaticResource FormLabel}"
                                   Margin="0" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="A" Style="{StaticResource FormLabel}" Margin="0" VerticalAlignment="Center"/>
                        <Slider x:Name="AlphaSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Channel_Changed"/>
                        <TextBlock x:Name="AlphaText" Grid.Column="2" Style="{StaticResource FormLabel}"
                                   Margin="0" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
