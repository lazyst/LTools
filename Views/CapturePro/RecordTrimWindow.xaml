<Window x:Class="LTools.Views.CapturePro.RecordTrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="裁剪 · 倍速" Width="960" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main">
    <!-- 裁剪 + 倍速：上面预览，中间时间轴（两个抓手定起止），下面倍速与出口。
         区间是源时间的半开区间（[起, 止)），时间码保留毫秒；倍速只影响导出与预览，不改源时间。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="GripStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="5" Background="{StaticResource PrimaryBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Rectangle Width="1.5" Height="12" Fill="#B3FFFFFF" RadiusX="1" RadiusY="1"/>
                                <Rectangle Width="1.5" Height="12" Fill="#B3FFFFFF" RadiusX="1" RadiusY="1"
                                           Margin="3,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrimButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="86"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <Border Grid.Row="1" Background="#0F0F13">
            <Grid>
                <MediaElement x:Name="Preview" LoadedBehavior="Manual" ScrubbingEnabled="True"
                              Stretch="Uniform" MediaOpened="Preview_MediaOpened" MediaFailed="Preview_MediaFailed"
                              MediaEnded="Preview_MediaEnded"/>
                <TextBlock x:Name="PreviewHint" Text="正在打开视频…" Foreground="#9CA3AF" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="BadgeBox" Background="#B3000000" CornerRadius="4" Padding="8,4"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="BadgeText" Foreground="#F4F4F5" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="18,12,18,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Canvas x:Name="Timeline" Height="40" ClipToBounds="True"
                        MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove"
                        Background="Transparent">
                    <Border x:Name="TrackBar" Height="6" CornerRadius="3" Background="{StaticResource SurfaceAltBrush}"
                            VerticalAlignment="Center"/>
                    <Border x:Name="SelectionBar" Height="10" CornerRadius="5" Background="{StaticResource PrimaryBrush}"
                            Opacity="0.35"/>
                    <Border x:Name="PlayheadBar" Width="2" Background="{StaticResource TextBrush}"/>
                    <Thumb x:Name="StartGrip" Style="{StaticResource GripStyle}" DragDelta="StartGrip_DragDelta"/>
                    <Thumb x:Name="EndGrip" Style="{StaticResource GripStyle}" DragDelta="EndGrip_DragDelta"/>
                </Canvas>

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock x:Name="StartText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource HintTextBrush}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="RangeText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EndText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource HintTextBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayBtn" Grid.Column="0" Content="▶ 试看" Style="{StaticResource TrimButton}"
                        Click="Play_Click" ToolTip="从选区起点开始播放（再点一次暂停）"/>
                <ComboBox x:Name="SpeedBox" Grid.Column="1" Width="92" Margin="8,0,0,0"
                          SelectionChanged="Speed_Changed"
                          ToolTip="导出与试看的倍速；源时间轴与时间码不变"/>

                <TextBlock x:Name="OutputText" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,10,0"
                           Foreground="{StaticResource HintTextBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource TrimButton}"
                            Click="Cancel_Click"/>
                    <Button x:Name="CopyBtn" Content="复制" Style="{StaticResource TrimButton}" Margin="8,0,0,0"
                            Click="Copy_Click" ToolTip="导出到剪贴板（文件形式）"/>
                    <Button x:Name="SaveAsBtn" Content="另存为…" Style="{StaticResource TrimButton}" Margin="8,0,0,0"
                            Click="SaveAs_Click"/>
                    <Button x:Name="KeepBtn" Content="存进采集历史" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Padding="14,6" MinWidth="112" Click="Keep_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
