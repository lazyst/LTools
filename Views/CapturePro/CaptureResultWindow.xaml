<Window x:Class="LTools.Views.CapturePro.CaptureResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LTools.Views.CapturePro"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="识别结果" Width="720" Height="620" MinWidth="460" MinHeight="320"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextBrush}">
    <!-- 识别结果窗（照 Snow Shot 的 screenshotrecognitionwindow）：无边框置顶、贴选区摆位、
         文字层按原图行框重排（可选中 / 编辑 / 复制），另有表格与二维码两页。
         「显示原图 / 填充背景 / 原文预览」三个开关都对应上游的真实能力。 -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="{StaticResource CornerLg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：拖动把手 + 状态（引擎 / 用时 / 选区字数） -->
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="识别结果" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DetailText" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
                <Button x:Name="CloseBtn" Content="✕" Width="34" Height="32" Padding="0"
                        HorizontalAlignment="Right" Style="{StaticResource BtnGhost}"
                        Focusable="False" Click="Close_Click"/>
            </Grid>

            <!-- 页签：只列当前真能出结果的页（没有实现的模式不放上来当死按钮） -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="10,0,10,6">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabText" Style="{StaticResource CaptureTab}" GroupName="resultTab"
                                 Content="文字" IsChecked="True" Tag="text" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabTable" Style="{StaticResource CaptureTab}" GroupName="resultTab"
                                 Content="表格" Tag="table" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabQr" Style="{StaticResource CaptureTab}" GroupName="resultTab"
                                 Content="二维码" Tag="qr" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabMarkdown" Style="{StaticResource CaptureTab}" GroupName="resultTab"
                                 Content="Markdown" Tag="markdown" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabHtml" Style="{StaticResource CaptureTab}" GroupName="resultTab"
                                 Content="HTML" Tag="html" Checked="Tab_Changed"/>
                </StackPanel>
            </Border>

            <!-- 内容：文字层 / 原图共用一块画布尺寸（摆位与滚动一致） -->
            <Border Grid.Row="2" Margin="12,10,12,8" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerMd}" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="OcrScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" Padding="0">
                        <local:CaptureOcrCanvas x:Name="OcrCanvas"/>
                    </ScrollViewer>

                    <ScrollViewer x:Name="OriginalScroll" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" Padding="0">
                        <Image x:Name="OriginalImage" Stretch="None" SnapsToDevicePixels="True"/>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyText" Text="没有识别到文字" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

                    <!-- 表格：识别成表格文档后可以直接改字 / 合并 / 拆分（照 Snow Shot 的
                         screenshottableeditor：单击进编辑、拖动是矩形选区、工具条对应它的命令集） -->
                    <Grid x:Name="TablePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="TableScroll" Padding="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      SizeChanged="TableScroll_SizeChanged">
                            <local:CaptureTableGrid x:Name="TableCanvas"/>
                        </ScrollViewer>

                        <TextBlock x:Name="TableEmpty" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="没有识别出表格（至少要 2 行 × 2 列）"/>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="10,6">
                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="TableUndoBtn" Style="{StaticResource BtnGhost}" Content="撤销"
                                        MinWidth="60" Height="26" FontSize="{StaticResource FontSizeHint}"
                                        Margin="0,0,4,4" ToolTip="Ctrl+Z" Click="TableUndo_Click"/>
                                <Button x:Name="TableRedoBtn" Style="{StaticResource BtnGhost}" Content="重做"
                                        MinWidth="60" Height="26" FontSize="{StaticResource FontSizeHint}"
                                        Margin="0,0,4,4" ToolTip="Ctrl+Y" Click="TableRedo_Click"/>
                                <Button x:Name="TableMergeBtn" Style="{StaticResource BtnGhost}" Content="合并"
                                        MinWidth="60" Height="26" FontSize="{StaticResource FontSizeHint}"
                                        Margin="0,0,4,4" Click="TableMerge_Click"/>
                                <Button x:Name="TableSplitBtn" Style="{StaticResource BtnGhost}" Content="拆分"
                                        MinWidth="60" Height="26" FontSize="{StaticResource FontSizeHint}"
                                        Margin="0,0,4,4" Click="TableSplit_Click"/>
                                <Button x:Name="TableResetBtn" Style="{StaticResource BtnGhost}" Content="重置"
                                        MinWidth="60" Height="26" FontSize="{StaticResource FontSizeHint}"
                                        Margin="0,0,4,4" Click="TableReset_Click"/>
                                <Border Width="1" Height="16" Margin="4,0,8,4"
                                        Background="{StaticResource BorderStrongBrush}"/>
                                <Button x:Name="TableCopyHtmlBtn" Style="{StaticResource BtnGhost}"
                                        Content="复制 HTML" MinWidth="76" Height="26"
                                        FontSize="{StaticResource FontSizeHint}" Margin="0,0,4,4"
                                        Click="TableCopyHtml_Click"/>
                                <Button x:Name="TableCopyTsvBtn" Style="{StaticResource BtnGhost}"
                                        Content="复制 TSV" MinWidth="76" Height="26"
                                        FontSize="{StaticResource FontSizeHint}" Margin="0,0,4,4"
                                        Click="TableCopyTsv_Click"/>
                                <Button x:Name="TableExportBtn" Style="{StaticResource BtnGhost}"
                                        Content="导出 xlsx" MinWidth="76" Height="26"
                                        FontSize="{StaticResource FontSizeHint}" Margin="0,0,4,4"
                                        Click="TableExport_Click"/>
                                <Button x:Name="TableOpenBtn" Style="{StaticResource BtnGhost}"
                                        Content="打开表格" MinWidth="76" Height="26"
                                        FontSize="{StaticResource FontSizeHint}" Margin="0,0,4,4"
                                        Click="TableOpen_Click"/>
                                <TextBlock x:Name="TableInfo" Margin="8,0,0,4" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </WrapPanel>
                        </Border>
                    </Grid>

                    <!-- Markdown / HTML：把 OCR 行派生出的块（标题 / 段落 / 列表 / 表格）渲染成流文档。
                         渲染与源码出自同一份块列表，划选可复制选中那段。 -->
                    <local:CaptureConversionView x:Name="ConversionPage" Visibility="Collapsed"/>

                    <!-- 二维码 -->
                    <Grid x:Name="QrPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="QrView" BorderThickness="0" Background="Transparent" Margin="10"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 controls:TextBoxPlaceholder.Text="没有找到二维码"
                                 controls:TextBoxClear.Attach="False"/>

                        <TextBlock x:Name="QrInfo" Grid.Row="1" Margin="10,0,10,10" TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 底栏：显示原图 / 填充背景 / 原文预览 · 复制 / 关闭 -->
            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="12,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="OriginalToggle" Content="显示原图" VerticalAlignment="Center"
                                  Checked="Original_Changed" Unchecked="Original_Changed"/>
                        <CheckBox x:Name="FillToggle" Content="填充背景" IsChecked="True"
                                  VerticalAlignment="Center" Margin="14,0,0,0"
                                  Checked="Fill_Changed" Unchecked="Fill_Changed"/>
                        <Button x:Name="PreviewBtn" Style="{StaticResource BtnGhost}" Content="原文预览"
                                MinWidth="88" Margin="14,0,0,0" Click="Preview_Click"/>
                        <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CopyBtn" Style="{StaticResource BtnPrimary}" Content="复制文字"
                                MinWidth="110" Click="Copy_Click"/>
                        <Button Style="{StaticResource BtnGhost}" Content="关闭" MinWidth="78"
                                Margin="8,0,0,0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
