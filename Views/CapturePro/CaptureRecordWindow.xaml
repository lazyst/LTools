<Window x:Class="LTools.Views.CapturePro.CaptureRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="录屏" Width="344" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        WindowStartupLocation="Manual" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        views:WindowSizing.Mode="Overlay">
    <!-- 录屏控制条：不抢焦点（ShowActivated=False + WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW），
         并且用 SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE) 自己不入镜。
         代价是收不到 Esc，出口全部做成鼠标可达（暂停 / 完成 / 取消）。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 浮层配色（浅色）与其他截图浮层共用一份 -->
                <ResourceDictionary Source="CaptureChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 主按钮：整格主色、白字（与工具栏的 BarBtnPrimary 同一套观感） -->
            <Style x:Key="RecPrimaryBtn" TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="#3B82F6"/>
                <Setter Property="Padding" Value="13,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2F6FE0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2560C8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                                    <Setter Property="Foreground" Value="{StaticResource ChromeInkOff}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RecGhostBtn" TargetType="Button" BasedOn="{StaticResource RecPrimaryBtn}">
                <Setter Property="Background" Value="{StaticResource ChromeWell}"/>
                <Setter Property="Foreground" Value="{StaticResource ChromeInk}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource ChromeBorder}"
            BorderThickness="1" CornerRadius="8" Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#EF4444" VerticalAlignment="Center"/>
                    <TextBlock Text="录屏" Foreground="{StaticResource ChromeInk}" FontSize="13" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockLabel" Text="00:00" Foreground="{StaticResource ChromeInk}" FontSize="18"
                               FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="MetaText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeInkDim}" FontSize="11" TextTrimming="CharacterEllipsis"
                           MaxWidth="150"/>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="1" Text="录制中 · 点「完成」保存到采集历史"
                       Foreground="{StaticResource ChromeInkDim}" FontSize="12" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="PauseBtn" Style="{StaticResource RecGhostBtn}" Content="暂停"
                        MinWidth="66" Click="Pause_Click" ToolTip="暂停 / 继续（暂停的时间不进成品）"/>
                <Button x:Name="DoneBtn" Style="{StaticResource RecPrimaryBtn}" Content="完成"
                        MinWidth="66" Margin="8,0,0,0" Click="Done_Click" ToolTip="停止录制并保存"/>
                <Button x:Name="CancelBtn" Style="{StaticResource RecGhostBtn}" Content="取消"
                        MinWidth="66" Margin="8,0,0,0" Click="Cancel_Click" ToolTip="放弃这次录制"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
