<Window x:Class="LTools.Views.CapturePro.CaptureRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="录屏" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        WindowStartupLocation="Manual" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        views:WindowSizing.Mode="Overlay">
    <!-- 录屏工具条（照 Snow Shot 的录屏面板）：两行白色圆角面板，第二行是「导出设置」，
         由第一行那个蓝色开关切显隐。整条**不抢焦点**（ShowActivated=False +
         WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW），并且用 WDA_EXCLUDEFROMCAPTURE 自己不入镜。
         按钮全部在 code-behind 里按 RecordTools / RecordOptions 生成，这里只给骨架与外观。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 图标几何 + 按钮样式 + 浮层配色（与其他截图浮层共用一份） -->
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 面板底：白底 + 圆角 8 + 浮层阴影（Snow Shot `createPanel` 同款，不画边框） -->
            <Style x:Key="RecPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ChromePanel}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Effect" Value="{StaticResource BarShadow}"/>
            </Style>

            <!-- 录制时长：14 号（`RECORDING_DURATION_FONT_SIZE`）、colorTextSecondary，
                 宽度按「最宽数字 × 6 + 两个冒号」预留，所以走时不会把面板撑宽。 -->
            <Style x:Key="RecClock" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource CaptureTextSecondary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Width" Value="58"/>
                <Setter Property="Margin" Value="2,0,2,0"/>
            </Style>

            <!-- 第二行的下拉式按钮文字（格式选择 / 延迟胶囊） -->
            <Style x:Key="RecPillText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource CaptureText}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel x:Name="PanelRoot" HorizontalAlignment="Center">
        <!-- 第一行：拖动把手 / 导出设置 / 绘制工具 / 撤销重做 / 录制控制 / 收尾动作 -->
        <Border x:Name="ActionBar" Style="{StaticResource RecPanel}" Padding="12,4"
                MouseLeftButtonDown="Bar_MouseDown"
                MouseMove="Bar_MouseMove"
                MouseLeftButtonUp="Bar_MouseUp"
                PreviewMouseRightButtonDown="Bar_RightDown">
            <StackPanel x:Name="ActionRow" Orientation="Horizontal"/>
        </Border>

        <!-- 第二行：导出设置（格式 / 色卡 / 键鼠特效 / 跟随 / 摄像头 / 延迟 / 设置）。
             上游把它 `AlignRight` 摆在第一行下面（右边缘对齐），行间距 6。 -->
        <Border x:Name="StyleBar" Style="{StaticResource RecPanel}" Padding="10,4"
                Margin="0,6,0,0" HorizontalAlignment="Right"
                MouseLeftButtonDown="Bar_MouseDown"
                MouseMove="Bar_MouseMove"
                MouseLeftButtonUp="Bar_MouseUp"
                PreviewMouseRightButtonDown="Bar_RightDown">
            <StackPanel x:Name="StyleRow" Orientation="Horizontal"/>
        </Border>
    </StackPanel>
</Window>
