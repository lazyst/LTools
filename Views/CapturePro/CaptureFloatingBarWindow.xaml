<Window x:Class="LTools.Views.CapturePro.CaptureFloatingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        Title="悬浮工具条" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        views:WindowSizing.Mode="Overlay">
    <!-- 悬浮工具条（照 Snow Shot 的 floating_toolbar）：常驻桌面的一小条截图入口。
         不抢焦点（WS_EX_NOACTIVATE）、不进 Alt+Tab；图标模式平时只露第一个按钮，悬停展开。 -->
    <Window.Resources>
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource PressedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Chrome" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="8" Padding="5" AllowDrop="True"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <StackPanel x:Name="Row" Orientation="Horizontal"/>
    </Border>
</Window>
