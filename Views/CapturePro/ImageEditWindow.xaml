<Window x:Class="LTools.Views.CapturePro.ImageEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:cap="clr-namespace:LTools.Features.CapturePro"
        xmlns:cp="clr-namespace:LTools.Views.CapturePro"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="图片编辑" Width="1180" Height="780" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        Drop="Window_Drop" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
    <!-- 图片编辑窗（照 snow-shot 的 ImageEditingWindow）：导入已有图片 → 画布标注 → 导出。
         布局照上游：**没有顶部工具行**，绘图工具条浮在画布右下（`placeToolbar`），
         缩放条（适应 / 100%）浮在画布底部居中；空态可点「添加图片」或把图片拖进来。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 棋盘格透明底：10px 一格（照上游 theme.colorBgContainer / colorFillSecondary） -->
            <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Stretch="None"
                          Viewport="0,0,20,20" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource SurfaceBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,20,20"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#F0F0F1">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,10,10"/>
                                    <RectangleGeometry Rect="10,10,10,10"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- 浮层底：白底 + 圆角 8 + 浮层阴影（浮在画布上的两块都走它） -->
            <Style x:Key="FloatPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ChromePanel}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Effect" Value="{StaticResource BarShadow}"/>
            </Style>

            <!-- 缩放条上的按钮（放文字：适应 / 100%） -->
            <Style x:Key="ZoomBtn" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource ChromeInk}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChromeHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <!-- 画布：棋盘格底 + 可缩放平移的内容 + 裁剪预览层 + 浮层（工具条 / 缩放条） -->
        <Grid x:Name="Surface" Grid.Row="1" Background="{StaticResource CheckerBrush}"
              ClipToBounds="True" Focusable="True"
              PreviewMouseWheel="Surface_MouseWheel"
              PreviewMouseDown="Surface_MouseDown"
              PreviewMouseUp="Surface_MouseUp"
              PreviewMouseMove="Surface_MouseMove"
              MouseLeave="Surface_MouseLeave">

            <Grid x:Name="ContentHost" HorizontalAlignment="Left" VerticalAlignment="Top"
                  RenderTransformOrigin="0,0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="PanOffset"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <cap:CaptureCanvas x:Name="Canvas" IsHitTestVisible="False"
                                   ShowSelectionChrome="False"/>
            </Grid>

            <cp:ImageEditCropLayer x:Name="CropLayer" IsHitTestVisible="False"/>

            <!-- 浮层：工具条（右下 4px，照上游 placeToolbar）+ 缩放条（底部居中） -->
            <Canvas x:Name="Overlay">
                <cp:CaptureToolbar x:Name="Toolbar" Visibility="Collapsed"/>

                <Border x:Name="ZoomBar" Style="{StaticResource FloatPanel}" Padding="4,3"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FitBtn" Style="{StaticResource ZoomBtn}" Content="适应"
                                ToolTip="适应窗口（Fit image to window）" Click="Fit_Click"/>
                        <Button x:Name="ActualBtn" Style="{StaticResource ZoomBtn}" Content="100%"
                                ToolTip="实际大小（100%）" Click="Actual_Click"/>
                        <Border Width="1" Height="14" Margin="4,0" VerticalAlignment="Center"
                                Background="{StaticResource CaptureBorder}"/>
                        <TextBlock x:Name="ZoomText" Margin="2,0,4,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource ChromeInkDim}"/>
                    </StackPanel>
                </Border>

                <!-- 「文字」工具的就地输入框（照截图覆盖层：Enter 提交、Shift+Enter 换行、Esc 放弃；
                     **不抢画布手势**，点画布别处 = 提交） -->
                <TextBox x:Name="TextEntry" Visibility="Collapsed"
                         AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="80" MaxWidth="480"
                         Background="#E6101014" Foreground="#F4F4F5" BorderBrush="#3B82F6"
                         BorderThickness="1" Padding="4,2" FontFamily="Microsoft YaHei UI"
                         PreviewKeyDown="TextEntry_KeyDown" LostFocus="TextEntry_LostFocus"/>
            </Canvas>

            <!-- 空态 -->
            <Grid x:Name="EmptyState" Background="Transparent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="开始图片编辑" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="拖入图片文件，或点「添加图片」" Margin="0,8,0,0"
                               FontSize="{StaticResource FontSizeHint}" HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="多张图片会各开一个窗口" Margin="0,4,0,0"
                               FontSize="{StaticResource FontSizeHint}" HorizontalAlignment="Center"
                               Foreground="{StaticResource HintTextBrush}"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="添加图片" MinWidth="110"
                            Margin="0,16,0,0" HorizontalAlignment="Center" Click="AddImage_Click"/>
                </StackPanel>
            </Grid>

            <!-- 拖放提示 -->
            <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
                    Margin="12" BorderThickness="2" BorderBrush="{StaticResource PrimaryBrush}"
                    CornerRadius="8" Background="#CCFFFFFF">
                <TextBlock Text="松开鼠标开始编辑" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" Padding="12,5"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NoticeText" FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="InfoText" Grid.Column="1" Margin="12,0,0,0"
                           FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource HintTextBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
