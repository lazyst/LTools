    <!-- ============ 图标盒 ============
         24 = Snow Shot 的 `screenshot_action_toolbar::IconSize`；第二行的样式按钮用 18（`STYLE_ICON_SIZE`）。
         颜色一律跟随所在按钮的 Foreground（选中 / 危险 / 禁用都只改前景色）。 -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
    </Style>

    <Style x:Key="IconPathSm" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
    </Style>

    <!-- ============ 按钮 ============
         度量照 Snow Shot：按钮 32（`ControlSize`）、圆角 8、悬停 rgba(0,0,0,.06)、按下 .12；
         图标态前景 rgba(0,0,0,.88)、禁用 .25（antd 的 colorText / colorTextQuaternary）。 -->
    <Style x:Key="BarBtn" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource CaptureText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CaptureTextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险动作（取消 / 关闭）：图标红，底不红（antd 的 Text + Danger） -->
    <Style x:Key="BarBtnDanger" TargetType="Button" BasedOn="{StaticResource BarBtn}">
        <Setter Property="Foreground" Value="{StaticResource CaptureDanger}"/>
    </Style>

    <!-- 主按钮（照 Snow Shot 的 Solid + Primary：整格主色、图标白） -->
    <Style x:Key="BarBtnPrimary" TargetType="Button" BasedOn="{StaticResource BarBtn}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource CapturePrimary}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapturePrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapturePrimaryActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureBorderSecondary}"/>
                            <Setter Property="Foreground" Value="{StaticResource CaptureTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具格（单选）：选中 = 浅主色底 + 主色图标（antd 的主动态，Snow Shot 的 tool radio 同款） -->
    <Style x:Key="BarToolBtn" TargetType="RadioButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource CaptureText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapturePrimaryBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource CapturePrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CaptureTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 第二行的样式按钮：28 / 图标 18（`STYLE_BUTTON_SIZE` / `STYLE_ICON_SIZE`） -->
    <Style x:Key="BarBtnSm" TargetType="Button" BasedOn="{StaticResource BarBtn}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
    </Style>

    <Style x:Key="BarBtnSmDanger" TargetType="Button" BasedOn="{StaticResource BarBtnSm}">
        <Setter Property="Foreground" Value="{StaticResource CaptureDanger}"/>
    </Style>

    <!-- 第二行的开关按钮：勾上 = 整格主色（Snow Shot 的 `setScreenshotToolPaletteButtonActive`） -->
    <Style x:Key="BarToggleSm" TargetType="ToggleButton">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource CaptureText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapturePrimary}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource CaptureTextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组竖线：1×16，两侧各 12（`kSeparatorWidth` / `kSeparatorHeight` / `kSeparatorSideSpacing`）；
         第二行同样是 1×16、两侧 12（`STYLE_GROUP_SPACING` 8 + 条目间距 4）。
         颜色用 antd 的 colorBorder（#D9D9D9），别用更浅的那档——白底上几乎看不见。 -->
    <Style x:Key="BarSeparator" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Background" Value="{StaticResource CaptureBorder}"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BarSeparatorSm" TargetType="Border" BasedOn="{StaticResource BarSeparator}">
        <Setter Property="Margin" Value="12,0"/>
    </Style>

    <!-- 第一行的开关（导出设置）：勾上 = 整格主色 + 白图标（截图里就是那个蓝色方块） -->
    <Style x:Key="BarToggle" TargetType="ToggleButton" BasedOn="{StaticResource BarToggleSm}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <!-- 录音 / 录音设备这类「只是一个状态灯」的开关：勾上只换图标颜色（截图里扬声器是绿色） -->
    <Style x:Key="BarToggleAccent" TargetType="ToggleButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource CaptureTextDisabled}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource CaptureSuccess}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CaptureTextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主色图标按钮（录制按钮：蓝圈 + 蓝点，底仍是白的） -->
    <Style x:Key="BarBtnAccent" TargetType="Button" BasedOn="{StaticResource BarBtn}">
        <Setter Property="Foreground" Value="{StaticResource CapturePrimary}"/>
    </Style>

    <!-- ============ 色卡 ============
         照 Snow Shot 的 `drawColorSwatch`：触发器的外框 28（`STYLE_BUTTON_SIZE`，圆角 8、1px 描边），
         里面 18 的色块（圆角 4，**自己不带描边**）；预设色卡没有外框。alpha < 255 时先铺棋盘格
         （白 + colorFillTertiary #F0F0F0，格子 4），alpha = 0 再画一条整格的对角红线（`#FF4D4F`）。
         选中 = 28 格浅主色底 `#E6F4FF`（上游 `setScreenshotToolPaletteStyleButtonActive` 只换底色）。 -->
    <DrawingBrush x:Key="SwatchChecker" TileMode="Tile" Stretch="None"
                  Viewport="0,0,8,8" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F0F0F0">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,4,4"/>
                            <RectangleGeometry Rect="4,4,4,4"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="SwatchRadio" TargetType="RadioButton">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <Grid Width="18" Height="18">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,18,18" RadiusX="4" RadiusY="4"/>
                            </Grid.Clip>
                            <!-- 底色：半透明的颜色能透出棋盘格，不透明的颜色整个盖住 -->
                            <Border CornerRadius="4" Background="{StaticResource SwatchChecker}"/>
                            <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
                            <!-- alpha = 0 的色卡：对角红线（上游 `colorError` 从角画到角） -->
                            <Path x:Name="Slash" Visibility="Collapsed"
                                  Data="M0,18L18,0" Stroke="{StaticResource CaptureDanger}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureHover}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="none">
                            <Setter TargetName="Slash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapturePrimaryBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 取色器的「当前颜色」触发器：与色卡同款，但不是单选（点开取色弹层），外面保留 1px 边框 -->
    <Style x:Key="SwatchButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            BorderBrush="{StaticResource CaptureBorder}" BorderThickness="1">
                        <Grid Width="18" Height="18">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,18,18" RadiusX="4" RadiusY="4"/>
                            </Grid.Clip>
                            <Border CornerRadius="4" Background="{StaticResource SwatchChecker}"/>
                            <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
                            <Path x:Name="Slash" Visibility="Collapsed"
                                  Data="M0,18L18,0" Stroke="{StaticResource CaptureDanger}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureActive}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="none">
                            <Setter TargetName="Slash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 悬停弹层（`AdPopover` 同款）============
         白底圆角 8 + 阴影，内边距 12、行距 8；条目是普通复选框 / 单选框（走应用主题）。 -->
    <Style x:Key="PopCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChromePanel}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect" Value="{StaticResource BarShadow}"/>
    </Style>

    <Style x:Key="PopStack" TargetType="StackPanel">
        <Setter Property="Margin" Value="0"/>
    </Style>


    <!-- 第二行的下拉 / 胶囊按钮（格式选择、录制延迟）：白底、悬停浅灰、圆角 6 -->
    <Style x:Key="BarPill" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Foreground" Value="{StaticResource CaptureText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CaptureTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 录制延迟：带 1px 描边的圆角胶囊（截图里是唯一有边框的那一个） -->
    <Style x:Key="BarPillBordered" TargetType="Button" BasedOn="{StaticResource BarPill}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            BorderBrush="{StaticResource CaptureBorder}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptureActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CaptureTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

