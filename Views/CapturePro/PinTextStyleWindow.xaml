<Window x:Class="LTools.Views.CapturePro.PinTextStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="贴图文字样式" Width="492" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <Grid Margin="20,10,20,16">
                <Button x:Name="ResetBtn" Style="{StaticResource BtnGhost}" Content="恢复默认"
                        MinWidth="86" HorizontalAlignment="Left" Click="Reset_Click"
                        ToolTip="把最大宽 / 字体 / 字号 / 两种颜色都改回 Snow Shot 的默认值"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                            IsCancel="True" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="74"
                            Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </controls:DialogShell.Footer>

        <!-- 内容宽 452（与选区参数框同一套度量） -->
        <StackPanel Width="452" Margin="20,12,20,16">

            <!-- 最大宽 | 字号 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="218"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource HintLabel}" Text="最大文字宽"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource HintLabel}" Text="默认字号"/>
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="WidthBox" Width="120" Height="32" VerticalContentAlignment="Center"
                             controls:TextBoxClear.Attach="False" TextChanged="Field_Changed"/>
                    <TextBlock Text="px（100–2000）" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="SizeBox" Width="120" Height="32" VerticalContentAlignment="Center"
                             controls:TextBoxClear.Attach="False" TextChanged="Field_Changed"/>
                    <TextBlock Text="px（8–96）" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>

            <!-- 字体 -->
            <TextBlock Style="{StaticResource HintLabel}" Text="默认字体" Margin="0,12,0,0"/>
            <ComboBox x:Name="FontBox" Height="32" Margin="0,4,0,0"
                      VerticalContentAlignment="Center" SelectionChanged="Field_Changed"
                      ToolTip="「系统默认」= 跟随系统界面字体"/>

            <!-- 文字颜色 -->
            <TextBlock Style="{StaticResource HintLabel}" Text="文字颜色" Margin="0,12,0,0"/>
            <StackPanel Margin="0,4,0,0">
                <CheckBox x:Name="TextThemeBox" Content="跟随主题（浅色主题下是深灰字）"
                          VerticalAlignment="Center" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <WrapPanel x:Name="TextPalette" Margin="0,6,0,0"/>
                <TextBox x:Name="TextHexBox" Width="130" Height="30" Margin="0,4,0,0"
                         HorizontalAlignment="Left" VerticalContentAlignment="Center"
                         TextChanged="TextHex_Changed"/>
            </StackPanel>

            <!-- 背景颜色 -->
            <TextBlock Style="{StaticResource HintLabel}" Text="背景颜色" Margin="0,12,0,0"/>
            <StackPanel Margin="0,4,0,0">
                <CheckBox x:Name="BackgroundThemeBox" Content="跟随主题（浅色主题下是白底）"
                          VerticalAlignment="Center" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <WrapPanel x:Name="BackgroundPalette" Margin="0,6,0,0"/>
                <TextBox x:Name="BackgroundHexBox" Width="130" Height="30" Margin="0,4,0,0"
                         HorizontalAlignment="Left" VerticalContentAlignment="Center"
                         TextChanged="BackgroundHex_Changed"/>
            </StackPanel>

            <!-- 预览：真按当前这些值渲染一张文字卡（与贴到屏幕上的是同一份渲染） -->
            <TextBlock Style="{StaticResource HintLabel}" Text="预览" Margin="0,12,0,0"/>
            <Border Margin="0,4,0,0" Height="132" Background="{StaticResource SurfaceAltBrush}"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                    CornerRadius="{StaticResource CornerMd}" ClipToBounds="True">
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <TextBlock Style="{StaticResource HintLabel}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="这些默认值只影响之后新贴上去的文字；已经在屏幕上的贴图保留它们各自的样式。字体选「系统默认」、颜色选「跟随主题」就是上游的初始状态。"/>
        </StackPanel>
    </controls:DialogShell>
</Window>
