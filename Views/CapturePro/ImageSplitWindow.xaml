<Window x:Class="LTools.Views.CapturePro.ImageSplitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:cp="clr-namespace:LTools.Views.CapturePro"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="切图" Width="1200" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        Drop="Window_Drop" PreviewKeyDown="Window_KeyDown">
    <!-- 切图窗（照 snow-shot 的 ImageSplitWindow / ImageSplitEditorWidget）：
         左边是切图预览画布（棋盘格 + 标尺 + 切分线 + 序号），右边固定 340 宽的表单
         （方向 / 方式 / 重叠 / 张数 / 行列 / 每张尺寸 + 单位），底部是尺寸 · 张数 + 按钮栏。
         浮在画布底部的四个小按钮照上游 CanvasActionToolbar：撤销 / 重做 / 适应窗口 / 重选图片。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 棋盘格透明底：10px 一格（与图片编辑窗 / 覆盖层同一套取值） -->
            <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Stretch="None"
                          Viewport="0,0,20,20" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource SurfaceBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,20,20"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#F0F0F1">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,10,10"/>
                                    <RectangleGeometry Rect="10,10,10,10"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- 浮层底：白底 + 圆角 8 + 浮层阴影（画布底部的工具条） -->
            <Style x:Key="FloatPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ChromePanel}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Effect" Value="{StaticResource BarShadow}"/>
            </Style>

            <!-- 分段控件的一格：透明底、选中填主色（照上游 AdSegmented 的 joined 组） -->
            <Style x:Key="SegBtn" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource CaptureTextSecondary}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="6,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource CaptureHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource CapturePrimary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 分段控件的容器（灰底 + 2 内边距，读起来是一组） -->
            <Style x:Key="SegGroup" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CaptureBorderSecondary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CaptureBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <!-- 表单标签 / 数字输入 / 错误 -->
            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="NumberBox" TargetType="TextBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
                <Setter Property="controls:TextBoxClear.Attach" Value="False"/>
            </Style>

            <Style x:Key="FieldError" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>

            <!-- 画布上的 32×32 图标按钮（复刻上游 CanvasActionToolbar） -->
            <Style x:Key="CanvasAction" TargetType="Button" BasedOn="{StaticResource BarBtn}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
            </Style>

            <Style x:Key="CanvasActionPath" TargetType="Path" BasedOn="{StaticResource IconPathSm}">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 画布区：棋盘格 + 切图预览 + 浮层工具条 + 空态 / 拖放提示 -->
            <Grid x:Name="Surface" Grid.Column="0" Background="{StaticResource CheckerBrush}"
                  ClipToBounds="True">
                <cp:SplitPreviewCanvas x:Name="Preview"/>

                <Border x:Name="CanvasToolbar" Style="{StaticResource FloatPanel}" Padding="3"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UndoBtn" Style="{StaticResource CanvasAction}"
                                ToolTip="撤销（Ctrl+Z）" Click="Undo_Click">
                            <Path Data="{StaticResource IconUndo}" Style="{StaticResource CanvasActionPath}"/>
                        </Button>
                        <Button x:Name="RedoBtn" Style="{StaticResource CanvasAction}"
                                ToolTip="重做（Ctrl+Y）" Click="Redo_Click">
                            <Path Data="{StaticResource IconRedo}" Style="{StaticResource CanvasActionPath}"/>
                        </Button>
                        <Border Width="1" Height="16" Margin="4,0" Background="{StaticResource CaptureBorder}"
                                VerticalAlignment="Center"/>
                        <Button x:Name="FitBtn" Style="{StaticResource CanvasAction}"
                                ToolTip="适应窗口（F）" Click="Fit_Click">
                            <Path Data="{StaticResource IconFit}" Style="{StaticResource CanvasActionPath}"/>
                        </Button>
                        <Button x:Name="ReloadBtn" Style="{StaticResource CanvasAction}"
                                ToolTip="重选图片" Click="Reload_Click">
                            <Path Data="{StaticResource IconReload}" Style="{StaticResource CanvasActionPath}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 空态（上游 imageSplitEmptyState）：标题 + 说明 + 「选择图片」 -->
                <Grid x:Name="EmptyState" Background="Transparent">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="选择要切分的图片" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="把图片文件拖到这里，或点「选择图片」" Margin="0,8,0,0"
                                   FontSize="{StaticResource FontSizeHint}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="选择图片" MinWidth="110"
                                Margin="0,16,0,0" HorizontalAlignment="Center" Click="SelectImage_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 拖放提示 -->
                <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
                        Margin="12" BorderThickness="2" BorderBrush="{StaticResource PrimaryBrush}"
                        CornerRadius="8" Background="#CCFFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DropHintTitle" Text="松开载入要切分的图片" FontSize="18"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="一次拖入一个图片文件" Margin="0,6,0,0" FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 表单（上游 ImageSplitEditorWidget 的右栏，固定 340） -->
            <Border Grid.Column="1" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="16,16,12,16">
                    <StackPanel x:Name="FormPanel">
                        <TextBlock Text="切分方向" Style="{StaticResource FormLabel}"/>
                        <Border Style="{StaticResource SegGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="DirVertical" Grid.Column="0" Style="{StaticResource SegBtn}"
                                             GroupName="splitDirection" Content="纵向"
                                             Checked="Direction_Checked"/>
                                <RadioButton x:Name="DirHorizontal" Grid.Column="1" Style="{StaticResource SegBtn}"
                                             GroupName="splitDirection" Content="横向"
                                             Checked="Direction_Checked"/>
                                <RadioButton x:Name="DirGrid" Grid.Column="2" Style="{StaticResource SegBtn}"
                                             GroupName="splitDirection" Content="宫格"
                                             Checked="Direction_Checked"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DirectionError" Style="{StaticResource FieldError}"/>

                        <TextBlock x:Name="TypeLabel" Text="切分方式" Style="{StaticResource FormLabel}"
                                   Margin="0,14,0,4"/>
                        <Border x:Name="TypeGroup" Style="{StaticResource SegGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="TypeSmart" Grid.Column="0" Style="{StaticResource SegBtn}"
                                             GroupName="splitType" Content="智能切分"
                                             Checked="Type_Checked"/>
                                <RadioButton x:Name="TypeEqual" Grid.Column="1" Style="{StaticResource SegBtn}"
                                             GroupName="splitType" Content="等分"
                                             Checked="Type_Checked"/>
                                <RadioButton x:Name="TypePrecise" Grid.Column="2" Style="{StaticResource SegBtn}"
                                             GroupName="splitType" Content="精确切分"
                                             Checked="Type_Checked"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TypeError" Style="{StaticResource FieldError}"/>

                        <TextBlock Text="重叠宽度" Style="{StaticResource FormLabel}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OverlapBox" Style="{StaticResource NumberBox}"
                                     TextChanged="Overlap_TextChanged" LostFocus="Field_LostFocus"
                                     PreviewKeyDown="Field_KeyDown"/>
                            <TextBlock Grid.Column="1" Text="px" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </Grid>
                        <TextBlock x:Name="OverlapError" Style="{StaticResource FieldError}"/>

                        <StackPanel x:Name="CountRow">
                            <TextBlock Text="图片数量" Style="{StaticResource FormLabel}" Margin="0,14,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CountBox" Style="{StaticResource NumberBox}"
                                         TextChanged="Count_TextChanged" LostFocus="Field_LostFocus"
                                         PreviewKeyDown="Field_KeyDown"/>
                                <TextBlock Grid.Column="1" Text="张" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource HintTextBrush}"/>
                            </Grid>
                            <TextBlock x:Name="CountError" Style="{StaticResource FieldError}"/>
                        </StackPanel>

                        <StackPanel x:Name="RowsRow">
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="行数" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="RowsBox" Style="{StaticResource NumberBox}"
                                             TextChanged="Rows_TextChanged" LostFocus="Field_LostFocus"
                                             PreviewKeyDown="Field_KeyDown"/>
                                    <TextBlock x:Name="RowsError" Style="{StaticResource FieldError}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="列数" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="ColumnsBox" Style="{StaticResource NumberBox}"
                                             TextChanged="Columns_TextChanged" LostFocus="Field_LostFocus"
                                             PreviewKeyDown="Field_KeyDown"/>
                                    <TextBlock x:Name="ColumnsError" Style="{StaticResource FieldError}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="SizeRow">
                            <Grid Margin="0,14,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SizeLabel" Text="每张宽度" Style="{StaticResource FormLabel}"
                                           Margin="0,0,0,4" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource SegGroup}" Padding="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="UnitPixels" Style="{StaticResource SegBtn}" Height="22"
                                                     GroupName="splitUnit" Content="像素" Padding="6,0"
                                                     Checked="Unit_Checked"/>
                                        <RadioButton x:Name="UnitPercentage" Style="{StaticResource SegBtn}" Height="22"
                                                     GroupName="splitUnit" Content="百分比" Padding="6,0"
                                                     Checked="Unit_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SizeBox" Style="{StaticResource NumberBox}"
                                         TextChanged="Size_TextChanged" LostFocus="Field_LostFocus"
                                         PreviewKeyDown="Field_KeyDown"/>
                                <TextBlock x:Name="SizeSuffix" Grid.Column="1" Text="%" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource HintTextBrush}"/>
                            </Grid>
                            <TextBlock x:Name="SizeError" Style="{StaticResource FieldError}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 页脚：尺寸 / 张数（左）+ 状态（中）+ 取消 / 全部保存（右） -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" Padding="12,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DimensionsText" FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalText" Margin="12,0,0,0" FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeHint}" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource HintTextBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Style="{StaticResource Btn}" Content="取消" MinWidth="76"
                            Click="Cancel_Click"/>
                    <Button x:Name="SaveAllBtn" Style="{StaticResource BtnPrimary}" Content="全部保存"
                            MinWidth="92" Margin="8,0,0,0" Click="SaveAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
