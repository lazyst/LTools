<Window x:Class="LTools.Views.CapturePro.CaptureHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="采集历史" Width="1020" Height="660" MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main">
    <!-- 采集历史：左列表（缩略图 / 时间 / 尺寸 / 摘要）+ 右预览（大图 + 识别文字）。
         三页签用主题里的 CaptureTab（与识别结果窗共用同一份自绘 RadioButton 样式）。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 行卡片自带底色：全局 ListItemTemplate 的选中底色会被卡片完全挡住，
             所以高亮写在卡片模板的 DataTrigger 里（照 SubActionLibraryView 的既有做法）。 -->
        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <!-- 头部：三个页签 + 搜索 + 页面级操作 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabAll" Style="{StaticResource CaptureTab}" GroupName="historyTab"
                                 Content="全部" IsChecked="True" Tag="all" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabShot" Style="{StaticResource CaptureTab}" GroupName="historyTab"
                                 Content="截图" Tag="shot" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabRecognize" Style="{StaticResource CaptureTab}" GroupName="historyTab"
                                 Content="识别" Tag="recognize" Checked="Tab_Changed"/>
                </StackPanel>

                <TextBox x:Name="SearchBox" Grid.Column="1" Width="240" Height="30"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,16,0"
                         controls:TextBoxPlaceholder.Text="搜索识别文字…"
                         TextChanged="SearchBox_TextChanged"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnGhost}" Content="打开目录" Click="OpenDir_Click"
                            ToolTip="在资源管理器里打开 captures 目录"/>
                    <Button Style="{StaticResource BtnGhost}" Content="清空全部" Margin="8,0,0,0"
                            Click="ClearAll_Click" ToolTip="删除全部采集记录与图片（不可撤销）"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左列表 + 右预览 -->
        <Grid Grid.Row="2" Margin="14,10,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource HistoryItem}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="HistoryList_SelectionChanged"
                         MouseDoubleClick="HistoryList_MouseDoubleClick"
                         PreviewKeyDown="HistoryList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Margin="0,0,6,6" Padding="8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CornerMd}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="88" Height="58" Margin="0,0,10,0"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="{StaticResource CornerSm}" ClipToBounds="True">
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Info}" Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSizeHint}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" Margin="0,3,0,0"
                                                   FontSize="{StaticResource FontSizeHint}"
                                                   Foreground="{StaticResource HintTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource PressedBgBrush}"/>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="250"
                           Foreground="{StaticResource SecondaryTextBrush}" IsHitTestVisible="False"
                           Text="还没有采集记录。"/>
            </Grid>

            <Border Grid.Column="1" Width="1" Margin="8,2,8,2" Background="{StaticResource BorderBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerMd}" Padding="10"
                        MinHeight="180">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="选择左边一条查看大图"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock x:Name="PreviewInfo" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

                    <StackPanel x:Name="TextPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="识别文字" Style="{StaticResource HintLabel}"/>
                        <Border Height="96" Margin="0,4,0,0" Padding="8,6"
                                Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="{StaticResource CornerSm}" ClipToBounds="True">
                            <TextBox x:Name="TextPreview" Style="{StaticResource HistoryText}"
                                     controls:TextBoxClear.Attach="False"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="CopyImageBtn" Style="{StaticResource BtnGhost}" Content="复制图片"
                                MinWidth="88" Click="CopyImage_Click" IsEnabled="False"/>
                        <Button x:Name="SaveAsBtn" Style="{StaticResource BtnGhost}" Content="另存为…"
                                MinWidth="88" Margin="8,0,0,0" Click="SaveAs_Click" IsEnabled="False"/>
                        <Button x:Name="CopyTextBtn" Style="{StaticResource BtnGhost}" Content="复制识别文字"
                                MinWidth="108" Margin="8,0,0,0" Click="CopyText_Click" IsEnabled="False"/>
                        <Button x:Name="DeleteBtn" Style="{StaticResource BtnGhostDanger}" Content="删除"
                                MinWidth="76" Margin="8,0,0,0" Click="Delete_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 底栏：统计 + 关闭 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" Padding="14,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,150,0"
                           Text="采集历史保存在 captures/，进备份。"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="关闭" MinWidth="78"
                            IsCancel="True" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
