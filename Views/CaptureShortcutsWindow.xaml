<Window x:Class="LTools.Views.CaptureShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="截图 Pro · 全局快捷键" Width="660" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,16">
                <Button Style="{StaticResource BtnGhost}" Content="恢复默认"
                        MinWidth="86" Click="Restore_Click"
                        ToolTip="把每一条都改回默认（截图 F1 / 截图并复制 Ctrl+F1 / 贴剪贴板 F3 / 恢复上一张关闭的贴图 Ctrl+F3）"/>
                <Button Style="{StaticResource BtnPrimary}" Content="关闭" MinWidth="78"
                        Margin="8,0,0,0" IsDefault="True" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </controls:DialogShell.Footer>

        <StackPanel Margin="20,14,20,0">
            <CheckBox x:Name="EnableBox" Content="启用全局快捷键"
                      Checked="Enable_Changed" Unchecked="Enable_Changed"/>
            <TextBlock Style="{StaticResource HintLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="这些键在任何程序里都能触发。取消勾选 = 暂停所有全局快捷键（设置页这份不落盘，重启恢复启用）。"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource HintLabel}" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>

            <Border Height="1" Background="{StaticResource BorderStrongBrush}" Margin="0,12,0,0"/>

            <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RowsHost" Margin="0,10,0,14"/>
            </ScrollViewer>
        </StackPanel>
    </controls:DialogShell>
</Window>
