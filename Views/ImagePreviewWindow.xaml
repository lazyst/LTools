<Window x:Class="LTools.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模板预览" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Background="#101014" KeyDown="Window_KeyDown" MouseDown="Window_MouseDown"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Image x:Name="Preview" Stretch="Uniform" Margin="16,16,16,42"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="Caption" Foreground="#A1A1AA" HorizontalAlignment="Center"
                   VerticalAlignment="Bottom" Margin="16,0,16,16" TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeHint}" TextAlignment="Center"/>
    </Grid>
</Window>
