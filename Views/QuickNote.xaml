<Window x:Class="LTools.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="速记" Width="780" Height="540" MinWidth="560" MinHeight="380"
        ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        KeyDown="Window_KeyDown" Closing="Window_Closing"
        views:WindowSizing.Mode="Main">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar x:Name="NoteTitleBar" Grid.Row="0" ShowPin="True" PinClicked="TitleBar_PinClicked"/>

        <!-- 主内容：左列(列表) + 分隔条 + 右列(编辑) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：分类 / 搜索 / 列表 -->
            <Grid Grid.Column="0" Margin="14,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 分类下拉 + 新建 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="CategoryBox"
                               SelectionChanged="CategoryBox_SelectionChanged"
                               ToolTip="右键管理分类">
                        <ComboBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建分类..." Click="NewCategory_Click"/>
                                <MenuItem Header="重命名分类..." Click="RenameCategory_Click"/>
                                <MenuItem Header="删除分类" Click="DeleteCategory_Click"/>
                            </ContextMenu>
                        </ComboBox.ContextMenu>
                    </ComboBox>
                    <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="新建"
                            Click="NewNote_Click" Margin="8,0,0,0"/>
                </Grid>

                <!-- 搜索（占位文字走全局 TextBoxPlaceholder，别再叠一层 TextBlock） -->
                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="8,5"
                             controls:TextBoxPlaceholder.Text="搜索速记…"/>
                </Grid>

                <!-- 速记列表 -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="NoteList"
                             PreviewMouseLeftButtonUp="NoteList_Click"
                             PreviewMouseRightButtonUp="NoteList_RightClick"
                             MouseDoubleClick="NoteList_MouseDoubleClick"
                             ToolTip="单击切换到这条速记；双击把焦点拉回正文，接着写">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="删除" Click="DeleteNote_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   FontWeight="Medium" VerticalAlignment="Center"/>
                                        <!-- 分类标签：仅「全部」视图显示（单分类视图每行相同→隐藏） -->
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}"
                                                CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                                Visibility="{Binding CategoryTagVis}">
                                            <TextBlock Text="{Binding Category}" FontSize="{StaticResource FontSizeHint}"
                                                       Foreground="{StaticResource HintTextBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding MtimeText}" Style="{StaticResource HintLabel}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- 正文摘要：第一行真正的内容（去掉 Markdown 记号），没有就不占位 -->
                                    <TextBlock Text="{Binding Snippet}" Style="{StaticResource HintLabel}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                               Visibility="{Binding SnippetVis}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyHint" Text="暂无速记" Style="{StaticResource HintLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- 右列：标题 + 正文 -->
            <Grid Grid.Column="2" Margin="0,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" Grid.Column="0" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                             BorderThickness="0" Padding="0,2" Background="Transparent"
                             controls:TextBoxPlaceholder.Text="标题"
                             TextChanged="TitleBox_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyMarkdownBtn" Style="{StaticResource BtnGhost}" Content="复制 Markdown"
                                Padding="8,3" FontSize="{StaticResource FontSizeHint}" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="CopyMarkdown_Click"
                                ToolTip="把这条速记的 Markdown 源码复制到剪贴板"/>
                        <Button x:Name="PreviewToggleBtn" Style="{StaticResource BtnGhost}" Content="预览"
                                Padding="8,3" FontSize="{StaticResource FontSizeHint}" Margin="4,0,0,0"
                                Click="PreviewToggle_Click" ToolTip="Ctrl+P 在源码与预览之间切换"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 一行紧凑工具栏：按钮 Focusable=False，点它不抢编辑器的选区 / 光标。 -->
                    <StackPanel x:Name="MarkdownToolbar" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="MdToolBold" Style="{StaticResource BtnGhost}" Content="B" FontWeight="Bold"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="加粗（Ctrl+B）"/>
                        <Button x:Name="MdToolItalic" Style="{StaticResource BtnGhost}" Content="I" FontStyle="Italic"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="斜体（Ctrl+I）"/>
                        <Button x:Name="MdToolCode" Style="{StaticResource BtnGhost}" Content="&lt;/&gt;"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="行内代码（Ctrl+E）"/>
                        <Button x:Name="MdToolH1" Style="{StaticResource BtnGhost}" Content="H1"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="一级标题"/>
                        <Button x:Name="MdToolH2" Style="{StaticResource BtnGhost}" Content="H2"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="二级标题"/>
                        <Button x:Name="MdToolBullet" Style="{StaticResource BtnGhost}" Content="•"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="无序列表"/>
                        <Button x:Name="MdToolOrdered" Style="{StaticResource BtnGhost}" Content="1."
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="有序列表"/>
                        <Button x:Name="MdToolTask" Style="{StaticResource BtnGhost}" Content="☐"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="待办"/>
                        <Button x:Name="MdToolQuote" Style="{StaticResource BtnGhost}" Content="❝"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="引用"/>
                        <Button x:Name="MdToolLink" Style="{StaticResource BtnGhost}" Content="链接"
                                Focusable="False" Padding="6,1" MinHeight="0" Margin="0,0,2,0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="链接（Ctrl+K）"/>
                        <Button x:Name="MdToolTable" Style="{StaticResource BtnGhost}" Content="表格"
                                Focusable="False" Padding="6,1" MinHeight="0"
                                FontSize="{StaticResource FontSizeHint}" Click="MarkdownToolbar_Click"
                                ToolTip="插入表格"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- 正文是 Markdown 源码：TextBox 不能局部着色，换 AvalonEdit（逐 token 高亮 + 虚拟化）。 -->
                        <avalonedit:TextEditor x:Name="BodyBox"
                                               WordWrap="True" ShowLineNumbers="False"
                                               HorizontalScrollBarVisibility="Disabled"
                                               VerticalScrollBarVisibility="Auto"
                                               Background="Transparent" Foreground="{StaticResource TextBrush}"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
                                               Padding="0,4" BorderThickness="0" AllowDrop="True"
                                               TextChanged="BodyBox_TextChanged"
                                               PreviewKeyDown="BodyBox_PreviewKeyDown"
                                               PreviewDragOver="BodyBox_PreviewDragOver"
                                               PreviewDrop="BodyBox_PreviewDrop">
                            <!-- AvalonEdit 不自带右键菜单；换掉 TextBox 后这四件事要自己补回来。 -->
                            <avalonedit:TextEditor.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="撤销" Command="ApplicationCommands.Undo"/>
                                    <MenuItem Header="重做" Command="ApplicationCommands.Redo"/>
                                    <Separator/>
                                    <MenuItem Header="剪切" Command="ApplicationCommands.Cut"/>
                                    <MenuItem Header="复制" Command="ApplicationCommands.Copy"/>
                                    <MenuItem Header="粘贴" Click="PasteMenu_Click"/>
                                    <Separator/>
                                    <MenuItem Header="全选" Command="ApplicationCommands.SelectAll"/>
                                </ContextMenu>
                            </avalonedit:TextEditor.ContextMenu>
                        </avalonedit:TextEditor>
                        <!-- AvalonEdit 没有占位文字：空正文时叠一层灰字，和全局 TextBox 的手感一致。 -->
                        <TextBlock x:Name="BodyPlaceholder" Text="正文（Markdown）" IsHitTestVisible="False"
                                   Margin="1,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Foreground="{StaticResource HintTextBrush}" Visibility="Collapsed"/>
                        <!-- 预览：只读 RichTextBox 托着 FlowDocument（点某一块要能回源码行，要它的命中测试）。
                             选区色是画在文字**上面**的一层：SelectionOpacity 千万别设 1，那样等于拿一块不透明的灰把字整块盖住（踩过，表现为「选中的字看不见」）；0.4 是 WPF 默认。 -->
                        <RichTextBox x:Name="PreviewBox" Visibility="Collapsed"
                                     IsReadOnly="True" IsDocumentEnabled="True" IsReadOnlyCaretVisible="False"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     SelectionBrush="{StaticResource EditorSelectionBrush}" SelectionOpacity="0.4"
                                     AcceptsTab="False" BorderThickness="0" Background="Transparent"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
                                     Padding="0,4" SpellCheck.IsEnabled="False"
                                     ToolTip="双击某一块回到源码对应行（Ctrl+P 切回编辑）"
                                     ScrollViewer.ScrollChanged="PreviewBox_ScrollChanged"
                                     SizeChanged="PreviewBox_SizeChanged"
                                     MouseDoubleClick="PreviewBox_MouseDoubleClick"/>
                        <!-- 命中框画在预览上面（半透明）：垫在下面会被代码块 / 行内代码自己的底色盖住。 -->
                        <Canvas x:Name="FindLayer" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True"/>
                        <!-- 预览里的查找条（Ctrl+F）：悬浮在预览右上角，不占正文高度 -->
                        <Border x:Name="FindBar" Visibility="Collapsed" Panel.ZIndex="10"
                                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,6,0"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CornerMd}" Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="FindBox" Width="150" Padding="6,3"
                                         controls:TextBoxClear.Attach="False"
                                         controls:TextBoxPlaceholder.Text="在预览里查找…"
                                         TextChanged="FindBox_TextChanged"
                                         PreviewKeyDown="FindBox_PreviewKeyDown"/>
                                <TextBlock x:Name="FindCount" Style="{StaticResource HintLabel}"
                                           VerticalAlignment="Center" Margin="8,0,2,0"/>
                                <Button x:Name="FindPrev" Style="{StaticResource BtnGhost}" Content="↑"
                                        Focusable="False" Padding="6,1" MinHeight="0"
                                        FontSize="{StaticResource FontSizeHint}" Click="FindPrev_Click"
                                        ToolTip="上一个（Shift+Enter）"/>
                                <Button x:Name="FindNext" Style="{StaticResource BtnGhost}" Content="↓"
                                        Focusable="False" Padding="6,1" MinHeight="0"
                                        FontSize="{StaticResource FontSizeHint}" Click="FindNext_Click"
                                        ToolTip="下一个（Enter）"/>
                                <Button x:Name="FindClose" Style="{StaticResource BtnGhost}" Content="✕"
                                        Focusable="False" Padding="6,1" MinHeight="0"
                                        FontSize="{StaticResource FontSizeHint}" Click="FindClose_Click"
                                        ToolTip="关闭查找（Esc）"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="StatusBar" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" x:Name="SaveBadge" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
