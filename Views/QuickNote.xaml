<Window x:Class="CapsLockPro.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CapsLockPro.Views.Controls"
        Title="速记" Width="780" Height="540" MinWidth="560" MinHeight="380"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <!-- 主内容：左列(列表) + 分隔条 + 右列(编辑) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：分类 / 搜索 / 列表 -->
            <Grid Grid.Column="0" Margin="14,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 分类下拉 + 新建 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="CategoryBox"
                               SelectionChanged="CategoryBox_SelectionChanged"
                               ToolTip="右键管理分类">
                        <ComboBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建分类..." Click="NewCategory_Click"/>
                                <MenuItem Header="重命名分类..." Click="RenameCategory_Click"/>
                                <MenuItem Header="删除分类" Click="DeleteCategory_Click"/>
                            </ContextMenu>
                        </ComboBox.ContextMenu>
                    </ComboBox>
                    <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="新建"
                            Click="NewNote_Click" Margin="8,0,0,0"/>
                </Grid>

                <!-- 搜索 -->
                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="8,5"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索…" IsHitTestVisible="False"
                               Foreground="{StaticResource HintTextBrush}" FontSize="13"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                </Grid>

                <!-- 速记列表 -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="NoteList" PreviewMouseLeftButtonUp="NoteList_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,0">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="{Binding MtimeText}" Style="{StaticResource HintLabel}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyHint" Text="暂无速记" Style="{StaticResource HintLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- 右列：标题 + 正文 -->
            <Grid Grid.Column="2" Margin="0,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBox x:Name="TitleBox" FontSize="15" FontWeight="SemiBold"
                             BorderThickness="0" Padding="0,2" Background="Transparent"
                             TextChanged="TitleBox_TextChanged"/>
                    <TextBlock x:Name="TitlePlaceholder" Text="标题" IsHitTestVisible="False"
                               Foreground="{StaticResource HintTextBrush}" FontSize="15"
                               FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,0"/>
                </Grid>
                <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>
                <Grid Grid.Row="2">
                    <TextBox x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"
                             Padding="0,4" TextChanged="BodyBox_TextChanged"/>
                    <TextBlock x:Name="BodyPlaceholder" Text="正文" IsHitTestVisible="False"
                               Foreground="{StaticResource HintTextBrush}"
                               VerticalAlignment="Top" Margin="0,6,0,0"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="StatusBar" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" x:Name="SaveBadge" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
