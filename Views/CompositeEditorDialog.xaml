<Window x:Class="CapsLockPro.Views.CompositeEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CapsLockPro.Views.Controls"
        Title="组合步骤" Width="640" Height="480"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 步骤行 -->
        <DataTemplate x:Key="StepRowTemplate">
            <Border Padding="6,6" Margin="0,2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 拖拽手柄：仅此把手触发拖动，其余控件保持可交互 -->
                    <TextBlock Grid.Column="0" Text="⋮⋮" Foreground="{StaticResource HintTextBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Cursor="SizeAll" ToolTip="按住拖动可调整顺序"
                               PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown"/>
                    <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <!-- 引用的动作：点击可更换 -->
                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="{Binding ActionLabel}"
                            MinWidth="60" Margin="0,0,8,0" VerticalAlignment="Center" MinHeight="28"
                            ToolTip="点击更换引用的动作"
                            HorizontalContentAlignment="Left" Click="ChangeAction_Click"/>
                    <TextBox Grid.Column="3" Text="{Binding DelayMs, UpdateSourceTrigger=LostFocus}"
                             MinHeight="28" Margin="0,0,8,0" ToolTip="本步开始前等待（毫秒）"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding StrategyOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding OnFail}"
                              Margin="0,0,8,0" MinHeight="28" ToolTip="本步失败后的策略"/>
                    <Button Grid.Column="5" Style="{StaticResource BtnGhost}" Content="上移" MinWidth="52"
                            Click="MoveUp_Click" Margin="0,0,4,0"/>
                    <Button Grid.Column="6" Style="{StaticResource BtnGhostDanger}" Content="删除" MinWidth="52"
                            Click="Delete_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False"/>

        <TextBlock Grid.Row="1" Margin="20,12,20,0" Style="{StaticResource HintLabel}"
                   Text="步骤按顺序执行。延迟（毫秒）为本步开始前等待；失败策略 continue=继续下一步，abort=中止组合。"/>

        <!-- 步骤列表（支持拖拽排序） -->
        <ListBox Grid.Row="2" x:Name="StepsList" Margin="20,8,20,0"
                 AllowDrop="True"
                 Drop="StepsList_Drop" DragOver="StepsList_DragOver"
                 SelectionChanged="StepsList_SelectionChanged"
                 ItemTemplate="{StaticResource StepRowTemplate}"/>

        <!-- 底部 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnPrimary}" Content="添加步骤…" MinWidth="104" Click="Add_Click"/>
                    <Button Style="{StaticResource BtnGhost}" Content="上移" MinWidth="56" Margin="8,0,0,0" Click="MoveUp_Click"/>
                    <Button Style="{StaticResource BtnGhost}" Content="下移" MinWidth="56" Margin="4,0,0,0" Click="MoveDown_Click"/>
                    <Button Style="{StaticResource BtnGhostDanger}" Content="删除" MinWidth="56" Margin="4,0,0,0" Click="Delete_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="84" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="84" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
