<Window x:Class="LTools.Views.MouseTipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseTip"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" Focusable="False"
        WindowStartupLocation="Manual"
        Background="Transparent" ShowActivated="False">
    <Border Background="#18181B" CornerRadius="6" Padding="12,7"
            BorderBrush="#00000000" BorderThickness="0" MaxWidth="380">
        <TextBlock x:Name="TipText" Foreground="White" FontSize="13"
                   FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
    </Border>
</Window>
