<Window x:Class="LTools.Views.SuperPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="动作面板" Width="560" Height="620" MinWidth="360" MinHeight="340"
        WindowStyle="None" Topmost="True" ShowInTaskbar="False"
        ResizeMode="CanResize" WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 左栏入口：图标按钮（透明底；悬停 / 选中时白色圆角底 + 淡投影，左栏本身是浅灰底） -->
        <Style x:Key="RailBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="ToolTipService.Placement" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="content"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                TextBlock.FontSize="{TemplateBinding FontSize}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 选中（Tag=Selected）：白色圆角底 + 淡投影 -->
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                          Direction="270" Opacity="0.10"
                                                          Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="content" Property="TextBlock.Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <!-- 悬停：同样的白底 + 略深的投影；禁用项也给反馈（tooltip 用 ShowOnDisabled） -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                          Direction="270" Opacity="0.16"
                                                          Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="content" Property="TextBlock.Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource PressedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 场景标签：靠左，小圆角胶囊，选中项左侧带主色竖条（照 Quicker 的区头标签） -->
        <Style x:Key="SceneTabBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,0,9,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeHint}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- 分组导航条：一小条 = 一个分组，悬停就把视图切到那个分组（照 Quicker 面板左缘的分组导航） -->
        <Style x:Key="GroupBarBtn" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.Placement" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="bar" Width="10" Height="3" CornerRadius="1.5"
                                    Background="{StaticResource BorderStrongBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Background"
                                        Value="{StaticResource SecondaryTextBrush}"/>
                            </Trigger>
                            <!-- 当前分组：主色 + 略长略粗（放在悬停之后，悬停当前分组不会变淡） -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bar" Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bar" Property="Width" Value="13"/>
                                <Setter TargetName="bar" Property="Height" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组导航末尾的「＋」：新建分组 -->
        <Style x:Key="GroupAddBtn" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource HintTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.Placement" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="glyph" Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource HoverBgBrush}"/>
                                <Setter TargetName="glyph" Property="Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 磁贴：Quicker 式——透明底、1px 透明边、圆角 8、hover 软底，磁贴之间只有 4×2 间距 -->
        <Style x:Key="TileBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4,4,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource HoverBgBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource SelectedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 双区之间的可拖动分割条：1px 线 + 悬停 / 拖动时显示主色抓手 -->
        <Style x:Key="PaneSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Height="1" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                            <Border x:Name="grip" Height="3" Margin="20,0"
                                    VerticalAlignment="Center" CornerRadius="1.5"
                                    Background="{StaticResource PrimaryBrush}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="grip" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 不透明窗口（无 AllowsTransparency）：保留 ClearType 与硬件加速文本渲染 -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ 左栏：logo + 入口 ============ -->
            <Border Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="44">
                        <Image x:Name="LogoImage" Width="22" Height="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="LogoFallback" Text="L" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel>
                        <Button x:Name="NavActionsBtn" Style="{StaticResource RailBtn}"
                                Tag="Selected" Click="NavActions_Click"
                                ToolTip="动作面板：这里放常用动作磁贴"
                                AutomationProperties.Name="动作面板">
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button x:Name="NavStashBtn" Style="{StaticResource RailBtn}"
                                Click="NavStash_Click"
                                ToolTip="暂存区：AI 写好的草稿停在这里"
                                AutomationProperties.Name="暂存区">
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ 顶栏 ============ -->
            <Grid Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="LTools" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}"
                           Foreground="{StaticResource TextBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- 搜索框（输入即搜索） -->
                    <Border x:Name="SearchHost" Width="188" Height="24" Margin="0,0,4,0"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="9,0,7,0">
                        <Grid>
                            <TextBlock x:Name="SearchPlaceholder" Text="搜索动作…" IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource HintTextBrush}"
                                       FontSize="{StaticResource FontSizeSecondary}"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Padding="0" VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TextBrush}"
                                     FontSize="{StaticResource FontSizeSecondary}"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        </Grid>
                    </Border>

                    <Button x:Name="SettingsBtn" Style="{StaticResource BtnGhost}"
                            Width="30" Height="28" Padding="0" Margin="0,0,1,0"
                            Click="Settings_Click" ToolTip="面板管理 (CapsLock+\)">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="PinBtn" Style="{StaticResource BtnGhost}"
                            Width="30" Height="28" Padding="0"
                            Click="Pin_Click" ToolTip="钉住：点击外部不关闭">
                        <TextBlock x:Name="PinIcon" Text="&#xE840;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource BtnGhost}" Content="✕"
                            Width="32" Height="28" Margin="1,0,0,0"
                            Click="Close_Click" ToolTip="关闭 (Esc)"/>
                </StackPanel>
            </Grid>

            <!-- ============ 双区内容（动作面板） ============ -->
            <Grid x:Name="ActionsPane" Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="GlobalRow" Height="*" MinHeight="96"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition x:Name="ContextRow" Height="*" MinHeight="96"/>
                </Grid.RowDefinitions>

                <!-- 全局区：场景标签靠左，点击切换；内容左侧是分组导航条（悬停切换分组） -->
                <DockPanel Grid.Row="0">
                    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Padding="8,7,8,3"
                                  Background="{StaticResource SurfaceBrush}">
                        <StackPanel x:Name="GlobalSceneTabs" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="GlobalGroupRail" Grid.Column="0" Width="18"
                                    VerticalAlignment="Top" Margin="3,7,0,0"/>
                        <ScrollViewer x:Name="GlobalScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="4,2,6,6">
                            <StackPanel x:Name="GlobalGroups"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- 可拖动分割条：调整上下两区高度（比例记入 Preferences.GlobalRatio） -->
                <GridSplitter Grid.Row="1" x:Name="PaneSplitter"
                              Style="{StaticResource PaneSplitterStyle}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              DragDelta="PaneSplitter_DragDelta"/>

                <!-- 上下文区：同样靠左的场景标签，点击可切换（含「通用」） -->
                <DockPanel Grid.Row="2">
                    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Padding="8,7,8,3"
                                  Background="{StaticResource SurfaceBrush}">
                        <StackPanel x:Name="ContextSceneTabs" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- 未配置场景提示（照 Quicker：左侧说明 + 右侧「添加专用设置」行内按钮 + 淡红 ⊘） -->
                    <Border x:Name="ContextHintBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                            Background="{StaticResource SurfaceAltBrush}" BorderThickness="0" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ContextHintText" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSecondary}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextBrush}"/>
                            <Button x:Name="HintAddButton" Grid.Column="1" Style="{StaticResource HintActionButton}"
                                    Content="添加专用设置" FontSize="{StaticResource FontSizeSecondary}"
                                    Margin="12,0,0,0" Click="CreateSceneForForeground_Click"/>
                            <Button x:Name="HintDismissButton" Grid.Column="2" Style="{StaticResource HintDismissButton}"
                                    Content="&#x2298;" Margin="4,0,0,0" VerticalAlignment="Center"
                                    ToolTip="不再提示" Click="DismissHint_Click"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ContextGroupRail" Grid.Column="0" Width="18"
                                    VerticalAlignment="Top" Margin="3,7,0,0"/>
                        <ScrollViewer x:Name="ContextScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="4,4,6,6">
                            <StackPanel x:Name="ContextGroups"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- ============ 暂存区（左栏第二个入口，照 Quicker：草稿在面板里，不在设置里） ============ -->
            <controls:StashPane x:Name="StashView" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"/>

            <!-- 拖动幽灵 / 占位层（覆盖全窗口，不挡鼠标） -->
            <Canvas x:Name="GhostLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
