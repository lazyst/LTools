<Window x:Class="CapsLockPro.Views.SuperPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超级面板" Width="384" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.14" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="34" Background="{StaticResource SurfaceAltBrush}">
                <TextBlock x:Name="TitleText" Text="超级面板" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="CloseBtn" Style="{StaticResource BtnGhost}" Content="✕"
                        Width="34" Height="28" HorizontalAlignment="Right" Margin="0,0,3,0"
                        Click="Close_Click" ToolTip="关闭 (Esc)"/>
            </Grid>

            <!-- 3×3 格子 -->
            <UniformGrid x:Name="CellsHost" Grid.Row="1" Rows="3" Columns="3" Margin="8"/>

            <!-- 页脚：提示 + 翻页 + 页数指示 -->
            <Grid Grid.Row="2" Height="38" Background="{StaticResource SurfaceAltBrush}">
                <TextBlock x:Name="HintText" Margin="10,0,0,0"
                           Text="1-9 选格 · 滚轮翻页 · Esc 关闭"
                           Foreground="{StaticResource HintTextBrush}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button x:Name="PrevBtn" Style="{StaticResource BtnGhost}" Content="‹" MinWidth="32"
                            FontSize="16" Click="Prev_Click" ToolTip="上一页"/>
                    <TextBlock x:Name="PageIndicator" Margin="8,0" Text="1/1"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button x:Name="NextBtn" Style="{StaticResource BtnGhost}" Content="›" MinWidth="32"
                            FontSize="16" Click="Next_Click" ToolTip="下一页"/>
                </StackPanel>
            </Grid>

            <!-- 拖动幽灵层（覆盖全窗口，不挡鼠标；§5.6） -->
            <Canvas x:Name="GhostLayer" Grid.RowSpan="3" IsHitTestVisible="False">
                <Border x:Name="DragGhost" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="2" CornerRadius="6" Padding="8,4" Opacity="0.92"
                        Width="118" Height="78">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="GhostIcon" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="GhostName" Margin="0,3,0,0" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="104"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
