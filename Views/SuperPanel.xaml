<Window x:Class="LTools.Views.SuperPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超级面板" Width="386" SizeToContent="Height"
        WindowStyle="None" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <!-- 不透明窗口（无 AllowsTransparency）：恢复 ClearType + 硬件加速文本渲染。
         圆角由 Border CornerRadius 在同色底上自绘（白底圆角描边）；无阴影留白故 Margin=0。
         WindowStyle=None + 不透明 = 与本应用所有对话框一致的弹窗基底。 -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8"
            Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="34" Background="{StaticResource SurfaceAltBrush}">
                <TextBlock x:Name="TitleText" Text="超级面板" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="CloseBtn" Style="{StaticResource BtnGhost}" Content="✕"
                        Width="34" Height="28" HorizontalAlignment="Right" Margin="0,0,3,0"
                        Click="Close_Click" ToolTip="关闭 (Esc)"/>
            </Grid>

            <!-- 4×4 格子（无间隙，紧贴标题栏/页脚；§5.3 紧凑布局）
                 外层 Grid ClipToBounds：翻页动画（§5.3）两页同时横滑时裁到本行，
                 避免滑出的格子盖住标题栏 / 页脚。PageFxHost 放「旧页截图」，在格子之下。 -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid x:Name="PageFxHost" IsHitTestVisible="False"/>
                <UniformGrid x:Name="CellsHost" Rows="4" Columns="4" Margin="0"/>
            </Grid>

            <!-- 页脚：提示 + 翻页 + 页数指示 -->
            <Grid Grid.Row="2" Height="38" Background="{StaticResource SurfaceAltBrush}">
                <TextBlock x:Name="HintText" Margin="10,0,0,0"
                           Text="1-9 选格 · 滚轮翻页 · Esc 关闭"
                           Foreground="{StaticResource HintTextBrush}" FontSize="{StaticResource FontSizeHint}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button x:Name="PrevBtn" Style="{StaticResource BtnGhost}" Content="‹" MinWidth="32"
                            FontSize="16" Click="Prev_Click" ToolTip="上一页"/>
                    <TextBlock x:Name="PageIndicator" Margin="8,0" Text="1/1"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeSecondary}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="NextBtn" Style="{StaticResource BtnGhost}" Content="›" MinWidth="32"
                            FontSize="16" Click="Next_Click" ToolTip="下一页"/>
                </StackPanel>
            </Grid>

            <!-- 拖动幽灵层（覆盖全窗口，不挡鼠标；§5.6） -->
            <Canvas x:Name="GhostLayer" Grid.RowSpan="3" IsHitTestVisible="False">
                <Border x:Name="DragGhost" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="2" CornerRadius="6" Padding="8,4" Opacity="0.92"
                        Width="118" Height="78">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="GhostIcon" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="GhostName" Margin="0,3,0,0" FontSize="{StaticResource FontSizeHint}"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="104"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
