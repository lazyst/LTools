<Window x:Class="LTools.Views.FlowNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="流程" Width="780" Height="660" MinWidth="620" MinHeight="440"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- 参数区：变量用输入框右侧的「插入变量」按钮插入，不再另设右侧变量栏 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Padding="20,12,20,0">
                <StackPanel>
                    <!-- 设置变量 -->
                    <StackPanel x:Name="SetSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="变量名" Margin="0,0,0,4"/>
                        <TextBox x:Name="VarBox" MinHeight="32" Margin="0,0,0,4" TextChanged="VarBox_TextChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <RadioButton x:Name="SetOverwriteRadio" Content="覆盖" GroupName="SetMode"
                                         VerticalAlignment="Center" IsChecked="True" Checked="SetMode_Changed"/>
                            <RadioButton x:Name="SetAppendRadio" Content="追加（a += …）" GroupName="SetMode"
                                         VerticalAlignment="Center" Margin="18,0,0,0" Checked="SetMode_Changed"
                                         ToolTip="新值接在变量原来的文本后面；同名变量可以反复赋值"/>
                        </StackPanel>
                        <TextBlock x:Name="SetVarHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                   Margin="0,4,0,14"/>
                        <controls:ProbeEditor x:Name="SetProbe"/>
                    </StackPanel>

                    <!-- 条件分支 -->
                    <StackPanel x:Name="IfSection" Visibility="Collapsed">
                        <controls:ConditionEditor x:Name="IfCondition"/>
                    </StackPanel>

                    <!-- 循环 -->
                    <StackPanel x:Name="LoopSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="循环方式" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="LoopCountRadio" Content="固定次数" GroupName="LoopMode"
                                         VerticalAlignment="Center" Checked="LoopMode_Changed"/>
                            <RadioButton x:Name="LoopWhileRadio" Content="条件成立时重复" GroupName="LoopMode"
                                         VerticalAlignment="Center" Margin="18,0,0,0" Checked="LoopMode_Changed"/>
                        </StackPanel>

                        <Grid x:Name="LoopCountPanel" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="次数" VerticalAlignment="Center"
                                       Foreground="{StaticResource HintTextBrush}"/>
                            <TextBox x:Name="LoopCountBox" Grid.Column="1" Width="90" MinHeight="32" Margin="8,0,0,0"
                                     ToolTip="1–20000；单次运行的步数 / 时间预算另计"/>
                        </Grid>

                        <!-- 下标 / 轮次变量放在条件编辑器之前：条件编辑器很高，放在它后面会被挤出可视区 -->
                        <TextBlock x:Name="LoopIndexLabel" Style="{StaticResource SectionLabel}"
                                   Text="下标变量（可选）" Margin="0,0,0,4"/>
                        <TextBox x:Name="LoopIndexVarBox" MinHeight="32" TextChanged="LoopIndexVar_Changed"
                                 ToolTip="填一个变量名，例如「序号」；留空表示不创建变量"/>
                        <TextBlock x:Name="LoopIndexHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="每轮开始时写入当前下标（从 0 开始），循环体内用 ${变量名} 引用；结束后保留最后一次的值。"/>
                        <TextBlock x:Name="LoopIndexWarn" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                   Margin="0,3,0,10" Visibility="Collapsed"
                                   Foreground="{StaticResource DangerBrush}"/>

                        <StackPanel x:Name="LoopWhilePanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <controls:ConditionEditor x:Name="LoopCondition"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="跳出 / 继续用于控制循环。"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="84" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="84"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
