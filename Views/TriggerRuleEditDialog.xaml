<Window x:Class="LTools.Views.TriggerRuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="编辑自动触发规则" Width="760" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <!-- 按钮栏常驻；错误提示也留在这里（不在滚动区里，出错时始终看得见） -->
            <Grid Margin="20,10,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" Style="{StaticResource HintLabel}"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                            IsCancel="True" Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="74"
                            Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </controls:DialogShell.Footer>

        <Grid Margin="20,12,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>   <!-- 左栏：每次都要填的核心项 -->
                    <ColumnDefinition Width="Auto"/>  <!-- 竖分隔线 -->
                    <ColumnDefinition Width="*"/>     <!-- 右栏：随触发方式变化的参数与可选配置 -->
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Width="1" Margin="2,2,2,2"
                        Background="{StaticResource BorderBrush}" VerticalAlignment="Stretch"/>

                <!-- ============ 左栏：说明 / 启用 / 触发方式 / 动作 ============ -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="说明" Margin="0,0,0,4"/>
                    <TextBox x:Name="NoteBox" MinHeight="30" ToolTip="给这条规则起个名字，列表里按它显示"/>
                    <CheckBox x:Name="EnabledBox" Content="启用此规则" Margin="0,8,0,0" IsChecked="True"/>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="触发方式" Margin="0,16,0,4"/>
                    <ComboBox x:Name="KindBox" MinHeight="30" SelectionChanged="Kind_Changed">
                        <ComboBoxItem Content="定时" Tag="timer"/>
                        <ComboBoxItem Content="启动后" Tag="startup"/>
                        <ComboBoxItem Content="事件" Tag="event"/>
                    </ComboBox>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="动作" Margin="0,16,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ActionBox" IsReadOnly="True" MinHeight="30"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择动作…"
                                MinWidth="86" Margin="8,0,0,0" Click="PickAction_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource HintLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="无人值守时，动作里注入键鼠或弹出界面可能打断你正在做的事。"/>

                    <!-- 事件专属：ActionParam 跟着「动作」放左栏；定时 / 启动后由 ApplyKindVisibility 收起。
                         「插入变量 ▾」把事件输出变量一键插进模板，不用手抄变量名。 -->
                    <StackPanel x:Name="ActionParamPanel" Margin="0,14,0,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="动作参数（可选）"
                                       Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="插入变量 ▾"
                                    MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                                    Click="InsertVariable_Click" ToolTip="从当前事件的输出变量里挑一个插入"/>
                        </Grid>
                        <TextBox x:Name="ActionParamBox" MinHeight="30" AcceptsReturn="True" TextWrapping="Wrap"
                                 ToolTip="支持 ${变量} 插值；插值结果作为变量 triggerParam 注入动作"/>
                        <TextBlock Style="{StaticResource HintLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="内置功能引用不接收事件输出变量；动作需在变量表里声明同名变量才能读到。"/>
                    </StackPanel>
                </StackPanel>

                <!-- ============ 右栏：触发方式专属参数 / 作用范围 / 高级 ============ -->
                <!-- 能选的都给选择入口：数字 / 时刻 / Cron / 筛选是可编辑下拉（常用值一键选、仍可手填），
                     路径 / 窗口 / 进程用按钮调系统选择器；正则、说明这类本质自由的才留纯文本。 -->
                <StackPanel Grid.Column="2" Margin="14,0,0,0">
                    <TextBlock x:Name="RightTitle" Style="{StaticResource SectionLabel}"
                               Text="定时设置" Margin="0,0,0,6"/>

                    <!-- 参数区：定时 -->
                    <StackPanel x:Name="TimerPanel">
                        <TextBlock Style="{StaticResource HintLabel}" Text="间隔 / 每天时刻 / Cron 三选一：填了 Cron 优先，否则填了间隔优先，最后按每天时刻。" TextWrapping="Wrap"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="每" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="IntervalBox" Grid.Column="1" MinHeight="30" IsEditable="True"
                                      ToolTip="间隔分钟数（可手填小数）；留空表示不用间隔">
                                <ComboBoxItem Content="1" ToolTip="每 1 分钟"/>
                                <ComboBoxItem Content="5" ToolTip="每 5 分钟"/>
                                <ComboBoxItem Content="10" ToolTip="每 10 分钟"/>
                                <ComboBoxItem Content="15" ToolTip="每 15 分钟"/>
                                <ComboBoxItem Content="30" ToolTip="每 30 分钟"/>
                                <ComboBoxItem Content="60" ToolTip="每 1 小时"/>
                                <ComboBoxItem Content="120" ToolTip="每 2 小时"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Style="{StaticResource SectionLabel}" Text="分钟　·　每天" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <ComboBox x:Name="DailyBox" Grid.Column="3" MinHeight="30" IsEditable="True"
                                      ToolTip="HH:mm，如 09:00（可手填）；留空表示不用每天时刻">
                                <ComboBoxItem Content="00:00" ToolTip="每天零点"/>
                                <ComboBoxItem Content="08:30" ToolTip="每天 8:30"/>
                                <ComboBoxItem Content="09:00" ToolTip="每天 9:00"/>
                                <ComboBoxItem Content="12:00" ToolTip="每天中午"/>
                                <ComboBoxItem Content="18:00" ToolTip="每天 18:00"/>
                                <ComboBoxItem Content="22:00" ToolTip="每天 22:00"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="Cron 表达式（可选）"
                                       Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource HintLabel}" Margin="8,0,0,0"
                                       Text="从下拉选常用，或手填自定义"/>
                        </Grid>
                        <ComboBox x:Name="CronBox" MinHeight="30" IsEditable="True"
                                  ToolTip="5 段「分 时 日 月 周」或 6 段含秒「秒 分 时 日 月 周」；与间隔 / 每天时刻三选一">
                            <ComboBoxItem Content="*/5 * * * *" ToolTip="每 5 分钟"/>
                            <ComboBoxItem Content="*/10 * * * *" ToolTip="每 10 分钟"/>
                            <ComboBoxItem Content="0 * * * *" ToolTip="每小时整点"/>
                            <ComboBoxItem Content="0 9 * * 1-5" ToolTip="工作日 9:00"/>
                            <ComboBoxItem Content="0 0 * * *" ToolTip="每天 0:00"/>
                            <ComboBoxItem Content="0 0 1 * *" ToolTip="每月 1 号 0:00"/>
                            <ComboBoxItem Content="*/30 * * * * *" ToolTip="每 30 秒（6 段含秒）"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource HintLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="如 */5 * * * *（每 5 分钟）、0 9 * * 1-5（工作日 9:00）；含秒写 6 段。"/>
                    </StackPanel>

                    <!-- 参数区：启动后 -->
                    <StackPanel x:Name="StartupPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource HintLabel}" Text="LTools 启动后延迟这段时间运行一次。" TextWrapping="Wrap"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="延迟" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="DelaySecondsBox" Grid.Column="1" MinHeight="30" IsEditable="True"
                                      ToolTip="秒数（可手填）；0 = 启动即运行">
                                <ComboBoxItem Content="0" ToolTip="启动即运行"/>
                                <ComboBoxItem Content="5" ToolTip="延迟 5 秒"/>
                                <ComboBoxItem Content="10" ToolTip="延迟 10 秒"/>
                                <ComboBoxItem Content="30" ToolTip="延迟 30 秒"/>
                                <ComboBoxItem Content="60" ToolTip="延迟 1 分钟"/>
                                <ComboBoxItem Content="120" ToolTip="延迟 2 分钟"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="OnlyFirstStartBox" Content="仅每日第一次启动时运行" Margin="0,10,0,0"
                                  ToolTip="同一天内多次启动 LTools，只有第一次启动才运行这条规则"/>
                        <CheckBox x:Name="OnlyOnAutoStartBox" Content="仅由开机自启任务拉起时运行" Margin="0,6,0,0"
                                  ToolTip="手动启动 LTools 时不运行；仅登录时由任务计划拉起才运行"/>
                    </StackPanel>

                    <!-- 参数区：事件（参数行按事件类型动态生成，含窗口 / 进程 / 目录选择按钮与多选勾选） -->
                    <StackPanel x:Name="EventPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="事件类型" Margin="0,0,0,4"/>
                        <ComboBox x:Name="EventTypeBox" MinHeight="30" SelectionChanged="EventType_Changed">
                            <ComboBoxItem Content="窗口 / 进程切换" Tag="window.foreground"/>
                            <ComboBoxItem Content="剪贴板变化" Tag="clipboard.change"/>
                            <ComboBoxItem Content="文件系统变化" Tag="file.change"/>
                        </ComboBox>
                        <TextBlock x:Name="ParamHint" Style="{StaticResource HintLabel}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <StackPanel x:Name="ParamsHost" Margin="0,8,0,0"/>
                        <!-- 只在「有条件可能不生效」时出现的一行极简状态；完整说明在参数行徽章的 ToolTip 里 -->
                        <TextBlock x:Name="SemanticMiniBar" Style="{StaticResource HintLabel}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="AvailableVarsText" Style="{StaticResource HintLabel}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 作用范围（可选）：留空 = 不过滤，复用快捷键那套名单匹配；三行都能从系统里选 -->
                    <Expander x:Name="ScopeExpander" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="作用范围（可选）" Margin="0"/>
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource HintLabel}" Text="留空 = 任何时候都触发；填了 = 仅当这些程序 / 窗口在前台时触发。" TextWrapping="Wrap"/>

                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="进程（每行一个，支持 * ?）"
                                           Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择进程…"
                                        MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                                        Click="ScopeProcess_Click" ToolTip="从正在运行的程序里挑，追加一行"/>
                            </Grid>
                            <TextBox x:Name="ProcessBox" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" ToolTip="chrome.exe / Code.exe"/>

                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="窗口标题（每行一个，按包含匹配）"
                                           Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择窗口…"
                                        MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                                        Click="ScopeTitle_Click" ToolTip="点击屏幕上的窗口，把标题追加一行"/>
                            </Grid>
                            <TextBox x:Name="TitleBox" MinHeight="36" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="窗口类名（每行一个）"
                                           Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择窗口…"
                                        MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                                        Click="ScopeClass_Click" ToolTip="点击屏幕上的窗口，把类名追加一行"/>
                            </Grid>
                            <TextBox x:Name="ClassBox" MinHeight="32" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>

                    <!-- 高级参数：设过非默认值才自动展开（照 InputSpec.Advanced 的做法） -->
                    <Expander x:Name="AdvExpander" Margin="0,8,0,0" Foreground="{StaticResource TextBrush}">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="高级参数" Margin="0"/>
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="延迟" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="DelayMsBox" Grid.Column="1" MinHeight="28" IsEditable="True" ToolTip="命中后延迟执行（毫秒）">
                                    <ComboBoxItem Content="0"/><ComboBoxItem Content="100"/><ComboBoxItem Content="300"/>
                                    <ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/><ComboBoxItem Content="3000"/>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Style="{StaticResource SectionLabel}" Text="防抖" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <ComboBox x:Name="DebounceBox" Grid.Column="3" MinHeight="28" IsEditable="True" ToolTip="这段时间内重复命中只算一次（毫秒）">
                                    <ComboBoxItem Content="0"/><ComboBoxItem Content="100"/><ComboBoxItem Content="300"/>
                                    <ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/><ComboBoxItem Content="3000"/>
                                </ComboBox>
                                <TextBlock Grid.Column="4" Style="{StaticResource SectionLabel}" Text="节流" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <ComboBox x:Name="ThrottleBox" Grid.Column="5" MinHeight="28" IsEditable="True" ToolTip="两次执行之间的最短间隔（毫秒）">
                                    <ComboBoxItem Content="0"/><ComboBoxItem Content="100"/><ComboBoxItem Content="300"/>
                                    <ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/><ComboBoxItem Content="3000"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="SkipFurtherBox" Content="命中后不再判断后续事件规则" Margin="0,8,0,0"
                                      ToolTip="SkipFurther：只对事件规则有效；定时 / 启动后规则不受影响"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
    </controls:DialogShell>
</Window>
