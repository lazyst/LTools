                                        <ComboBoxItem Content="保留换行"/>
                                        <ComboBoxItem Content="去掉换行"/>
                                        <ComboBoxItem Content="智能排版"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
