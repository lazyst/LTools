                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="文本检测缩放" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="OcrResizeCombo" MinHeight="32"
                                              SelectionChanged="CaptureOcr_Changed"
                                              ToolTip="照上游 text_recognition/detector_resize_policy">
                                        <ComboBoxItem Content="限制长边（更快）"/>
                                        <ComboBoxItem Content="放大短边（更细）"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="文本检测处理" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="OcrProcessingCombo" MinHeight="32"
                                              SelectionChanged="CaptureOcr_Changed"
                                              ToolTip="照上游 text_recognition/text_detection_processing">
                                        <ComboBoxItem Content="精度优先"/>
                                        <ComboBoxItem Content="速度优先"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="填充样式" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="OcrFillCombo" MinHeight="32"
                                              SelectionChanged="CaptureOcr_Changed"
                                              ToolTip="识别结果里文字区域的底（照上游 text_recognition/fill_style）">
                                        <ComboBoxItem Content="背景填充（逐行估色）"/>
                                        <ComboBoxItem Content="模糊（高斯模糊 + 半透明底）"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="OcrResidentBox" Content="常驻识别进程（识别完不卸载）"
                                          Margin="0,14,0,0" Checked="CaptureOcr_Changed" Unchecked="CaptureOcr_Changed"
                                          ToolTip="照上游 text_recognition/resident_process；关掉后每次识别完立刻卸载引擎"/>
                                <CheckBox x:Name="OcrHotStartBox" Content="模型热启动（启动时预加载所选模型）"
                                          Margin="0,8,0,0" Checked="CaptureOcr_Changed" Unchecked="CaptureOcr_Changed"
                                          ToolTip="照上游 text_recognition/model_hot_start：需要常驻进程，会多占一些内存"/>
                                <CheckBox x:Name="OcrHighlightBox" Content="识别结果加遮罩（压暗文字以外的区域）"
                                          Margin="0,8,0,0" Checked="CaptureOcr_Changed" Unchecked="CaptureOcr_Changed"
                                          ToolTip="照上游 text_recognition/show_text_highlighting：遮罩色取「界面与参考线」里的选区压暗色"/>
                                <CheckBox x:Name="OcrSaveImageBox" Content="保存图片时带上识别 / 译文结果"
                                          Margin="0,8,0,0" Checked="CaptureOcr_Changed" Unchecked="CaptureOcr_Changed"
                                          ToolTip="照上游 text_recognition/save_recognition_result_as_image"/>
                                <CheckBox x:Name="OcrPreviewBox" Content="识别结果先显示原图"
                                          Margin="0,8,0,0" Checked="CaptureOcr_Changed" Unchecked="CaptureOcr_Changed"
                                          ToolTip="照上游 text_recognition/show_original_image_preview：打开结果窗时先在同一个窗口里显示原图（可随时勾「显示原图」切回来）"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="截图 Pro · 在线翻译" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="源语言" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="TranslationSourceCombo" MinHeight="32"
                                              SelectionChanged="TranslationLanguage_Changed"
                                              ToolTip="照 Snow Shot 的 screenshot_translation/source_language"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="目标语言" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="TranslationTargetCombo" MinHeight="32"
                                              SelectionChanged="TranslationLanguage_Changed"
                                              ToolTip="照 Snow Shot 的 screenshot_translation/target_language"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="第二目标语言" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="TranslationSecondaryCombo" MinHeight="32"
                                              SelectionChanged="TranslationLanguage_Changed"
                                              ToolTip="照 Snow Shot 的 screenshot_translation/secondary_target_language：原文本来就是目标语言时改译成它"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="142,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="自动判断出原文本来就是目标语言时，改译成第二目标语言（例如中文界面译中文稿 → 出英文）。选「不用」就关掉。"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="检测门槛（%）" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TranslationThresholdBox" MinHeight="32"
                                             VerticalContentAlignment="Center" MaxWidth="120"
                                             HorizontalAlignment="Left" MinWidth="88"
                                             controls:TextBoxClear.Attach="False"
                                             LostFocus="TranslationThreshold_LostFocus"
                                             KeyDown="TranslationThreshold_KeyDown"
                                             ToolTip="照 Snow Shot 的 screenshot_translation/language_detection_confidence_threshold：30–100，默认 60"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="142,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="语言检测置信度低于这个门槛就不换目标语言。30–100，默认 60。"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="翻译服务" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="TranslationSettingsButton"
                                            Style="{StaticResource Btn}" Content="设置…" MinHeight="32"
                                            Padding="14,4" HorizontalAlignment="Left"
                                            Click="TranslationSettings_Click"
                                            ToolTip="端点 / 模型 / 密钥 / 超时 / 译文画进原图 / 复制成图片 / 版面处理"/>
                                </Grid>
                                <TextBlock x:Name="TranslationSummaryText" Style="{StaticResource HintLabel}"
                                           Margin="142,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 动作管理 ============ -->
                <Grid x:Name="Page_Actions" Visibility="Collapsed" Margin="20,14,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ActionFilterBox" Width="240" MinHeight="30"
                                 HorizontalAlignment="Left"
                                 ToolTip="按动作名称 / 类型 / 步骤筛选"
                                 controls:TextBoxPlaceholder.Text="搜索动作名称、类型或步骤…"
                                 TextChanged="ActionFilter_TextChanged"/>
                        <!-- 引用位置：选项由 ActionReferenceIndex.Options() 填，按场景·分组 / 快捷键 / 悬浮项 / 触发规则收窄 -->
                        <ComboBox Grid.Column="1" x:Name="ActionRefFilterCombo" Width="180" MinHeight="30"
                                  Margin="8,0,0,0" HorizontalAlignment="Left"
                                  ToolTip="按引用位置筛选（面板场景 / 快捷键 / 悬浮项 / 触发规则）"
                                  DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectionChanged="ActionRefFilter_SelectionChanged"/>
                        <TextBlock Grid.Column="2" x:Name="ActionCountText" Style="{StaticResource HintLabel}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button Grid.Column="3" x:Name="OpenStagingButton" Style="{StaticResource BtnGhost}"
                                Content="暂存区" MinWidth="0" Height="28" Padding="10,2" FontSize="12"
                                Margin="12,0,0,0" ToolTip="AI 写出来的动作草稿都在那里"
                                Click="OpenStagingPage_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="ActionList"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="ActionList_PreviewMouseLeftButtonDown"
                              MouseDoubleClick="ActionList_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="动作" Width="1.6*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 单行：名称（深色）+ 摘要（浅色小字）同行，行高沿用 30 不裁切 -->
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto" MaxWidth="240"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Name}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Margin="8,0,0,0"
                                                       Style="{StaticResource HintLabel}"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Summary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="110" MinWidth="90"/>
                            <DataGridTemplateColumn Header="引用位置" Width="1.2*" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding References}" ToolTip="{Binding References}"
                                                   TextTrimming="CharacterEllipsis" Margin="2,0"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 操作列：照 TriggersView 的常驻小图标（CommandParameter 分发、不用 Tag——
                                 BtnGhost 把 Tag 当悬停色）。双击整行也能编辑。
                                 ActionList_PreviewMouseLeftButtonDown 先给 cell 焦点，否则第一次点图标
                                 会被 DataGridCell 吞掉（HotkeysView 踩过）。 -->
                            <DataGridTemplateColumn Header="操作" Width="124" MinWidth="124">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✎" CommandParameter="edit" Style="{StaticResource BtnGhost}"
                                                    Width="24" Height="24" Padding="0" FontSize="14"
                                                    FontFamily="Segoe UI Symbol" Focusable="False"
                                                    ToolTip="编辑这个动作" Click="ActionRowAction_Click"/>
                                            <Button Content="⧉" CommandParameter="copy" Style="{StaticResource BtnGhost}"
                                                    Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14"
                                                    FontFamily="Segoe UI Symbol" Focusable="False"
                                                    ToolTip="复制为副本（新动作，模板图 / 脚本一起带走）" Click="ActionRowAction_Click"/>
                                            <Button Content="🕘" CommandParameter="history" Style="{StaticResource BtnGhost}"
                                                    Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="13"
                                                    FontFamily="Segoe UI Symbol" Focusable="False"
                                                    ToolTip="历史版本（每次保存前的样子，可恢复）"
                                                    Click="ActionRowAction_Click"/>
                                            <Button Content="✕" CommandParameter="delete" Style="{StaticResource BtnGhostDanger}"
                                                    Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14"
                                                    FontFamily="Segoe UI Symbol" Focusable="False"
                                                    ToolTip="删除这个动作" Click="ActionRowAction_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Content="新建动作…" MinWidth="104"
                                Click="NewAction_Click"/>
                        <TextBlock Style="{StaticResource HintLabel}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Text="双击一行也能编辑；行右侧是编辑 / 复制 / 历史版本 / 删除。"/>
                    </StackPanel>
                </Grid>

                <!-- ============ 惰性页 ============
                     6 个重量级 UserControl 不再在 InitializeComponent() 里一次性建出来：
                     这里只放空的 ContentControl 宿主，窗口首次切到该页时才由 code-behind 的
                     Page_* 惰性属性 new 出视图、塞进 Host.Content。低级鼠标钩子与 WPF 共用
                     UI 线程，一次建 6 棵可视树会让「从超级面板打开设置」顿一下。
                     可见性设在宿主上（不触发创建）；数据/方法走 Page_*（触发创建）。
                     Page_General / Page_Actions / Page_Terminals / Page_Logs* / Page_Backup
                     是内联的轻量 ScrollViewer / Grid，保持现状。 -->

                <!-- ============ 快捷键 ============ -->
                <ContentControl x:Name="Host_Hotkeys" Visibility="Collapsed"/>

                <!-- ============ 截图输出（格式 / 质量 / 压缩 / 目录 / 文件名模板 / 另存为 / 自动保存） ============ -->
                <ScrollViewer x:Name="Page_Output" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="保存位置" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="目录"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="ExportDirBox" MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             LostFocus="ExportDir_LostFocus" KeyDown="ExportDir_KeyDown"
                                             controls:TextBoxPlaceholder.Text="留空 = 系统「图片」文件夹"
                                             ToolTip="自动保存、快速保存与「复制图片文件到剪贴板」都写在这里"/>
                                    <Button Grid.Column="2" Style="{StaticResource Btn}" Content="浏览…"
                                            MinWidth="72" Margin="8,0,0,0" Click="ExportBrowseDir_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="留空 = 系统「图片」文件夹；目录不存在会自动创建。"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="格式" Margin="0,18,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="图片格式"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="ExportFormatCombo" MinHeight="32"
                                              SelectionChanged="ExportFormat_Changed"
                                              ToolTip="自动保存 / 快速保存 / 复制图片文件用的格式">
                                        <ComboBoxItem Content="PNG（无损，支持透明）" Tag="png"/>
                                        <ComboBoxItem Content="JPEG（有损，体积小）" Tag="jpeg"/>
                                        <ComboBoxItem Content="BMP（未压缩位图）" Tag="bmp"/>
                                        <ComboBoxItem Content="TIFF（无损，ZIP 压缩）" Tag="tiff"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="上游还能输出 WebP / JPEG XL / AVIF / PDF，本地没有对应的编码器，这四种之外的格式不列。"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="JPEG 质量"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="ExportQualityBox" Width="72" MinHeight="32"
                                                 VerticalContentAlignment="Center"
                                                 LostFocus="ExportQuality_LostFocus" KeyDown="ExportQuality_KeyDown"
                                                 ToolTip="0–100，越大越清晰、文件越大；只对 JPEG 生效"/>
                                        <TextBlock Text="%" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource HintTextBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="PNG 压缩力度"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="ExportCompressionCombo" MinHeight="32"
                                              SelectionChanged="ExportCompression_Changed"
                                              ToolTip="低 = 存得快、文件大；高 = 存得慢、文件小；同样无损">
                                        <ComboBoxItem Content="低（快）" Tag="low"/>
                                        <ComboBoxItem Content="中（默认）" Tag="medium"/>
                                        <ComboBoxItem Content="高（小）" Tag="high"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="文件名" Margin="0,18,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="另存为"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="ExportManualNameBox" MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             LostFocus="ExportManualName_LostFocus"
                                             KeyDown="ExportManualName_KeyDown"
                                             ToolTip="手动「另存为」时预填的文件名（不含扩展名）"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="自动保存"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="ExportAutoNameBox" MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             LostFocus="ExportAutoName_LostFocus"
                                             KeyDown="ExportAutoName_KeyDown"
                                             ToolTip="快速保存与「执行完自动保存」用的文件名（不含扩展名）"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="0,6,0,0" TextWrapping="Wrap">
                                    <Run Text="{}{YYYY} 年 · {YY} 两位年 · {MM} 月 · {DD} 日 · {HH} 时 · {mm} 分 · {ss} 秒 · {zzz} 毫秒；"/>
                                    <Run Text="{}{AN} 前台程序的进程名 · {WN} 前台窗口标题。"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="文件名里不能出现的字符会换成 _，同一个目录下重名会自动加 (2)、(3)。"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="保存行为" Margin="0,18,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="另存为对话框"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="ExportDialogCombo" MinHeight="32"
                                              SelectionChanged="ExportDialog_Changed"
                                              ToolTip="手动保存时用哪个框">
                                        <ComboBoxItem Content="LTools 自绘（带预览 / 尺寸 / 质量）" Tag="builtin"/>
                                        <ComboBoxItem Content="Windows 自带" Tag="system"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ExportShowResultBox" Content="保存之后留着对话框显示结果"
                                          Margin="0,12,0,0" Checked="ExportShowResult_Changed"
                                          Unchecked="ExportShowResult_Changed"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="22,4,0,0" TextWrapping="Wrap"
                                           Text="存完不马上关，显示落盘路径与文件大小（Esc / 关闭再走）。"/>

                                <CheckBox x:Name="ExportCopyFileBox" Content="复制截图时把图片文件也放进剪贴板"
                                          Margin="0,12,0,0" Checked="ExportCopyFileBox_Changed"
                                          Unchecked="ExportCopyFileBox_Changed"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="22,4,0,0" TextWrapping="Wrap"
                                           Text="资源管理器与聊天软件粘贴出一个文件，图库软件仍读到图片本身。"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="执行完自动保存" Margin="0,18,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="勾上的动作在完成之后按上面的格式与目录顺带存一份（不改变原来的复制 / 贴图行为）。"/>
                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="ExportAutoCopyBox" Content="复制截图" Margin="0,4"
                                              Tag="copy_screenshot"
                                              Checked="ExportAutoSave_Changed" Unchecked="ExportAutoSave_Changed"/>
                                    <CheckBox x:Name="ExportAutoScrollingBox" Content="复制长截图" Margin="0,4"
                                              Tag="copy_scrolling_screenshot"
                                              Checked="ExportAutoSave_Changed" Unchecked="ExportAutoSave_Changed"/>
                                    <CheckBox x:Name="ExportAutoPinnedBox" Content="复制贴图" Margin="0,4"
                                              Tag="copy_pinned_image"
                                              Checked="ExportAutoSave_Changed" Unchecked="ExportAutoSave_Changed"/>
                                    <CheckBox x:Name="ExportAutoMonitorBox" Content="截取当前显示器" Margin="0,4"
                                              Tag="capture_current_monitor"
                                              Checked="ExportAutoSave_Changed" Unchecked="ExportAutoSave_Changed"/>
                                    <CheckBox x:Name="ExportAutoWindowBox" Content="截取前台窗口" Margin="0,4"
                                              Tag="capture_focused_window"
                                              Checked="ExportAutoSave_Changed" Unchecked="ExportAutoSave_Changed"/>
                                    <CheckBox x:Name="ExportAutoPinBox" Content="贴图到屏幕" Margin="0,4"
                                              Tag="pin_to_screen"
                                              Checked="ExportAutoSave_Changed" Unchecked="ExportAutoSave_Changed"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 键鼠宏 ============ -->
                <ContentControl x:Name="Host_Macros" Visibility="Collapsed"/>

                <!-- ============ 子动作库 ============ -->
                <ContentControl x:Name="Host_SubActions" Visibility="Collapsed"/>

                <!-- ============ 面板管理 ============ -->
                <ContentControl x:Name="Host_SuperPanel" Visibility="Collapsed"/>

                <!-- ============ 终端路径 ============ -->
                <ScrollViewer x:Name="Page_Terminals" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="终端路径" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource HintLabel}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="「运行命令」选终端时按这里的路径启动。「实际路径」是现在生效的那个；某一行找不到、或想用另一份副本（便携版 / 非默认目录），就在「覆盖」里填它的 exe——留空 = 继续自动探测，改完离开输入框即保存；填了但文件不存在会在「实际路径」里标出来并回退到自动探测。"/>
                        <Border Style="{StaticResource CardBox}">
                            <DataGrid x:Name="PathsGrid" Height="220"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      PreviewMouseLeftButtonDown="PathsGrid_PreviewMouseLeftButtonDown"
                                      PreviewMouseWheel="PathsGrid_PreviewMouseWheel"
                                      MouseDoubleClick="PathsGrid_MouseDoubleClick"
                                      ToolTip="双击一行直接编辑「覆盖」路径">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="终端" Binding="{Binding Label}" Width="140" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="实际路径" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Path}" Margin="2,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" ToolTipService.ShowDuration="20000"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="覆盖" Width="240">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Override, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="24" Margin="0,2" VerticalContentAlignment="Center"
                                                         ToolTip="留空 = 自动探测；填 exe 路径则优先用它（文件存在才算）"
                                                         LostFocus="TerminalOverride_LostFocus"
                                                         KeyDown="TerminalOverride_KeyDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BtnGhost}" Content="浏览…"
                                                        MinWidth="64" Margin="6,2,0,2" Click="BrowseTerminal_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 运行日志 → 设置（二级子页） ============ -->
                <ScrollViewer x:Name="Page_LogsSettings" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="运行日志 · 设置" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="LogEnabledBox" Content="记录运行日志"
                                          Checked="LogOption_Changed" Unchecked="LogOption_Changed"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="22,4,0,12"
                                           TextWrapping="Wrap"
                                           Text="记录启动与环境、动作与流程执行、取值结果、设置变更和异常。日志按天写入数据根下的 logs 文件夹，只保存在本机，不会上传。"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="记录级别" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LogLevelCombo" MinHeight="32"
                                              SelectionChanged="LogOption_Changed">
                                        <ComboBoxItem Content="仅错误"/>
                                        <ComboBoxItem Content="常规（推荐）"/>
                                        <ComboBoxItem Content="详细（含变量值）"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="LogLevelHint" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap" Margin="120,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="保留时间" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LogRetentionCombo" MinHeight="32"
                                              SelectionChanged="LogOption_Changed">
                                        <ComboBoxItem Content="3 天"/>
                                        <ComboBoxItem Content="7 天"/>
                                        <ComboBoxItem Content="14 天"/>
                                        <ComboBoxItem Content="30 天"/>
                                        <ComboBoxItem Content="不自动清理"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="日志文件" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock x:Name="LogPathText" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="LogStatusText" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="打开日志文件夹"
                                            MinWidth="120" Click="OpenLogFolder_Click"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="打开今天的日志"
                                            MinWidth="120" Margin="8,0,0,0" Click="OpenTodayLog_Click"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="复制文件夹路径"
                                            MinWidth="120" Margin="8,0,0,0" Click="CopyLogPath_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 运行日志 → 最近日志（二级子页） ============ -->
                <!-- 单独成页后日志框用 * 行撑满可用高度（不再挤在设置页底部固定 260）。
                     默认自动贴底：向上滚动取消、滚到底恢复；⤓ 按钮一键回底。见 ConfigHelper.Logs.cs。 -->
                <Grid x:Name="Page_LogsRecent" Visibility="Collapsed" Margin="20,14,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                   Text="运行日志 · 最近日志" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="AutoScrollBtn" Style="{StaticResource BtnGhost}"
                                Content="⤓ 自动贴底" MinWidth="110" Click="AutoScrollBtn_Click"
                                ToolTip="默认自动贴底；向上滚动会暂停，滚到底自动恢复。点它回到最新并恢复贴底。"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardBox}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="LogPreviewLevelCombo" Width="104" MinHeight="30"
                                          SelectedIndex="0"
                                          ToolTip="只看某一级别" SelectionChanged="LogPreview_Changed">
                                    <ComboBoxItem Content="全部"/>
                                    <ComboBoxItem Content="错误"/>
                                    <ComboBoxItem Content="警告"/>
                                    <ComboBoxItem Content="信息"/>
                                    <ComboBoxItem Content="调试"/>
                                </ComboBox>
                                <TextBox Grid.Column="1" x:Name="LogPreviewSearchBox" MinHeight="30" Margin="8,0"
                                         ToolTip="按文本过滤（包含匹配，忽略大小写）"
                                         controls:TextBoxPlaceholder.Text="过滤日志文本…"
                                         TextChanged="LogPreview_Changed"/>
                                <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="刷新"
                                        MinWidth="60" Margin="0,0,8,0" Click="LogPreviewRefresh_Click"/>
                                <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="打开失败报告"
                                        MinWidth="104" Margin="0,0,8,0" Click="OpenFailureReport_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="复制诊断信息"
                                        MinWidth="104" Click="CopyDiagnostics_Click"/>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="LogPreviewBox" Margin="0,10,0,0" MinHeight="240"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     ScrollViewer.ScrollChanged="LogPreview_ScrollChanged"
                                     FontFamily="Consolas" FontSize="{StaticResource FontSizeSecondary}"
                                     ToolTip="今天的运行日志；只读。默认自动贴底，向上滚动暂停，滚到底恢复"/>
                            <TextBlock Grid.Row="2" x:Name="LogPreviewHint" Style="{StaticResource HintLabel}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ 运行日志 → 运行历史（二级子页，P2-2） ============ -->
                <!-- 一次运行的薄记录（时间 / 动作 / 来源 / 结果 / 耗时 / 失败位置）+ 失败步骤分布。
                     完整轨迹仍在「最近日志 → 打开失败报告」里，两者别混成一份。见 ConfigHelper.RunHistory.cs。 -->
                <Grid x:Name="Page_LogsHistory" Visibility="Collapsed" Margin="20,14,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"
                                   Text="运行日志 · 运行历史"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnGhost}" Content="刷新" MinWidth="60"
                                    Margin="0,0,8,0" Click="RunHistoryRefresh_Click"/>
                            <Button Style="{StaticResource BtnGhost}" Content="复制摘要" MinWidth="80"
                                    Margin="0,0,8,0" Click="RunHistoryCopy_Click"
                                    ToolTip="把统计、失败步骤分布与最近 50 条明细复制成 markdown（可直接贴给 AI 或提 issue）"/>
                            <Button Style="{StaticResource BtnGhost}" Content="清空" MinWidth="60"
                                    Click="RunHistoryClear_Click"
                                    ToolTip="只删运行历史，不动失败报告与日志文件"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="RunHistoryStats" Style="{StaticResource HintLabel}"
                               TextWrapping="Wrap" Margin="0,0,0,8" Text="（还没有运行过）"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" x:Name="RunHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  HeadersVisibility="Column" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  MouseDoubleClick="RunHistoryGrid_MouseDoubleClick"
                                  ToolTip="双击一行复制这条记录（含错误全文），方便贴给 AI">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="140" MinWidth="130"/>
                                <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="1.2*" MinWidth="120"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80" MinWidth="70"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="70" MinWidth="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="失败">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="80" MinWidth="70"/>
                                <DataGridTextColumn Header="失败位置" Binding="{Binding Step}" Width="1.4*" MinWidth="140"/>
                                <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" MinWidth="160"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="1" Style="{StaticResource CardBox}" Margin="12,0,0,0" Padding="12,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="失败步骤分布"/>
                                    <TextBlock x:Name="RunHistoryDistHint" Style="{StaticResource HintLabel}"
                                               TextWrapping="Wrap" Margin="0,2,0,6" Text=""/>
                                    <ItemsControl x:Name="RunHistoryDist">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Count}" MinWidth="26"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource DangerBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                               ToolTip="{Binding Text}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="RunHistoryHint" Style="{StaticResource HintLabel}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </Grid>

                <!-- ============ 自动触发 ============ -->
                <ContentControl x:Name="Host_Triggers" Visibility="Collapsed"/>

                <!-- ============ AI 接入 ============ -->
                <ContentControl x:Name="Host_Ai" Visibility="Collapsed"/>

                <!-- ============ 备份与恢复 ============ -->
                <ScrollViewer x:Name="Page_Backup" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="导出" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="BackupIncludeResourcesBox"
                                          Content="资源目录（resources）" IsChecked="True"
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="BackupIncludeNotesBox"
                                          Content="速记" IsChecked="True"
                                          Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="动作（actions）、全局子动作（subactions）、配置（configs）、宏（macros）、跨动作状态（state）与 AI 暂存区草稿（staging）始终包含，无需勾选；AI 访问令牌不在备份里。"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="导出…"
                                            MinWidth="104" Click="BackupExport_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="导入" Margin="0,12,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                           Text="导入会整体替换备份里包含的内容（动作、全局子动作、配置、宏、暂存区草稿、状态，以及导出时勾选的目录），旧数据自动备份为 .bak-时间戳。备份含可执行文件，导入后可能以管理员权限执行——仅导入来源可信的备份。"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="导入…"
                                            MinWidth="104" Click="BackupImport_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="BackupStatusText" Style="{StaticResource HintLabel}"
                                   Text="" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,9">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="StatusText" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="重新加载"
                        Click="Reload_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
