<Window x:Class="LTools.Views.ConfigHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="设置" Width="980" Height="620"
        MinWidth="820" MinHeight="500"
        ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 导航项：整行可点、悬停浅灰、选中强调 -->
        <Style x:Key="NavRow" TargetType="RadioButton">
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedBgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- 二级导航项（面板管理下拉）：缩进 + 细竖线，选中实底 -->
        <Style x:Key="SubNavRow" TargetType="RadioButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="8,0" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片容器 -->
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左导航 -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0">
                    <StackPanel x:Name="NavList" Margin="0,8">
                        <RadioButton Style="{StaticResource NavRow}" Content="通用"
                                     Checked="Nav_Changed" Tag="general"/>
                        <RadioButton x:Name="NavActions" Style="{StaticResource NavRow}" Content="动作管理"
                                     Checked="Nav_Changed" Tag="actions"/>
                        <RadioButton Style="{StaticResource NavRow}" Content="子动作库"
                                     Checked="Nav_Changed" Tag="subactions"/>
                        <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavRow}" Content="快捷键"
                                     Checked="Nav_Changed" Tag="hotkeys"/>
                        <!-- 面板管理：点它进「常规」主页面，并在下方展开二级下拉导航 -->
                        <RadioButton x:Name="NavSuperPanel" Style="{StaticResource NavRow}"
                                     Checked="Nav_Changed" Tag="superpanel"
                                     PreviewMouseLeftButtonUp="NavSuperPanel_MouseUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="面板管理" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavSuperPanelChevron" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Margin="6,1,0,0" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Foreground="{StaticResource HintTextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <Border x:Name="SuperPanelSubNavHost" Visibility="Collapsed" ClipToBounds="True"
                                Margin="22,0,0,6" Padding="6,2,0,2"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0">
                            <StackPanel x:Name="SuperPanelSubNav">
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav"
                                             Content="常规" Checked="Nav_Changed" Tag="superpanel-general"/>
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav"
                                             Content="场景" Checked="Nav_Changed" Tag="superpanel-scenes"/>
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav"
                                             Content="禁止弹出" Checked="Nav_Changed" Tag="superpanel-blocked"/>
                            </StackPanel>
                        </Border>
                        <RadioButton Style="{StaticResource NavRow}" Content="终端路径"
                                     Checked="Nav_Changed" Tag="terminals"/>
                        <RadioButton Style="{StaticResource NavRow}" Content="运行日志"
                                     Checked="Nav_Changed" Tag="logs"/>
                        <RadioButton x:Name="NavAi" Style="{StaticResource NavRow}"
                                     Checked="Nav_Changed" Tag="ai"
                                     PreviewMouseLeftButtonUp="NavAi_MouseUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AI 接入" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavAiChevron" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Margin="6,1,0,0" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Foreground="{StaticResource HintTextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <Border x:Name="AiSubNavHost" Visibility="Collapsed" ClipToBounds="True"
                                Margin="22,0,0,6" Padding="6,2,0,2"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0">
                            <StackPanel x:Name="AiSubNav">
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav-ai"
                                             Content="连接" Checked="Nav_Changed" Tag="ai-connect"/>
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav-ai"
                                             Content="审计" Checked="Nav_Changed" Tag="ai-audit"/>
                            </StackPanel>
                        </Border>
                        <RadioButton Style="{StaticResource NavRow}" Content="备份与恢复"
                                     Checked="Nav_Changed" Tag="backup"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右内容：所有页面同层，按导航切换可见性 -->
            <Grid Grid.Column="1">
                <!-- ============ 通用 ============ -->
                <ScrollViewer x:Name="Page_General" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="工具开关" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="CapsLockEnabledBox" Content="启用 CapsLock 键功能"
                                          Checked="CapsLockEnabledBox_Changed" Unchecked="CapsLockEnabledBox_Changed"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="22,4,0,12"
                                           Text="CapsLock 作为修饰键：轻按发 Esc，按住即可配合其它键（CapsLock+字母 等）触发「快捷键」页里配好的动作。关闭后 CapsLock 恢复原生大小写切换，带 CapsLock 前缀的快捷键也随之停用。"
                                           TextWrapping="Wrap"/>
                                <CheckBox x:Name="SuperPanelEnabledBox" Content="启用超级面板"
                                          Checked="SuperPanelEnabledBox_Changed" Unchecked="SuperPanelEnabledBox_Changed"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="22,4,0,0"
                                           Text="按住右键（长按）唤起 4×4 动作面板。与上面的 CapsLock 开关相互独立。"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="开机自启" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartBox" Content="开机自动启动（任务计划，静默提权）"
                                          Checked="AutoStartBox_Changed" Unchecked="AutoStartBox_Changed"/>
                                <TextBlock x:Name="AutoStartHint" Style="{StaticResource HintLabel}" Margin="22,4,0,0"
                                           Text="通过任务计划程序创建 ONLOGON / 最高权限任务，开机无 UAC 弹窗。"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="AutoStartFixButton" Style="{StaticResource Btn}" Content="改为当前程序"
                                        Margin="22,8,0,2" HorizontalAlignment="Left" Padding="12,4"
                                        Visibility="Collapsed" Click="AutoStartFix_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="运行提示" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="动作结束后" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="RunNoticeCombo" MinHeight="32"
                                              SelectionChanged="RunNotice_Changed">
                                        <ComboBoxItem Content="不提示（只看日志）"/>
                                        <ComboBoxItem Content="只在失败时（推荐）"/>
                                        <ComboBoxItem Content="成功也提示"/>
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="默认提示位置" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="ToastPositionCombo" MinHeight="32"
                                              SelectionChanged="RunNotice_Changed">
                                        <ComboBoxItem Content="右下（推荐）"/>
                                        <ComboBoxItem Content="左下"/>
                                        <ComboBoxItem Content="底部居中"/>
                                        <ComboBoxItem Content="右上"/>
                                        <ComboBoxItem Content="左上"/>
                                        <ComboBoxItem Content="顶部居中"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="120,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="失败提示常驻（点一下关，下一次运行自动替换），标题带「第 3 行 › 否则 › 第 1 行」这样的位置；按停止也会给一条。成功提示 2.5 秒后自动消失。「提示弹窗」步骤里位置选「跟随设置」时用这里的落点。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 动作管理 ============ -->
                <Grid x:Name="Page_Actions" Visibility="Collapsed" Margin="20,14,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ActionFilterBox" Width="260" MinHeight="30"
                                 HorizontalAlignment="Left"
                                 ToolTip="按动作名称 / 类型筛选"
                                 TextChanged="ActionFilter_TextChanged"/>
                        <TextBlock Grid.Column="1" x:Name="ActionCountText" Style="{StaticResource HintLabel}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" x:Name="OpenStagingButton" Style="{StaticResource BtnGhost}"
                                Content="暂存区" MinWidth="0" Height="28" Padding="10,2" FontSize="12"
                                Margin="12,0,0,0" ToolTip="AI 写出来的动作草稿都在那里"
                                Click="OpenStagingPage_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="ActionList"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow"
                              MouseDoubleClick="ActionList_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="动作" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 单行：名称（深色）+ 摘要（浅色小字）同行，行高沿用 30 不裁切 -->
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto" MaxWidth="240"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Name}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Margin="8,0,0,0"
                                                       Style="{StaticResource HintLabel}"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Summary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="110"/>
                            <DataGridTemplateColumn Header="引用位置" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding References}" ToolTip="{Binding References}"
                                                   TextTrimming="CharacterEllipsis" Margin="2,0"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Content="新建动作…" MinWidth="104"
                                Click="NewAction_Click"/>
                        <Button Style="{StaticResource BtnGhost}" Content="编辑" MinWidth="64"
                                Margin="8,0,0,0" Click="EditAction_Click"/>
                        <Button Style="{StaticResource BtnGhost}" Content="复制" MinWidth="64"
                                Margin="6,0,0,0" Click="DuplicateAction_Click"/>
                        <Button Style="{StaticResource BtnGhostDanger}" Content="删除" MinWidth="64"
                                Margin="6,0,0,0" Click="DeleteAction_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ============ 快捷键 ============ -->
                <controls:HotkeysView x:Name="Page_Hotkeys" Visibility="Collapsed"/>

                <!-- ============ 子动作库 ============ -->
                <controls:SubActionLibraryView x:Name="Page_SubActions" Visibility="Collapsed"/>

                <!-- ============ 面板管理 ============ -->
                <controls:PanelManageView x:Name="Page_SuperPanel" Visibility="Collapsed"/>

                <!-- ============ 终端路径 ============ -->
                <ScrollViewer x:Name="Page_Terminals" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="终端探测状态" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <DataGrid x:Name="PathsGrid" Height="180"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="终端" Binding="{Binding Label}" Width="140"/>
                                    <DataGridTextColumn Header="解析路径" Binding="{Binding Path}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="Git Bash 路径覆盖" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="GitBashBox" MinHeight="30" Margin="0,0,8,0"
                                         ToolTip="留空则自动探测常见安装位置"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…"
                                        MinWidth="72" Margin="0,0,8,0" Click="BrowseGitBash_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="保存"
                                        MinWidth="72" Click="SaveGitBash_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 运行日志 ============ -->
                <ScrollViewer x:Name="Page_Logs" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="运行日志" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="LogEnabledBox" Content="记录运行日志"
                                          Checked="LogOption_Changed" Unchecked="LogOption_Changed"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="22,4,0,12"
                                           TextWrapping="Wrap"
                                           Text="记录启动与环境、动作与流程执行、取值结果、设置变更和异常。日志按天写入数据根下的 logs 文件夹，只保存在本机，不会上传。"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="记录级别" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LogLevelCombo" MinHeight="32"
                                              SelectionChanged="LogOption_Changed">
                                        <ComboBoxItem Content="仅错误"/>
                                        <ComboBoxItem Content="常规（推荐）"/>
                                        <ComboBoxItem Content="详细（含变量值）"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="LogLevelHint" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap" Margin="120,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="保留时间" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LogRetentionCombo" MinHeight="32"
                                              SelectionChanged="LogOption_Changed">
                                        <ComboBoxItem Content="3 天"/>
                                        <ComboBoxItem Content="7 天"/>
                                        <ComboBoxItem Content="14 天"/>
                                        <ComboBoxItem Content="30 天"/>
                                        <ComboBoxItem Content="不自动清理"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="日志文件" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock x:Name="LogPathText" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="LogStatusText" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="打开日志文件夹"
                                            MinWidth="120" Click="OpenLogFolder_Click"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="打开今天的日志"
                                            MinWidth="120" Margin="8,0,0,0" Click="OpenTodayLog_Click"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="复制文件夹路径"
                                            MinWidth="120" Margin="8,0,0,0" Click="CopyLogPath_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ AI 接入 ============ -->
                <controls:AiView x:Name="Page_Ai" Visibility="Collapsed"/>

                <!-- ============ 备份与恢复 ============ -->
                <ScrollViewer x:Name="Page_Backup" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="导出" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="BackupIncludeResourcesBox"
                                          Content="资源目录（resources）" IsChecked="True"
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="BackupIncludeNotesBox"
                                          Content="速记" IsChecked="True"
                                          Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="配置（LTools.json）、宏（macros）与 AI 暂存区草稿（staging）始终包含；AI 访问令牌不在备份里。"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="导出…"
                                            MinWidth="104" Click="BackupExport_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="导入" Margin="0,12,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                           Text="导入会整体替换当前配置与所选目录（旧数据自动备份为 .bak-时间戳）。备份含可执行文件，导入后可能以管理员权限执行——仅导入来源可信的备份。"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="导入…"
                                            MinWidth="104" Click="BackupImport_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="BackupStatusText" Style="{StaticResource HintLabel}"
                                   Text="" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,9">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="StatusText" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="重新加载"
                        Click="Reload_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
