                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="模型档" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="OcrModelCombo" MinHeight="32"
