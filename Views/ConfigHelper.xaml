<Window x:Class="LTools.Views.ConfigHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="设置" Width="980" Height="620"
        MinWidth="820" MinHeight="500"
        ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Main">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 导航项：整行可点、行内缩成圆角块（悬停浅灰、选中最深）。
             侧栏底是 SurfaceAlt(#F4F4F5)，所以用 NavHover / NavSelected 两组专用色，
             别套全局 HoverBg / SelectedBg——它们与侧栏底同色，看不出反馈。 -->
        <Style x:Key="NavRow" TargetType="RadioButton">
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Margin="6,1" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBgBrush}"/>
                            </Trigger>
                            <!-- 选中放在悬停之后：同一行既悬停又选中时，选中的色更深，优先级由此决定 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelectedBgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- 二级导航项（面板管理下拉）：缩进 + 细竖线。选中与父项同一个灰底 (#E4E4E7)，
             靠左侧 3px 近黑竖条标「当前页」——别改回白底：白块在灰侧栏上比父项还亮，上下级倒挂。 -->
        <Style x:Key="SubNavRow" TargetType="RadioButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource CornerMd}" Margin="0,1">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="2" Margin="0,5"
                                        HorizontalAlignment="Left" Background="{StaticResource TextBrush}"
                                        Visibility="Collapsed"/>
                                <!-- 左边距 20 = 3px 竖条 + 间隙：竖条贴块左缘，文字别压在它上面 -->
                                <ContentPresenter Margin="20,0,9,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelectedBgBrush}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片容器 -->
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左导航 -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0">
                    <StackPanel x:Name="NavList" Margin="0,8">
                        <RadioButton Style="{StaticResource NavRow}" Content="通用"
                                     Checked="Nav_Changed" Tag="general"/>
                        <RadioButton x:Name="NavActions" Style="{StaticResource NavRow}" Content="动作管理"
                                     Checked="Nav_Changed" Tag="actions"/>
                        <RadioButton Style="{StaticResource NavRow}" Content="子动作库"
                                     Checked="Nav_Changed" Tag="subactions"/>
                        <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavRow}" Content="快捷键"
                                     Checked="Nav_Changed" Tag="hotkeys"/>
                        <!-- 键鼠宏：第四个带二级下拉的父项（录制的宏 / 设置），与面板管理 / AI / 日志共用一套机制 -->
                        <RadioButton x:Name="NavMacros" Style="{StaticResource NavRow}"
                                     Checked="Nav_Changed" Tag="macros"
                                     PreviewMouseLeftButtonUp="NavMacros_MouseUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="键鼠宏" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavMacrosChevron" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Margin="6,1,0,0" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Foreground="{StaticResource HintTextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <Border x:Name="MacrosSubNavHost" Visibility="Collapsed" ClipToBounds="True"
                                Margin="22,0,0,6" Padding="6,2,0,2"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0">
                            <StackPanel x:Name="MacrosSubNav">
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav-macros"
                                             Content="录制的宏" Checked="Nav_Changed" Tag="macros-list"/>
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav-macros"
                                             Content="设置" Checked="Nav_Changed" Tag="macros-settings"/>
                            </StackPanel>
                        </Border>
                        <RadioButton Style="{StaticResource NavRow}" Content="自动触发"
                                     Checked="Nav_Changed" Tag="triggers"/>
                        <!-- 面板管理：点它进「常规」主页面，并在下方展开二级下拉导航 -->
                        <RadioButton x:Name="NavSuperPanel" Style="{StaticResource NavRow}"
                                     Checked="Nav_Changed" Tag="superpanel"
                                     PreviewMouseLeftButtonUp="NavSuperPanel_MouseUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="面板管理" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavSuperPanelChevron" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Margin="6,1,0,0" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Foreground="{StaticResource HintTextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <Border x:Name="SuperPanelSubNavHost" Visibility="Collapsed" ClipToBounds="True"
                                Margin="22,0,0,6" Padding="6,2,0,2"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0">
                            <StackPanel x:Name="SuperPanelSubNav">
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav"
                                             Content="常规" Checked="Nav_Changed" Tag="superpanel-general"/>
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav"
                                             Content="场景" Checked="Nav_Changed" Tag="superpanel-scenes"/>
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav"
                                             Content="禁止弹出" Checked="Nav_Changed" Tag="superpanel-blocked"/>
                            </StackPanel>
                        </Border>
                        <RadioButton Style="{StaticResource NavRow}" Content="终端路径"
                                     Checked="Nav_Changed" Tag="terminals"/>
                        <!-- 运行日志：第三个带二级下拉的父项（设置 / 最近日志），
                             与面板管理 / AI 接入共用 NavFamilyOf / SyncNavGroup / AnimateSubNav 一套机制 -->
                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavRow}"
                                     Checked="Nav_Changed" Tag="logs"
                                     PreviewMouseLeftButtonUp="NavLogs_MouseUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="运行日志" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLogsChevron" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Margin="6,1,0,0" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Foreground="{StaticResource HintTextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <Border x:Name="LogsSubNavHost" Visibility="Collapsed" ClipToBounds="True"
                                Margin="22,0,0,6" Padding="6,2,0,2"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0">
                            <StackPanel x:Name="LogsSubNav">
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav-logs"
                                             Content="设置" Checked="Nav_Changed" Tag="logs-settings"/>
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav-logs"
                                             Content="最近日志" Checked="Nav_Changed" Tag="logs-recent"/>
                            </StackPanel>
                        </Border>
                        <RadioButton x:Name="NavAi" Style="{StaticResource NavRow}"
                                     Checked="Nav_Changed" Tag="ai"
                                     PreviewMouseLeftButtonUp="NavAi_MouseUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AI 接入" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavAiChevron" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Margin="6,1,0,0" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Foreground="{StaticResource HintTextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <Border x:Name="AiSubNavHost" Visibility="Collapsed" ClipToBounds="True"
                                Margin="22,0,0,6" Padding="6,2,0,2"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0">
                            <StackPanel x:Name="AiSubNav">
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav-ai"
                                             Content="连接" Checked="Nav_Changed" Tag="ai-connect"/>
                                <RadioButton Style="{StaticResource SubNavRow}" GroupName="subnav-ai"
                                             Content="审计" Checked="Nav_Changed" Tag="ai-audit"/>
                            </StackPanel>
                        </Border>
                        <RadioButton Style="{StaticResource NavRow}" Content="备份与恢复"
                                     Checked="Nav_Changed" Tag="backup"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右内容：所有页面同层，按导航切换可见性 -->
            <Grid Grid.Column="1">
                <!-- ============ 通用 ============ -->
                <ScrollViewer x:Name="Page_General" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="工具开关" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="CapsLockModifierBox" Content="CapsLock 可作为快捷键修饰键"
                                          Checked="CapsLockModifierBox_Changed" Unchecked="CapsLockModifierBox_Changed"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="22,4,0,12"
                                           Text="按住 CapsLock 配合其它键（CapsLock+字母 等）触发「快捷键」页里配好的动作，轻按发 Esc，灯保持关闭（Ctrl+CapsLock 可手动开关大写锁定）。关闭后 CapsLock 恢复原生大小写切换，带 CapsLock 前缀的绑定也随之不触发。"
                                           TextWrapping="Wrap"/>
                                <CheckBox x:Name="EdgeWheelVolumeBox" Content="屏幕边缘滚轮调音量"
                                          Checked="EdgeWheelVolumeBox_Changed" Unchecked="EdgeWheelVolumeBox_Changed"/>
                                <Grid x:Name="EdgeWheelEdgeRow" Margin="22,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="算哪条边" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="EdgeWheelEdgeCombo" MinHeight="32"
                                              SelectionChanged="EdgeWheelEdge_Changed">
                                        <ComboBoxItem Content="屏幕底部"/>
                                        <ComboBoxItem Content="屏幕顶部"/>
                                        <ComboBoxItem Content="上下都算"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="EdgeWheelVolumeHint" Style="{StaticResource HintLabel}"
                                           Margin="22,6,0,0" TextWrapping="Wrap"
                                           Text="鼠标停在光标所在显示器边缘 8px 内滚动滚轮 → 系统音量 ±1 档；其它位置的滚轮不受影响。多显示器只认光标所在的那块屏。"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="开机自启" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartBox" Content="开机自动启动（任务计划，静默提权）"
                                          Checked="AutoStartBox_Changed" Unchecked="AutoStartBox_Changed"/>
                                <TextBlock x:Name="AutoStartHint" Style="{StaticResource HintLabel}" Margin="22,4,0,0"
                                           Text="通过任务计划程序创建 ONLOGON / 最高权限任务，开机无 UAC 弹窗。"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="AutoStartFixButton" Style="{StaticResource Btn}" Content="改为当前程序"
                                        Margin="22,8,0,2" HorizontalAlignment="Left" Padding="12,4"
                                        Visibility="Collapsed" Click="AutoStartFix_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="运行提示" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="动作结束后" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="RunNoticeCombo" MinHeight="32"
                                              SelectionChanged="RunNotice_Changed">
                                        <ComboBoxItem Content="不提示（只看日志）"/>
                                        <ComboBoxItem Content="只在失败时（推荐）"/>
                                        <ComboBoxItem Content="成功也提示"/>
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="默认提示位置" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="ToastPositionCombo" MinHeight="32"
                                              SelectionChanged="RunNotice_Changed">
                                        <ComboBoxItem Content="右下（推荐）"/>
                                        <ComboBoxItem Content="左下"/>
                                        <ComboBoxItem Content="底部居中"/>
                                        <ComboBoxItem Content="右上"/>
                                        <ComboBoxItem Content="左上"/>
                                        <ComboBoxItem Content="顶部居中"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="120,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="失败提示常驻（点一下关，下一次运行自动替换），标题带「第 3 行 › 否则 › 第 1 行」这样的位置；按停止也会给一条。成功提示 2.5 秒后自动消失。「提示弹窗」步骤里位置选「跟随设置」时用这里的落点。"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="托盘图标" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="左键双击" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="TrayDoubleClickCombo" MinHeight="32"
                                              SelectionChanged="TrayDoubleClick_Changed"
                                              ToolTip="左键双击托盘图标时打开设置窗口并停到所选页面">
                                        <ComboBoxItem Content="打开设置"/>
                                        <ComboBoxItem Content="打开动作管理"/>
                                        <ComboBoxItem Content="打开快捷键"/>
                                        <ComboBoxItem Content="打开键鼠宏"/>
                                        <ComboBoxItem Content="打开自动触发"/>
                                        <ComboBoxItem Content="打开面板管理"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="120,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="「打开设置」停在上次看的页面，其余直接跳到对应页面；「打开面板管理」停在该分组上次停留的子页。右键单击仍是托盘菜单。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 动作管理 ============ -->
                <Grid x:Name="Page_Actions" Visibility="Collapsed" Margin="20,14,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ActionFilterBox" Width="240" MinHeight="30"
                                 HorizontalAlignment="Left"
                                 ToolTip="按动作名称 / 类型 / 步骤筛选"
                                 controls:TextBoxPlaceholder.Text="搜索动作名称、类型或步骤…"
                                 TextChanged="ActionFilter_TextChanged"/>
                        <!-- 引用位置：选项由 ActionReferenceIndex.Options() 填，按场景·分组 / 快捷键 / 悬浮项 / 触发规则收窄 -->
                        <ComboBox Grid.Column="1" x:Name="ActionRefFilterCombo" Width="180" MinHeight="30"
                                  Margin="8,0,0,0" HorizontalAlignment="Left"
                                  ToolTip="按引用位置筛选（面板场景 / 快捷键 / 悬浮项 / 触发规则）"
                                  DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectionChanged="ActionRefFilter_SelectionChanged"/>
                        <TextBlock Grid.Column="2" x:Name="ActionCountText" Style="{StaticResource HintLabel}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button Grid.Column="3" x:Name="OpenStagingButton" Style="{StaticResource BtnGhost}"
                                Content="暂存区" MinWidth="0" Height="28" Padding="10,2" FontSize="12"
                                Margin="12,0,0,0" ToolTip="AI 写出来的动作草稿都在那里"
                                Click="OpenStagingPage_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="ActionList"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="ActionList_PreviewMouseLeftButtonDown"
                              MouseDoubleClick="ActionList_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="动作" Width="1.6*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 单行：名称（深色）+ 摘要（浅色小字）同行，行高沿用 30 不裁切 -->
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto" MaxWidth="240"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Name}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Margin="8,0,0,0"
                                                       Style="{StaticResource HintLabel}"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Summary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="110" MinWidth="90"/>
                            <DataGridTemplateColumn Header="引用位置" Width="1.2*" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding References}" ToolTip="{Binding References}"
                                                   TextTrimming="CharacterEllipsis" Margin="2,0"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 操作列：照 TriggersView 的常驻小图标（CommandParameter 分发、不用 Tag——
                                 BtnGhost 把 Tag 当悬停色）。双击整行也能编辑。
                                 ActionList_PreviewMouseLeftButtonDown 先给 cell 焦点，否则第一次点图标
                                 会被 DataGridCell 吞掉（HotkeysView 踩过）。 -->
                            <DataGridTemplateColumn Header="操作" Width="96" MinWidth="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✎" CommandParameter="edit" Style="{StaticResource BtnGhost}"
                                                    Width="24" Height="24" Padding="0" FontSize="14"
                                                    FontFamily="Segoe UI Symbol" Focusable="False"
                                                    ToolTip="编辑这个动作" Click="ActionRowAction_Click"/>
                                            <Button Content="⧉" CommandParameter="copy" Style="{StaticResource BtnGhost}"
                                                    Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14"
                                                    FontFamily="Segoe UI Symbol" Focusable="False"
                                                    ToolTip="复制这个动作" Click="ActionRowAction_Click"/>
                                            <Button Content="✕" CommandParameter="delete" Style="{StaticResource BtnGhostDanger}"
                                                    Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14"
                                                    FontFamily="Segoe UI Symbol" Focusable="False"
                                                    ToolTip="删除这个动作" Click="ActionRowAction_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Content="新建动作…" MinWidth="104"
                                Click="NewAction_Click"/>
                        <TextBlock Style="{StaticResource HintLabel}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Text="双击一行也能编辑；行右侧是编辑 / 复制 / 删除。"/>
                    </StackPanel>
                </Grid>

                <!-- ============ 惰性页 ============
                     6 个重量级 UserControl 不再在 InitializeComponent() 里一次性建出来：
                     这里只放空的 ContentControl 宿主，窗口首次切到该页时才由 code-behind 的
                     Page_* 惰性属性 new 出视图、塞进 Host.Content。低级鼠标钩子与 WPF 共用
                     UI 线程，一次建 6 棵可视树会让「从超级面板打开设置」顿一下。
                     可见性设在宿主上（不触发创建）；数据/方法走 Page_*（触发创建）。
                     Page_General / Page_Actions / Page_Terminals / Page_Logs* / Page_Backup
                     是内联的轻量 ScrollViewer / Grid，保持现状。 -->

                <!-- ============ 快捷键 ============ -->
                <ContentControl x:Name="Host_Hotkeys" Visibility="Collapsed"/>

                <!-- ============ 键鼠宏 ============ -->
                <ContentControl x:Name="Host_Macros" Visibility="Collapsed"/>

                <!-- ============ 子动作库 ============ -->
                <ContentControl x:Name="Host_SubActions" Visibility="Collapsed"/>

                <!-- ============ 面板管理 ============ -->
                <ContentControl x:Name="Host_SuperPanel" Visibility="Collapsed"/>

                <!-- ============ 终端路径 ============ -->
                <ScrollViewer x:Name="Page_Terminals" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="终端路径" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource HintLabel}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="「运行命令」选终端时按这里的路径启动。「实际路径」是现在生效的那个；某一行找不到、或想用另一份副本（便携版 / 非默认目录），就在「覆盖」里填它的 exe——留空 = 继续自动探测，改完离开输入框即保存；填了但文件不存在会在「实际路径」里标出来并回退到自动探测。"/>
                        <Border Style="{StaticResource CardBox}">
                            <DataGrid x:Name="PathsGrid" Height="220"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      PreviewMouseLeftButtonDown="PathsGrid_PreviewMouseLeftButtonDown"
                                      PreviewMouseWheel="PathsGrid_PreviewMouseWheel"
                                      MouseDoubleClick="PathsGrid_MouseDoubleClick"
                                      ToolTip="双击一行直接编辑「覆盖」路径">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="终端" Binding="{Binding Label}" Width="140" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="实际路径" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Path}" Margin="2,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" ToolTipService.ShowDuration="20000"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="覆盖" Width="240">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Override, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="24" Margin="0,2" VerticalContentAlignment="Center"
                                                         ToolTip="留空 = 自动探测；填 exe 路径则优先用它（文件存在才算）"
                                                         LostFocus="TerminalOverride_LostFocus"
                                                         KeyDown="TerminalOverride_KeyDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BtnGhost}" Content="浏览…"
                                                        MinWidth="64" Margin="6,2,0,2" Click="BrowseTerminal_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 运行日志 → 设置（二级子页） ============ -->
                <ScrollViewer x:Name="Page_LogsSettings" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="运行日志 · 设置" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="LogEnabledBox" Content="记录运行日志"
                                          Checked="LogOption_Changed" Unchecked="LogOption_Changed"/>
                                <TextBlock Style="{StaticResource HintLabel}" Margin="22,4,0,12"
                                           TextWrapping="Wrap"
                                           Text="记录启动与环境、动作与流程执行、取值结果、设置变更和异常。日志按天写入数据根下的 logs 文件夹，只保存在本机，不会上传。"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="记录级别" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LogLevelCombo" MinHeight="32"
                                              SelectionChanged="LogOption_Changed">
                                        <ComboBoxItem Content="仅错误"/>
                                        <ComboBoxItem Content="常规（推荐）"/>
                                        <ComboBoxItem Content="详细（含变量值）"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="LogLevelHint" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap" Margin="120,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                               Text="保留时间" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LogRetentionCombo" MinHeight="32"
                                              SelectionChanged="LogOption_Changed">
                                        <ComboBoxItem Content="3 天"/>
                                        <ComboBoxItem Content="7 天"/>
                                        <ComboBoxItem Content="14 天"/>
                                        <ComboBoxItem Content="30 天"/>
                                        <ComboBoxItem Content="不自动清理"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="日志文件" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock x:Name="LogPathText" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="LogStatusText" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="打开日志文件夹"
                                            MinWidth="120" Click="OpenLogFolder_Click"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="打开今天的日志"
                                            MinWidth="120" Margin="8,0,0,0" Click="OpenTodayLog_Click"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="复制文件夹路径"
                                            MinWidth="120" Margin="8,0,0,0" Click="CopyLogPath_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 运行日志 → 最近日志（二级子页） ============ -->
                <!-- 单独成页后日志框用 * 行撑满可用高度（不再挤在设置页底部固定 260）。
                     默认自动贴底：向上滚动取消、滚到底恢复；⤓ 按钮一键回底。见 ConfigHelper.Logs.cs。 -->
                <Grid x:Name="Page_LogsRecent" Visibility="Collapsed" Margin="20,14,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                   Text="运行日志 · 最近日志" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="AutoScrollBtn" Style="{StaticResource BtnGhost}"
                                Content="⤓ 自动贴底" MinWidth="110" Click="AutoScrollBtn_Click"
                                ToolTip="默认自动贴底；向上滚动会暂停，滚到底自动恢复。点它回到最新并恢复贴底。"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardBox}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="LogPreviewLevelCombo" Width="104" MinHeight="30"
                                          SelectedIndex="0"
                                          ToolTip="只看某一级别" SelectionChanged="LogPreview_Changed">
                                    <ComboBoxItem Content="全部"/>
                                    <ComboBoxItem Content="错误"/>
                                    <ComboBoxItem Content="警告"/>
                                    <ComboBoxItem Content="信息"/>
                                    <ComboBoxItem Content="调试"/>
                                </ComboBox>
                                <TextBox Grid.Column="1" x:Name="LogPreviewSearchBox" MinHeight="30" Margin="8,0"
                                         ToolTip="按文本过滤（包含匹配，忽略大小写）"
                                         controls:TextBoxPlaceholder.Text="过滤日志文本…"
                                         TextChanged="LogPreview_Changed"/>
                                <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="刷新"
                                        MinWidth="60" Margin="0,0,8,0" Click="LogPreviewRefresh_Click"/>
                                <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="打开失败报告"
                                        MinWidth="104" Margin="0,0,8,0" Click="OpenFailureReport_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="复制诊断信息"
                                        MinWidth="104" Click="CopyDiagnostics_Click"/>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="LogPreviewBox" Margin="0,10,0,0" MinHeight="240"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     ScrollViewer.ScrollChanged="LogPreview_ScrollChanged"
                                     FontFamily="Consolas" FontSize="{StaticResource FontSizeSecondary}"
                                     ToolTip="今天的运行日志；只读。默认自动贴底，向上滚动暂停，滚到底恢复"/>
                            <TextBlock Grid.Row="2" x:Name="LogPreviewHint" Style="{StaticResource HintLabel}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ 自动触发 ============ -->
                <ContentControl x:Name="Host_Triggers" Visibility="Collapsed"/>

                <!-- ============ AI 接入 ============ -->
                <ContentControl x:Name="Host_Ai" Visibility="Collapsed"/>

                <!-- ============ 备份与恢复 ============ -->
                <ScrollViewer x:Name="Page_Backup" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Padding="20,14,20,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="导出" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="BackupIncludeResourcesBox"
                                          Content="资源目录（resources）" IsChecked="True"
                                          Margin="0,0,0,6"/>
                                <CheckBox x:Name="BackupIncludeNotesBox"
                                          Content="速记" IsChecked="True"
                                          Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="动作（actions）、全局子动作（subactions）、配置（configs）、宏（macros）、跨动作状态（state）与 AI 暂存区草稿（staging）始终包含，无需勾选；AI 访问令牌不在备份里。"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="导出…"
                                            MinWidth="104" Click="BackupExport_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="导入" Margin="0,12,0,8"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                           Text="导入会整体替换备份里包含的内容（动作、全局子动作、配置、宏、暂存区草稿、状态，以及导出时勾选的目录），旧数据自动备份为 .bak-时间戳。备份含可执行文件，导入后可能以管理员权限执行——仅导入来源可信的备份。"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="导入…"
                                            MinWidth="104" Click="BackupImport_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="BackupStatusText" Style="{StaticResource HintLabel}"
                                   Text="" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,9">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="StatusText" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="重新加载"
                        Click="Reload_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
