<Window x:Class="LTools.Views.FeatureParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LTools.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="功能参数" Width="440" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        views:WindowSizing.Mode="Dialog">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <controls:DialogShell>
        <controls:DialogShell.Footer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,16">
                <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="74"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="74"
                        Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </controls:DialogShell.Footer>

        <StackPanel Margin="20,12,20,16">
            <TextBlock x:Name="Headline" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FormHost"/>
            </ScrollViewer>
        </StackPanel>
    </controls:DialogShell>
</Window>
