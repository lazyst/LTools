<Window x:Class="CapsLockPro.Views.ActionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CapsLockPro.Views.Controls"
        Title="动作" Width="720" Height="560"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False"/>

        <!-- 主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 名称 + 类型 -->
                    <RowDefinition Height="Auto"/>   <!-- 类型特定字段 -->
                    <RowDefinition Height="Auto"/>   <!-- 图标 -->
                </Grid.RowDefinitions>

                <!-- 名称 + 类型 -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="名称" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" x:Name="NameBox" MinHeight="32"/>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="类型" Margin="0,0,0,4"/>
                        <ComboBox Grid.Row="1" x:Name="TypeCombo" MinHeight="32" SelectionChanged="TypeCombo_SelectionChanged"/>
                    </Grid>
                </Grid>

                <!-- 类型特定字段：同层叠加，按类型切换可见性 -->
                <StackPanel Grid.Row="1" x:Name="FieldsPanel" Margin="0,0,0,14">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12"
                            MinHeight="120">

                        <Grid>
                            <!-- launchApp -->
                            <StackPanel x:Name="F_LaunchApp">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="程序路径" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TargetBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72" Click="BrowseTarget_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="参数（可选）" Margin="0,0,0,4"/>
                                <TextBox x:Name="ArgsBox" MinHeight="30" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="工作目录（可选）" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="LaunchWorkdirBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72"
                                            Click="BrowseLaunchWorkdir_Click" ToolTip="用文件资源管理器选择工作目录"/>
                                </Grid>
                            </StackPanel>

                            <!-- openFile -->
                            <StackPanel x:Name="F_OpenFile">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="文件路径" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="FileBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72" Click="BrowseFile_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- openFolder -->
                            <StackPanel x:Name="F_OpenFolder">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="文件夹路径" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="FolderBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72" Click="BrowseFolder_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- openUrl -->
                            <StackPanel x:Name="F_OpenUrl">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="网址" Margin="0,0,0,4"/>
                                <TextBox x:Name="UrlBox" MinHeight="30"/>
                            </StackPanel>

                            <!-- runCommand -->
                            <StackPanel x:Name="F_RunCommand">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="命令" Margin="0,0,0,4"/>
                                <TextBox x:Name="CmdBox" MinHeight="30" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="终端" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TerminalCombo" MinHeight="30"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="KeepWindowBox" Content="保持窗口"
                                              VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </Grid>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="工作目录（可选）" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="CmdWorkdirBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72"
                                            Click="BrowseCmdWorkdir_Click" ToolTip="用文件资源管理器选择工作目录"/>
                                </Grid>
                            </StackPanel>

                            <!-- sendText -->
                            <StackPanel x:Name="F_SendText">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="要发送的文本" Margin="0,0,0,4"/>
                                <TextBox x:Name="SendTextBox" MinHeight="96" MaxHeight="200"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="发送方式" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SendModeCombo" MinHeight="30">
                                            <ComboBoxItem Content="自动（Unicode 注入：不受输入法影响，不碰剪贴板）" Tag="auto"/>
                                            <ComboBoxItem Content="始终键入（真实按键，受输入法影响；仅布局可映射字符）" Tag="type"/>
                                            <ComboBoxItem Content="始终剪贴板粘贴（临时覆盖，150ms 后恢复原内容）" Tag="paste"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="AppendEnterBox" Content="末尾添加回车"
                                              VerticalAlignment="Bottom" Margin="0,0,0,4"
                                              ToolTip="发送完文本后再发一次回车（聊天软件中用于直接发出）"/>
                                </Grid>
                            </StackPanel>

                            <!-- sendKeys（模拟按键） -->
                            <StackPanel x:Name="F_SendKeys">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="输入序列" Margin="0,0,0,4"/>
                                <TextBlock Text="录制：按下快捷键自动记录，空闲 800ms 成条；Esc 停止。"
                                           Foreground="{StaticResource HintTextBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="RecordBtn" Style="{StaticResource BtnGhost}"
                                            Content="● 开始录制" MinWidth="100" MinHeight="30" Margin="0,0,6,0"
                                            Click="Record_Click"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="＋ 组合键"
                                            MinHeight="30" Margin="0,0,6,0" Click="AddChord_Click"/>
                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="＋ 文本"
                                            MinHeight="30" Margin="0,0,6,0" Click="AddText_Click"/>
                                    <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="＋ 延时"
                                            MinHeight="30" Click="AddSleep_Click"/>
                                    <TextBlock Grid.Column="4" x:Name="RecordHint" VerticalAlignment="Center"
                                               Margin="12,0,0,0" Foreground="{StaticResource HintTextBrush}"
                                               FontSize="11" Text=""/>
                                </Grid>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                        MinHeight="80" MaxHeight="180">
                                    <ListBox x:Name="KeysList" BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Number}" Margin="2,0,8,0"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Desc}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="↑"
                                                            Padding="0" Width="24" Height="24" Margin="2,0"
                                                            Click="KeyUp_Click" ToolTip="上移"/>
                                                    <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="↓"
                                                            Padding="0" Width="24" Height="24" Margin="2,0"
                                                            Click="KeyDown_Click" ToolTip="下移"/>
                                                    <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="✕"
                                                            Padding="0" Width="24" Height="24" Margin="2,0"
                                                            Click="KeyDelete_Click" ToolTip="删除"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>

                            <!-- internal -->
                            <StackPanel x:Name="F_Internal">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="内部命令" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CommandCombo" MinHeight="30"/>
                            </StackPanel>

                            <!-- 注：组合动作已改用独立窗口（CompositeActionDialog），
                                 类型下拉选「组合动作 ▸」即跳转，故本窗口不再有 composite 字段区。 -->
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 图标 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="图标" Margin="0,0,0,6"/>
                    <controls:IconPicker Grid.Row="1" x:Name="IconPicker"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10"
                Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="84" Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="84" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
