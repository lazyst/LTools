<Window x:Class="LTools.Views.ActionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="动作" Width="720" Height="560"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar"/>

        <!-- 主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 名称 + 类型 -->
                    <RowDefinition Height="Auto"/>   <!-- 类型特定字段 -->
                    <RowDefinition Height="Auto"/>   <!-- 输出变量（仅流程步骤） -->
                    <RowDefinition Height="Auto"/>   <!-- 图标 -->
                </Grid.RowDefinitions>

                <!-- 名称 + 类型 -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>   <!-- 名称可空提示（仅步骤场景显示） -->
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="名称" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" x:Name="NameBox" MinHeight="32"/>
                        <TextBlock Grid.Row="2" x:Name="NameHint" FontSize="{StaticResource FontSizeHint}" Margin="0,4,0,0"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="名称可留空：步骤行将显示类型名"/>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="类型" Margin="0,0,0,4"/>
                        <ComboBox Grid.Row="1" x:Name="TypeCombo" MinHeight="32" SelectionChanged="TypeCombo_SelectionChanged"/>
                    </Grid>
                </Grid>

                <!-- 类型特定字段：同层叠加，按类型切换可见性 -->
                <StackPanel Grid.Row="1" x:Name="FieldsPanel" Margin="0,0,0,14">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12"
                            MinHeight="120">

                        <Grid>
                            <!-- launchApp -->
                            <StackPanel x:Name="F_LaunchApp">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="程序路径" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:VariableTextBox Grid.Column="0" x:Name="TargetBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72" Click="BrowseTarget_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="参数（可选）" Margin="0,0,0,4"/>
                                <controls:VariableTextBox x:Name="ArgsBox" MinHeight="30" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="工作目录（可选，留空 = LTools 所在目录）" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:VariableTextBox Grid.Column="0" x:Name="LaunchWorkdirBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72" Margin="0,0,8,0"
                                            Click="BrowseLaunchWorkdir_Click" ToolTip="用文件资源管理器选择工作目录"/>
                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="资源目录" MinWidth="80"
                                            Click="OpenResourceDir_Click" ToolTip="打开 resources\（脚本建议放这里，可用相对路径）"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="提示：脚本建议放 resources\（Git Bash / WSL 请用 resources/）；工作目录留空即可用相对路径"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- openFile -->
                            <StackPanel x:Name="F_OpenFile">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="文件路径" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:VariableTextBox Grid.Column="0" x:Name="FileBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72" Click="BrowseFile_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- openFolder -->
                            <StackPanel x:Name="F_OpenFolder">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="文件夹路径" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:VariableTextBox Grid.Column="0" x:Name="FolderBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72" Click="BrowseFolder_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- openUrl -->
                            <StackPanel x:Name="F_OpenUrl">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="网址" Margin="0,0,0,4"/>
                                <controls:VariableTextBox x:Name="UrlBox" MinHeight="30"/>
                            </StackPanel>

                            <!-- runCommand -->
                            <StackPanel x:Name="F_RunCommand">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="命令" Margin="0,0,0,4"/>
                                <controls:VariableTextBox x:Name="CmdBox" MinHeight="30" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="终端" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TerminalCombo" MinHeight="30" SelectionChanged="TerminalCombo_SelectionChanged"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="KeepWindowBox" Content="保持窗口"
                                              VerticalAlignment="Bottom" Margin="0,0,0,4"
                                              ToolTip="命令跑完后窗口留在原处；需要选择具体终端才有效（「直接运行」不打开终端）"/>
                                </Grid>
                                <TextBlock x:Name="KeepWindowHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                           Margin="0,0,0,10" Visibility="Collapsed"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="工作目录（可选，留空 = LTools 所在目录）" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:VariableTextBox Grid.Column="0" x:Name="CmdWorkdirBox" MinHeight="30" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="浏览…" MinWidth="72" Margin="0,0,8,0"
                                            Click="BrowseCmdWorkdir_Click" ToolTip="用文件资源管理器选择工作目录"/>
                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="资源目录" MinWidth="80"
                                            Click="OpenResourceDir_Click" ToolTip="打开 resources\（脚本建议放这里，可用相对路径）"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="提示：脚本建议放 resources\（Git Bash / WSL 请用 resources/）；工作目录留空即可用相对路径"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- sendText -->
                            <StackPanel x:Name="F_SendText">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="要发送的文本" Margin="0,0,0,4"/>
                                <controls:VariableTextBox x:Name="SendTextBox" MinHeight="96" MaxHeight="200"
                                                          AcceptsReturn="True" TextWrapping="Wrap"
                                                          VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="发送方式" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SendModeCombo" MinHeight="30">
                                            <ComboBoxItem Content="自动（Unicode 注入：不受输入法影响，不碰剪贴板）" Tag="auto"/>
                                            <ComboBoxItem Content="始终键入（真实按键，受输入法影响；仅布局可映射字符）" Tag="type"/>
                                            <ComboBoxItem Content="始终剪贴板粘贴（临时覆盖，150ms 后恢复原内容）" Tag="paste"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="AppendEnterBox" Content="末尾添加回车"
                                              VerticalAlignment="Bottom" Margin="0,0,0,4"
                                              ToolTip="发送完文本后再发一次回车（聊天软件中用于直接发出）"/>
                                </Grid>
                            </StackPanel>

                            <!-- setClipboard（写入剪贴板） -->
                            <StackPanel x:Name="F_SetClipboard">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="写入剪贴板的文本" Margin="0,0,0,4"/>
                                <controls:VariableTextBox x:Name="ClipboardTextBox" MinHeight="96" MaxHeight="200"
                                                          AcceptsReturn="True" TextWrapping="Wrap"
                                                          VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="可用 ${变量} 插入运行时的值（例如先「取值 · 选中文本」，再把它写进剪贴板）。留空则清空剪贴板。"/>
                            </StackPanel>

                            <!-- toast（提示弹窗） -->
                            <StackPanel x:Name="F_Toast">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="要提示的文字" Margin="0,0,0,4"/>
                                <controls:VariableTextBox x:Name="ToastTextBox" MinHeight="80" MaxHeight="180"
                                                          AcceptsReturn="True" TextWrapping="Wrap"
                                                          VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="停留" VerticalAlignment="Center"
                                               Foreground="{StaticResource HintTextBrush}"/>
                                    <TextBox Grid.Column="1" x:Name="ToastDurationBox" Width="72" MinHeight="30"
                                             Margin="8,0,4,0" ToolTip="秒；0 = 不自动关闭，点一下才关"/>
                                    <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center"
                                               Foreground="{StaticResource HintTextBrush}"/>
                                    <TextBlock Grid.Column="3" Text="（点一下卡片也能关掉）" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Style="{StaticResource HintLabel}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="右下角弹出，不打断流程：下一步立刻继续。卡片不抢焦点——自动化正在往别的窗口打字时，提示出现也不会把输入带偏。标题用动作名称（可留空）。"/>
                            </StackPanel>

                            <!-- sendKeys（模拟按键） -->
                            <StackPanel x:Name="F_SendKeys">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="输入序列" Margin="0,0,0,4"/>
                                <TextBlock Text="录制：按下快捷键自动记录，空闲 800ms 成条；Esc 停止。"
                                           Foreground="{StaticResource HintTextBrush}" FontSize="{StaticResource FontSizeHint}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="RecordBtn" Style="{StaticResource BtnGhost}"
                                            Content="● 开始录制" MinWidth="100" MinHeight="30" Margin="0,0,6,0"
                                            Click="Record_Click"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="＋ 组合键"
                                            MinHeight="30" Margin="0,0,6,0" Click="AddChord_Click"/>
                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="＋ 文本"
                                            MinHeight="30" Margin="0,0,6,0" Click="AddText_Click"/>
                                    <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="＋ 延时"
                                            MinHeight="30" Click="AddSleep_Click"/>
                                    <TextBlock Grid.Column="4" x:Name="RecordHint" VerticalAlignment="Center"
                                               Margin="12,0,0,0" Foreground="{StaticResource HintTextBrush}"
                                               FontSize="{StaticResource FontSizeHint}" Text=""/>
                                </Grid>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                        MinHeight="80" MaxHeight="180">
                                    <ListBox x:Name="KeysList" BorderThickness="0" Background="Transparent"
                                             HorizontalContentAlignment="Stretch"
                                             MouseDoubleClick="KeysList_DoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>    <!-- 把手 -->
                                                        <ColumnDefinition Width="Auto"/>    <!-- 序号 -->
                                                        <ColumnDefinition Width="*"/>       <!-- 描述 -->
                                                        <ColumnDefinition Width="Auto"/>    <!-- 编辑 -->
                                                        <ColumnDefinition Width="Auto"/>    <!-- 删除 -->
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="18" Cursor="SizeAll" Background="Transparent"
                                                            VerticalAlignment="Stretch" ToolTip="拖拽排序"
                                                            PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown">
                                                        <TextBlock Text="≡" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource HintTextBrush}"
                                                                   FontSize="{StaticResource FontSizeBody}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Number}" Margin="2,0,8,0"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Desc}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="✎"
                                                            Padding="0" Width="24" Height="24" Margin="2,0"
                                                            Click="KeyEdit_Click" ToolTip="编辑（双击行亦可）"/>
                                                    <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="✕"
                                                            Padding="0" Width="24" Height="24" Margin="2,0"
                                                            Click="KeyDelete_Click" ToolTip="删除"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>

                            <!-- mouse（鼠标操作） -->
                            <StackPanel x:Name="F_Mouse">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="鼠标动作" Margin="0,0,0,4"/>
                                <ComboBox x:Name="MouseActionCombo" MinHeight="30" Margin="0,0,0,10"
                                          SelectionChanged="MouseAction_Changed">
                                    <ComboBoxItem Content="左键单击"/>
                                    <ComboBoxItem Content="左键双击"/>
                                    <ComboBoxItem Content="右键单击"/>
                                    <ComboBoxItem Content="中键单击"/>
                                    <ComboBoxItem Content="只移动光标"/>
                                    <ComboBoxItem Content="滚轮向上"/>
                                    <ComboBoxItem Content="滚轮向下"/>
                                </ComboBox>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="屏幕坐标（虚拟桌面像素）" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="x" VerticalAlignment="Center"
                                               Foreground="{StaticResource HintTextBrush}"/>
                                    <controls:VariableTextBox Grid.Column="1" x:Name="MouseXBox" MinHeight="30" Margin="6,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="y" VerticalAlignment="Center"
                                               Foreground="{StaticResource HintTextBrush}"/>
                                    <controls:VariableTextBox Grid.Column="3" x:Name="MouseYBox" MinHeight="30" Margin="6,0,0,0"/>
                                    <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="⌖ 拾取"
                                            MinHeight="30" Padding="10,4" Margin="8,0,0,0"
                                            Click="MousePick_Click"
                                            ToolTip="最小化窗口后在屏幕上单击取坐标"/>
                                </Grid>

                                <StackPanel x:Name="MouseWheelPanel" Orientation="Horizontal" Margin="0,10,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="滚动刻度" VerticalAlignment="Center"
                                               Foreground="{StaticResource HintTextBrush}"/>
                                    <TextBox x:Name="MouseWheelBox" Width="72" MinHeight="30" Margin="8,0,4,0"/>
                                    <TextBlock Text="（120 = 一格）" VerticalAlignment="Center"
                                               Foreground="{StaticResource HintTextBrush}"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="坐标留空 = 当前光标位置（滚轮可直接不填）。也可写 ${变量}：先用「设置变量 · 截图找图」拿到位置，再用 ${m.x} / ${m.y} 点击。"/>
                            </StackPanel>

                            <!-- window（窗口操作）：目标窗口与条件里的「窗口」同一套匹配规则 -->
                            <StackPanel x:Name="F_Window">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="目标窗口" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:VariableTextBox Grid.Column="0" x:Name="WindowTitleBox" MinHeight="30"
                                                              ToolTip="标题里包含这段文字就算匹配（可用 ${变量}）"/>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="从当前窗口选择…"
                                            MinHeight="30" Padding="10,4" Margin="8,0,0,0" Click="WindowPick_Click"
                                            ToolTip="列出当前打开的窗口，点一个即可填入标题"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="标题按「包含」匹配，命中最上面那个。同名窗口分不清时，在下面填类名精确定位。"/>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="类名（可选）" VerticalAlignment="Center"
                                               Foreground="{StaticResource HintTextBrush}"/>
                                    <TextBox Grid.Column="1" x:Name="WindowClassBox" MinHeight="30" Margin="8,0,0,0"
                                             ToolTip="精确匹配窗口类名（如 Notepad），一般不用填"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="操作" Margin="0,12,0,4"/>
                                <ComboBox x:Name="WindowOpCombo" MinHeight="30" SelectionChanged="WindowOp_Changed">
                                    <ComboBoxItem Content="切换到前台"/>
                                    <ComboBoxItem Content="最大化"/>
                                    <ComboBoxItem Content="最小化"/>
                                    <ComboBoxItem Content="还原"/>
                                    <ComboBoxItem Content="调整到指定大小"/>
                                </ComboBox>

                                <StackPanel x:Name="WindowRectPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="x" VerticalAlignment="Center"
                                                   Foreground="{StaticResource HintTextBrush}"/>
                                        <TextBox Grid.Column="1" x:Name="WindowXBox" MinHeight="30" Margin="6,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="y" VerticalAlignment="Center"
                                                   Foreground="{StaticResource HintTextBrush}"/>
                                        <TextBox Grid.Column="3" x:Name="WindowYBox" MinHeight="30" Margin="6,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="w" VerticalAlignment="Center"
                                                   Foreground="{StaticResource HintTextBrush}"/>
                                        <TextBox Grid.Column="1" x:Name="WindowWBox" MinHeight="30" Margin="6,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="h" VerticalAlignment="Center"
                                                   Foreground="{StaticResource HintTextBrush}"/>
                                        <TextBox Grid.Column="3" x:Name="WindowHBox" MinHeight="30" Margin="6,0,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource BtnGhost}" Content="在屏幕上框选…"
                                                MinHeight="30" Padding="10,4" Click="WindowPickRect_Click"
                                                ToolTip="最小化窗口后在屏幕上框一块：把窗口摆到那块区域"/>
                                        <Button Style="{StaticResource BtnGhost}" Content="用目标窗口当前尺寸"
                                                MinHeight="30" Padding="10,4" Margin="8,0,0,0"
                                                Click="WindowUseCurrentRect_Click"
                                                ToolTip="读取目标窗口现在的矩形，填进上面四个框"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="物理像素，与鼠标 / 截图同一坐标系。框选 = 把窗口摆到刚框的那块区域（含标题栏的外框）。"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="每个操作都会读回真实结果，做不到就按失败策略处理，不会假装成功。切前台受系统前台锁限制（别的程序全屏、窗口在别的虚拟桌面时会被拒绝）；调整大小可能被应用的最小尺寸夹住，那时会记日志，输出变量给的是实际矩形。"/>
                            </StackPanel>

                            <!-- clickText（文字点击）：截取区域 → OCR → 点命中文字中心 -->
                            <StackPanel x:Name="F_ClickText">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="要点击的文字" Margin="0,0,0,4"/>
                                <controls:VariableTextBox x:Name="ClickTextBox" MinHeight="30"
                                                          ToolTip="按「包含」匹配，忽略大小写与词间空格；可用 ${变量}"/>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="区域里识别到这几个字就点它。按「包含」匹配（写「保存」也能命中「保存并关闭」），忽略大小写与词间空格；多处出现时点最上面那个。"/>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="在哪儿找" Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ClickRegionCombo" MinHeight="30" SelectionChanged="ClickRegion_Changed">
                                        <ComboBoxItem Content="前台窗口"/>
                                        <ComboBoxItem Content="整个屏幕"/>
                                        <ComboBoxItem Content="固定区域"/>
                                    </ComboBox>
                                    <Button x:Name="ClickPickBtn" Grid.Column="1" Style="{StaticResource BtnGhost}"
                                            Content="框选区域…" MinHeight="30" Padding="10,4" Margin="8,0,0,0"
                                            Click="ClickPickRect_Click"
                                            ToolTip="在屏幕上框出一块，自动切到「固定区域」并填入 x / y / w / h"/>
                                </Grid>
                                <StackPanel x:Name="ClickRectPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="x" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                                        <TextBox x:Name="ClickXBox" Width="64" MinHeight="30" Margin="4,0,10,0"/>
                                        <TextBlock Text="y" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                                        <TextBox x:Name="ClickYBox" Width="64" MinHeight="30" Margin="4,0,10,0"/>
                                        <TextBlock Text="w" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                                        <TextBox x:Name="ClickWBox" Width="64" MinHeight="30" Margin="4,0,10,0"/>
                                        <TextBlock Text="h" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                                        <TextBox x:Name="ClickHBox" Width="64" MinHeight="30" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="区域越小识别越快、越不容易认错。「前台窗口」在执行时取当时最前面的窗口，适合跨程序复用；「固定区域」是虚拟桌面物理像素，与鼠标 / 截图同一坐标系。"/>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="找到后" Margin="0,12,0,4"/>
                                <ComboBox x:Name="ClickActionCombo" MinHeight="30">
                                    <ComboBoxItem Content="左键单击"/>
                                    <ComboBoxItem Content="左键双击"/>
                                    <ComboBoxItem Content="右键单击"/>
                                    <ComboBoxItem Content="中键单击"/>
                                    <ComboBoxItem Content="只移动光标，不点击"/>
                                </ComboBox>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="识别与等待" Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="识别引擎" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                                    <ComboBox x:Name="ClickOcrCombo" MinWidth="220" MinHeight="30" Margin="8,0,0,0"
                                              SelectionChanged="ClickOcr_Changed">
                                        <ComboBoxItem Content="PP-OCRv6 快速（内置，推荐）"/>
                                        <ComboBoxItem Content="系统 OCR（快，省内存）"/>
                                        <ComboBoxItem Content="PP-OCRv6 高精度（需下载）"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="ClickOcrHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="找不到时最多等" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                                    <TextBox x:Name="ClickTimeoutBox" Width="64" MinHeight="30" Margin="8,0,4,0"/>
                                    <TextBlock Text="秒（0 = 只找一次）" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="等的时候会反复截图重试，适合「点完上一步，等按钮出现再点」。一直找不到就是这一步失败（不会假装点过），报错里会列出区域内识别到的文字，方便判断是文字写错了还是 OCR 没认出来。高精度模型需先在「文字识别」取值器里下载一次。"/>
                            </StackPanel>

                            <!-- macro（键鼠宏）：一宏一动作，只能当场录制，不再选宏文件。
                                 回放参数按宏独立（速度 / 循环 / 倒计时），录制的全局参数也在同一面板编辑：
                                 设置页不再有「键鼠录制」页，宏也不再需要手工管理文件。 -->
                            <StackPanel x:Name="F_Macro">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="键鼠宏" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MacroInfoText" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="MacroRecordBtn" Style="{StaticResource BtnPrimary}"
                                            Content="● 录制新宏" MinWidth="110" MinHeight="30"
                                            Click="MacroRecord_Click"/>
                                    <TextBlock x:Name="MacroRecordHint" Style="{StaticResource HintLabel}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Text="点击后本窗口自动最小化并立即开录，按录制热键停止并自动保存"/>
                                </StackPanel>

                                <TextBlock x:Name="MacroHint" Style="{StaticResource HintLabel}" Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>

                                <DockPanel Margin="0,14,0,6">
                                    <Button x:Name="MacroPreviewBtn" DockPanel.Dock="Right"
                                            Style="{StaticResource BtnGhost}"
                                            Content="▶ 试放本宏" MinHeight="24" Padding="10,2"
                                            VerticalAlignment="Center" Click="MacroPreview_Click"
                                            ToolTip="用当前速度 / 循环 / 倒计时试放一次；不保存动作，也不会修改宏"/>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="回放（本宏）"/>
                                </DockPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource HintLabel}"
                                               Text="速度" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="MacroSpeedBox" MinHeight="28" Width="70"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource HintLabel}"
                                               Text="倍（0.1–5，1 = 原速）" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource HintLabel}"
                                               Text="循环" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="MacroLoopsBox" MinHeight="28" Width="70"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource HintLabel}"
                                               Text="次" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <CheckBox Grid.Column="3" x:Name="MacroInfiniteBox" Content="无限"
                                              VerticalAlignment="Center" Margin="12,0,0,0"
                                              Checked="MacroInfinite_Changed" Unchecked="MacroInfinite_Changed"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource HintLabel}"
                                               Text="倒计时" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="MacroCountdownBox" MinHeight="28" Width="70"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource HintLabel}"
                                               Text="ms（0 = 立即回放）" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="MacroPlaybackHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"/>

                                <DockPanel Margin="0,14,0,6">
                                    <Button x:Name="MacroResetHotkeyBtn" DockPanel.Dock="Right"
                                            Style="{StaticResource BtnGhost}"
                                            Content="恢复默认" MinHeight="24" Padding="10,2"
                                            VerticalAlignment="Center" Click="MacroHotkeyReset_Click"/>
                                    <TextBlock Style="{StaticResource SectionLabel}"
                                               Text="全局（录制 / 停止回放）"/>
                                </DockPanel>
                                <CheckBox x:Name="MacroEnabledBox" Content="启用宏录制与回放" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource HintLabel}"
                                               Text="录制热键" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="MacroRecordHotkeyBox" MinHeight="28" Width="180"/>
                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="手动选择…"
                                            MinWidth="80" Margin="6,0,0,0" Click="MacroRecordHotkeyPick_Click"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource HintLabel}"
                                               Text="仅在键鼠宏编辑窗口录制时生效" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource HintLabel}"
                                               Text="停止回放" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="MacroStopHotkeyBox" MinHeight="28" Width="180"/>
                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="手动选择…"
                                            MinWidth="80" Margin="6,0,0,0" Click="MacroStopHotkeyPick_Click"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource HintLabel}"
                                               Text="仅回放期间注册 / 生效" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource HintLabel}"
                                               Text="鼠标采样" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="MacroSampleMsBox" MinHeight="28" Width="60"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource HintLabel}"
                                               Text="ms 间隔 ·" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Column="3" x:Name="MacroSamplePxBox" MinHeight="28" Width="60" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource HintLabel}"
                                               Text="px 位移（0 = 不抽稀；越小越精细、宏越大）"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="MacroHotkeyHint" Style="{StaticResource HintLabel}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- internal -->
                            <StackPanel x:Name="F_Internal">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="内部命令" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CommandCombo" MinHeight="30"/>
                            </StackPanel>

                            <!-- 注：组合动作已改用独立窗口（CompositeActionDialog），
                                 类型下拉选「组合动作 ▸」即跳转，故本窗口不再有 composite 字段区。 -->
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 输出：只有组合动作步骤（能拿到流程变量）且该类型有结果时显示 -->
                <Border x:Name="OutputPanel" Grid.Row="2" Margin="0,0,0,14"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="输出" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource HintLabel}" Text="结果存到变量（可选）" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="OutputVarBox" MinHeight="32" TextChanged="OutputVar_Changed"
                                     ToolTip="变量名，例如 输出；留空表示不需要结果"/>
                            <Button Grid.Column="1" x:Name="OutputVarPickBtn" Style="{StaticResource BtnGhost}"
                                    Content="选择…" MinWidth="64" Margin="8,0,0,0"
                                    Click="OutputVarPick_Click"
                                    ToolTip="从本流程已有的变量里选一个"/>
                        </Grid>
                        <TextBlock x:Name="OutputVarHint" Style="{StaticResource HintLabel}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="执行后变量会出现在右侧变量面板，后面的步骤可用 ${变量} 引用（也支持 .x / .exit / .err 等属性）。"/>
                    </StackPanel>
                </Border>

                <!-- 图标 -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="图标" Margin="0,0,0,6"/>
                    <controls:IconPicker Grid.Row="1" x:Name="IconPicker"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10"
                Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="84" Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="84" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <!-- 拖动排序幽灵层（覆盖全窗口，不挡鼠标；与组合动作编辑器同款视觉） -->
        <Canvas x:Name="GhostLayer" Grid.RowSpan="3" IsHitTestVisible="False">
            <Border x:Name="DragGhost" Visibility="Collapsed"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2" CornerRadius="6" Padding="10,6" Opacity="0.92"
                    MinWidth="180" MaxWidth="320">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="GhostBadge" FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="GhostName" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border x:Name="InsertLine" Height="3" CornerRadius="1.5"
                    Background="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
