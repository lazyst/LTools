<UserControl x:Class="LTools.Views.Controls.SubActionLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LTools.Views.Controls"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <UserControl.Resources>
        <Style x:Key="SubActionRowBtn" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 高亮画在卡片自己身上（照 StepRowTemplate），范围正好是可见卡片：
                                 全局 ListItemTemplate 把 hover / selected 画在 ListBoxItem 容器上，
                                 会被这张不透明卡片完全挡住，且容器含 6px 下边距 → 高亮比卡片高一截。
                                 容器模板已改成透明 ContentPresenter（见下面 ItemContainerStyle）。 -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource SurfaceAltBrush}"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource PressedBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="20,14,20,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionLabel}" Text="子动作库"/>
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="子动作是一段可复用的步骤：在动作编辑器里用「调用子动作」按名字调用，参数和返回值由变量表里的「输入 / 输出」标记决定。"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- 顶部只留「页面级」操作；一行自己的操作全在行右侧（4 个常驻图标 + ⋯ 收低频），
                 不再有「顶部一套 + 右键一套」两个入口。 -->
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BtnPrimary}" Content="新建子动作" MinWidth="104"
                        Click="New_Click"/>
                <Button Style="{StaticResource BtnGhost}" Content="打开目录" MinWidth="84" Margin="8,0,0,0"
                        Click="OpenFolder_Click"/>
            </StackPanel>

            <TextBox Grid.Column="2" x:Name="SearchBox" MinHeight="30" Margin="10,0,0,0"
                     ToolTip="按名称 / id / 输入变量名筛选"
                     controls:TextBoxPlaceholder.Text="搜索子动作…"
                     TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <TextBlock x:Name="BrokenHint" DockPanel.Dock="Top" Style="{StaticResource HintLabel}"
                   TextWrapping="Wrap" Margin="2,0,0,8" Visibility="Collapsed"
                   Foreground="{StaticResource DangerBrush}"/>

        <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Style="{StaticResource HintLabel}"
                   TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"
                   Text="还没有全局子动作。新建一个，把常用的一串步骤收进去，之后每个动作都能调用它。"/>

        <TextBlock x:Name="NoMatchHint" DockPanel.Dock="Top" Style="{StaticResource HintLabel}"
                   TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"
                   Text="没有匹配的子动作。"/>

        <!-- 右键菜单已拆成行右侧的常驻图标（见 ItemTemplate 的 SubActionRowAction_Click）：
             高频 4 个直接点，低频 3 个收进每行的 ⋯，不再有隐藏入口。 -->
        <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="List_MouseDoubleClick">

            <ListBox.ItemContainerStyle>
                <!-- 不继承全局 ListItemTemplate：它把 hover / selected 画在 ListBoxItem 的 bd 上，
                     被下面那张不透明卡片挡住（选中看不见），矩形还含卡片 6px 下边距（高亮比卡片高）。
                     高亮改由卡片自己的 DataTrigger 负责，这里只承载内容、不画任何底色。 -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource SubActionRowBtn}" Click="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Glyph}" VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Id}" Margin="8,0,0,0"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontSizeHint}"
                                               Foreground="{StaticResource HintTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" Margin="0,2,0,0"
                                           FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding RefText}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" ToolTip="{Binding RefTip}"
                                       FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>

                            <!-- 行右侧常驻图标：试运行 / 编辑 / 复制 / 删除 / ⋯（低频 3 项）。
                                 动作标识走 CommandParameter，别用 Tag（BtnGhost 把 Tag 当悬停色）。
                                 分发器按 DataContext 认行——点按钮不会自动选中这一行。 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Content="▶" CommandParameter="run" Style="{StaticResource BtnGhost}"
                                        Width="24" Height="24" Padding="0" FontSize="13" Focusable="False"
                                        FontFamily="Segoe UI Symbol" ToolTip="试运行这个子动作"
                                        Click="SubActionRowAction_Click"/>
                                <Button Content="✎" CommandParameter="edit" Style="{StaticResource BtnGhost}"
                                        Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14" Focusable="False"
                                        FontFamily="Segoe UI Symbol" ToolTip="编辑这个子动作"
                                        Click="SubActionRowAction_Click"/>
                                <Button Content="⧉" CommandParameter="copy" Style="{StaticResource BtnGhost}"
                                        Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14" Focusable="False"
                                        FontFamily="Segoe UI Symbol" ToolTip="复制这个子动作"
                                        Click="SubActionRowAction_Click"/>
                                <Button Content="✕" CommandParameter="delete" Style="{StaticResource BtnGhostDanger}"
                                        Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14" Focusable="False"
                                        FontFamily="Segoe UI Symbol" ToolTip="删除这个子动作"
                                        Click="SubActionRowAction_Click"/>
                                <Button Content="⋯" CommandParameter="more" Style="{StaticResource BtnGhost}"
                                        Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="15" Focusable="False"
                                        FontFamily="Segoe UI Symbol" ToolTip="更多：另存为动作 / 复制 id / 在文件夹中显示"
                                        Click="SubActionRowAction_Click"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
