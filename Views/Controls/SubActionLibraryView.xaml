<UserControl x:Class="LTools.Views.Controls.SubActionLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <UserControl.Resources>
        <Style x:Key="SubActionRowBtn" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="20,14,20,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionLabel}" Text="子动作库"/>
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="子动作是一段可复用的步骤：在动作编辑器里用「调用子动作」按名字调用，参数和返回值由下面的「输入 / 输出」标记决定。"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,10">
            <Button Style="{StaticResource BtnPrimary}" Content="新建子动作" MinWidth="104"
                    Click="New_Click"/>
            <Button Style="{StaticResource BtnGhost}" Content="编辑" MinWidth="64" Margin="8,0,0,0"
                    Click="Edit_Click"/>
            <Button Style="{StaticResource BtnGhost}" Content="复制" MinWidth="64" Margin="6,0,0,0"
                    Click="Duplicate_Click"/>
            <Button Style="{StaticResource BtnGhostDanger}" Content="删除" MinWidth="64" Margin="6,0,0,0"
                    Click="Delete_Click"/>
            <Button Style="{StaticResource BtnGhost}" Content="打开目录" MinWidth="84" Margin="6,0,0,0"
                    Click="OpenFolder_Click"/>
        </StackPanel>

        <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Style="{StaticResource HintLabel}"
                   TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"
                   Text="还没有全局子动作。新建一个，把常用的一串步骤收进去，之后每个动作都能调用它。"/>

        <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="List_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource SubActionRowBtn}" Click="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Id}" Margin="8,0,0,0"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontSizeHint}"
                                               Foreground="{StaticResource HintTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" Margin="0,2,0,0"
                                           FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="编辑 ›" VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="{StaticResource FontSizeHint}"
                                       Foreground="{StaticResource HintTextBrush}"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
