<UserControl x:Class="LTools.Views.Controls.HotkeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <UserControl.Resources>
        <!-- 小按钮：组 / 绑定列表下方的操作条 -->
        <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="9,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <!-- 预设组行：整行可点，勾选框控制整组启停 -->
        <DataTemplate x:Key="GroupRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,7,0" Focusable="False"
                          ToolTip="整组启用 / 停用（停用后组内绑定都不生效，配置保留）"
                          Click="GroupEnabled_Click"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center"
                           Style="{StaticResource HintLabel}" FontSize="{StaticResource FontSizeHint}"
                           Margin="6,0,2,0" ToolTip="{Binding Count}"/>
                <!-- 常驻小图标：重命名 / 删除 / 上移 / 下移。动作标识走 CommandParameter，
                     别用 Tag——BtnGhost 把 Tag 当悬停色；点按钮不会选中行，分发器按 DataContext 认行。 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0">
                    <Button Content="✎" CommandParameter="rename" Style="{StaticResource BtnGhost}"
                            Width="20" Height="20" Padding="0" FontSize="12" Focusable="False"
                            FontFamily="Segoe UI Symbol" ToolTip="重命名这个组" Click="GroupRowAction_Click"/>
                    <Button Content="✕" CommandParameter="delete" Style="{StaticResource BtnGhostDanger}"
                            Width="20" Height="20" Padding="0" Margin="2,0,0,0" FontSize="12" Focusable="False"
                            FontFamily="Segoe UI Symbol" ToolTip="删除这个组" Click="GroupRowAction_Click"/>
                    <Button Content="↑" CommandParameter="up" Style="{StaticResource BtnGhost}"
                            Width="20" Height="20" Padding="0" Margin="2,0,0,0" FontSize="12" Focusable="False"
                            FontFamily="Segoe UI Symbol" ToolTip="整组上移（排在前面的组优先匹配）" Click="GroupRowAction_Click"/>
                    <Button Content="↓" CommandParameter="down" Style="{StaticResource BtnGhost}"
                            Width="20" Height="20" Padding="0" Margin="2,0,0,0" FontSize="12" Focusable="False"
                            FontFamily="Segoe UI Symbol" ToolTip="整组下移" Click="GroupRowAction_Click"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,14,20,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" MinWidth="220"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左：预设组 ============ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="预设组"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource MiniBtn}" Content="＋ 新建"
                        Click="NewGroup_Click" ToolTip="新建一个预设组（组内是一批「快捷键 → 动作」）"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent"
                         ItemTemplate="{StaticResource GroupRowTemplate}"
                         SelectionChanged="GroupList_SelectionChanged"
                         MouseDoubleClick="GroupList_MouseDoubleClick"
                         Padding="6,6"/>
            </Border>

            <TextBlock Grid.Row="2" Style="{StaticResource HintLabel}" Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis"
                       Text="双击组名也能重命名；行右侧是 重命名 / 删除 / 上移 / 下移。"/>
        </Grid>

        <!-- ============ 右：热键表 ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SearchBox" MinHeight="30"
                         ToolTip="按快捷键 / 动作名 / 备注筛选"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock Grid.Column="1" x:Name="ConflictText" Style="{StaticResource HintLabel}"
                           VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="添加快捷键…"
                        MinWidth="104" Click="AddBinding_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <DataGrid x:Name="BindingGrid"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                          IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" BorderThickness="0"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreviewMouseLeftButtonDown="BindingGrid_PreviewMouseLeftButtonDown">
                    <DataGrid.Columns>
                        <!-- 每列都写 MinWidth：窗口变窄时 DataGrid 会把列按比例压扁，压到 20 时
                             启用勾选框会被裁成空矩形（点不到、也看不见），所以宁可出横向滚动条。 -->
                        <DataGridTemplateColumn Header="启用" Width="44" MinWidth="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Focusable="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="这一条是否生效（组停用时一律不生效）"
                                              Click="BindingEnabled_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="快捷键" Width="140" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Chord}" Margin="2,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               FontFamily="Consolas,Microsoft YaHei UI" FontWeight="SemiBold"
                                               ToolTip="{Binding ChordTip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Conflict}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="动作" Width="*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActionName}" Margin="2,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ActionName}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="生效范围" Width="100" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ScopeText}" Margin="2,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource HintLabel}"
                                               FontSize="{StaticResource FontSizeHint}"
                                               ToolTip="{Binding ScopeTip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="备注" Width="96" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Note}" Margin="2,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource HintLabel}"
                                               FontSize="{StaticResource FontSizeHint}"
                                               ToolTip="{Binding Note}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 操作列：编辑 / 删除 / 上移 / 下移，照 TriggersView 的 RowAction_Click 套路。
                             双击整行已有编辑（BindingGrid_PreviewMouseLeftButtonDown 里认 ClickCount == 2）。 -->
                        <DataGridTemplateColumn Header="操作" Width="120" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✎" CommandParameter="edit" Style="{StaticResource BtnGhost}"
                                                Width="24" Height="24" Padding="0" FontSize="14" Focusable="False"
                                                FontFamily="Segoe UI Symbol" ToolTip="编辑这条快捷键" Click="BindingRowAction_Click"/>
                                        <Button Content="✕" CommandParameter="delete" Style="{StaticResource BtnGhostDanger}"
                                                Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14" Focusable="False"
                                                FontFamily="Segoe UI Symbol" ToolTip="删除这条快捷键" Click="BindingRowAction_Click"/>
                                        <Button Content="↑" CommandParameter="up" Style="{StaticResource BtnGhost}"
                                                Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14" Focusable="False"
                                                FontFamily="Segoe UI Symbol" ToolTip="上移（同一组合键出现多次时，排在前面的优先）" Click="BindingRowAction_Click"/>
                                        <Button Content="↓" CommandParameter="down" Style="{StaticResource BtnGhost}"
                                                Width="24" Height="24" Padding="0" Margin="2,0,0,0" FontSize="14" Focusable="False"
                                                FontFamily="Segoe UI Symbol" ToolTip="下移" Click="BindingRowAction_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="HintText" Style="{StaticResource HintLabel}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource HintLabel}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Text="双击一行也能编辑；行右侧是 编辑 / 删除 / 上移 / 下移。"/>
            </StackPanel>

            <!-- 全局默认名单：每条绑定默认跟随这里，也可以在单条里覆盖 -->
            <Expander Grid.Row="3" Margin="0,10,0,0" IsExpanded="False"
                      Foreground="{StaticResource TextBrush}">
                <Expander.Header>
                    <TextBlock x:Name="DefaultHeader" Style="{StaticResource SectionLabel}"
                               Text="全局默认：所有窗口"/>
                </Expander.Header>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                       Text="默认生效范围" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="DefaultScopeBox" MinHeight="30"
                                      SelectionChanged="DefaultScope_Changed">
                                <ComboBoxItem Content="所有窗口" Tag="all"/>
                                <ComboBoxItem Content="只在白名单里的程序" Tag="whitelist"/>
                                <ComboBoxItem Content="排除黑名单里的程序" Tag="blacklist"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource HintLabel}" Margin="120,0,0,6"
                                   TextWrapping="Wrap"
                                   Text="每条快捷键还可以单独指定范围（编辑对话框里的「生效范围」）。LTools 自己的窗口、取不到前台程序时一律不触发 / 照常触发。"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="进程（每行一个，支持 * ?）"
                                       FontSize="{StaticResource FontSizeHint}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择进程…"
                                    MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                                    Click="DefaultProcess_Click" ToolTip="点击屏幕上的窗口，把它的进程名追加一行"/>
                        </Grid>
                        <TextBox x:Name="DefaultProcessBox" MinHeight="44" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 ToolTip="chrome.exe / Code.exe / 完整路径"
                                 LostFocus="DefaultFilter_LostFocus"/>
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="窗口标题（每行一个，按包含匹配）"
                                       FontSize="{StaticResource FontSizeHint}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择窗口…"
                                    MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                                    Click="DefaultTitle_Click" ToolTip="点击屏幕上的窗口，把标题追加一行"/>
                        </Grid>
                        <TextBox x:Name="DefaultTitleBox" MinHeight="38" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 LostFocus="DefaultFilter_LostFocus"/>
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="窗口类名（每行一个）"
                                       FontSize="{StaticResource FontSizeHint}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择窗口…"
                                    MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                                    Click="DefaultClass_Click" ToolTip="点击屏幕上的窗口，把类名追加一行"/>
                        </Grid>
                        <TextBox x:Name="DefaultClassBox" MinHeight="30" AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 LostFocus="DefaultFilter_LostFocus"/>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
