<UserControl x:Class="LTools.Views.Controls.ActionKindSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- 分段项：选中 = 主色实心 + 反白；未选中 = 透明 + 悬停浅底。
             同一 StackPanel 里的 RadioButton 默认互斥，无需 GroupName。
             触发器顺序有讲究：IsChecked 必须排在 IsMouseOver 之后，否则悬停会把选中态盖掉。 -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SubtleFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{StaticResource CornerSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnPrimaryTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource CornerMd}" Padding="2"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="NormalItem" Style="{StaticResource Segment}" Content="普通动作"
                         IsChecked="True" Checked="Item_Checked"
                         ToolTip="单个动作：启动程序、发送文本、键鼠宏等"/>
            <RadioButton x:Name="CompositeItem" Style="{StaticResource Segment}" Content="组合动作"
                         Margin="2,0,0,0" Checked="Item_Checked"
                         ToolTip="按顺序执行多个动作（步骤、延迟、失败策略）"/>
        </StackPanel>
    </Border>
</UserControl>
