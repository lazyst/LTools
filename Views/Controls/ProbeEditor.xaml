<UserControl x:Class="LTools.Views.Controls.ProbeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionLabel}" Text="取值方式" Margin="0,0,0,4"/>
        <ComboBox x:Name="KindCombo" MinHeight="32" SelectionChanged="Kind_Changed"/>

        <!-- 字面文本 -->
        <StackPanel x:Name="P_Text" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="文本；可用 ${变量} 插入运行时的值，$$ 表示字面 $"/>
            <TextBox x:Name="TextValueBox" MinHeight="46" Margin="0,4,0,0"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxHeight="100"/>
        </StackPanel>

        <!-- 变量 -->
        <StackPanel x:Name="P_Variable" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="变量名；支持 name.x / name.y / name.found 取属性"/>
            <TextBox x:Name="VarNameBox" MinHeight="32" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 选中文本 -->
        <StackPanel x:Name="P_Selection" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}"
                       Text="读取前台应用当前选中的文本（会短暂占用剪贴板；终端里 Ctrl+C 是中断，不适用）"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="等待上限" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="SelectionTimeoutBox" Width="72" MinHeight="30" Margin="6,0,0,0"/>
                <TextBlock Text="ms" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}" Margin="4,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 剪贴板 -->
        <StackPanel x:Name="P_Clipboard" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="读取系统剪贴板里的文本。"/>
        </StackPanel>

        <!-- 光标 -->
        <StackPanel x:Name="P_Cursor" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="当前光标位置，存为坐标值（${变量.x} / ${变量.y}）。"/>
        </StackPanel>

        <!-- 日期时间 -->
        <StackPanel x:Name="P_DateTime" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text=".NET 日期格式，例如 yyyy-MM-dd 或 HH:mm:ss"/>
            <TextBox x:Name="DateFormatBox" MinHeight="32" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 询问用户 -->
        <StackPanel x:Name="P_User" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="运行时弹出输入框（流程会等待用户确定 / 取消）"/>
            <TextBox x:Name="UserPromptBox" MinHeight="32" Margin="0,4,0,0" ToolTip="提示文字"/>
            <TextBox x:Name="UserDefaultBox" MinHeight="32" Margin="0,6,0,0" ToolTip="默认值"/>
        </StackPanel>

        <!-- 图像 -->
        <StackPanel x:Name="P_Image" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="100" Height="60" CornerRadius="4" ClipToBounds="True"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand" ToolTip="点击预览这张模板图" MouseLeftButtonUp="Thumb_Click">
                    <Grid>
                        <TextBlock x:Name="ImageThumbHint" Text="无图" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"
                                   Foreground="{StaticResource HintTextBrush}"/>
                        <Image x:Name="ImageThumb" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="CaptureShotBtn" Style="{StaticResource BtnPrimary}" Content="▣ 框选截图"
                                MinHeight="30" Padding="10,4" Click="CaptureShot_Click"
                                ToolTip="隐藏 LTools → 冻结屏幕 → 拖个框，松手即存为模板图"/>
                        <Button Style="{StaticResource BtnGhost}" Content="换图…" Margin="6,0,0,0"
                                MinHeight="30" Padding="10,4" Click="BrowseImage_Click"/>
                        <Button x:Name="PreviewImageBtn" Style="{StaticResource BtnGhost}" Content="预览"
                                Margin="6,0,0,0" MinHeight="30" Padding="10,4" Click="PreviewImage_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ImageFileHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="模板文件" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ImagePathBox" Grid.Column="1" MinHeight="30" Margin="8,0,0,0"
                         TextChanged="ImagePath_Changed"
                         ToolTip="相对 resources/images，也可填绝对路径"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="搜索区域" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <ComboBox x:Name="RegionCombo" Grid.Column="1" MinHeight="30" Margin="8,0,8,0"
                          SelectionChanged="Region_Changed"/>
                <Button x:Name="PickRegionBtn" Grid.Column="2" Style="{StaticResource BtnGhost}"
                        Content="框选区域…" MinHeight="30" Padding="10,4" Click="PickRegion_Click"
                        ToolTip="在屏幕上框出一块，自动填入 x / y / w / h"/>
            </Grid>
            <StackPanel x:Name="RectPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBlock Text="x" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="RectXBox" Width="58" MinHeight="30" Margin="4,0,8,0"/>
                <TextBlock Text="y" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="RectYBox" Width="58" MinHeight="30" Margin="4,0,8,0"/>
                <TextBlock Text="w" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="RectWBox" Width="58" MinHeight="30" Margin="4,0,8,0"/>
                <TextBlock Text="h" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="RectHBox" Width="58" MinHeight="30" Margin="4,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="RegionHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Margin="0,4,0,0" Visibility="Collapsed"
                       Text="只在框内查找（更快更准）；目标位置会变就改成「前台窗口」。"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="等待" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ImageTimeoutBox" Grid.Column="1" Width="64" MinHeight="30" Margin="6,0,4,0"
                         ToolTip="最长等待时间；0 = 只找一次"/>
                <TextBlock Grid.Column="2" Text="ms · 间隔" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ImageIntervalBox" Grid.Column="3" Width="64" MinHeight="30" Margin="6,0,4,0"/>
                <TextBlock Grid.Column="4" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}" Margin="2,0,0,0"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="最低相似度" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ImageScoreBox" Grid.Column="1" Width="72" MinHeight="30"
                         HorizontalAlignment="Left" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- 颜色 -->
        <StackPanel x:Name="P_Color" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="读取屏幕某点的颜色；坐标支持 ${变量}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="x" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ColorXBox" Width="64" MinHeight="30" Margin="4,0,10,0"/>
                <TextBlock Text="y" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ColorYBox" Width="64" MinHeight="30" Margin="4,0,0,0"/>
                <Button x:Name="PickPointBtn" Style="{StaticResource BtnGhost}" Content="⌖ 吸管取点"
                        MinHeight="30" Padding="10,4" Margin="10,0,0,0" Click="PickColorPoint_Click"
                        ToolTip="隐藏窗口后在屏幕上单击：取坐标，条件里同时填入目标色"/>
            </StackPanel>
            <StackPanel x:Name="ColorTargetPanel" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="目标色" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ColorHexBox" Width="92" MinHeight="30" Margin="6,0,6,0" TextChanged="ColorHex_Changed"/>
                <Border x:Name="ColorPreview" Width="30" Height="30" CornerRadius="4"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                <TextBlock Text="容差" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}" Margin="10,0,4,0"/>
                <TextBox x:Name="ColorToleranceBox" Width="52" MinHeight="30"/>
                <TextBlock Text="（容差 0 = 必须完全相同）" VerticalAlignment="Center" Margin="6,0,0,0"
                           Style="{StaticResource HintLabel}"/>
            </StackPanel>
        </StackPanel>

        <!-- 窗口 -->
        <StackPanel x:Name="P_Window" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="标题包含 / 类名匹配；留空表示任意窗口"/>
            <TextBox x:Name="WindowTitleBox" MinHeight="32" Margin="0,4,0,0" ToolTip="标题包含的文本"/>
            <TextBox x:Name="WindowClassBox" MinHeight="32" Margin="0,6,0,0" ToolTip="窗口类名（可留空）"/>
        </StackPanel>

        <!-- 进程 -->
        <StackPanel x:Name="P_Process" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="进程名（不含 .exe），例如 chrome"/>
            <TextBox x:Name="ProcessNameBox" MinHeight="32" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 就地测试：用当前屏幕 / 剪贴板求值一次，不改流程 -->
        <Border x:Name="TestBar" Margin="0,12,0,0" Padding="10,8" CornerRadius="4"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TestBtn" Style="{StaticResource BtnGhost}" Content="▶ 测试这个取值"
                            MinHeight="30" Padding="10,4" Click="Test_Click"/>
                    <TextBlock x:Name="TestHint" Style="{StaticResource HintLabel}" VerticalAlignment="Center"
                               Margin="8,0,0,0" TextWrapping="Wrap"
                               Text="按现在的设置立即求值一次（测试期间窗口会短暂隐藏）"/>
                </StackPanel>
                <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                           FontFamily="Consolas" FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
