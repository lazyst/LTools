<UserControl x:Class="LTools.Views.Controls.ProbeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LTools.Views.Controls"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionLabel}" Text="取值方式" Margin="0,0,0,4"/>
        <ComboBox x:Name="KindCombo" MinHeight="32" SelectionChanged="Kind_Changed"/>

        <!-- 文本 / 变量：整段就是 ${变量} 时按变量处理（保留 found / number 等属性），否则按模板文本 -->
        <StackPanel x:Name="P_Text" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="直接输入文本；用 ${变量} 插入运行时的值（整段只写 ${变量} 时按变量处理）。$$ 表示字面 $。"/>
            <controls:VariableTextBox x:Name="TextValueBox" MinHeight="64" Margin="0,4,0,0"
                                      AcceptsReturn="True" TextWrapping="Wrap"
                                      VerticalScrollBarVisibility="Auto" MaxHeight="140"
                                      TextChanged="TextValue_Changed"/>
        </StackPanel>

        <!-- 选中文本 -->
        <StackPanel x:Name="P_Selection" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="读取前台应用当前选中的文本（通过 UI Automation，不模拟按键、不动剪贴板）。"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="退回复制时最多等" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="SelectionTimeoutBox" Width="72" MinHeight="30" Margin="6,0,0,0"
                         ToolTip="UI Automation 读不到时退回 WM_COPY，最多等这么久"/>
                <TextBlock Text="ms" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}" Margin="4,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 剪贴板 -->
        <StackPanel x:Name="P_Clipboard" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="读取系统剪贴板里的文本。"/>
        </StackPanel>

        <!-- 光标 -->
        <StackPanel x:Name="P_Cursor" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="当前光标位置，存为坐标值（${变量.x} / ${变量.y}）。"/>
        </StackPanel>

        <!-- 日期时间 -->
        <StackPanel x:Name="P_DateTime" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text=".NET 日期格式，例如 yyyy-MM-dd 或 HH:mm:ss"/>
            <TextBox x:Name="DateFormatBox" MinHeight="32" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 截图：只负责拿图（交互框选 / 前台窗口 / 整个屏幕 / 固定区域），识字交给「文字识别」 -->
        <StackPanel x:Name="P_Screenshot" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="取一张屏幕截图交给流程。要识别其中的文字，再接一步「文字识别」，把这张图的变量填进去即可。"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="截图方式" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <ComboBox x:Name="ScreenshotModeCombo" Grid.Column="1" MinHeight="30" Margin="8,0,0,0"
                          SelectionChanged="ScreenshotMode_Changed">
                    <ComboBoxItem Content="交互框选（运行时框一块）"/>
                    <ComboBoxItem Content="前台窗口"/>
                    <ComboBoxItem Content="整个屏幕"/>
                    <ComboBoxItem Content="固定区域 / 变量区域"/>
                </ComboBox>
            </Grid>

            <StackPanel x:Name="ScreenshotRectPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBlock Text="区域（物理像素 x,y,w,h）" Foreground="{StaticResource HintTextBrush}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:VariableTextBox x:Name="ScreenshotRectBox" MinHeight="30"
                                              TextChanged="TextValue_Changed"
                                              ToolTip="例如 100,200,800,600，或 ${截图} 这类区域变量"/>
                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="框选区域…"
                            MinHeight="30" Padding="10,4" Margin="8,0,0,0"
                            Click="ScreenshotPickRect_Click"
                            ToolTip="在屏幕上框一块，自动填入 x / y / w / h"/>
                </Grid>
                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="也可以填区域变量（如 ${截图}），把上一张图的区域再截一次。"/>
            </StackPanel>

            <TextBlock x:Name="ScreenshotModeHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="结果怎么用：${变量} 是区域「x,y,w,h」；${变量.cx} / ${变量.cy} 是中心点（可直接喂给鼠标操作）；${变量.w} / ${变量.h} 是尺寸；${变量.file} 是存下来的 png 路径，交给「文字识别」或「打开文件」；${变量.found} 是 true / false，交互框选按 Esc 取消时为 false。"/>
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="截下来的图片存在 resources\images\：本次运行期间一直可用（交给「文字识别」、写进剪贴板的 .file 路径都能读），下一次运行开始时清掉上一次留下的、没人引用的；编辑器里试截的图测完即删。"/>
        </StackPanel>

        <!-- 输入文本：两个字段用途不同——上面是问句，下面是输入框的预填内容 -->
        <StackPanel x:Name="P_User" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="运行时弹出输入框，流程停下等你填（确定 / 取消）。${变量} 就是填进来的文字；取消时为空且 ${变量.found} 为 false。"/>
            <TextBlock Style="{StaticResource SectionLabel}" Text="提示文字（问用户什么）" Margin="0,6,0,2"/>
            <TextBox x:Name="UserPromptBox" MinHeight="32"
                     ToolTip="运行时显示在输入框上方的说明文字，例如「请输入文件名」"/>
            <TextBlock Style="{StaticResource SectionLabel}" Text="默认值（预填在输入框里，可留空）" Margin="0,6,0,2"/>
            <TextBox x:Name="UserDefaultBox" MinHeight="32"
                     ToolTip="输入框一开始的内容，用户可以直接改；留空则从空白开始"/>
            <CheckBox x:Name="UserMultilineBox" Content="多行输入（长文本 / 多行内容）" Margin="0,8,0,0"
                      ToolTip="勾上后输入框支持换行，Ctrl+Enter 确定；单行时回车即确定"/>
        </StackPanel>

        <!-- 图像 -->
        <StackPanel x:Name="P_Image" Visibility="Collapsed" Margin="0,8,0,0">
            <controls:TemplateImagePicker x:Name="ImagePicker" Captured="ImagePicker_Captured"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="最低相似度" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ImageScoreBox" Grid.Column="1" Width="72" MinHeight="30"
                         HorizontalAlignment="Left" Margin="8,0,0,0"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="等待" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ImageTimeoutBox" Grid.Column="1" Width="64" MinHeight="30" Margin="6,0,4,0"
                         ToolTip="最长等待时间；0 = 只找一次"/>
                <TextBlock Grid.Column="2" Text="ms · 间隔" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ImageIntervalBox" Grid.Column="3" Width="64" MinHeight="30" Margin="6,0,4,0"/>
                <TextBlock Grid.Column="4" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}" Margin="2,0,0,0"/>
            </Grid>

            <!-- 找图结果怎么读：变量、found、score 三者分工不同，写清楚免得只能靠猜 -->
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="结果怎么用：${变量} 是命中位置「x,y」（没找到时为空）；${变量.found} 是 true / false；${变量.score} 是 0–1 的相似度，1 表示完全一致。分数低于「最低相似度」就算没找到——此时 ${变量.score} 仍会给出最像的那次分数，可用来判断阈值定高了还是定低了。"/>
        </StackPanel>

        <!-- 文字识别：只吃图片（通常来自「截图」步骤），不再自己截屏 -->
        <StackPanel x:Name="P_Ocr" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="识别一张图片里的文字。图片来自「截图」步骤（它会把 png 存进变量），也可以直接填图片文件路径。系统 OCR 零下载、十几毫秒出结果；PP-OCRv6 明显更准（小字、数字、深色底），代价是慢一些、占内存。识别不到文字时结果为空，可用「不为空」判断。"/>

            <TextBlock Text="图片变量 / 文件路径" Foreground="{StaticResource HintTextBrush}" Margin="0,8,0,0"/>
            <controls:VariableTextBox x:Name="OcrImageBox" MinHeight="30" Margin="0,4,0,0"
                                      TextChanged="TextValue_Changed"
                                      ToolTip="例如 ${截图}、${截图.file}，或图片文件的完整路径"/>
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="填 ${截图}（「截图」的结果会自动用它存下来的图片），也可填 ${截图.file} 或图片文件路径。直接识别那张图，不会重新截屏——中途切换窗口也不影响。"/>
        </StackPanel>

        <!-- 找文字（区域）：只查找、不点击，输出命中的文字与坐标 -->
        <StackPanel x:Name="P_TextSearch" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="在屏幕区域里找一段文字（OCR），找到就给出它的位置。找不到不是错误：结果 found = false，用「找到了 / 没找到」判断。"/>
            <TextBlock Text="要找的文字" Foreground="{StaticResource HintTextBrush}" Margin="0,8,0,0"/>
            <controls:VariableTextBox x:Name="TextSearchBox" MinHeight="30" Margin="0,4,0,0"
                                      ToolTip="按「包含」匹配，忽略大小写与词间空格；可用 ${变量}"/>
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="按「包含」匹配（写「保存」也能命中「保存并关闭」），多处出现时取最上面那个。"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="等待" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="TextSearchTimeoutBox" Width="64" MinHeight="30" Margin="8,0,4,0"
                         ToolTip="最长等待时间；0 = 只找一次"/>
                <TextBlock Text="ms · 间隔" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="TextSearchIntervalBox" Width="64" MinHeight="30" Margin="6,0,4,0"/>
                <TextBlock Text="ms" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}" Margin="2,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="结果怎么用：${变量} 是实际命中的文字；${变量.x} / ${变量.y} 是命中位置（虚拟桌面物理像素，可直接填进「鼠标操作」）；${变量.found} 是 true / false。没找到时 ${变量} 为空、坐标不存在。"/>
        </StackPanel>

        <!-- OCR 引擎：文字识别与找文字共用（缺模型时先在这里下载） -->
        <StackPanel x:Name="OcrEngineSection" Visibility="Collapsed" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="识别引擎" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <ComboBox x:Name="OcrEngineCombo" Width="240" MinHeight="30" Margin="8,0,0,0"
                          DisplayMemberPath="Label" SelectionChanged="OcrEngine_Changed"/>
            </StackPanel>
            <TextBlock x:Name="OcrEngineHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
            <StackPanel x:Name="OcrDownloadPanel" Orientation="Horizontal" Margin="0,6,0,0"
                        Visibility="Collapsed">
                <Button x:Name="OcrDownloadButton" Style="{StaticResource BtnGhost}"
                        Content="下载模型（29.8 MB）" MinHeight="30" Padding="10,4"
                        Click="OcrDownload_Click"
                        ToolTip="从 ModelScope 下载 PP-OCRv6 高精度模型并校验 SHA-256；只需下载一次"/>
                <TextBlock x:Name="OcrDownloadHint" Style="{StaticResource HintLabel}" VerticalAlignment="Center"
                           Margin="8,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- 屏幕区域：截图找图 / 找文字（搜索范围）共用 -->
        <StackPanel x:Name="RegionSection" Visibility="Collapsed" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RegionLabel" Text="搜索区域" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <ComboBox x:Name="RegionCombo" Grid.Column="1" MinHeight="30" Margin="8,0,8,0"
                          SelectionChanged="Region_Changed"/>
                <Button x:Name="PickRegionBtn" Grid.Column="2" Style="{StaticResource BtnGhost}"
                        Content="框选区域…" MinHeight="30" Padding="10,4" Click="PickRegion_Click"
                        ToolTip="在屏幕上框出一块，自动填入 x / y / w / h"/>
            </Grid>
            <StackPanel x:Name="RectPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBlock Text="x" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="RectXBox" Width="58" MinHeight="30" Margin="4,0,8,0"/>
                <TextBlock Text="y" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="RectYBox" Width="58" MinHeight="30" Margin="4,0,8,0"/>
                <TextBlock Text="w" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="RectWBox" Width="58" MinHeight="30" Margin="4,0,8,0"/>
                <TextBlock Text="h" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="RectHBox" Width="58" MinHeight="30" Margin="4,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="RegionHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- 颜色 -->
        <StackPanel x:Name="P_Color" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="读取屏幕某点的颜色；坐标支持 ${变量}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="x" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <controls:VariableTextBox x:Name="ColorXBox" Width="64" MinHeight="30" Margin="4,0,10,0"/>
                <TextBlock Text="y" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <controls:VariableTextBox x:Name="ColorYBox" Width="64" MinHeight="30" Margin="4,0,0,0"/>
                <Button x:Name="PickPointBtn" Style="{StaticResource BtnGhost}" Content="⌖ 吸管取点"
                        MinHeight="30" Padding="10,4" Margin="10,0,0,0" Click="PickColorPoint_Click"
                        ToolTip="最小化窗口后在屏幕上单击：取坐标，条件里同时填入目标色"/>
            </StackPanel>
            <StackPanel x:Name="ColorTargetPanel" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="目标色" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}"/>
                <TextBox x:Name="ColorHexBox" Width="92" MinHeight="30" Margin="6,0,6,0" TextChanged="ColorHex_Changed"/>
                <Border x:Name="ColorPreview" Width="30" Height="30" CornerRadius="4"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                <TextBlock Text="容差" VerticalAlignment="Center" Foreground="{StaticResource HintTextBrush}" Margin="10,0,4,0"/>
                <TextBox x:Name="ColorToleranceBox" Width="52" MinHeight="30"/>
                <TextBlock Text="（容差 0 = 必须完全相同）" VerticalAlignment="Center" Margin="6,0,0,0"
                           Style="{StaticResource HintLabel}"/>
            </StackPanel>
        </StackPanel>

        <!-- 窗口：默认只暴露「标题包含」一个输入框；类名属于高级用法，需要时再展开 -->
        <StackPanel x:Name="P_Window" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="窗口标题包含的文本；留空表示任意窗口。点「从当前窗口选择…」可直接挑一个，不必手填。"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WindowTitleBox" MinHeight="32" Grid.Column="0"
                         ToolTip="窗口标题包含的文本"/>
                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="从当前窗口选择…"
                        MinHeight="32" Padding="10,4" Margin="8,0,0,0" Click="PickWindow_Click"
                        ToolTip="列出当前打开的窗口，点一个即可自动填入"/>
            </Grid>

            <Button x:Name="WindowAdvancedToggle" Style="{StaticResource BtnGhost}"
                    HorizontalContentAlignment="Left" Padding="0" Margin="0,7,0,0"
                    FontSize="{StaticResource FontSizeHint}" Foreground="{StaticResource HintTextBrush}"
                    Content="高级：按窗口类名精确匹配 ▸" Click="WindowAdvanced_Click"
                    ToolTip="只有同名窗口分不清时才需要填写类名"/>
            <StackPanel x:Name="WindowAdvancedPanel" Visibility="Collapsed" Margin="0,5,0,0">
                <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                           Text="类名必须精确匹配；一般留空即可，点「从当前窗口选择…」只按标题匹配。"/>
                <TextBox x:Name="WindowClassBox" MinHeight="30" Margin="0,4,0,0"
                         ToolTip="窗口类名（可留空）"/>
            </StackPanel>
        </StackPanel>

        <!-- 上一步的错误 -->
        <StackPanel x:Name="P_LastError" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                       Text="读取上一步被「失败策略：继续下一步」吞掉的错误文本；没有错误时为空。"/>
        </StackPanel>

        <!-- 进程 -->
        <StackPanel x:Name="P_Process" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintLabel}" Text="进程名（不含 .exe），例如 chrome"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:VariableTextBox x:Name="ProcessNameBox" MinHeight="32" Grid.Column="0"/>
                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="从运行中的进程选择…"
                        MinHeight="32" Padding="10,4" Margin="8,0,0,0" Click="PickProcess_Click"
                        ToolTip="列出正在运行的进程，点一个即可自动填入"/>
            </Grid>
        </StackPanel>

        <!-- 就地测试：用当前屏幕 / 剪贴板求值一次，不改流程 -->
        <Border x:Name="TestBar" Margin="0,12,0,0" Padding="10,8" CornerRadius="4"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TestBtn" Style="{StaticResource BtnGhost}" Content="▶ 测试这个取值"
                            MinHeight="30" Padding="10,4" Click="Test_Click"/>
                    <TextBlock x:Name="TestHint" Style="{StaticResource HintLabel}" VerticalAlignment="Center"
                               Margin="8,0,0,0" TextWrapping="Wrap"
                               Text="按现在的设置立即求值一次（测试期间窗口会短暂最小化）"/>
                </StackPanel>
                <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                           FontFamily="Consolas" FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
