<UserControl x:Class="LTools.Views.Controls.AppScopeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}">
    <!-- 作用范围（进程 / 标题 / 类名）的唯一编辑器：快捷键绑定、预设组、组作用范围共用。
         条目的文案由 SetOptions 生成，这里不写死，免得「跟随默认」出现在只该有三档的地方。 -->
    <StackPanel>
        <ComboBox x:Name="ScopeBox" MinHeight="30" SelectionChanged="Scope_Changed"/>

        <StackPanel x:Name="FilterPanel" Visibility="Collapsed">
            <Grid Margin="0,10,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="进程（每行一个，支持 * ?）"
                           Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"/>
                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择进程…"
                        MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                        Click="PickProcess_Click" ToolTip="点击屏幕上的窗口，把它的进程名追加一行"/>
            </Grid>
            <TextBox x:Name="ProcessBox" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="chrome.exe / Code.exe / C:\Program Files\...\app.exe"/>

            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="窗口标题（每行一个，按包含匹配）"
                           Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"/>
                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择窗口…"
                        MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                        Click="PickTitle_Click" ToolTip="点击屏幕上的窗口，把标题追加一行"/>
            </Grid>
            <TextBox x:Name="TitleBox" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="窗口类名（每行一个）"
                           Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeHint}"/>
                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="选择窗口…"
                        MinWidth="0" Padding="8,2" FontSize="{StaticResource FontSizeHint}"
                        Click="PickClass_Click" ToolTip="点击屏幕上的窗口，把类名追加一行"/>
            </Grid>
            <TextBox x:Name="ClassBox" MinHeight="32" AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</UserControl>
