<UserControl x:Class="LTools.Views.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             x:Name="Root"
             Height="36">
    <Grid Background="Transparent">
        <!-- 标题 + 可选扩展内容（如「普通动作 / 组合动作」切换）。
             扩展内容要设 IsHitTestVisibleInChrome，否则点击会被 WindowChrome 当成拖拽标题栏。 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                       Style="{StaticResource TitleBarText}"/>
            <ContentPresenter x:Name="ExtraHost" Margin="14,0,0,0" VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
        <!-- 右侧窗口按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}"
                    Click="Minimize_Click" ToolTip="最小化">
                <Path Width="10" Height="10" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Data="M 0,5 L 10,5"/>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}"
                    Click="Maximize_Click" ToolTip="最大化">
                <Path x:Name="MaxIcon" Width="10" Height="10" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Data="M 1,1 L 9,1 L 9,9 L 1,9 Z"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}"
                    Click="Close_Click" ToolTip="关闭">
                <Path Width="10" Height="10" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
        </StackPanel>
        <!-- 底部细线 -->
        <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource BorderBrush}"/>
    </Grid>
</UserControl>
