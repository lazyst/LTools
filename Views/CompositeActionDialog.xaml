<Window x:Class="LTools.Views.CompositeActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="组合动作" Width="940" Height="660"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <controls:WidthAtLeastConverter x:Key="WidthAtLeast"/>
        <!-- 步骤行模板（宽度响应式）：
             · ListBox 够宽（≥520px）→ 单行：把手/序号/徽标/名称(*)/参数/编辑/删除，
               名称吃掉全部剩余空间，随窗口拉宽而变长；
             · 不够 → 参数下沉到第二行，上行只剩 172px 固定件 → 编辑/删除按钮恒可见。
             必须响应式：单行时 Auto 列总和约 378px > 中栏最小可用 256px，
             而 Grid 的 Auto 列不收缩，溢出从最右侧裁 → 删除按钮最先消失。
             两份参数区共用同一份 XAML（ContentPresenter + ParamsTemplate），同 DataContext
             双向绑定天然同步；切换只改 Visibility（触发器见模板底部）。 -->
        <DataTemplate x:Key="ParamsTemplate">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="⏱" VerticalAlignment="Center"
                               Foreground="{StaticResource HintTextBrush}" FontSize="13"/>
                    <TextBox Width="46" MinHeight="26" Margin="4,0,0,0"
                             Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="Delay_PreviewTextInput"/>
                    <TextBlock Text="ms" VerticalAlignment="Center"
                               Foreground="{StaticResource HintTextBrush}" FontSize="11" Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="失败" VerticalAlignment="Center"
                               Foreground="{StaticResource HintTextBrush}" FontSize="11" Margin="0,0,4,0"/>
                    <ComboBox MinWidth="78" MinHeight="28"
                              ItemsSource="{Binding StrategyOptions}"
                              SelectedIndex="{Binding OnFailIndex}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StepRowTemplate">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Margin="0,2" Padding="8,6">
                <!-- 卡片内容 = 左停靠把手 + 右侧两行 Grid。
                     禁止改回 Grid.RowSpan 让把手跨两行：跨行 Auto 行会把手的
                     DesiredSize 分摊进 Row1，ParamsBelow 折叠后仍残留 9.3px
                     （把手 ≡ 高度的一半）→ 单行态内容偏上不居中。
                     实测对照：RowSpan=2 → Grid 39.3 / 卡片 53.3；Dock 停靠 → 30 / 44。 -->
                <DockPanel LastChildFill="True">
                    <!-- 把手（停靠左侧、自动拉伸到整行高，可拖整行） -->
                    <Border DockPanel.Dock="Left" Width="18"
                            Cursor="SizeAll" Background="Transparent"
                            VerticalAlignment="Stretch" ToolTip="拖拽排序"
                            PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown">
                        <TextBlock Text="≡" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource HintTextBrush}" FontSize="14"/>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>      <!-- 身份 + 操作（+ 宽时的参数） -->
                            <RowDefinition Height="Auto"/>      <!-- 窄时的参数 -->
                        </Grid.RowDefinitions>

                        <!-- 上行：序号 | 类型徽标 | 名称（截断）| 参数（宽时）| 编辑 | 删除 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>    <!-- 序号 -->
                                <ColumnDefinition Width="Auto"/>    <!-- 类型徽标 -->
                                <ColumnDefinition Width="*"/>       <!-- 名称（截断） -->
                                <ColumnDefinition Width="Auto"/>    <!-- 参数（宽时） -->
                                <ColumnDefinition Width="30"/>      <!-- 编辑 -->
                                <ColumnDefinition Width="30"/>      <!-- 删除 -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="3"
                                    Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TypeBadge}" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding ActionName}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <ContentPresenter Grid.Column="3" x:Name="ParamsInline"
                                              Content="{Binding}" ContentTemplate="{StaticResource ParamsTemplate}"
                                              Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0"/>

                            <!-- 编辑 / 删除（Padding=0：图标在 30px 按钮里完整居中，不被 Btn 的 10,4 内边距挤压） -->
                            <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="✎"
                                    Padding="0" Width="30" Height="30" VerticalAlignment="Center"
                                    ToolTip="编辑本步（双击行亦可）" Click="EditStep_Click"/>
                            <Button Grid.Column="5" Style="{StaticResource BtnGhost}" Content="✕"
                                    Padding="0" Width="30" Height="30" VerticalAlignment="Center"
                                    ToolTip="删除步骤" Click="Delete_Click"/>
                        </Grid>

                        <!-- 下行：窄时的参数（独占整行宽度，不与名称争空间） -->
                        <ContentPresenter Grid.Row="1" x:Name="ParamsBelow"
                                          Content="{Binding}" ContentTemplate="{StaticResource ParamsTemplate}"
                                          VerticalAlignment="Center" Margin="0,5,0,0"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 宽度够 → 单行（参数上移，名称拉长）；不够 → 两行（按钮常驻） -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox},
                                               Path=ActualWidth,
                                               Converter={StaticResource WidthAtLeast}, ConverterParameter=520}"
                             Value="True">
                    <Setter TargetName="ParamsInline" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ParamsBelow" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False"/>

        <!-- 三栏正文 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="280" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左：动作来源 ============ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8,0,8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}"
                               Text="动作来源" Margin="12,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintLabel}"
                               Text="双击或拖入中间区加入步骤" Margin="12,0,12,6"/>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="12,0,12,8"
                             MinHeight="30" TextChanged="SearchBox_TextChanged"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SourceList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 中：步骤编排 ============ -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <DockPanel Margin="12,8,12,8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="步骤"/>
                        <Button Style="{StaticResource BtnGhost}" Content="改为普通动作…"
                                HorizontalAlignment="Right" Click="ToNormal_Click"
                                ToolTip="关闭本窗口并新建一个普通动作（不带数据跳转）"/>
                    </Grid>
                    <!-- EmptyHint 必须排在 ListBox 之前：DockPanel 只有最后一个子元素才
                         LastChildFill 填满剩余。否则 ListBox 落到默认 Dock="Left"，宽度变成
                         内容自然宽（且被可用宽 clamp）→ 窄窗口时右侧删除按钮被裁、
                         宽窗口时行宽固定不随窗口拉宽（实测 ListBox 只有 460px / 中间列 880px）。 -->
                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Bottom"
                               Style="{StaticResource HintLabel}"
                               Text="（无步骤）从左侧双击或拖入动作" Margin="0,6,0,0"/>
                    <ListBox x:Name="StepsList" HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource StepRowTemplate}"
                             AllowDrop="True"
                             DragOver="StepsList_DragOver" Drop="StepsList_Drop"
                             MouseDoubleClick="StepsList_DoubleClick"/>
                </DockPanel>
            </Border>

            <!-- ============ 右：组合属性 ============ -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="名称" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" MinHeight="32" Margin="0,0,0,14"/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="图标" Margin="0,0,0,6"/>
                        <controls:IconPicker x:Name="IconPicker" Margin="0,0,0,14"/>

                        <CheckBox x:Name="AbortBox"
                                  Content="任一步失败即中止（默认继续）"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnGhost}" Content="取消"
                        Width="92" MinHeight="32" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="确定"
                        Width="92" MinHeight="32" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <!-- 拖动幽灵层（覆盖全窗口，不挡鼠标；与超级面板 §5.6 同款视觉） -->
        <Canvas x:Name="GhostLayer" Grid.RowSpan="3" IsHitTestVisible="False">
            <Border x:Name="DragGhost" Visibility="Collapsed"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2" CornerRadius="6" Padding="10,6" Opacity="0.92"
                    MinWidth="180" MaxWidth="320">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="GhostBadge" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="GhostName" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <!-- 插入指示线（拖动排序的目标位置，§12） -->
            <Border x:Name="InsertLine" Height="3" CornerRadius="1.5"
                    Background="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
