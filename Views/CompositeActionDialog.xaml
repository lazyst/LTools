<Window x:Class="LTools.Views.CompositeActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LTools.Views.Controls"
        Title="组合动作" Width="980" Height="700"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" Style="{StaticResource ModernWindow}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBody}"
        PreviewMouseMove="Window_PreviewMouseMove">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <controls:WidthAtLeastConverter x:Key="WidthAtLeast"/>

        <!-- 流程行的延迟 / 失败策略（所有节点共用）。
             两份参数区共用同一份 XAML（ContentPresenter + ParamsTemplate），同 DataContext
             双向绑定天然同步；切换只改 Visibility（触发器见模板底部）。 -->
        <DataTemplate x:Key="ParamsTemplate">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="⏱" VerticalAlignment="Center"
                               Foreground="{StaticResource HintTextBrush}" FontSize="{StaticResource FontSizeHint}"/>
                    <TextBox Width="44" MinHeight="22" Margin="4,0,0,0" Padding="4,1"
                             Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="Delay_PreviewTextInput"/>
                    <TextBlock Text="ms" VerticalAlignment="Center"
                               Foreground="{StaticResource HintTextBrush}" FontSize="{StaticResource FontSizeHint}" Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="失败" VerticalAlignment="Center"
                               Foreground="{StaticResource HintTextBrush}" FontSize="{StaticResource FontSizeHint}" Margin="0,0,4,0"/>
                    <ComboBox MinWidth="74" MinHeight="22" FontSize="{StaticResource FontSizeHint}" Padding="6,0"
                              ItemsSource="{Binding StrategyOptions}"
                              SelectedIndex="{Binding OnFailIndex}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 流程行：缩进表示嵌套；标记行（否则 / 结束如果 / 结束循环）不可编辑、不可拖。 -->
        <DataTemplate x:Key="FlowRowTemplate">
            <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" CornerRadius="3"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Margin="{Binding IndentMargin}" Padding="6,2">
                <DockPanel LastChildFill="True">
                    <!-- 把手（停靠左侧、自动拉伸到整行高，可拖整行） -->
                    <Border x:Name="Grip" DockPanel.Dock="Left" Width="16"
                            Cursor="SizeAll" Background="Transparent"
                            VerticalAlignment="Stretch" ToolTip="拖到另一行即可移动"
                            PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown">
                        <TextBlock Text="≡" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource HintTextBrush}" FontSize="{StaticResource FontSizeHint}"/>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>      <!-- 身份 + 操作（+ 宽时的参数） -->
                            <RowDefinition Height="Auto"/>      <!-- 窄时的参数 -->
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>    <!-- 序号 -->
                                <ColumnDefinition Width="Auto"/>    <!-- 类型徽标 -->
                                <ColumnDefinition Width="*"/>       <!-- 标题（截断） -->
                                <ColumnDefinition Width="Auto"/>    <!-- 参数（宽时） -->
                                <ColumnDefinition Width="26"/>      <!-- 编辑 -->
                                <ColumnDefinition Width="26"/>      <!-- 删除 -->
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="NumberText" Grid.Column="0" Text="{Binding Number}" FontSize="{StaticResource FontSizeSecondary}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="2,0,6,0"/>
                            <Border x:Name="BadgeBorder" Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="3"
                                    Padding="5,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Badge}" FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Border>
                            <TextBlock x:Name="TitleText" Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeSecondary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}"/>

                            <ContentPresenter Grid.Column="3" x:Name="ParamsInline"
                                              Content="{Binding}" ContentTemplate="{StaticResource ParamsTemplate}"
                                              Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <Button x:Name="EditBtn" Grid.Column="4" Style="{StaticResource BtnGhost}" Content="✎"
                                    Padding="0" Width="24" Height="24" FontSize="{StaticResource FontSizeSecondary}"
                                    VerticalAlignment="Center"
                                    ToolTip="编辑（双击行亦可）" Click="EditRow_Click"/>
                            <Button x:Name="DeleteBtn" Grid.Column="5" Style="{StaticResource BtnGhost}" Content="✕"
                                    Padding="0" Width="24" Height="24" FontSize="{StaticResource FontSizeHint}"
                                    VerticalAlignment="Center"
                                    ToolTip="删除（含其子步骤）" Click="Delete_Click"/>
                        </Grid>

                        <ContentPresenter Grid.Row="1" x:Name="ParamsBelow"
                                          Content="{Binding}" ContentTemplate="{StaticResource ParamsTemplate}"
                                          VerticalAlignment="Center" Margin="0,2,0,0"/>
                    </Grid>
                </DockPanel>
            </Border>

            <DataTemplate.Triggers>
                <!-- 宽度够 → 单行（参数上移，标题拉长）；不够 → 两行（按钮常驻） -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox},
                                               Path=ActualWidth,
                                               Converter={StaticResource WidthAtLeast}, ConverterParameter=400}"
                             Value="True">
                    <Setter TargetName="ParamsInline" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ParamsBelow" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <!-- 跳出 / 继续 / 停止没有参数，隐藏编辑入口 -->
                <DataTrigger Binding="{Binding CanEdit}" Value="False">
                    <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <!-- 没有徽标的行（「停止」）不显示空白胶囊 -->
                <DataTrigger Binding="{Binding Badge}" Value="">
                    <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <!-- 标记行最后覆盖：更轻的视觉、不可操作 -->
                <DataTrigger Binding="{Binding IsMarker}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="0"/>
                    <Setter TargetName="Card" Property="Padding" Value="6,1"/>
                    <Setter TargetName="Grip" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ParamsInline" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ParamsBelow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DeleteBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource HintTextBrush}"/>
                    <Setter TargetName="TitleText" Property="FontStyle" Value="Italic"/>
                    <Setter TargetName="TitleText" Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBar"/>

        <!-- 三栏正文 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" MinWidth="180"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="256" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左：动作来源 ============ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8,0,8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}"
                               Text="动作来源" Margin="12,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintLabel}"
                               Text="双击或拖入中间区；插入位置随选中的行" Margin="12,0,12,6"
                               TextWrapping="Wrap"/>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="12,0,12,8"
                             MinHeight="30" TextChanged="SearchBox_TextChanged"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SourceList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 中：流程编排 ============ -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <DockPanel Margin="12,8,12,8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="流程"/>
                    </Grid>
                    <!-- EmptyHint 必须排在 ListBox 之前：DockPanel 只有最后一个子元素才
                         LastChildFill 填满剩余。否则 ListBox 落到默认 Dock="Left"，宽度变成
                         内容自然宽（且被可用宽 clamp）→ 窄窗口时右侧删除按钮被裁。 -->
                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Bottom"
                               Style="{StaticResource HintLabel}"
                               Text="（空）从左侧双击动作或流程，例如：设置变量 → 如果 → 发送文本"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <ListBox x:Name="FlowList" HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource FlowRowTemplate}"
                             AllowDrop="True"
                             DragOver="FlowList_DragOver" Drop="FlowList_Drop"
                             MouseDoubleClick="FlowList_DoubleClick">
                        <ListBox.ItemContainerStyle>
                            <!-- 行高自己控制：去掉 ListBoxItem 默认的 8,6 内边距 -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ 右：变量 + 组合属性 ============ -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="变量" Margin="0,0,0,3"/>
                        <TextBlock x:Name="VarHint" Style="{StaticResource HintLabel}" TextWrapping="Wrap"
                                   Text="变量来自「设置变量」或左侧「取值」；点一下复制 ${变量}。"/>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <controls:VariableList x:Name="VarList"/>
                        </ScrollViewer>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="名称" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" MinHeight="32" Margin="0,0,0,14"/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="图标" Margin="0,0,0,6"/>
                        <controls:IconPicker x:Name="IconPicker" Margin="0,0,0,14"/>

                        <CheckBox x:Name="AbortBox"
                                  Content="任一节点失败即中止（默认继续）"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnGhost}" Content="取消"
                        Width="92" MinHeight="32" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="确定"
                        Width="92" MinHeight="32" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <!-- 拖动幽灵 / 占位层（覆盖全窗口，不挡鼠标） -->
        <Canvas x:Name="GhostLayer" Grid.RowSpan="3" IsHitTestVisible="False"/>
    </Grid>
</Window>
