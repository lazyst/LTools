<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 带 Windows SDK 投影：截图 OCR 用 Windows.Media.Ocr（Win10 2004+ 系统自带，无额外模型文件） -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 管理员清单（requireAdministrator），双击即提权 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 嵌入图标 -->
    <ApplicationIcon>Icon\LTools.ico</ApplicationIcon>
    <Version>2.6.9</Version>
    <AssemblyVersion>2.6.9.0</AssemblyVersion>
    <AssemblyName>LTools</AssemblyName>
    <RootNamespace>LTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- UI Automation 客户端：读取选区文本等，不注入按键（FlaUI 是维护中的 .NET UIA 封装） -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- 图像识别：OpenCV 的 .NET 绑定（模板匹配 / 缩放）。native 包只含 win-x64。 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <!-- 高精度 OCR：PP-OCRv6 推理（ONNX Runtime + SkiaSharp，纯托管包，无原生 Paddle） -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <!-- 本机 MCP（外部 agent 帮写动作）：官方 C# SDK，HTTP 传输；只用 127.0.0.1 + 令牌。 -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- 自动触发二期：完整 Cron 解析 / 排程（Quicker 同款引擎，支持 5 段与 6 段含秒、CronFormat.IncludeSeconds） -->
    <PackageReference Include="Cronos" Version="0.13.0" />
    <!-- C# 脚本动作单元（script.csharp）：进程内 Roslyn 脚本层，MIT，net10.0 兼容。
         固定引用集见 Features/Script/CSharpRunner.cs，不开放任意 AddReferences。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <!-- 二维码生成 / 识别（image.qrcodeGen / image.qrcodeRead）：net5.0+ 主包只含核心类，
         PNG 由本项目自己画 / 存（ImageLibrary），不引 ZXing.Net.Bindings.* 的 System.Drawing 绑定包。 -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- HTML DOM + XPath（web.html）：容错 HTML 解析，MIT；与 web.request 串成「请求 → 提取」两步。 -->
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <!-- 速记的 Markdown 源码编辑器：WPF 原生 TextBox 不能局部着色，Markdown 记号和正文
         在长笔记里会糊成一片。AvalonEdit（MIT，netstandard2.0）提供逐 token 高亮、
         虚拟化滚动与自带的撤销栈；高亮定义由 Views/QuickNote/MarkdownHighlighting.cs 从
         主题色现拼（xshd 不能绑定资源，所以不落 .xshd 文件）。 -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- 速记的 Markdown 解析（预览用）：只解析成 AST，渲染成 FlowDocument 由
         Views/QuickNote/MarkdownRender.cs 自己做——不引 Markdig.Wpf，那套的配色与
         「点块回源码行」都改不动。MIT，netstandard2.0。 -->
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <!-- tests\ 是仓库内的冒烟工程（各自独立 csproj）：SDK 默认把 **/*.cs 全收进 LTools，
       必须显式排除，否则 dotnet build 会把冒烟 Program.cs 一起编进产品。 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <ApplicationDefinition Remove="tests\**" />
    <Resource Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <!-- UiHost 是独立工程（所有窗口 + 共享服务跑在普通权限进程里），别把它的源码和 obj 生成的
         .cs 一起卷进主程序——它自带 App.xaml 与 Main。 -->
    <Compile Remove="UiHost\**" />
    <Page Remove="UiHost\**" />
    <ApplicationDefinition Remove="UiHost\**" />
    <Resource Remove="UiHost\**" />
    <None Remove="UiHost\**" />
    <Content Remove="UiHost\**" />
    <EmbeddedResource Remove="UiHost\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 宿主进程直接用 ShareServer / ConfigStore / Ui 这些 internal 类型。 -->
    <InternalsVisibleTo Include="UiHost" />
    <!-- 链路层的环回冒烟（tests/LinkSmoke）：管道 / 握手 / 超时都要直接驱动 internal 类型。 -->
    <InternalsVisibleTo Include="LinkSmoke" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icon\LTools.ico">
      <Link>Icon\LTools.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- OCR 引擎按此目录找模型；tiny 随包分发，small 按需下载到数据根（见 OcrModelStore） -->
    <Content Include="Assets\Ocr\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 局域网共享的浏览器单页（内嵌 CSS/JS，随包分发；运行时由 ShareAssets 读一次） -->
    <Content Include="Assets\Share\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 相机快门音（P7-g）：截图时响的那一下，照 Snow Shot 的 audios/camera_shutter.mp3。
         出处与许可证见 licenses\CameraShutterSound-NOTICE.txt。 -->
    <Content Include="Assets\Audio\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 随包 AutoHotkey v2：脚本单元直接用，不依赖用户机器上装没装 AHK。
         只放 64 位主程序（1.2 MB）；许可证与源码出处在 licenses\ 里（GPL-2.0 要求）。
         更新用 tools\fetch-autohotkey.ps1。 -->
    <Content Include="runtime\autohotkey\AutoHotkey64.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 随包 ffmpeg：录屏（抓帧 → pipe:0 编码）用它，不依赖用户机器上装没装。
         目录由 tools\build-ffmpeg.ps1 编（精简构建，只开录屏用到的编解码器与滤镜），
         或 tools\fetch-ffmpeg.ps1 取一份（仓库 release 上的附件优先，取不到退回 gyan.dev）。
         二进制**不进仓库**，
         所以这里是通配——目录不存在时匹配为空、构建照常成功（运行时退回 PATH）。
         许可证与源码出处在 licenses\FFmpeg-NOTICE.txt（GPL 要求）。 -->
    <Content Include="runtime\ffmpeg\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="licenses\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 只随包分发示例配置 LTools.example.json，绝不生成用户配置——
         否则用户用新版 zip 解压覆盖旧版时会把已有的用户配置冲掉。
         运行时若 configs/ 缺失，ConfigBundle 回退读同目录示例作为默认值，
         首次保存才在同级生成 configs/（见 Core/ConfigLocator + Config/ConfigBundle）。 -->
    <Content Include="LTools.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- RapidOcrNet 的包内 targets 会把自带的 PP-OCRv5 模型（约 13.7 MB）拷到输出目录，
       我们只用 PP-OCRv6（Assets\Ocr），故构建 / 发布后清掉，避免发布包白白变大。 -->
  <Target Name="RemoveRapidOcrNetV5Models" AfterTargets="CopyModelsBuild">
    <ItemGroup>
      <_RapidOcrV5 Include="$(TargetDir)models\v5\**\*" />
    </ItemGroup>
    <Delete Files="@(_RapidOcrV5)" />
    <RemoveDir Directories="$(TargetDir)models\v5" Condition="'$(TargetDir)' != ''" />
  </Target>

  <Target Name="RemoveRapidOcrNetV5ModelsOnPublish" AfterTargets="CopyModelsPublish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_RapidOcrV5Publish Include="$(PublishDir)models\v5\**\*" />
    </ItemGroup>
    <Delete Files="@(_RapidOcrV5Publish)" />
    <RemoveDir Directories="$(PublishDir)models\v5" />
  </Target>

  <!-- OpenCvSharp4.runtime.win 顺带拷贝 opencv_videoio_ffmpeg（27.3 MB），它是 VideoCapture /
       VideoWriter 的 FFmpeg 后端插件，由 videoio 在用到时才 LoadLibrary。本应用只用 imgproc
       （ImRead / Resize / CvtColor / MatchTemplate，见 Features\Flow\ImageProbe.cs），从不碰 videoio，
       故构建 / 发布后删掉：解压包 -27.3 MB，zip 约 -11.6 MB。
       未指定 RID 的构建把原生库放在 runtimes\<rid>\native\ 下，发布（-r win-x64）才摊平到根，两处都要删。 -->
  <Target Name="RemoveUnusedOpenCvVideoio" AfterTargets="Build">
    <ItemGroup>
      <_OpenCvFfmpeg Include="$(TargetDir)opencv_videoio_ffmpeg*_64.dll" />
      <_OpenCvFfmpeg Include="$(TargetDir)runtimes\**\opencv_videoio_ffmpeg*_64.dll" />
    </ItemGroup>
    <Delete Files="@(_OpenCvFfmpeg)" />
  </Target>

  <Target Name="RemoveUnusedOpenCvVideoioOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_OpenCvFfmpegPublish Include="$(PublishDir)opencv_videoio_ffmpeg*_64.dll" />
      <_OpenCvFfmpegPublish Include="$(PublishDir)runtimes\**\opencv_videoio_ffmpeg*_64.dll" />
    </ItemGroup>
    <Delete Files="@(_OpenCvFfmpegPublish)" />
  </Target>

  <!-- Microsoft.CodeAnalysis.CSharp.Scripting 带 13 种语言的诊断消息卫星程序集
       （publish\<lang>\Microsoft.CodeAnalysis*.resources.dll，约 7 MB）。脚本层只用
       InvariantCulture 取英文诊断，缺卫星程序集时 .NET 自动回退主程序集里的中性资源，
       不会抛异常；与 OpenCV ffmpeg / OCR v5 模型同一套「构建 / 发布后删掉」做法。 -->
  <Target Name="RemoveRoslynSatelliteResources" AfterTargets="Build">
    <ItemGroup>
      <_RoslynSatellites Include="$(TargetDir)**\Microsoft.CodeAnalysis*.resources.dll" />
    </ItemGroup>
    <Delete Files="@(_RoslynSatellites)" />
  </Target>

  <Target Name="RemoveRoslynSatelliteResourcesOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_RoslynSatellitesPublish Include="$(PublishDir)**\Microsoft.CodeAnalysis*.resources.dll" />
    </ItemGroup>
    <Delete Files="@(_RoslynSatellitesPublish)" />
  </Target>

  <!-- 发布时带上界面宿主（UiHost.exe）：先发到 obj 下的临时目录，只把 UiHost.* 拷进
       publish，免得把 LTools 自己与整套依赖再复制一遍（两个 exe 共用同一份依赖与数据根）。 -->
  <Target Name="PublishUiHost" AfterTargets="Publish">
    <MSBuild Projects="$(MSBuildProjectDirectory)\UiHost\UiHost.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(MSBuildProjectDirectory)\obj\uihost-publish\" />
    <ItemGroup>
      <_UiHostPublish Include="$(MSBuildProjectDirectory)\obj\uihost-publish\UiHost.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_UiHostPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="界面宿主已发布到 $(PublishDir)" />
  </Target>

  <!-- WindowsDesktop 共享框架会把 WinForms 一起带进 self-contained 发布：System.Windows.Forms*.dll
       三件约 22 MB（本项目一处都没用，GlobalUsings 明确「不要引用 WinForms 类型」），加上 13 种语言的
       .resources.dll 约 17 MB（产品 UI 是自己的中文，不靠框架语言包；缺卫星程序集时 .NET 自动回退
       主程序集里的中性资源）。发布后删掉：解压包约 -35 MB、zip 约 -14 MB。
       必须排在 PublishUiHost **之后**：宿主也会把同一批共享框架文件拷进 publish 目录，先删后拷等于没删。
       与 OpenCV ffmpeg 插件 / Roslyn 卫星程序集同一套「发布后删掉」做法；改这里之后跑一遍
       LTools.exe 的 selftest，确认没有隐藏的 WinForms 引用。 -->
  <Target Name="RemoveUnusedDesktopPartsOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_UnusedWinForms Include="$(PublishDir)System.Windows.Forms*.dll" />
      <_UnusedWinForms Include="$(PublishDir)System.Design.dll" />
      <_UnusedWinForms Include="$(PublishDir)System.Drawing.Design.dll" />
      <_UnusedWinForms Include="$(PublishDir)Accessibility.dll" />
      <_UnusedWinForms Include="$(PublishDir)**\System.Windows.Forms*.resources.dll" />
      <_UnusedSatellites Include="$(PublishDir)*\*.resources.dll"
                         Exclude="$(PublishDir)zh-Hans\*.resources.dll" />
    </ItemGroup>
    <Delete Files="@(_UnusedWinForms)" />
    <Delete Files="@(_UnusedSatellites)" />
  </Target>

</Project>
