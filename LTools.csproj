<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 管理员清单（requireAdministrator），双击即提权 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 嵌入图标 -->
    <ApplicationIcon>Icon\LTools.ico</ApplicationIcon>
    <Version>2.4.1</Version>
    <AssemblyVersion>2.4.1.0</AssemblyVersion>
    <AssemblyName>LTools</AssemblyName>
    <RootNamespace>LTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- UI Automation 客户端：读取选区文本等，不注入按键（FlaUI 是维护中的 .NET UIA 封装） -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- 图像识别：OpenCV 的 .NET 绑定（模板匹配 / 缩放）。native 包只含 win-x64。 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icon\LTools.ico">
      <Link>Icon\LTools.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 只随包分发示例配置 LTools.example.json，绝不生成 LTools.json——
         否则用户用新版 zip 解压覆盖旧版时会把已有的用户配置冲掉。
         运行时若 LTools.json 缺失，AppConfig.Load 回退读同目录示例作为默认值，
         首次保存才在同目录生成 LTools.json（见 Core/ConfigLocator + Config/AppConfig）。 -->
    <Content Include="LTools.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
