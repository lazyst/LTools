<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 带 Windows SDK 投影：截图 OCR 用 Windows.Media.Ocr（Win10 2004+ 系统自带，无额外模型文件） -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 管理员清单（requireAdministrator），双击即提权 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 嵌入图标 -->
    <ApplicationIcon>Icon\LTools.ico</ApplicationIcon>
    <Version>2.6.7</Version>
    <AssemblyVersion>2.6.7.0</AssemblyVersion>
    <AssemblyName>LTools</AssemblyName>
    <RootNamespace>LTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- UI Automation 客户端：读取选区文本等，不注入按键（FlaUI 是维护中的 .NET UIA 封装） -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- 图像识别：OpenCV 的 .NET 绑定（模板匹配 / 缩放）。native 包只含 win-x64。 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <!-- 高精度 OCR：PP-OCRv6 推理（ONNX Runtime + SkiaSharp，纯托管包，无原生 Paddle） -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <!-- 本机 MCP（外部 agent 帮写动作）：官方 C# SDK，HTTP 传输；只用 127.0.0.1 + 令牌。 -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- 自动触发二期：完整 Cron 解析 / 排程（Quicker 同款引擎，支持 5 段与 6 段含秒、CronFormat.IncludeSeconds） -->
    <PackageReference Include="Cronos" Version="0.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icon\LTools.ico">
      <Link>Icon\LTools.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- OCR 引擎按此目录找模型；tiny 随包分发，small 按需下载到数据根（见 OcrModelStore） -->
    <Content Include="Assets\Ocr\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 随包 AutoHotkey v2：脚本单元直接用，不依赖用户机器上装没装 AHK。
         只放 64 位主程序（1.2 MB）；许可证与源码出处在 licenses\ 里（GPL-2.0 要求）。
         更新用 tools\fetch-autohotkey.ps1。 -->
    <Content Include="runtime\autohotkey\AutoHotkey64.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="licenses\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 只随包分发示例配置 LTools.example.json，绝不生成用户配置——
         否则用户用新版 zip 解压覆盖旧版时会把已有的用户配置冲掉。
         运行时若 configs/ 缺失，ConfigBundle 回退读同目录示例作为默认值，
         首次保存才在同级生成 configs/（见 Core/ConfigLocator + Config/ConfigBundle）。 -->
    <Content Include="LTools.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- RapidOcrNet 的包内 targets 会把自带的 PP-OCRv5 模型（约 13.7 MB）拷到输出目录，
       我们只用 PP-OCRv6（Assets\Ocr），故构建 / 发布后清掉，避免发布包白白变大。 -->
  <Target Name="RemoveRapidOcrNetV5Models" AfterTargets="CopyModelsBuild">
    <ItemGroup>
      <_RapidOcrV5 Include="$(TargetDir)models\v5\**\*" />
    </ItemGroup>
    <Delete Files="@(_RapidOcrV5)" />
    <RemoveDir Directories="$(TargetDir)models\v5" Condition="'$(TargetDir)' != ''" />
  </Target>

  <Target Name="RemoveRapidOcrNetV5ModelsOnPublish" AfterTargets="CopyModelsPublish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_RapidOcrV5Publish Include="$(PublishDir)models\v5\**\*" />
    </ItemGroup>
    <Delete Files="@(_RapidOcrV5Publish)" />
    <RemoveDir Directories="$(PublishDir)models\v5" />
  </Target>

  <!-- OpenCvSharp4.runtime.win 顺带拷贝 opencv_videoio_ffmpeg（27.3 MB），它是 VideoCapture /
       VideoWriter 的 FFmpeg 后端插件，由 videoio 在用到时才 LoadLibrary。本应用只用 imgproc
       （ImRead / Resize / CvtColor / MatchTemplate，见 Features\Flow\ImageProbe.cs），从不碰 videoio，
       故构建 / 发布后删掉：解压包 -27.3 MB，zip 约 -11.6 MB。
       未指定 RID 的构建把原生库放在 runtimes\<rid>\native\ 下，发布（-r win-x64）才摊平到根，两处都要删。 -->
  <Target Name="RemoveUnusedOpenCvVideoio" AfterTargets="Build">
    <ItemGroup>
      <_OpenCvFfmpeg Include="$(TargetDir)opencv_videoio_ffmpeg*_64.dll" />
      <_OpenCvFfmpeg Include="$(TargetDir)runtimes\**\opencv_videoio_ffmpeg*_64.dll" />
    </ItemGroup>
    <Delete Files="@(_OpenCvFfmpeg)" />
  </Target>

  <Target Name="RemoveUnusedOpenCvVideoioOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_OpenCvFfmpegPublish Include="$(PublishDir)opencv_videoio_ffmpeg*_64.dll" />
      <_OpenCvFfmpegPublish Include="$(PublishDir)runtimes\**\opencv_videoio_ffmpeg*_64.dll" />
    </ItemGroup>
    <Delete Files="@(_OpenCvFfmpegPublish)" />
  </Target>

</Project>
