# Release 文件夹
Release/
Release.zip

# 调试日志文件
*.log

# IDE配置文件
.vscode/
.idea/
.trae/

# Claude 配置目录
.claude/

# 系统文件
Thumbs.db
.DS_Store

# Python缓存
__pycache__/
*.pyc
*.pyo

# 速记目录
速记/
# 宏事件目录（运行时生成）
macros/
# 运行时日志目录
logs/
# 可随时清空的运行缓存（运行期截图 cache/screenshots，下一次运行 / 启动时整体清空）
/cache/
# AI 接入：服务配置（含令牌）/ 知识包 / 审计，与暂存区草稿（运行时生成）
/ai/
/staging/
# 跨动作状态（「存状态 / 读状态」单元写的表，随备份走，不进仓库）
/state/
# 全局子动作库（一个子动作一个 json，随备份走，不进仓库）
/subactions/
# 框选截图生成的模板图（程序生成、可回收，随备份走，不进仓库）
resources/images/
# 用户自己放进来的素材（找图模板等，永不回收，随备份走，不进仓库）
resources/user/
# 误产生的空文件
null
# C# 本地构建产物（仓库根 bin/）与临时诊断目录
bin/
.diag/

# C# 构建产物（项目扁平化后）
obj/

# 发布产物（本地构建）
LTools-*.zip
CapsLockPro-*.zip   # 改名前旧产物

# 用户本地配置（仅保留示例 LTools.example.json）
LTools.json
# 配置解析失败时的现场备份（ConfigBundle.TryBackupUnreadable）
LTools.json.bad-*
# 分域后的配置目录（settings / ui / menus / panel / floating / macros），迁移后旧文件归档为 .migrated
/configs/
LTools.json.migrated*
# 动作目录（一个动作一个目录：action.json + files/），与删除后保留的回收目录
/actions/
/trash/
CapsLock++.json   # 改名前旧配置

# 自动触发紧急禁用：数据根下的空文件（存在即暂停全部自动触发，与托盘菜单同源）
/disable-auto-trigger.txt

publish/

# 按需下载的 OCR 模型（PP-OCRv6 高精度），dev 落在仓库根
ocr-models/

