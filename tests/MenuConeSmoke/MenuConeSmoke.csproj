<Project Sdk="Microsoft.NET.Sdk">

  <!--
    右键菜单「预测锥」的真鼠标冒烟（仓库外跑，不进 CI）。
    - 真实 `ContextMenu` + `SetCursorPos` 斜穿相邻菜单项，断言子菜单不换项 / 不闪高亮 / 停住让位；
    - 用反射驱动 LTools.dll 里的 internal 类型（MenuFx / MenuCone），不复制任何产品代码；
    - 只断言「看得见的行为」：`IsSubmenuOpen` / 模板底板颜色 / 指针下的命中。

    直接引用 Debug 输出里的 LTools.dll（不走 ProjectReference）：本冒烟不需要动「LTools 怎么构建」，
    也不会顺手把带提权清单的 exe 盖到开发输出上。跑之前先构建产品：
        dotnet build -p:NoWin32Manifest=true
        cd tests\MenuConeSmoke；dotnet run
    相关文档：tests/README.md、AGENTS.md「MenuItem 模板」那条。
  -->
  <PropertyGroup>
    <!-- Exe 而不是 WinExe：结果靠 stdout 打印，`dotnet run` 要能把 PASS / FAIL 显示出来 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MenuConeSmoke</AssemblyName>
    <RootNamespace>MenuConeSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LTools">
      <HintPath>..\..\bin\Debug\net10.0-windows10.0.19041.0\LTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
