<Project Sdk="Microsoft.NET.Sdk">

  <!--
    进程间链路（命名管道）的环回冒烟（仓库外跑，不进 CI）：
    - 真起一条命名管道，LinkServer + LinkClient 走完整握手 / 请求 / 事件 / 超时 / 断开 / 重连；
    - 1 MB 负载验帧切分与缓冲增长；
    - 跑之前先构建产品：dotnet build -p:NoWin32Manifest=true
        cd tests\LinkSmoke；dotnet run
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LinkSmoke</AssemblyName>
    <RootNamespace>LinkSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LTools">
      <HintPath>..\..\bin\Debug\net10.0-windows10.0.19041.0\LTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
