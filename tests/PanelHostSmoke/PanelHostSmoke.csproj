<Project Sdk="Microsoft.NET.Sdk">

  <!--
    普通权限宿主的只读初始化冒烟（仓库外跑，不进 CI）：
    - 先按主程序的 Initialize 建一份临时数据根（动作 / 面板 / 快捷键都在）；
    - 再调 InitializeReadOnly，断言**一个字节都没写**、动作与面板照常读得到、Save 被拒绝；
    - 再拿一个空数据根调 InitializeReadOnly，断言它不会把默认面板写出来。
    跑之前先构建产品：dotnet build -p:NoWin32Manifest=true
        cd tests\PanelHostSmoke；dotnet run
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PanelHostSmoke</AssemblyName>
    <RootNamespace>PanelHostSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LTools">
      <HintPath>..\..\bin\Debug\net10.0-windows10.0.19041.0\LTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
