<Project Sdk="Microsoft.NET.Sdk">

  <!--
    快捷键「组作用范围」+ 作用范围编辑器 + CapsLock 录入修复的界面冒烟（仓库内，不进 CI）。
    - 用反射驱动 LTools.dll 里的 internal 类型：HotkeysView / HotkeyGroupDialog / HotkeyEditDialog / AppScopeEditor
    - 只验「界面能建出来 + 组作用范围进到行 / 对话框里」；真按键行为靠手按（钩子会忽略注入事件）
    跑之前先构建产品：
        dotnet build -p:NoWin32Manifest=true
        cd tests\HotkeyScopeSmoke；dotnet run
    详见 tests/README.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HotkeyScopeSmoke</AssemblyName>
    <RootNamespace>HotkeyScopeSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LTools">
      <HintPath>..\..\bin\Debug\net10.0-windows10.0.19041.0\LTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
