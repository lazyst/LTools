<Project Sdk="Microsoft.NET.Sdk">

  <!--
    运行内核的端到端冒烟（仓库外跑，不进 CI）：
    - 真起 RunCoordinator + 专用线程跑假动作（flow.delay），验并发 / 上限 / 同动作两份 /
      队列 / 停止一个 / 停止全部 / 试运行拒绝 / 运行历史；
    - 不注入键鼠、不弹窗口：钩子行为仍需真机点（见 docs/RUN_INTEROP.md §13）。
    - 跑之前先构建产品：dotnet build -p:NoWin32Manifest=true
        cd tests\RunConcurrencySmoke；dotnet run
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RunConcurrencySmoke</AssemblyName>
    <RootNamespace>RunConcurrencySmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LTools">
      <HintPath>..\..\bin\Debug\net10.0-windows10.0.19041.0\LTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
