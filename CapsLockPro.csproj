<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 管理员清单（requireAdministrator），双击即提权 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 嵌入图标 -->
    <ApplicationIcon>Icon\CapsLock++.ico</ApplicationIcon>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <RootNamespace>CapsLockPro</RootNamespace>
  </PropertyGroup>

  <!-- 阶段6 UIA / MSAA 用的 COM 互操作程序集（按需启用：-p:EnableUia=true） -->
  <ItemGroup Condition="'$(EnableUia)' == 'true'">
    <COMReference Include="UIAutomationClient">
      <Guid>944de083-8fb8-4cf2-8e6e-8b22f0670e69</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icon\CapsLock++.ico">
      <Link>Icon\CapsLock++.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 只随包分发示例配置 CapsLock++.example.json，绝不生成 CapsLock++.json——
         否则用户用新版 zip 解压覆盖旧版时会把已有的用户配置冲掉。
         运行时若 CapsLock++.json 缺失，AppConfig.Load 回退读同目录示例作为默认值，
         首次保存才在同目录生成 CapsLock++.json（见 Core/ConfigLocator + Config/AppConfig）。 -->
    <Content Include="CapsLock++.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
